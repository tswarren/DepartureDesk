<% content_for :title, "Set up a #{family_title} · #{@departure.name} · DepartureDesk" %>
<% arrangement = (@arrangement_attributes || {}).with_indifferent_access %>
<% item = (@item_attributes || {}).with_indifferent_access %>
<% occurrence = (@occurrence_attributes || {}).with_indifferent_access %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow"><%= @departure.name %></p>
    <h1 class="dd-page-title">Set up a <%= family_title %></h1>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: request.path.sub("/new", ""), method: :post, class: "dd-form dd-stack", data: { turbo: false } do %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
      <% if @form_error.present? %>
        <div id="form-error-summary" class="dd-form-error-summary" role="alert" tabindex="-1">
          <h2 class="dd-form-error-summary__title">Please fix the following:</h2>
          <ul><li><%= @form_error %></li></ul>
        </div>
      <% end %>
      <div class="dd-field-group">
        <label class="dd-label" for="arrangement_contracting_supplier_id">Contracting Supplier</label>
        <select id="arrangement_contracting_supplier_id" name="arrangement[contracting_supplier_id]" class="dd-field" required>
          <option value="">Choose a supplier</option>
          <% active_supplier_options.each do |supplier| %>
            <option value="<%= supplier.id %>" <%= "selected" if arrangement[:contracting_supplier_id].to_s == supplier.id.to_s %>><%= supplier_option_label(supplier) %></option>
          <% end %>
        </select>
      </div>
      <div class="dd-field-group">
        <label class="dd-label" for="arrangement_name">Arrangement name</label>
        <input id="arrangement_name" name="arrangement[name]" class="dd-field" required maxlength="160" value="<%= arrangement[:name] %>">
      </div>
      <div class="dd-field-group">
        <label class="dd-label" for="item_name">Service name</label>
        <input id="item_name" name="item[name]" class="dd-field" required maxlength="160" value="<%= item[:name] %>">
      </div>
      <% if @family == "activities" %>
        <div class="dd-field-group">
          <label class="dd-label" for="template">Template</label>
          <select id="template" name="template" class="dd-field">
            <option value="activity">Activity</option>
            <option value="meal">Meal</option>
            <option value="excursion">Excursion</option>
          </select>
        </div>
      <% end %>
      <% if @family == "transportation" %>
        <div class="dd-field-group">
          <label class="dd-label" for="occurrence_pickup">Pickup</label>
          <input id="occurrence_pickup" name="occurrence[pickup]" class="dd-field" value="<%= occurrence[:pickup] %>">
        </div>
        <div class="dd-field-group">
          <label class="dd-label" for="occurrence_dropoff">Drop-off</label>
          <input id="occurrence_dropoff" name="occurrence[dropoff]" class="dd-field" value="<%= occurrence[:dropoff] %>">
        </div>
        <div class="dd-field-group">
          <label class="dd-label" for="seat_count">Seats</label>
          <input id="seat_count" name="seat_count" class="dd-field" inputmode="numeric" value="<%= params[:seat_count] %>">
        </div>
      <% end %>
      <div class="dd-field-group">
        <label class="dd-label" for="occurrence_name">Schedule name</label>
        <input id="occurrence_name" name="occurrence[name]" class="dd-field" required maxlength="160" value="<%= occurrence[:name] %>">
      </div>
      <div class="dd-field-group">
        <label class="dd-label" for="occurrence_starts_on">Start date</label>
        <input id="occurrence_starts_on" name="occurrence[starts_on]" type="date" class="dd-field" required value="<%= occurrence[:starts_on] %>">
      </div>
      <div class="dd-field-group">
        <label class="dd-label" for="occurrence_ends_on">End date</label>
        <input id="occurrence_ends_on" name="occurrence[ends_on]" type="date" class="dd-field" required value="<%= occurrence[:ends_on] %>">
      </div>
      <div class="dd-field-group">
        <label class="dd-label" for="occurrence_time_zone">Time zone</label>
        <input id="occurrence_time_zone" name="occurrence[time_zone]" class="dd-field" required value="<%= occurrence[:time_zone] %>">
      </div>
      <div class="dd-form-actions">
        <%= submit_tag "Save and continue", class: "dd-button" %>
      </div>
    <% end %>
  </div>
</article>
