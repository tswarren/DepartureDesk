<% content_for :title, "Clients · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">Clients</h1>
    <p class="dd-page-description">Search people and organizations in this agency. A source is not a Client until one is created.</p>
  </div>
  <% if Current.agency_user.permitted?(:manage_client_directory) %>
    <div class="dd-page-actions">
      <%= link_to "New Client", new_client_path, class: "dd-button" %>
      <%= link_to "Add person", new_client_person_path, class: "dd-button dd-button--quiet" %>
      <%= link_to "Add organization", new_client_organization_path, class: "dd-button dd-button--quiet" %>
    </div>
  <% end %>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: clients_path, method: :get, class: "dd-form" do |form| %>
      <div class="dd-filter-grid">
        <div class="dd-field-group">
          <%= form.label :q, "Search", class: "dd-label" %>
          <%= form.search_field :q, value: params[:q], maxlength: 100, class: "dd-field" %>
        </div>
        <div class="dd-field-group">
          <%= form.label :kind, "Record type", class: "dd-label" %>
          <%= form.select :kind, [ [ "All", "all" ], [ "People", "people" ], [ "Organizations", "organizations" ] ], { selected: @kind }, class: "dd-field" %>
        </div>
        <div class="dd-field-group">
          <%= form.label :status, "Status", class: "dd-label" %>
          <%= form.select :status, [ [ "Active", "active" ], [ "Inactive", "inactive" ], [ "Active and inactive", "all" ] ], { selected: @status }, class: "dd-field" %>
        </div>
        <div class="dd-field-group">
          <%= form.label :creator, "Created by", class: "dd-label" %>
          <%= form.select :creator, [ [ "Anyone", "any" ], [ "A reseller", "reseller" ] ], { selected: @creator }, class: "dd-field", aria: { describedby: "creator_hint" } %>
          <p class="dd-field-hint" id="creator_hint">A reseller creates profiles as it books, with no duplicate check, so review them here.</p>
        </div>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Apply", class: "dd-button" %>
        <%= link_to "Reset", clients_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>

<% if @search %>
  <article class="dd-panel dd-results" aria-labelledby="results-heading">
    <header class="dd-panel-header">
      <h2 class="dd-panel-title" id="results-heading"><%= @search.truncated ? "Showing the first 50 records matched. Narrow the #{params[:q].present? ? "search" : "filters"} to see the rest." : "#{pluralize(@search.records.size, "record")} matched." %></h2>
    </header>
    <div class="dd-table-wrap">
    <table class="dd-table">
      <caption class="dd-visually-hidden">Clients</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Record type</th>
          <th scope="col">Client reference</th>
          <th scope="col">Source status</th>
          <th scope="col">Client status</th>
        </tr>
      </thead>
      <tbody>
        <% @search.records.each do |record| %>
          <tr>
            <td>
              <% if record.record_type == "organization" %>
                <%= link_to record.display_name, client_organization_path(record.id) %>
              <% else %>
                <%= link_to record.display_name, client_person_path(record.id) %>
              <% end %>
            </td>
            <td><%= record.record_type == "organization" ? "Organization" : "Person" %></td>
            <td><%= record.client_reference.presence || "No Client" %></td>
            <td><%= directory_status_badge(record.status) %></td>
            <td><%= record.client_status.present? ? directory_status_badge(record.client_status) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </article>
<% end %>
