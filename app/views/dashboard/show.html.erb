<% content_for :title, "Dashboard · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Workspace</p>
    <h1 class="dd-page-title">Dashboard</h1>
    <p class="dd-page-description">
      <%= Current.agency.name %> · <%= Current.agency_user.access_role.titleize %>
    </p>
  </div>
</header>

<section class="dd-grid dd-grid--main">
  <article class="dd-panel">
    <header class="dd-panel-header">
      <h2 class="dd-panel-title">Current office</h2>
    </header>
    <div class="dd-panel-body">
      <% if Current.office %>
        <p><%= office_choice_label(Current.office) %></p>
        <p class="dd-page-description"><%= Current.office.default_timezone %></p>
      <% else %>
        <div class="dd-empty-state">
          <h3 class="dd-empty-title">No active office</h3>
          <p class="dd-empty-copy">This workspace has no active office selected. You can still sign in.</p>
        </div>
      <% end %>
      <%= link_to "Change current office", edit_current_office_path, class: "dd-button dd-button--secondary" %>
    </div>
  </article>
</section>
