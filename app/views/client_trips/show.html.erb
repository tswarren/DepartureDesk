<% content_for :title, "#{@trip.trip_reference} · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: trip_trail(@trip, current: true) %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Client Trip</p>
    <h1 class="dd-page-title"><span class="dd-type-mono"><%= @trip.trip_reference %></span></h1>
    <p class="dd-page-description">For <%= @trip.client.source.display_name %><%= ", on #{@trip.departure.name}" if @trip.departure %>.</p>
  </div>
  <div class="dd-page-actions">
    <%= render "shared/print_button" %>
    <% if Current.agency_user.permitted?(:manage_bookings) %>
      <%= link_to "Edit trip", edit_client_trip_path(@trip), class: "dd-button dd-button--quiet" %>
    <% end %>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div><dt>Status</dt><dd><%= status_badge(@trip.status_label, modifier: "neutral") %></dd></div>
      <div><dt>Responsible client</dt><dd><%= link_to @trip.client.source.display_name, client_profile_path_for(@trip.client) %> <span class="dd-type-mono"><%= @trip.client.client_reference %></span></dd></div>
      <div>
        <dt>Departure</dt>
        <dd><%= @trip.departure ? link_to("#{@trip.departure.departure_reference} · #{@trip.departure.name}", departure_path(@trip.departure)) : "None" %></dd>
      </div>
    </dl>
  </div>
</article>

<%= render "client_trips/bookings", trip: @trip, bookings: @bookings %>
<%= render "client_trips/next", trip: @trip, bookings: @bookings %>

<% if Current.agency_user.permitted?(:view_client_money) %>
  <%= render "client_trips/money", trip: @trip %>
<% end %>

<article class="dd-panel" id="travelers">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">The client's usual travelers</h2>
  </header>
  <div class="dd-panel-body">
    <% if @travelers.empty? %>
      <p class="dd-empty-copy">None linked. Any traveler can still be booked on this trip.</p>
    <% else %>
      <ul class="dd-plain-list">
        <% @travelers.each do |traveler| %>
          <li><%= link_to traveler.display_name, traveler_path(traveler) %> · <%= traveler_date_of_birth(traveler) %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</article>
