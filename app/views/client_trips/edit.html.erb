<% content_for :title, "Edit #{@trip.trip_reference} · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Clients", clients_path ], [ @trip.client.source.display_name, client_profile_path_for(@trip.client) ], [ @trip.trip_reference, client_trip_path(@trip) ], [ "Edit", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Client Trip</p>
    <h1 class="dd-page-title">Edit <%= @trip.trip_reference %></h1>
    <p class="dd-page-description">The responsible client and the reference never change.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @trip, url: client_trip_path(@trip), method: :patch, class: "dd-form", data: { controller: "unsaved-changes" } do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= render "form", form: %>
      <div class="dd-form-actions">
        <%= form.submit "Save trip", class: "dd-button" %>
        <%= link_to "Cancel", client_trip_path(@trip), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
