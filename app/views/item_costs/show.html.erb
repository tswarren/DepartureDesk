<% content_for :title, "#{@arrangement_item_definition.name} costs · DepartureDesk" %>
<% editable = @editable %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Draft Supplier costs</p>
    <h1 class="dd-page-title"><%= @arrangement_item_definition.name %></h1>
    <p class="dd-page-description"><%= @supplier_arrangement.name %> · <%= @departure.name %> · <%= @departure.operating_currency %></p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Cost forecast", departure_arrangement_cost_forecast_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
    <%= link_to "Back to arrangement", departure_arrangement_path(@departure, @supplier_arrangement, anchor: "item-#{@arrangement_item.id}"), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <p>
      <%= @item_cost_sources.empty? ? "⚠ Incomplete — no Item-scoped cost source" : (@item_cost_sources.any? { |source| source.supplier_cost_definitions.none?(&:forecast_ready?) } ? "⚠ Incomplete — a source needs a ready stage" : "✓ Declared Item costs ready") %>
    </p>
    <p>One job at a time: add a source, open a stage, then add components. Planning quantities stay in their own section below.</p>
  </div>
</article>

<section id="item-costs">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Cost sources</h2>
      <p>Exact Occurrence and Resource context when the cost is not Item-wide.</p>
    </div>
  </header>
  <%= render "supplier_arrangements/cost_sources",
        sources: @item_cost_sources,
        item: @arrangement_item,
        categories: @categories,
        editable: editable %>
</section>

<section id="planning-quantities" class="dd-panel">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Planning quantities</h2>
      <p>Participant labels and anonymous usage assumptions used by unit-rate formulas.</p>
    </div>
  </header>
  <div class="dd-panel-body">
    <h3 class="dd-panel-title">Participant categories</h3>
    <% if @categories.any? %>
      <ul>
        <% @categories.each do |category| %>
          <li>
            <%= category.label %>
            <% if editable %>
              <details>
                <summary>Edit participant category</summary>
                <%= form_with url: departure_arrangement_item_participant_category_path(@departure, @supplier_arrangement, @arrangement_item, category), method: :patch, class: "dd-form" do |form| %>
                  <%= form.hidden_field "supplier_cost_participant_category[lock_version]", value: category.lock_version %>
                  <div class="dd-field"><%= form.label "supplier_cost_participant_category[label]", "Label" %><%= form.text_field "supplier_cost_participant_category[label]", value: category.label, required: true %></div>
                  <%= form.submit "Save category", class: "dd-button dd-button--quiet" %>
                <% end %>
              </details>
              <%= button_to "Remove participant category",
                    departure_arrangement_item_participant_category_path(@departure, @supplier_arrangement, @arrangement_item, category),
                    method: :delete, class: "dd-row-action",
                    form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this participant category? Removal is blocked while a component or occupancy profile uses it." } },
                    params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="<%= empty_state_classes.join(" ") %>">No participant categories.</p>
    <% end %>
    <% if editable %>
      <details>
        <summary>Add participant category</summary>
        <%= form_with url: departure_arrangement_item_participant_categories_path(@departure, @supplier_arrangement, @arrangement_item), method: :post, class: "dd-form" do |form| %>
          <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
          <%= form.hidden_field :version_lock_version, value: @supplier_arrangement_version.lock_version %>
          <div class="dd-field"><%= form.label "supplier_cost_participant_category[label]", "Label" %><%= form.text_field "supplier_cost_participant_category[label]", required: true %></div>
          <%= form.submit "Add participant category", class: "dd-button dd-button--quiet" %>
        <% end %>
      </details>
    <% end %>

    <h3 class="dd-panel-title">Usage assumptions</h3>
    <% @item_cost_sources.each do |source| %>
      <% source.supplier_cost_definitions.each do |definition| %>
        <% quantity_components = definition.supplier_cost_components.select { |component| component.quantity_basis.present? } %>
        <% next if quantity_components.empty? %>
        <% matching = @assumptions.find { |assumption| assumption.service_occurrence_id == source.service_occurrence_id && assumption.supplier_resource_id == source.supplier_resource_id } %>
        <% if matching.nil? %>
          <% bases = quantity_components.map(&:quantity_basis) %>
          <p class="dd-alert dd-alert--warning">
            <%= if bases.any? { |basis| %w[occupancy_positions occupancy_position_nights single_occupancy_units single_occupancy_nights].include?(basis) }
                  "Define anonymous occupancy patterns"
                elsif bases.any? { |basis| basis.include?("night") || basis == "nights" }
                  "Add expected billable nights"
                elsif bases.any? { |basis| basis.include?("person") || basis == "persons" }
                  "Add expected persons"
                else
                  "Add expected resource units"
                end %>
            for <%= source.label %>.
          </p>
        <% end %>
      <% end %>
    <% end %>
    <% @assumptions.each do |assumption| %>
      <article class="dd-panel" id="assumption-<%= assumption.id %>">
        <div class="dd-panel-body">
          <p>
            Occurrence: <%= assumption.service_occurrence_id ? (@occurrence_definitions_by_item_id.fetch(@arrangement_item.id, []).find { |definition| definition.service_occurrence_id == assumption.service_occurrence_id }&.name || assumption.service_occurrence_id) : "Entire Item" %>;
            Resource: <%= assumption.supplier_resource_id ? (@resource_definitions_by_item_id.fetch(@arrangement_item.id, []).find { |definition| definition.supplier_resource_id == assumption.supplier_resource_id }&.name || assumption.supplier_resource_id) : "All resources" %>
          </p>
          <p>
            Resource units: <%= assumption.expected_resource_units.nil? ? "unknown" : assumption.expected_resource_units %>;
            persons: <%= assumption.expected_persons.nil? ? "unknown" : assumption.expected_persons %>;
            nights: <%= assumption.expected_billable_nights.nil? ? "unknown" : assumption.expected_billable_nights %>
          </p>
          <% assumption.supplier_cost_occupancy_profiles.sort_by(&:position).each do |profile| %>
            <% profile_positions = profile.supplier_cost_occupancy_profile_positions.sort_by(&:occupancy_position) %>
            <div id="profile-<%= profile.id %>" class="dd-stack">
              <p>
                Occupancy pattern: <%= profile.label %> × <%= profile.resource_unit_count %> resource unit(s) —
                <%= profile_positions.map { |position|
                      category = @categories.find { |entry| entry.id == position.participant_category_id }
                      "pos #{position.occupancy_position}: #{category&.label || position.participant_category_id}"
                    }.join(", ") %>
              </p>
              <% if editable && @categories.any? %>
                <details>
                  <summary>Edit occupancy profile</summary>
                  <%= form_with url: departure_arrangement_item_cost_assumption_occupancy_profile_path(
                        @departure, @supplier_arrangement, @arrangement_item, assumption, profile
                      ), method: :patch, class: "dd-form" do |form| %>
                    <%= form.hidden_field "supplier_cost_occupancy_profile[lock_version]", value: profile.lock_version %>
                    <div class="dd-field">
                      <%= form.label "supplier_cost_occupancy_profile[label]", "Occupancy pattern label" %>
                      <%= form.text_field "supplier_cost_occupancy_profile[label]", value: profile.label, required: true %>
                    </div>
                    <div class="dd-field">
                      <%= form.label "supplier_cost_occupancy_profile[resource_unit_count]", "Like resource units" %>
                      <%= form.number_field "supplier_cost_occupancy_profile[resource_unit_count]",
                            value: profile.resource_unit_count, min: 1, required: true %>
                    </div>
                    <fieldset>
                      <legend>Anonymous participant positions</legend>
                      <p class="dd-field-hint">Choose a category for each occupancy seat in order. Leave unused seats blank to shorten the pattern.</p>
                      <% selected_ids = profile_positions.map(&:participant_category_id) %>
                      <% 4.times do |index| %>
                        <div class="dd-field">
                          <%= label_tag "edit_profile_#{profile.id}_position_#{index}", "Position #{index + 1}" %>
                          <%= select_tag "participant_category_ids[]",
                                options_from_collection_for_select(@categories, :id, :label, selected_ids[index]),
                                include_blank: "Unused",
                                id: "edit_profile_#{profile.id}_position_#{index}" %>
                        </div>
                      <% end %>
                    </fieldset>
                    <%= form.submit "Save occupancy profile", class: "dd-button dd-button--quiet" %>
                  <% end %>
                </details>
                <%= button_to "Remove occupancy profile",
                      departure_arrangement_item_cost_assumption_occupancy_profile_path(
                        @departure, @supplier_arrangement, @arrangement_item, assumption, profile
                      ),
                      method: :delete, class: "dd-row-action",
                      form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this occupancy profile?" } },
                      params: { assumption_lock_version: assumption.lock_version } %>
              <% end %>
            </div>
          <% end %>
          <% if editable && @categories.any? %>
            <details>
              <summary>Add occupancy profile</summary>
              <%= form_with url: departure_arrangement_item_cost_assumption_occupancy_profiles_path(@departure, @supplier_arrangement, @arrangement_item, assumption), method: :post, class: "dd-form" do |form| %>
                <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
                <%= form.hidden_field :assumption_lock_version, value: assumption.lock_version %>
                <div class="dd-field"><%= form.label "supplier_cost_occupancy_profile[label]", "Occupancy pattern label" %><%= form.text_field "supplier_cost_occupancy_profile[label]", required: true %></div>
                <div class="dd-field"><%= form.label "supplier_cost_occupancy_profile[resource_unit_count]", "Like resource units" %><%= form.number_field "supplier_cost_occupancy_profile[resource_unit_count]", min: 1, required: true %></div>
                <fieldset>
                  <legend>Anonymous participant positions</legend>
                  <p class="dd-field-hint">Choose a category for each occupancy seat in order. The same category may be used more than once (for example Adult, Adult, Child).</p>
                  <% 4.times do |index| %>
                    <div class="dd-field">
                      <%= label_tag "participant_category_ids_#{index}", "Position #{index + 1}" %>
                      <%= select_tag "participant_category_ids[]",
                            options_from_collection_for_select(@categories, :id, :label),
                            include_blank: "Unused",
                            id: "participant_category_ids_#{index}" %>
                    </div>
                  <% end %>
                </fieldset>
                <%= form.submit "Add occupancy profile", class: "dd-button dd-button--quiet" %>
              <% end %>
            </details>
          <% end %>
          <% if editable %>
            <div class="dd-inline-actions">
              <%= button_to "Remove assumption", departure_arrangement_item_cost_assumption_path(@departure, @supplier_arrangement, @arrangement_item, assumption),
                    method: :delete, class: "dd-row-action",
                    form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this usage assumption and its occupancy profiles?" } },
                    params: { lock_version: assumption.lock_version } %>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
    <% if @assumptions.empty? %>
      <p class="<%= empty_state_classes.join(" ") %>">No usage assumptions yet.</p>
    <% end %>
    <% if editable %>
      <details>
        <summary>Add usage assumption</summary>
        <%= form_with url: departure_arrangement_item_cost_assumptions_path(@departure, @supplier_arrangement, @arrangement_item), method: :post, class: "dd-form" do |form| %>
          <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
          <div class="dd-field"><%= form.label "supplier_cost_usage_assumption[service_occurrence_id]", "Occurrence (optional)" %><%= form.select "supplier_cost_usage_assumption[service_occurrence_id]", @occurrence_definitions_by_item_id.fetch(@arrangement_item.id, []).map { |definition| [ definition.name, definition.service_occurrence_id ] }, include_blank: "Entire Item" %></div>
          <div class="dd-field"><%= form.label "supplier_cost_usage_assumption[supplier_resource_id]", "Resource (optional)" %><%= form.select "supplier_cost_usage_assumption[supplier_resource_id]", @resource_definitions_by_item_id.fetch(@arrangement_item.id, []).map { |definition| [ definition.name, definition.supplier_resource_id ] }, include_blank: "All resources" %></div>
          <div class="dd-field"><%= form.label "supplier_cost_usage_assumption[expected_resource_units]", "Expected resource units" %><%= form.number_field "supplier_cost_usage_assumption[expected_resource_units]", min: 0 %></div>
          <div class="dd-field"><%= form.label "supplier_cost_usage_assumption[expected_persons]", "Expected persons" %><%= form.number_field "supplier_cost_usage_assumption[expected_persons]", min: 0 %></div>
          <div class="dd-field"><%= form.label "supplier_cost_usage_assumption[expected_billable_nights]", "Expected billable nights" %><%= form.number_field "supplier_cost_usage_assumption[expected_billable_nights]", min: 0 %></div>
          <%= form.submit "Add usage assumption", class: "dd-button dd-button--quiet" %>
        <% end %>
      </details>
    <% end %>
  </div>
</section>
