<% preview = @price_preview %>
<% economics = @indicative_economics %>

<%= form_with url: preview_departure_service_offer_price_path(@departure, @service_offer), method: :post, class: "dd-form" do %>
  <%= hidden_field_tag :version_lock_version, @service_offer_version.lock_version %>
  <fieldset>
    <legend>Anonymous example</legend>
    <p class="dd-field-hint">Enter quantities only when the price uses them. Invalid preview leaves the draft intact.</p>
    <div class="dd-field-group">
      <label class="dd-label" for="scenario_persons">Persons</label>
      <%= number_field_tag "scenario[persons]", scenario&.persons || 2, min: 1, id: "scenario_persons", class: "dd-input" %>
    </div>
    <div class="dd-field-group">
      <label class="dd-label" for="scenario_resource_units">Resources</label>
      <%= number_field_tag "scenario[resource_units]", scenario&.resource_units || 1, min: 1, id: "scenario_resource_units", class: "dd-input" %>
    </div>
    <div class="dd-field-group">
      <label class="dd-label" for="scenario_nights">Billable nights</label>
      <%= number_field_tag "scenario[nights]", scenario&.nights || 7, min: 1, id: "scenario_nights", class: "dd-input" %>
    </div>
    <% occupancy_rows = Array(scenario&.occupancy_positions).presence || [
      EvaluateClientPrice::OccupancyPosition.new(key: "first", rate_category: nil),
      EvaluateClientPrice::OccupancyPosition.new(key: "second", rate_category: nil)
    ] %>
    <div data-controller="price-occupancy-fields" data-price-occupancy-fields-next-index-value="<%= occupancy_rows.size %>">
      <fieldset>
        <legend>Occupancy pattern</legend>
        <p class="dd-field-hint">Occupancy keys describe one resource, not every cabin. Add a Client rate category when the price uses one.</p>
        <div data-price-occupancy-fields-target="list">
          <% occupancy_rows.each_with_index do |position, index| %>
            <%= render "service_offers/price_occupancy_row", position: position, index: index %>
          <% end %>
        </div>
        <template data-price-occupancy-fields-target="template">
          <%= render "service_offers/price_occupancy_row", position: nil, index: "__INDEX__" %>
        </template>
        <button type="button" class="dd-button dd-button--quiet" data-action="price-occupancy-fields#add" data-price-occupancy-fields-target="addButton">
          Add occupancy position
        </button>
      </fieldset>
    </div>
    <% alternative_groups = @service_offer_version.source_bindings.select(&:alternative?).group_by(&:alternative_group_key) %>
    <% if alternative_groups.any? %>
      <% alternative_groups.each do |key, members| %>
        <fieldset>
          <legend><%= members.first.alternative_group_label.presence || "Alternative source" %></legend>
          <p class="dd-field-hint">Choose exactly one source for this scenario. The selection is not saved.</p>
          <% members.each do |binding| %>
            <label class="dd-choice">
              <%= radio_button_tag "scenario[alternative_selections][#{key}]",
                binding.id,
                Array(scenario&.selected_binding_ids).map(&:to_s).include?(binding.id.to_s),
                id: "scenario_binding_#{binding.id}" %>
              <span><%= binding.arrangement_item_definition&.name || binding.id %></span>
            </label>
          <% end %>
        </fieldset>
      <% end %>
    <% end %>
    <div class="dd-field-group">
      <label class="dd-label" for="scenario_enrollment_denominator">Enrollment denominator (optional)</label>
      <%= number_field_tag "scenario[enrollment_denominator]", scenario&.enrollment_denominator, min: 1, id: "scenario_enrollment_denominator", class: "dd-input" %>
    </div>
    <div class="dd-field-group">
      <label class="dd-choice">
        <%= check_box_tag :include_economics, "1", economics.present? %>
        <span>Include attributed Supplier cost in this preview (Staff only)</span>
      </label>
    </div>
    <div class="dd-form-actions">
      <%= submit_tag "Preview amount", class: "dd-button dd-button--quiet" %>
    </div>
  </fieldset>
<% end %>

<% if preview %>
  <% if preview.complete %>
    <p>Client amount: <strong><%= format_offer_money(preview.amount_minor_units, preview.currency || currency) %></strong></p>
    <% if preview.lines.any? %>
      <table class="dd-table">
        <thead>
          <tr>
            <th scope="col">Line</th>
            <th scope="col">Quantity</th>
            <th scope="col">Effect</th>
          </tr>
        </thead>
        <tbody>
          <% preview.lines.each do |line| %>
            <tr>
              <td>
                <%= line.label %>
                <span class="dd-field-hint">
                  <%= line.client_role.humanize %>
                  <% if line.included %> · included allocation<% end %>
                </span>
              </td>
              <td><%= line.quantity || "—" %></td>
              <td><%= format_offer_money(line.signed_revenue_effect_minor_units, preview.currency || currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% else %>
    <p>Preview is incomplete.</p>
    <ul class="dd-list">
      <% preview.blockers.each do |blocker| %>
        <li><%= blocker[:message] || blocker["message"] %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% if economics %>
  <div class="dd-panel-body">
    <h3 class="dd-panel-title">Scenario economics</h3>
    <% if economics.status == :known %>
      <p><%= economics.label.humanize %></p>
      <dl class="dd-definition-list">
        <div>
          <dt>Client revenue</dt>
          <dd><%= format_offer_money(economics.client_revenue_minor_units, economics.currency) %></dd>
        </div>
        <div>
          <dt>Forecast Supplier cost</dt>
          <dd><%= format_offer_money(economics.forecast_supplier_cost_minor_units, economics.currency) %></dd>
        </div>
        <div>
          <dt>Expected commission</dt>
          <dd><%= format_offer_money(economics.expected_commission_minor_units, economics.currency) %></dd>
        </div>
        <div>
          <dt>Scenario margin</dt>
          <dd><%= format_offer_money(economics.indicative_margin_minor_units, economics.currency) %></dd>
        </div>
      </dl>
    <% else %>
      <p>Scenario margin is unknown. <%= economics.reason %></p>
    <% end %>
    <p class="dd-field-hint">Expected commission is forecast, not cash. This is not guaranteed inventory.</p>
  </div>
<% end %>
