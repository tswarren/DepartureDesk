<% content_for :title, "New package · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Package", departure_offerings_path(@departure) ], [ "New package", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Package · <%= @departure.name %></p>
    <h1 class="dd-page-title">New package</h1>
    <p class="dd-page-description">A package groups what a client books; it never merges supplier arrangements or costs.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @offering, url: departure_offerings_path(@departure), scope: :offering, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= render "form", form: %>
      <div class="dd-form-actions">
        <%= form.submit "Save", class: "dd-button" %>
        <%= link_to "Cancel", departure_offerings_path(@departure), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
