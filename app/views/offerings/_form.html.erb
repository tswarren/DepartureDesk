<%# locals: (form:) -%>
<div class="dd-field-group">
  <%= form.label :name, class: "dd-label" %>
  <%= form.text_field :name, maxlength: Offering::NAME_LIMIT, **dd_field_options(form, :name) %>
  <%= dd_field_error(form, :name) %>
</div>
<div class="dd-field-group">
  <%= form.label :description, "Client description (optional)", class: "dd-label" %>
  <%= form.text_area :description, rows: 3, class: "dd-field" %>
</div>
