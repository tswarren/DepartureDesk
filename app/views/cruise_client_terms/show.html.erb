<% content_for :title, "Cruise Client terms — #{@supplier_arrangement.name}" %>
<div class="dd-client-terms">

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Cruise Supplier planning</p>
    <h1 class="dd-page-title">Cruise Client terms</h1>
    <p class="dd-page-description"><%= @supplier_arrangement.name %></p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Back to Cruise", departure_arrangement_cruise_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<% if @form_error.present? %>
  <div id="form-error-summary" class="dd-alert dd-alert--danger" role="alert" tabindex="-1" data-controller="form-error-summary">
    <p class="dd-alert-title">Please fix the following</p>
    <p><%= @form_error %></p>
  </div>
<% end %>

<% if @editor_open %>
  <%= render "editor" %>
<% else %>
  <%= render "summary" %>
<% end %>
</div>
