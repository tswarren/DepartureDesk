<% content_for :title, "Return #{@departure.name} to draft · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Departures</p>
    <h1 class="dd-page-title">Return to draft</h1>
    <p class="dd-page-description"><%= @departure.display_reference %> remains assigned.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @departure, url: departure_return_to_draft_path(@departure), method: :post, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= form.hidden_field :lock_version %>
      <div class="dd-field-group">
        <%= form.label :reason, "Reason", class: "dd-label" %>
        <%= form.text_area :reason, value: @reason, maxlength: ReturnDepartureToDraft::REASON_LIMIT, required: true, class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Return to draft", class: "dd-button dd-button--danger" %>
        <%= link_to "Cancel", departure_path(@departure), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
