<% content_for :title, "#{@office.name} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title"><%= @office.name %></h1>
    <p class="dd-page-description"><%= office_status_badge(@office) %></p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Edit", edit_administration_office_path(@office), class: "dd-button dd-button--secondary" %>
    <% if @office.active? %>
      <%= button_to "Deactivate", deactivate_administration_office_path(@office), method: :post, params: { lock_version: @office.lock_version }, class: "dd-button dd-button--danger", form: { data: { turbo_confirm: "Deactivate this office?" } } %>
    <% else %>
      <%= button_to "Reactivate", reactivate_administration_office_path(@office), method: :post, params: { lock_version: @office.lock_version }, class: "dd-button" %>
    <% end %>
  </div>
</header>

<%= render "administration/shared/subnav", current: :offices %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Code</dt>
        <dd class="dd-type-mono"><%= @office.code %></dd>
      </div>
      <div>
        <dt>Timezone</dt>
        <dd><%= @office.default_timezone %></dd>
      </div>
    </dl>
  </div>
</article>
