<% content_for :title, "New office · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title">New office</h1>
    <p class="dd-page-description">Office code is stored uppercase and cannot be changed later.</p>
  </div>
</header>

<%= render "administration/shared/subnav", current: :offices %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @office, url: administration_offices_path, class: "dd-form" do |form| %>
      <div class="dd-field-group">
        <%= form.label :name, class: "dd-label" %>
        <%= form.text_field :name, required: true, class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :code, "Office code", class: "dd-label" %>
        <%= form.text_field :code, required: true, maxlength: 10, class: "dd-field dd-field--code" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :default_timezone, "Timezone", class: "dd-label" %>
        <%= form.text_field :default_timezone, required: true, value: @office.default_timezone.presence || Current.agency.default_timezone, class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Create office", class: "dd-button" %>
        <%= link_to "Cancel", administration_offices_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
