<% content_for :title, "Edit office · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title">Edit office</h1>
    <p class="dd-page-description">Code <%= @office.code %> is fixed.</p>
  </div>
</header>

<%= render "administration/shared/subnav", current: :offices %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @office, url: administration_office_path(@office), class: "dd-form" do |form| %>
      <%= form.hidden_field :lock_version %>
      <div class="dd-field-group">
        <%= form.label :name, class: "dd-label" %>
        <%= form.text_field :name, required: true, class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :default_timezone, "Timezone", class: "dd-label" %>
        <%= form.text_field :default_timezone, required: true, class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Save office", class: "dd-button" %>
        <%= link_to "Cancel", administration_office_path(@office), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
