<% content_for :title, "Edit #{@office.name} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title">Edit <%= @office.name %></h1>
    <p class="dd-page-description">Office code <%= @office.code %> cannot be changed. Changing timezone does not rewrite existing timestamps.</p>
    <%= link_to "Back to office", administration_office_path(@office), class: "dd-button dd-button--quiet dd-button--small" %>
  </div>
</header>

<%= render "administration/shared/subnav", current: :offices %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <% if @office.errors.any? %>
      <div class="dd-alert dd-alert--danger" role="alert">
        <p>Please correct the following:</p>
        <ul>
          <% @office.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @office, url: administration_office_path(@office), method: :patch, class: "dd-form" do |form| %>
      <%= form.hidden_field :lock_version %>

      <div class="dd-field-group">
        <%= form.label :name, class: "dd-label" %>
        <%= form.text_field :name, required: true, class: "dd-field", aria: field_aria(@office, :name) %>
        <%= field_error @office, :name %>
      </div>

      <div class="dd-field-group">
        <%= form.label :default_timezone, "Timezone", class: "dd-label" %>
        <%= form.select :default_timezone, agency_timezone_choices(@office.default_timezone), {}, required: true, class: "dd-field", aria: field_aria(@office, :default_timezone) %>
        <%= field_error @office, :default_timezone %>
      </div>

      <div class="dd-form-actions">
        <%= form.submit "Save office", class: "dd-button" %>
        <%= link_to "Cancel", administration_office_path(@office), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
