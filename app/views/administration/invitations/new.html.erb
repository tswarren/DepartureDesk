<% content_for :title, "Invite someone · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title">Invite someone</h1>
    <p class="dd-page-description">
      Email is the login identity and is never inferred from a directory person.
      You will not be shown whether this address belongs to another agency.
    </p>
    <%= link_to "Back to team", administration_team_members_path, class: "dd-button dd-button--quiet dd-button--small" %>
  </div>
</header>

<%= render "administration/shared/subnav", current: :team %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <% if @invitation.errors.any? %>
      <div class="dd-alert dd-alert--danger" role="alert">
        <p>Please correct the following:</p>
        <ul>
          <% @invitation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @invitation,
      url: administration_invitations_path,
      method: :post,
      class: "dd-form" do |form| %>
      <div class="dd-field-group">
        <%= form.label :email_address, "Email address", class: "dd-label" %>
        <%= form.email_field :email_address, required: true, class: "dd-field", aria: field_aria(@invitation, :email_address) %>
        <%= field_error @invitation, :email_address %>
      </div>

      <fieldset class="dd-form-section">
        <legend class="dd-label">Directory person</legend>
        <p class="dd-field-hint">Invite an existing unlinked person, or create a new person with this invitation.</p>
        <div class="dd-choice-group">
          <label class="dd-choice" for="invitation_form_person_source_new">
            <%= form.radio_button :person_source, "new", id: "invitation_form_person_source_new" %>
            Create and invite a new person
          </label>
          <label class="dd-choice" for="invitation_form_person_source_existing">
            <%= form.radio_button :person_source, "existing", id: "invitation_form_person_source_existing" %>
            Invite an existing person
          </label>
        </div>
      </fieldset>

      <div class="dd-form-grid dd-form-grid--two-column">
        <div class="dd-field-group">
          <%= form.label :first_name, class: "dd-label" %>
          <%= form.text_field :first_name, class: "dd-field", aria: field_aria(@invitation, :first_name) %>
          <%= field_error @invitation, :first_name %>
        </div>

        <div class="dd-field-group">
          <%= form.label :last_name, class: "dd-label" %>
          <%= form.text_field :last_name, class: "dd-field", aria: field_aria(@invitation, :last_name) %>
          <%= field_error @invitation, :last_name %>
        </div>
      </div>

      <div class="dd-field-group">
        <%= form.label :preferred_name, class: "dd-label" %>
        <%= form.text_field :preferred_name, class: "dd-field", aria: field_aria(@invitation, :preferred_name) %>
        <%= field_error @invitation, :preferred_name %>
      </div>

      <div class="dd-field-group">
        <%= form.label :person_party_id, "Existing person", class: "dd-label" %>
        <%= form.select :person_party_id,
          @unlinked_people.map { |person| [ person.party.display_name, person.party_id ] },
          { include_blank: true },
          class: "dd-field",
          aria: field_aria(@invitation, :person_party_id) %>
        <%= field_error @invitation, :person_party_id %>
        <p class="dd-field-hint">Used when inviting an existing person. Linked team members are not listed.</p>
      </div>

      <div class="dd-field-group">
        <%= form.label :role, class: "dd-label" %>
        <%= form.select :role, AgencyMembership::ROLES, {}, class: "dd-field", aria: field_aria(@invitation, :role) %>
        <%= field_error @invitation, :role %>
      </div>

      <% if @offices.any? %>
        <fieldset class="dd-form-section"
          aria-invalid="<%= @invitation.errors[:office_ids].any? %>"
          <% if @invitation.errors[:office_ids].any? %>
            aria-describedby="<%= field_error_id(@invitation, :office_ids) %>"
          <% end %>>
          <legend class="dd-label">Offices</legend>
          <p class="dd-field-hint">Staff need at least one office and a default. Administrators need a default when an office exists.</p>
          <div class="dd-choice-group">
            <% @offices.each do |office| %>
              <label class="dd-choice" for="invitation_form_office_ids_<%= office.id %>">
                <%= check_box_tag "invitation_form[office_ids][]", office.id, Array(@invitation.office_ids).include?(office.id), id: "invitation_form_office_ids_#{office.id}" %>
                <%= office.name %> (<%= office.code %>)
              </label>
            <% end %>
          </div>
          <%= field_error @invitation, :office_ids %>
        </fieldset>

        <div class="dd-field-group">
          <%= form.label :default_office_id, "Default office", class: "dd-label" %>
          <%= form.select :default_office_id,
            @offices.map { |office| [ "#{office.name} (#{office.code})", office.id ] },
            { include_blank: true },
            class: "dd-field",
            aria: field_aria(@invitation, :default_office_id) %>
          <%= field_error @invitation, :default_office_id %>
        </div>
      <% end %>

      <div class="dd-form-actions">
        <%= form.submit "Send invitation", class: "dd-button" %>
        <%= link_to "Cancel", administration_team_members_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
