<% content_for :title, "Edit agency profile · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title">Edit agency profile</h1>
    <p class="dd-page-description">Workspace code cannot be changed.</p>
  </div>
</header>

<%= render "administration/shared/subnav", current: :agency %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @agency, url: administration_agency_path, class: "dd-form" do |form| %>
      <%= form.hidden_field :lock_version %>
      <div class="dd-field-group">
        <%= form.label :name, "Display name", class: "dd-label" %>
        <%= form.text_field :name, required: true, class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :legal_name, "Legal name", class: "dd-label" %>
        <%= form.text_field :legal_name, class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :country_code, "Country code", class: "dd-label" %>
        <%= form.text_field :country_code, required: true, maxlength: 2, class: "dd-field dd-field--code" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :default_currency, "Default currency", class: "dd-label" %>
        <%= form.text_field :default_currency, required: true, maxlength: 3, class: "dd-field dd-field--code" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :default_timezone, "Default timezone", class: "dd-label" %>
        <%= form.text_field :default_timezone, required: true, class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Save profile", class: "dd-button" %>
        <%= link_to "Cancel", administration_agency_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
