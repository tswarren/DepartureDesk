<% content_for :title, "Agency profile · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title">Agency profile</h1>
    <p class="dd-page-description">Identity and defaults for <%= @agency.name %>.</p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Edit profile", edit_administration_agency_path, class: "dd-button" %>
  </div>
</header>

<%= render "administration/shared/subnav", current: :agency %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Display name</dt>
        <dd><%= @agency.name %></dd>
      </div>
      <div>
        <dt>Legal name</dt>
        <dd><%= @agency.legal_name.presence || "Not provided" %></dd>
      </div>
      <div>
        <dt>Workspace code</dt>
        <dd class="dd-type-mono"><%= @agency.workspace_code %></dd>
      </div>
      <div>
        <dt>Country code</dt>
        <dd><%= @agency.country_code %></dd>
      </div>
      <div>
        <dt>Default timezone</dt>
        <dd><%= @agency.default_timezone %></dd>
      </div>
      <div>
        <dt>Default currency</dt>
        <dd><%= @agency.default_currency %></dd>
      </div>
      <div>
        <dt>Attention warning lead days</dt>
        <dd><%= @agency.attention_warning_lead_days.nil? ? "Not set" : @agency.attention_warning_lead_days %></dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd><%= agency_status_badge(@agency) %></dd>
      </div>
    </dl>
  </div>
</article>
