<% content_for :title, "#{@membership.user.display_name} · Team · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Administration</p>
    <h1 class="dd-page-title"><%= @membership.user.display_name %></h1>
    <p class="dd-page-description"><%= @membership.user.email_address %></p>
    <%= link_to "Back to team", administration_team_members_path, class: "dd-button dd-button--quiet dd-button--small" %>
  </div>
</header>

<%= render "administration/shared/subnav", current: :team %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Membership summary</h2>
  </header>

  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Role</dt>
        <dd><%= membership_role_badge(@membership) %></dd>
      </div>
      <div>
        <dt>Access</dt>
        <dd><%= membership_status_badge(@membership) %></dd>
      </div>
      <div>
        <dt>Default office</dt>
        <dd><%= @membership.default_office&.then { |office| "#{office.name} (#{office.code})" } || "None" %></dd>
      </div>
    </dl>

    <% if @membership.administrator? %>
      <p class="dd-field-hint">Administrators can use every active office in this agency. A default assignment is still stored for sign-in.</p>
    <% end %>

    <% if @membership.staff? && !@membership.has_active_office_assignment? %>
      <div class="dd-alert dd-alert--warning" role="status">
        This staff member has no operational office.
      </div>
    <% end %>
  </div>
</article>

<article class="dd-panel">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Office access</h2>
  </header>

  <div class="dd-panel-body">
    <% if @assigned_offices.any? %>
      <ul class="dd-list">
        <% @assigned_offices.each do |office| %>
          <% remaining = @assigned_offices.reject { |other| other.id == office.id } %>
          <li class="dd-list-item">
            <div>
              <strong class="dd-list-title"><%= office.name %> (<%= office.code %>)</strong>
              <span class="dd-list-detail">
                <%= office_status_badge(office) %>
                <%= "Default" if @membership.default_office&.id == office.id %>
              </span>
            </div>

            <div class="dd-button-group">
              <%= form_with url: revoke_office_administration_team_member_path(@membership), method: :post, class: "dd-form" do %>
                <input type="hidden" name="office_id" value="<%= office.id %>">
                <% if @membership.default_office&.id == office.id && remaining.any? %>
                  <div class="dd-field-group">
                    <label class="dd-label" for="replacement_office_id_<%= office.id %>">Replacement default</label>
                    <select name="replacement_office_id" id="replacement_office_id_<%= office.id %>" class="dd-field" required>
                      <% remaining.each do |other| %>
                        <option value="<%= other.id %>"><%= other.name %> (<%= other.code %>)</option>
                      <% end %>
                    </select>
                  </div>
                <% end %>
                <%= submit_tag "Revoke access", class: "dd-button dd-button--danger dd-button--small", data: { turbo_confirm: "Revoke access to #{office.name}?" } %>
              <% end %>
              <% unless @membership.default_office&.id == office.id %>
                <%= form_with url: set_default_office_administration_team_member_path(@membership), method: :post do %>
                  <input type="hidden" name="office_id" value="<%= office.id %>">
                  <%= submit_tag "Set as default", class: "dd-button dd-button--secondary dd-button--small" %>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="dd-empty-state">
        <h3 class="dd-empty-title">No offices are assigned</h3>
        <p class="dd-empty-copy">Grant access to an active office before this person can operate in one.</p>
      </div>
    <% end %>

    <% if @available_offices.any? %>
      <%= form_with url: grant_office_administration_team_member_path(@membership), method: :post, class: "dd-form" do %>
        <div class="dd-field-group">
          <label class="dd-label" for="office_id">Grant office access</label>
          <select name="office_id" id="office_id" class="dd-field" required>
            <% @available_offices.each do |office| %>
              <option value="<%= office.id %>"><%= office.name %> (<%= office.code %>)</option>
            <% end %>
          </select>
        </div>
        <label class="dd-choice" for="make_default">
          <input type="checkbox" name="make_default" id="make_default" value="1">
          Make this the default office
        </label>
        <div class="dd-form-actions">
          <%= submit_tag "Grant access", class: "dd-button dd-button--secondary" %>
        </div>
      <% end %>
    <% end %>
  </div>
</article>

<% if @membership.active? || @membership.suspended? %>
  <article class="dd-panel">
    <header class="dd-panel-header">
      <h2 class="dd-panel-title">Role</h2>
    </header>

    <div class="dd-panel-body">
      <%= form_with url: role_administration_team_member_path(@membership), method: :patch, class: "dd-form" do %>
        <div class="dd-field-group">
          <label class="dd-label" for="role">Change role</label>
          <select name="role" id="role" class="dd-field">
            <% AgencyMembership::ROLES.each do |role| %>
              <option value="<%= role %>" <%= "selected" if @membership.role == role %>><%= role %></option>
            <% end %>
          </select>
        </div>
        <div class="dd-form-actions">
          <%= submit_tag "Update role", class: "dd-button" %>
        </div>
      <% end %>
    </div>
  </article>
<% end %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Membership lifecycle</h2>
  </header>

  <div class="dd-panel-body">
    <% if @membership.active? %>
      <p class="dd-field-hint">Suspending access signs this person out and keeps their membership history.</p>
    <% end %>
    <% if @membership.invited? || @membership.revoked? %>
      <p class="dd-field-hint">Replacing the invitation invalidates the previous link.</p>
    <% end %>

    <div class="dd-button-group">
      <% if @membership.active? %>
        <%= form_with url: suspend_administration_team_member_path(@membership), method: :post do %>
          <%= submit_tag "Suspend access", class: "dd-button dd-button--danger", data: { turbo_confirm: "Suspend access for #{@membership.user.display_name}?" } %>
        <% end %>
      <% end %>

      <% if @membership.suspended? %>
        <%= form_with url: reactivate_administration_team_member_path(@membership), method: :post do %>
          <%= submit_tag "Reactivate access", class: "dd-button dd-button--secondary" %>
        <% end %>
      <% end %>

      <% if @membership.invited? || @membership.revoked? %>
        <%= form_with url: replace_invitation_administration_team_member_path(@membership), method: :post do %>
          <%= submit_tag "Replace invitation", class: "dd-button dd-button--secondary" %>
        <% end %>
      <% end %>

      <% if @membership.invited? %>
        <%= form_with url: revoke_invitation_administration_team_member_path(@membership), method: :post do %>
          <%= submit_tag "Revoke invitation", class: "dd-button dd-button--danger", data: { turbo_confirm: "Revoke this invitation?" } %>
        <% end %>
      <% end %>
    </div>
  </div>
</article>
