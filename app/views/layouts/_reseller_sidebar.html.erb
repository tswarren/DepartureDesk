<%# A reseller user's navigation (R-01): its home only; there are no Departure tabs or directories (step 9 plan, Screens). %>
<aside
  class="dd-sidebar"
  id="app-navigation"
  data-navigation-drawer-target="drawer">
  <div class="dd-sidebar-brand">
    <div class="dd-brand">
      <%= render "layouts/brand", alt: "DepartureDesk" %>
    </div>
    <button
      type="button"
      class="dd-drawer-close"
      data-navigation-drawer-target="close"
      data-action="navigation-drawer#close"
      aria-label="Close navigation">
      <%= icon_tag "x", html_class: "dd-icon dd-icon--md" %>
    </button>
  </div>

  <nav class="dd-sidebar-nav" aria-label="Primary navigation">
    <p class="dd-nav-section-label"><%= Current.agency_user.reseller.name %></p>
    <%= link_to reseller_root_path, class: "dd-sidebar-item", aria: { current: ("page" if controller_path.start_with?("reseller/")) } do %>
      <%= icon_tag "house" %>
      <span>Offers and bookings</span>
    <% end %>
  </nav>
</aside>
