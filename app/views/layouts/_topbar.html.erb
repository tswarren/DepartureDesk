<header class="dd-topbar" data-navigation-drawer-target="topbar">
  <button
    type="button"
    class="dd-drawer-toggle"
    data-navigation-drawer-target="toggle"
    data-action="navigation-drawer#toggle"
    aria-controls="app-navigation"
    aria-expanded="false"
    aria-label="Open navigation">
    <%= icon_tag "list", html_class: "dd-icon dd-icon--md" %>
    <span>Menu</span>
  </button>

  <%= link_to root_path, class: "dd-brand", aria: { label: "DepartureDesk home" } do %>
    <%= render "layouts/brand", compact_mark: true %>
  <% end %>

  <% if Current.office %>
    <%= link_to office_choice_label(Current.office), edit_current_office_path, class: "dd-topbar-office" %>
  <% else %>
    <%= link_to "Choose office", edit_current_office_path, class: "dd-topbar-office" %>
  <% end %>

  <div class="dd-topbar-account">
    <span class="dd-account-agency"><%= Current.agency.name %></span>
    <span class="dd-avatar" aria-hidden="true"><%= user_initials(Current.user) %></span>
    <span class="dd-account-user"><%= Current.user.display_name %></span>
    <%= button_to "Sign out",
      session_path,
      method: :delete,
      class: "dd-button dd-button--on-dark dd-button--small" %>
  </div>
</header>
