<aside
  class="dd-sidebar"
  id="app-navigation"
  data-navigation-drawer-target="drawer">
  <div class="dd-sidebar-brand">
    <span class="dd-brand-name">DepartureDesk</span>
    <button
      type="button"
      class="dd-drawer-close"
      data-navigation-drawer-target="close"
      data-action="navigation-drawer#close"
      aria-label="Close navigation">
      <%= icon_tag "x", html_class: "dd-icon dd-icon--md" %>
    </button>
  </div>

  <nav class="dd-sidebar-nav" aria-label="Primary navigation">
    <p class="dd-nav-section-label">Workspace</p>
    <%= link_to root_path, class: "dd-sidebar-item", aria: { current: primary_nav_current_for(:dashboard) } do %>
      <%= icon_tag "house" %>
      <span>Dashboard</span>
    <% end %>
    <%= link_to directory_parties_path, class: "dd-sidebar-item", aria: { current: primary_nav_current_for(:directory) } do %>
      <%= icon_tag "users" %>
      <span>Directory</span>
    <% end %>
    <%= link_to directory_clients_path, class: "dd-sidebar-item", aria: { current: primary_nav_current_for(:clients) } do %>
      <%= icon_tag "briefcase" %>
      <span>Clients</span>
    <% end %>
    <%= link_to directory_suppliers_path, class: "dd-sidebar-item", aria: { current: primary_nav_current_for(:suppliers) } do %>
      <%= icon_tag "boat" %>
      <span>Suppliers</span>
    <% end %>
    <span class="dd-sidebar-item" aria-disabled="true">
      <%= icon_tag "calendar_blank" %>
      <span>Departures</span>
    </span>
    <span class="dd-sidebar-item" aria-disabled="true">
      <%= icon_tag "suitcase" %>
      <span>Travelers</span>
    </span>
    <span class="dd-sidebar-item" aria-disabled="true">
      <%= icon_tag "coins" %>
      <span>Accounting</span>
    </span>
  </nav>

  <div class="dd-sidebar-footer">
    <p class="dd-nav-section-label">System</p>
    <% if Current.agency_membership&.administrator? %>
      <%= link_to administration_agency_path, class: "dd-sidebar-item", aria: { current: primary_nav_current_for(:administration) } do %>
        <%= icon_tag "gear" %>
        <span>Administration</span>
      <% end %>
    <% end %>
  </div>
</aside>
