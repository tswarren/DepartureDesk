<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "DepartureDesk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="DepartureDesk">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#002340">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if Rails.env.test? %>
      <meta name="turbo-prefetch" content="false">
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="<%= image_path("favicon.png") %>" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="<%= image_path("favicon.png") %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="dd-skip-link" href="#main-content">Skip to main content</a>

    <% if authenticated? %>
      <div class="dd-app-shell" data-controller="navigation-drawer">
        <div
          class="dd-drawer-backdrop"
          data-navigation-drawer-target="backdrop"
          data-action="click->navigation-drawer#close"
          hidden></div>
        <%= render "layouts/topbar" %>
        <%= render "layouts/sidebar" %>
        <div class="dd-main" data-navigation-drawer-target="main">
          <main id="main-content" class="dd-workspace<%= " dd-workspace--party" if party_workspace? %>">
            <% if notice = flash[:notice] %>
              <p class="dd-alert dd-alert--success" role="status"><%= notice %></p>
            <% end %>

            <% if alert = flash[:alert] %>
              <p class="dd-alert dd-alert--danger" role="alert"><%= alert %></p>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main id="main-content" class="dd-auth-shell">
        <section class="dd-auth-brand" aria-label="DepartureDesk">
          <div class="dd-brand">
            <%= render "layouts/brand" %>
          </div>
          <h1>Every group, clearly on course.</h1>
          <p>Coordinate departures, travelers, suppliers, reservations, and payments from one operational workspace.</p>
        </section>

        <section class="dd-auth-main">
          <div class="dd-auth-card">
            <%= yield %>
          </div>
        </section>
      </main>
    <% end %>
  </body>
</html>
