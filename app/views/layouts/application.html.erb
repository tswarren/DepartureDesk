<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "DepartureDesk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="DepartureDesk">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#002340">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if Rails.env.test? %>
      <meta name="turbo-prefetch" content="false">
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="dd-skip-link" href="#main-content">Skip to main content</a>

    <% if authenticated? %>
      <div class="dd-app-shell" data-controller="navigation-drawer">
        <div
          class="dd-drawer-backdrop"
          data-navigation-drawer-target="backdrop"
          data-action="click->navigation-drawer#close"
          hidden></div>
        <%= render "layouts/sidebar" %>
        <div class="dd-main" data-navigation-drawer-target="main">
          <%= render "layouts/topbar" %>
          <main id="main-content" class="dd-workspace">
            <% if notice = flash[:notice] %>
              <p class="dd-alert dd-alert--success" role="status"><%= notice %></p>
            <% end %>

            <% if alert = flash[:alert] %>
              <p class="dd-alert dd-alert--danger" role="alert"><%= alert %></p>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main id="main-content" class="dd-auth-shell">
        <section class="dd-auth-brand" aria-label="DepartureDesk">
          <div class="dd-brand">
            <svg class="dd-brand-mark" viewBox="0 0 40 40" aria-hidden="true">
              <circle cx="20" cy="20" r="18" fill="#007080"/>
              <path d="M10 25.5c5.2-8.8 11.2-12.4 20-12.4" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
              <circle cx="29.5" cy="13.2" r="4.2" fill="#f49a00" stroke="#002340" stroke-width="1.5"/>
            </svg>
            <span class="dd-brand-name">DepartureDesk</span>
          </div>
          <h1>Every group, clearly on course.</h1>
          <p>Coordinate departures, travelers, suppliers, reservations, and payments from one operational workspace.</p>
        </section>

        <section class="dd-auth-main">
          <div class="dd-auth-card">
            <%= yield %>
          </div>
        </section>
      </main>
    <% end %>
  </body>
</html>
