<% content_for :title, "Suppliers · #{@departure.name} · DepartureDesk" %>
<%= render "shell", active_area: "suppliers" %>

<article class="dd-panel" id="composition-suppliers">
  <div class="dd-panel-body dd-stack">
    <section aria-labelledby="current-supplier-planning-heading">
      <h2 id="current-supplier-planning-heading" class="dd-section-title">Current Supplier planning</h2>
      <nav class="dd-inline-actions" aria-label="Supplier planning actions">
        <%= link_to "All Arrangements", departure_arrangements_path(@departure), class: "dd-button" %>
        <%= link_to "Add Arrangement", new_departure_arrangement_path(@departure), class: "dd-button dd-button--quiet" %>
      </nav>

      <% arrangements = Array(@arrangements) %>
      <% if arrangements.blank? %>
        <p>No Supplier Arrangements yet.</p>
      <% else %>
        <ul>
          <% arrangements.each do |arrangement| %>
            <li>
              <%= link_to arrangement.name.presence || "Arrangement", departure_arrangement_path(@departure, arrangement) %>
              · <%= arrangement.status.to_s.humanize %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <details class="dd-disclosure">
      <summary>Advanced setup</summary>
      <p>Use Arrangement workspaces for capacity, cost terms, commitments, and graph-oriented detail.</p>
      <p><%= link_to "Open Arrangement index", departure_arrangements_path(@departure), class: "dd-link" %></p>
    </details>
  </div>
</article>
