<% content_for :title, "Supplier rates — #{@resource_definition.name}" %>

<%
  family_options = CruiseSupplierRateSupport::PROFILE_FAMILIES.map { |key, spec|
    [spec.fetch(:label), key.to_s]
  }
  starter_keys = %w[first_second additional every_traveler every_cabin single_supplement]
  profiles = (@form_profiles || []).map { |p| p.with_indifferent_access }
  if profiles.empty?
    profiles = starter_keys.map { |key|
      decoded = CruiseSupplierRateSupport.decode_profile_key(key)
      {
        "key" => key,
        "family" => key,
        "category" => nil,
        "occupancy_position_from" => decoded[:occupancy_position_from],
        "occupancy_position_to" => decoded[:occupancy_position_to]
      }
    }
  end
  custom_rows = (@form_custom_rows || []).map(&:with_indifferent_access)
  commission = (@form_commission || { method: "not_provided", shared: true }).with_indifferent_access
  matrix_initial_state = {
    profiles: profiles.map { |profile|
      {
        key: profile[:key].to_s,
        family: profile[:family].to_s,
        category: profile[:category],
        occupancy_position_from: profile[:occupancy_position_from],
        occupancy_position_to: profile[:occupancy_position_to]
      }
    },
    customRows: custom_rows.map { |row|
      {
        key: row[:key].to_s,
        label: row[:label].to_s,
        economic_role: row[:economic_role].to_s
      }
    },
    cells: (@form_cells || {}).transform_keys(&:to_s),
    commission: {
      method: (commission[:method] || "not_provided").to_s,
      shared: commission.fetch(:shared, true) != false && commission[:shared].to_s != "0",
      percentage: (commission[:percentage] || "").to_s,
      amounts: (commission[:amounts] || {}).transform_keys(&:to_s),
      rates: (commission[:rates] || {}).transform_keys(&:to_s),
      addCells: Array(commission[:add_cells]).map(&:to_s),
      subtractCells: Array(commission[:subtract_cells]).map(&:to_s)
    }
  }
%>

<article class="dd-panel" id="cruise-supplier-rates">
  <div class="dd-panel-body dd-stack">
    <p>
      <%= link_to "Back to Cruise workspace",
            departure_arrangement_cruise_path(@departure, @supplier_arrangement),
            class: "dd-link" %>
    </p>

    <header class="dd-stack">
      <h1 class="dd-page-title">Supplier rates</h1>
      <p>
        <%= @resource_definition.supplier_code.presence || @resource_definition.name %>
        · Maximum occupancy <%= @resource_definition.maximum_occupancy.presence || "not set" %>
        · <%= @departure.operating_currency %>
      </p>
    </header>

    <% if @rate_shape.compatible? == false && !@rate_shape.empty? %>
      <section class="dd-stack" aria-labelledby="advanced-rates-heading">
        <h2 id="advanced-rates-heading" class="dd-section-title">Advanced Supplier terms</h2>
        <p>These Supplier terms use a shape Cruise rates cannot reopen without discarding information.</p>
        <% if @rate_shape.reasons.any? %>
          <ul>
            <% @rate_shape.reasons.each do |reason| %>
              <li><%= reason %></li>
            <% end %>
          </ul>
        <% end %>
        <p><%= link_to "Open advanced cost planning", @advanced_path, class: "dd-button dd-button-secondary" %></p>
      </section>
    <% else %>
      <% if @editable %>
        <%= form_with url: departure_arrangement_cruise_cabin_category_supplier_rates_path(@departure, @supplier_arrangement, @supplier_resource),
              method: (@rate_shape.empty? ? :post : :patch),
              class: "dd-stack",
              html: {
                id: "cruise-supplier-rate-terms",
                data: {
                  controller: "cruise-rate-matrix",
                  cruise_rate_matrix_currency_value: (@operating_currency || @departure.operating_currency),
                  cruise_rate_matrix_preview_url_value: @preview_path,
                  cruise_rate_matrix_max_occupancy_value: @resource_definition.maximum_occupancy.to_i,
                  cruise_rate_matrix_initial_state_value: matrix_initial_state
                }
              } do %>
          <%= hidden_field_tag :version_lock_version, @cruise_shape.version.lock_version %>
          <%= hidden_field_tag :idempotency_key, @idempotency_key %>
          <% unless @rate_shape.empty? %>
            <%= hidden_field_tag :definition_lock_version, @rate_shape.definition.lock_version %>
          <% end %>
          <% if @rate_shape.legacy? %>
            <label>
              <%= check_box_tag :convert_legacy, "1", true, id: "convert_legacy" %>
              Convert this schedule to the Supplier rate matrix
            </label>
          <% end %>

          <div class="dd-field">
            <label class="dd-label" for="stage">Terms stage</label>
            <% if @rate_shape.empty? %>
              <%= select_tag :stage,
                    options_for_select([ [ "Estimate", "estimate" ], [ "Contracted", "contracted" ] ], @form_stage),
                    id: "stage", class: "dd-input" %>
            <% else %>
              <%= hidden_field_tag :stage, @form_stage %>
              <p id="stage" class="dd-help"><%= @form_stage.to_s.humanize %></p>
              <p class="dd-help">Stage is fixed after the schedule is first saved.</p>
            <% end %>
          </div>

          <section class="dd-stack" aria-labelledby="rate-terms-heading">
            <h2 id="rate-terms-heading" class="dd-section-title">Supplier rate schedule</h2>
            <% if @rate_shape.legacy? %>
              <p role="status">
                These terms were saved in the earlier fixed form. Saving converts them to the rate matrix.
                Confirm conversion below. Forecast readiness will clear.
              </p>
            <% end %>

            <fieldset class="dd-stack">
              <legend class="dd-label">Rate profiles</legend>
              <div data-cruise-rate-matrix-target="profileList"></div>
              <div class="dd-actions">
                <button type="button" class="dd-button dd-button-secondary"
                        data-action="cruise-rate-matrix#toggleProfilePanel">
                  Add rate profile
                </button>
              </div>

              <div class="dd-cruise-rate-add-profile dd-stack" data-cruise-rate-matrix-target="profilePanel" hidden>
                <input type="hidden" data-cruise-rate-matrix-target="editProfileIndex" value="">
                <div class="dd-field">
                  <label class="dd-label" for="add_profile_family">Profile family</label>
                  <select id="add_profile_family" class="dd-input"
                          data-cruise-rate-matrix-target="profileFamily"
                          data-action="change->cruise-rate-matrix#profileFamilyChanged">
                    <% family_options.each do |label, key| %>
                      <option value="<%= key %>"><%= label %></option>
                    <% end %>
                  </select>
                </div>
                <div class="dd-field" data-cruise-rate-matrix-target="profileCategoryField">
                  <label class="dd-label" for="add_profile_category">Traveler category (optional)</label>
                  <input type="text" id="add_profile_category" class="dd-input"
                         data-cruise-rate-matrix-target="profileCategory"
                         placeholder="Adult, Child, …">
                </div>
                <div class="dd-cruise-rate-bounded-fields" data-cruise-rate-matrix-target="profileBoundedFields" hidden>
                  <div class="dd-field">
                    <label class="dd-label" for="add_profile_from">Starting position</label>
                    <input type="number" id="add_profile_from" class="dd-input" min="1"
                           data-cruise-rate-matrix-target="profileFrom" value="1">
                  </div>
                  <div class="dd-field">
                    <label class="dd-label" for="add_profile_to">Ending position (optional)</label>
                    <input type="number" id="add_profile_to" class="dd-input" min="1"
                           data-cruise-rate-matrix-target="profileTo" placeholder="Open-ended">
                  </div>
                </div>
                <div class="dd-actions">
                  <button type="button" class="dd-button dd-button-primary"
                          data-action="cruise-rate-matrix#confirmProfile">Add column</button>
                  <button type="button" class="dd-button dd-button-secondary"
                          data-action="cruise-rate-matrix#cancelProfilePanel">Cancel</button>
                </div>
              </div>
            </fieldset>

            <fieldset class="dd-stack" data-cruise-rate-matrix-target="overlapPanel" hidden>
              <legend class="dd-label">Overlap with category-specific profiles</legend>
              <% resolution = @form_overlap_resolution.to_s %>
              <label>
                <%= radio_button_tag :overlap_resolution, "scope_existing_to_adult",
                      resolution == "scope_existing_to_adult", id: "overlap_scope_adult" %>
                Scope the category-free profile to Adult
              </label>
              <label>
                <%= radio_button_tag :overlap_resolution, "keep_every_traveler",
                      resolution == "keep_every_traveler", id: "overlap_keep_every" %>
                Keep the category-free profile for every traveler
              </label>
              <label>
                <%= radio_button_tag :overlap_resolution, "edit_profiles",
                      resolution == "edit_profiles", id: "overlap_edit" %>
                Return and edit the profiles
              </label>
            </fieldset>

            <div class="dd-cruise-rate-narrow">
              <label class="dd-label" for="cruise_rate_profile_select">Rate profile</label>
              <div class="dd-cruise-rate-narrow-controls">
                <button type="button" class="dd-button dd-button-secondary"
                        data-action="cruise-rate-matrix#previousProfile">Previous profile</button>
                <select id="cruise_rate_profile_select" class="dd-input"
                        data-cruise-rate-matrix-target="narrowSelect"
                        data-action="change->cruise-rate-matrix#selectProfile">
                </select>
                <button type="button" class="dd-button dd-button-secondary"
                        data-action="cruise-rate-matrix#nextProfile">Next profile</button>
              </div>
              <p class="dd-help" data-cruise-rate-matrix-target="profilePosition">1 of <%= profiles.size %></p>
            </div>

            <div class="dd-table-wrap dd-cruise-rate-matrix" role="region" aria-label="Rate components">
              <table class="dd-table">
                <thead data-cruise-rate-matrix-target="matrixHead"></thead>
                <tbody data-cruise-rate-matrix-target="matrixBody"></tbody>
              </table>
            </div>
            <p class="dd-help">Blank means pending. Enter 0.00 when the Supplier has confirmed a zero amount.</p>

            <div class="dd-actions">
              <button type="button" class="dd-button dd-button-secondary"
                      data-action="cruise-rate-matrix#toggleComponentPanel">
                Add component
              </button>
            </div>
            <div class="dd-stack" data-cruise-rate-matrix-target="componentPanel" hidden>
              <input type="hidden" data-cruise-rate-matrix-target="editRowKey" value="">
              <div class="dd-field">
                <label class="dd-label" for="component_label">Component description</label>
                <input type="text" id="component_label" class="dd-input"
                       data-cruise-rate-matrix-target="componentLabel">
              </div>
              <div class="dd-field">
                <label class="dd-label" for="component_role">Component kind</label>
                <select id="component_role" class="dd-input"
                        data-cruise-rate-matrix-target="componentRole">
                  <option value="supplier_charge">Supplier charge</option>
                  <option value="supplier_credit">Supplier credit</option>
                </select>
              </div>
              <div class="dd-actions">
                <button type="button" class="dd-button dd-button-primary"
                        data-action="cruise-rate-matrix#confirmComponent">Save component</button>
                <button type="button" class="dd-button dd-button-secondary"
                        data-action="cruise-rate-matrix#cancelComponentPanel">Cancel</button>
              </div>
            </div>
          </section>

          <fieldset class="dd-stack">
            <legend class="dd-label">How is expected commission stated?</legend>
            <div class="dd-field">
              <label class="dd-label" for="commission_method">Commission method</label>
              <select id="commission_method" class="dd-input"
                      data-cruise-rate-matrix-target="commissionMethod"
                      data-action="change->cruise-rate-matrix#selectCommissionMethod">
                <option value="not_provided" <%= "selected" if (commission[:method] || "not_provided") == "not_provided" %>>Not provided yet</option>
                <option value="dollar" <%= "selected" if commission[:method].to_s == "dollar" %>>Dollar amount</option>
                <option value="percentage" <%= "selected" if commission[:method].to_s == "percentage" %>>Percentage</option>
              </select>
            </div>

            <p class="dd-help" data-cruise-rate-matrix-target="commissionNotProvided">
              Expected commission will remain pending on illustrations until a method is chosen.
            </p>

            <div class="dd-cruise-rate-commission-panel dd-stack"
                 data-cruise-rate-matrix-target="commissionPercentagePanel" hidden>
              <label>
                <input type="checkbox" data-cruise-rate-matrix-target="commissionSharedField"
                       data-action="change->cruise-rate-matrix#commissionSharedChanged"
                       <%= "checked" if commission.fetch(:shared, true) != false %>>
                Use the same commission rate for every profile
              </label>
              <div class="dd-field">
                <label class="dd-label" for="commission_percentage">Shared commission percentage</label>
                <input type="text" id="commission_percentage" class="dd-input" inputmode="decimal"
                       data-cruise-rate-matrix-target="commissionPercentageField"
                       data-action="input->cruise-rate-matrix#commissionPercentageInput"
                       value="<%= commission[:percentage] %>">
              </div>
              <div class="dd-stack" data-cruise-rate-matrix-target="commissionRates"></div>
              <div data-cruise-rate-matrix-target="commissionTreatments"></div>
              <p class="dd-help">
                Shared percentage uses one commission component and one rounding boundary.
                Uncheck to round each profile independently.
              </p>
            </div>

            <div class="dd-cruise-rate-commission-panel dd-stack"
                 data-cruise-rate-matrix-target="commissionDollarPanel" hidden>
              <p class="dd-label">Dollar commission by profile</p>
              <div data-cruise-rate-matrix-target="commissionAmounts"></div>
            </div>
          </fieldset>

          <section class="dd-stack" aria-labelledby="rate-illustrations-heading">
            <h2 id="rate-illustrations-heading" class="dd-section-title">Per-cabin illustrations</h2>
            <div data-cruise-rate-matrix-target="occupantEditor"></div>
            <div data-cruise-rate-matrix-target="illustrations">
              <% if @preview.illustrations.any? %>
                <ul>
                  <% @preview.illustrations.each do |row| %>
                    <li>
                      <%= row.label %>:
                      <% if row.gross_minor_units %>
                        gross <%= Money.new(row.gross_minor_units, @preview.currency || @departure.operating_currency).format %>
                      <% else %>
                        gross pending
                      <% end %>
                      · commission <%= row.commission_state %>
                      · net <%= row.net_state == "shown" && row.net_minor_units ? Money.new(row.net_minor_units, @preview.currency || @departure.operating_currency).format : row.net_state %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="dd-help">Enter amounts to see per-cabin illustrations.</p>
              <% end %>
            </div>
          </section>

          <div data-cruise-rate-matrix-target="formFields" class="dd-visually-hidden" aria-hidden="true"></div>

          <div class="dd-field">
            <label class="dd-label" for="notes">Notes</label>
            <%= text_area_tag :notes, @form_notes, id: "notes", class: "dd-input", rows: 2 %>
          </div>

          <div class="dd-actions">
            <%= submit_tag "Save Supplier terms", class: "dd-button dd-button-primary" %>
            <%= link_to "Open advanced cost planning", @advanced_path, class: "dd-button dd-button-secondary" %>
          </div>
        <% end %>
      <% else %>
        <% if @preview.illustrations.any? %>
          <section class="dd-stack" aria-labelledby="rate-illustrations-heading">
            <h2 id="rate-illustrations-heading" class="dd-section-title">Per-cabin illustrations</h2>
            <ul>
              <% @preview.illustrations.each do |row| %>
                <li>
                  <%= row.label %>:
                  <% if row.gross_minor_units %>
                    gross <%= Money.new(row.gross_minor_units, @preview.currency || @departure.operating_currency).format %>
                  <% else %>
                    gross pending
                  <% end %>
                  · commission <%= row.commission_state %>
                  · net <%= row.net_state == "shown" && row.net_minor_units ? Money.new(row.net_minor_units, @preview.currency || @departure.operating_currency).format : row.net_state %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
        <p>Create a successor draft to edit Supplier rates.</p>
      <% end %>

      <section class="dd-stack" aria-labelledby="occupancy-plan-heading">
        <h2 id="occupancy-plan-heading" class="dd-section-title">Occupancy planning</h2>
        <p>Per-cabin illustrations above do not assert an expected sales mix. Enter expected cabin counts only when known.</p>
        <% if @editable %>
          <%= form_with url: occupancy_plan_departure_arrangement_cruise_cabin_category_supplier_rates_path(@departure, @supplier_arrangement, @supplier_resource),
                method: :put, class: "dd-stack", html: { id: "cruise-occupancy-plan" } do %>
            <%= hidden_field_tag :version_lock_version, @cruise_shape.version.lock_version %>
            <% if @assumption %>
              <%= hidden_field_tag :assumption_lock_version, @assumption.lock_version %>
            <% end %>
            <% CruiseSupplierRateSupport.occupancy_keys_for_maximum(@resource_definition.maximum_occupancy).each do |key| %>
              <div class="dd-field">
                <label class="dd-label" for="expected_<%= key %>">
                  <%= CruiseSupplierRateSupport::OCCUPANCY_PROFILE_SPECS.fetch(key).fetch(:label) %> expected cabins
                </label>
                <%= number_field_tag "expected_cabins[#{key}]", @form_occupancy[key] || @form_occupancy[key.to_s],
                      id: "expected_#{key}", class: "dd-input", min: 1 %>
              </div>
            <% end %>
            <div class="dd-actions">
              <%= submit_tag "Save occupancy planning", class: "dd-button dd-button-primary" %>
            </div>
          <% end %>
        <% end %>
      </section>

      <section class="dd-stack" aria-labelledby="rate-ready-heading">
        <h2 id="rate-ready-heading" class="dd-section-title">Review and mark forecast-ready</h2>
        <p>
          Blank Supplier terms will be treated as not applicable. Omitted expected commission will be treated as
          no expected commission—not as an unknown value.
        </p>
        <% if @preview.pending_fields.any? && @rate_shape.definition&.working? %>
          <p>Still pending: <%= @preview.pending_fields.map(&:humanize).to_sentence %>.</p>
        <% end %>
        <% if @editable && @rate_shape.definition&.working? %>
          <%= form_with url: forecast_readiness_departure_arrangement_cruise_cabin_category_supplier_rates_path(@departure, @supplier_arrangement, @supplier_resource),
                method: :post, class: "dd-stack", html: { id: "cruise-rate-forecast-ready" } do %>
            <%= hidden_field_tag :definition_lock_version, @rate_shape.definition.lock_version %>
            <div class="dd-field">
              <label class="dd-label" for="readiness_provenance">Readiness provenance</label>
              <%= text_field_tag :readiness_provenance, nil, id: "readiness_provenance", class: "dd-input" %>
            </div>
            <label>
              <%= check_box_tag :confirm_omissions, "1", false, id: "confirm_omissions" %>
              I confirm blank terms are not applicable and omitted commission means no expected commission.
            </label>
            <div class="dd-actions">
              <%= submit_tag "Mark terms forecast-ready", class: "dd-button dd-button-primary" %>
            </div>
          <% end %>
        <% elsif @rate_shape.definition&.forecast_ready? %>
          <p>These terms are forecast-ready.</p>
        <% end %>
      </section>
    <% end %>
  </div>
</article>
