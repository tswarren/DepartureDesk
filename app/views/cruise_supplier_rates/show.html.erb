<% content_for :title, "Supplier rates — #{@resource_definition.name}" %>

<article class="dd-panel" id="cruise-supplier-rates">
  <div class="dd-panel-body dd-stack">
    <p>
      <%= link_to "Back to Cruise workspace",
            departure_arrangement_cruise_path(@departure, @supplier_arrangement),
            class: "dd-link" %>
    </p>

    <header class="dd-stack">
      <h1 class="dd-page-title">Supplier rates</h1>
      <p>
        <%= @resource_definition.supplier_code.presence || @resource_definition.name %>
        · Maximum occupancy <%= @resource_definition.maximum_occupancy.presence || "not set" %>
        · <%= @departure.operating_currency %>
      </p>
    </header>

    <% if @rate_shape.compatible? == false && !@rate_shape.empty? %>
      <section class="dd-stack" aria-labelledby="advanced-rates-heading">
        <h2 id="advanced-rates-heading" class="dd-section-title">Advanced Supplier terms</h2>
        <p>These Supplier terms use a shape Cruise rates cannot reopen without discarding information.</p>
        <% if @rate_shape.reasons.any? %>
          <ul>
            <% @rate_shape.reasons.each do |reason| %>
              <li><%= reason %></li>
            <% end %>
          </ul>
        <% end %>
        <p><%= link_to "Open advanced cost planning", @advanced_path, class: "dd-button dd-button-secondary" %></p>
      </section>
    <% else %>
      <% if @preview.illustrations.any? %>
        <section class="dd-stack" aria-labelledby="rate-illustrations-heading">
          <h2 id="rate-illustrations-heading" class="dd-section-title">Per-cabin illustrations</h2>
          <ul>
            <% @preview.illustrations.each do |row| %>
              <li>
                <%= row.label %>:
                <% if row.gross_minor_units %>
                  gross <%= Money.new(row.gross_minor_units, @preview.currency || @departure.operating_currency).format %>
                <% else %>
                  gross pending
                <% end %>
                · commission <%= row.commission_state %>
                · net <%= row.net_state == "shown" && row.net_minor_units ? Money.new(row.net_minor_units, @preview.currency || @departure.operating_currency).format : row.net_state %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="dd-stack" aria-labelledby="rate-terms-heading"
            data-controller="cruise-rate-matrix">
        <h2 id="rate-terms-heading" class="dd-section-title">Supplier rate schedule</h2>
        <% if @rate_shape.legacy? %>
          <p role="status">
            These terms were saved in the earlier fixed form. Saving converts them to the rate matrix.
            Confirm conversion below. Forecast readiness will clear.
          </p>
        <% end %>
        <% if @editable %>
          <% profiles = (@form_profiles || []).map { |p| p.with_indifferent_access } %>
          <% if profiles.empty? %>
            <% profiles = %w[first_second additional every_traveler single_supplement].map { |key|
              { "key" => key, "family" => key, "category" => nil }
            } %>
          <% end %>
          <% profile_keys = profiles.map { |p| p[:key].to_s } %>
          <% custom_rows = (@form_custom_rows || []).map(&:with_indifferent_access) %>
          <% all_rows = CruiseSupplierRateSupport::STATIC_ROWS.map { |key, spec|
              { key: key.to_s, label: spec.fetch(:label), economic_role: spec.fetch(:economic_role), static: true }
            } + custom_rows.map { |row|
              { key: row[:key].to_s, label: row[:label], economic_role: row[:economic_role], static: false }
            } %>
          <%= form_with url: departure_arrangement_cruise_cabin_category_supplier_rates_path(@departure, @supplier_arrangement, @supplier_resource),
                method: (@rate_shape.empty? ? :post : :patch),
                class: "dd-stack",
                html: { id: "cruise-supplier-rate-terms" } do %>
            <%= hidden_field_tag :version_lock_version, @cruise_shape.version.lock_version %>
            <%= hidden_field_tag :idempotency_key, @idempotency_key %>
            <% unless @rate_shape.empty? %>
              <%= hidden_field_tag :definition_lock_version, @rate_shape.definition.lock_version %>
            <% end %>
            <% if @rate_shape.legacy? %>
              <label>
                <%= check_box_tag :convert_legacy, "1", true, id: "convert_legacy" %>
                Convert this schedule to the Supplier rate matrix
              </label>
            <% end %>

            <div class="dd-field">
              <label class="dd-label" for="stage">Terms stage</label>
              <%= select_tag :stage,
                    options_for_select([ [ "Estimate", "estimate" ], [ "Contracted", "contracted" ] ], @form_stage),
                    id: "stage", class: "dd-input" %>
            </div>

            <fieldset class="dd-stack">
              <legend class="dd-label">Rate profiles</legend>
              <% profiles.each_with_index do |profile, index| %>
                <%= hidden_field_tag "profiles[#{index}][key]", profile[:key] %>
                <%= hidden_field_tag "profiles[#{index}][family]", profile[:family] %>
                <div class="dd-field">
                  <span class="dd-label">
                    <%= CruiseSupplierRateSupport::PROFILE_FAMILIES.fetch(profile[:family].to_sym).fetch(:label) %>
                  </span>
                  <% if CruiseSupplierRateSupport::PROFILE_FAMILIES.fetch(profile[:family].to_sym).fetch(:allows_participant_category) %>
                    <label class="dd-label" for="profile_category_<%= index %>">Traveler category (optional)</label>
                    <%= text_field_tag "profiles[#{index}][category]", profile[:category],
                          id: "profile_category_#{index}", class: "dd-input",
                          placeholder: "Adult, Child, …" %>
                  <% end %>
                </div>
              <% end %>
              <p class="dd-help">
                Add Child or other traveler categories on overlapping positions only after choosing an overlap resolution below.
              </p>
            </fieldset>

            <fieldset class="dd-stack">
              <legend class="dd-label">Overlap with category-specific profiles</legend>
              <% resolution = @form_overlap_resolution.to_s %>
              <label>
                <%= radio_button_tag :overlap_resolution, "scope_existing_to_adult",
                      resolution == "scope_existing_to_adult", id: "overlap_scope_adult" %>
                Scope the category-free profile to Adult
              </label>
              <label>
                <%= radio_button_tag :overlap_resolution, "keep_every_traveler",
                      resolution == "keep_every_traveler", id: "overlap_keep_every" %>
                Keep the category-free profile for every traveler
              </label>
              <label>
                <%= radio_button_tag :overlap_resolution, "edit_profiles",
                      resolution == "edit_profiles", id: "overlap_edit" %>
                Return and edit the profiles
              </label>
            </fieldset>

            <div class="dd-cruise-rate-narrow" data-cruise-rate-matrix-target="narrowNav">
              <label class="dd-label" for="cruise_rate_profile_select">Rate profile</label>
              <div class="dd-cruise-rate-narrow-controls">
                <button type="button" class="dd-button dd-button-secondary" data-action="cruise-rate-matrix#previousProfile">Previous profile</button>
                <%= select_tag "cruise_rate_profile_select",
                      options_for_select(profile_keys.map { |key|
                        [ CruiseSupplierRateSupport.profile_display_label(key), key ]
                      }, profile_keys.first),
                      id: "cruise_rate_profile_select",
                      class: "dd-input",
                      data: {
                        cruise_rate_matrix_target: "profileSelect",
                        action: "change->cruise-rate-matrix#selectProfile"
                      } %>
                <button type="button" class="dd-button dd-button-secondary" data-action="cruise-rate-matrix#nextProfile">Next profile</button>
              </div>
              <p class="dd-help" data-cruise-rate-matrix-target="profilePosition">1 of <%= profile_keys.size %></p>
            </div>

            <div class="dd-table-wrap dd-cruise-rate-matrix" role="region" aria-label="Rate components">
              <table class="dd-table">
                <thead>
                  <tr>
                    <th scope="col">Component</th>
                    <% profiles.each do |profile| %>
                      <th scope="col" data-profile-column="<%= profile[:key] %>">
                        <%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %>
                      </th>
                    <% end %>
                  </tr>
                </thead>
                <tbody data-cruise-rate-matrix-target="rowsBody">
                  <% all_rows.each do |row| %>
                    <tr data-row-key="<%= row[:key] %>">
                      <th scope="row">
                        <% if row[:static] %>
                          <%= row[:label] %>
                        <% else %>
                          <%= hidden_field_tag "custom_rows[][key]", row[:key] %>
                          <%= text_field_tag "custom_rows[][label]", row[:label], class: "dd-input", aria: { label: "Component description" } %>
                          <%= select_tag "custom_rows[][economic_role]",
                                options_for_select(
                                  [ [ "Supplier charge", "supplier_charge" ], [ "Supplier credit", "supplier_credit" ] ],
                                  row[:economic_role]
                                ),
                                class: "dd-input",
                                aria: { label: "Component kind" } %>
                        <% end %>
                      </th>
                      <% profiles.each do |profile| %>
                        <% cell = CruiseSupplierRateSupport.cell_key(row[:key], profile[:key]) %>
                        <td data-profile-column="<%= profile[:key] %>">
                          <label class="dd-visually-hidden" for="cell_<%= cell.tr(':', '_') %>">
                            <%= row[:label] %> · <%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %>
                          </label>
                          <%= text_field_tag "cells[#{cell}]", @form_cells[cell] || @form_cells[cell.to_s],
                                id: "cell_#{cell.tr(':', '_')}",
                                class: "dd-input",
                                inputmode: "decimal",
                                data: {
                                  cruise_rate_matrix_target: "cell",
                                  row: row[:key],
                                  profile: profile[:key],
                                  role: row[:economic_role]
                                } %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                  <tr>
                    <th scope="row">Known profile subtotal</th>
                    <% profiles.each do |profile| %>
                      <td data-profile-column="<%= profile[:key] %>"
                          data-cruise-rate-matrix-target="subtotal"
                          data-profile="<%= profile[:key] %>">—</td>
                    <% end %>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="dd-help">Blank means pending. Enter 0.00 when the Supplier has confirmed a zero amount.</p>
            <div class="dd-actions">
              <button type="button" class="dd-button dd-button-secondary" data-action="cruise-rate-matrix#addComponent">
                Add component
              </button>
            </div>
            <template data-cruise-rate-matrix-target="customRowTemplate">
              <tr data-row-key="__KEY__">
                <th scope="row">
                  <input type="hidden" name="custom_rows[][key]" value="__KEY__">
                  <input type="text" name="custom_rows[][label]" class="dd-input" value="" aria-label="Component description" placeholder="Description">
                  <select name="custom_rows[][economic_role]" class="dd-input" aria-label="Component kind">
                    <option value="supplier_charge">Supplier charge</option>
                    <option value="supplier_credit">Supplier credit</option>
                  </select>
                </th>
                <% profiles.each do |profile| %>
                  <td data-profile-column="<%= profile[:key] %>">
                    <input type="text" name="cells[__KEY__:<%= profile[:key] %>]" class="dd-input" inputmode="decimal"
                      data-cruise-rate-matrix-target="cell"
                      data-row="__KEY__"
                      data-profile="<%= profile[:key] %>"
                      data-role="supplier_charge"
                      aria-label="New component · <%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %>">
                  </td>
                <% end %>
              </tr>
            </template>

            <fieldset class="dd-stack">
              <legend class="dd-label">How is expected commission stated?</legend>
              <% method = (@form_commission[:method] || @form_commission["method"] || "not_provided").to_s %>
              <% shared = @form_commission.fetch(:shared) { @form_commission.fetch("shared", true) } != false %>
              <label><%= radio_button_tag "commission[method]", "not_provided", method == "not_provided" %> Not provided yet</label>
              <label><%= radio_button_tag "commission[method]", "dollar", method == "dollar" %> Dollar amount</label>
              <label><%= radio_button_tag "commission[method]", "percentage", method == "percentage" %> Percentage</label>

              <div class="dd-stack">
                <p class="dd-label">Dollar commission by profile</p>
                <% amounts = (@form_commission[:amounts] || @form_commission["amounts"] || {}).with_indifferent_access %>
                <% profiles.each do |profile| %>
                  <div class="dd-field">
                    <label class="dd-label" for="commission_amount_<%= profile[:key].to_s.tr(':', '_') %>">
                      <%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %>
                    </label>
                    <%= text_field_tag "commission[amounts][#{profile[:key]}]", amounts[profile[:key]],
                          id: "commission_amount_#{profile[:key].to_s.tr(':', '_')}", class: "dd-input", inputmode: "decimal" %>
                  </div>
                <% end %>
              </div>

              <label>
                <%= hidden_field_tag "commission[shared]", "0", id: nil %>
                <%= check_box_tag "commission[shared]", "1", shared, id: "commission_shared" %>
                Use the same commission rate for every profile
              </label>

              <div class="dd-field">
                <label class="dd-label" for="commission_percentage">Shared commission percentage</label>
                <%= text_field_tag "commission[percentage]", @form_commission[:percentage] || @form_commission["percentage"],
                      id: "commission_percentage", class: "dd-input", inputmode: "decimal" %>
              </div>

              <% rates = (@form_commission[:rates] || @form_commission["rates"] || {}).with_indifferent_access %>
              <div class="dd-stack">
                <p class="dd-label">Commission percentage by profile</p>
                <% profiles.each do |profile| %>
                  <div class="dd-field">
                    <label class="dd-label" for="commission_rate_<%= profile[:key].to_s.tr(':', '_') %>">
                      <%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %>
                    </label>
                    <%= text_field_tag "commission[rates][#{profile[:key]}]", rates[profile[:key]],
                          id: "commission_rate_#{profile[:key].to_s.tr(':', '_')}", class: "dd-input", inputmode: "decimal" %>
                  </div>
                <% end %>
              </div>

              <fieldset class="dd-stack">
                <legend class="dd-label">Commissionable cells (add)</legend>
                <% selected_add = Array(@form_commission[:add_cells] || @form_commission["add_cells"]).map(&:to_s) %>
                <% profiles.each do |profile| %>
                  <% all_rows.select { |row| row[:economic_role] == "supplier_charge" }.each do |row| %>
                    <% cell = CruiseSupplierRateSupport.cell_key(row[:key], profile[:key]) %>
                    <label>
                      <%= check_box_tag "commission[add_cells][]", cell, selected_add.include?(cell),
                            id: "commission_add_#{cell.tr(':', '_')}" %>
                      <%= row[:label] %> ·
                      <%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %>
                    </label>
                  <% end %>
                <% end %>
              </fieldset>
              <fieldset class="dd-stack">
                <legend class="dd-label">Subtract before calculating commission</legend>
                <% selected_sub = Array(@form_commission[:subtract_cells] || @form_commission["subtract_cells"]).map(&:to_s) %>
                <% profiles.each do |profile| %>
                  <% all_rows.select { |row| row[:economic_role] == "supplier_credit" }.each do |row| %>
                    <% cell = CruiseSupplierRateSupport.cell_key(row[:key], profile[:key]) %>
                    <label>
                      <%= check_box_tag "commission[subtract_cells][]", cell, selected_sub.include?(cell),
                            id: "commission_sub_#{cell.tr(':', '_')}" %>
                      <%= row[:label] %> · <%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %>
                    </label>
                  <% end %>
                <% end %>
              </fieldset>
              <p class="dd-help">Shared percentage uses one commission component and one rounding boundary. Uncheck to round each profile independently.</p>
            </fieldset>

            <div class="dd-field">
              <label class="dd-label" for="notes">Notes</label>
              <%= text_area_tag :notes, @form_notes, id: "notes", class: "dd-input", rows: 2 %>
            </div>

            <div class="dd-actions">
              <%= submit_tag "Save Supplier terms", class: "dd-button dd-button-primary" %>
              <%= link_to "Open advanced cost planning", @advanced_path, class: "dd-button dd-button-secondary" %>
            </div>
          <% end %>
        <% else %>
          <p>Create a successor draft to edit Supplier rates.</p>
        <% end %>
      </section>

      <section class="dd-stack" aria-labelledby="occupancy-plan-heading">
        <h2 id="occupancy-plan-heading" class="dd-section-title">Occupancy planning</h2>
        <p>Per-cabin illustrations above do not assert an expected sales mix. Enter expected cabin counts only when known.</p>
        <% if @editable %>
          <%= form_with url: occupancy_plan_departure_arrangement_cruise_cabin_category_supplier_rates_path(@departure, @supplier_arrangement, @supplier_resource),
                method: :put, class: "dd-stack", html: { id: "cruise-occupancy-plan" } do %>
            <%= hidden_field_tag :version_lock_version, @cruise_shape.version.lock_version %>
            <% if @assumption %>
              <%= hidden_field_tag :assumption_lock_version, @assumption.lock_version %>
            <% end %>
            <% CruiseSupplierRateSupport.occupancy_keys_for_maximum(@resource_definition.maximum_occupancy).each do |key| %>
              <div class="dd-field">
                <label class="dd-label" for="expected_<%= key %>">
                  <%= CruiseSupplierRateSupport::OCCUPANCY_PROFILE_SPECS.fetch(key).fetch(:label) %> expected cabins
                </label>
                <%= number_field_tag "expected_cabins[#{key}]", @form_occupancy[key] || @form_occupancy[key.to_s],
                      id: "expected_#{key}", class: "dd-input", min: 1 %>
              </div>
            <% end %>
            <div class="dd-actions">
              <%= submit_tag "Save occupancy planning", class: "dd-button dd-button-primary" %>
            </div>
          <% end %>
        <% end %>
      </section>

      <section class="dd-stack" aria-labelledby="rate-ready-heading">
        <h2 id="rate-ready-heading" class="dd-section-title">Review and mark forecast-ready</h2>
        <p>
          Blank Supplier terms will be treated as not applicable. Omitted expected commission will be treated as
          no expected commission—not as an unknown value.
        </p>
        <% if @preview.pending_fields.any? && @rate_shape.definition&.working? %>
          <p>Still pending: <%= @preview.pending_fields.map(&:humanize).to_sentence %>.</p>
        <% end %>
        <% if @editable && @rate_shape.definition&.working? %>
          <%= form_with url: forecast_readiness_departure_arrangement_cruise_cabin_category_supplier_rates_path(@departure, @supplier_arrangement, @supplier_resource),
                method: :post, class: "dd-stack", html: { id: "cruise-rate-forecast-ready" } do %>
            <%= hidden_field_tag :definition_lock_version, @rate_shape.definition.lock_version %>
            <div class="dd-field">
              <label class="dd-label" for="readiness_provenance">Readiness provenance</label>
              <%= text_field_tag :readiness_provenance, nil, id: "readiness_provenance", class: "dd-input" %>
            </div>
            <label>
              <%= check_box_tag :confirm_omissions, "1", false, id: "confirm_omissions" %>
              I confirm blank terms are not applicable and omitted commission means no expected commission.
            </label>
            <div class="dd-actions">
              <%= submit_tag "Mark terms forecast-ready", class: "dd-button dd-button-primary" %>
            </div>
          <% end %>
        <% elsif @rate_shape.definition&.forecast_ready? %>
          <p>These terms are forecast-ready.</p>
        <% end %>
      </section>
    <% end %>
  </div>
</article>
