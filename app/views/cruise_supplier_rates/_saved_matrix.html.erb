<% profiles = cruise_saved_rate_profiles %>
<% rows = cruise_saved_rate_rows %>
<% commission = cruise_saved_commission %>
<section class="dd-stack" aria-labelledby="saved-supplier-rates-heading">
  <h2 id="saved-supplier-rates-heading" class="dd-section-title">Saved Supplier rates</h2>
  <p>Commission: <%= cruise_saved_commission_fact %></p>
  <% if cruise_saved_shared_percentage? %>
    <p class="dd-type-mono" id="saved-commission-percentage"><%= commission[:percentage] %>%</p>
  <% elsif commission[:method].to_s == "percentage" %>
    <dl class="dd-fact-grid" id="saved-commission-percentages">
      <% cruise_saved_profile_percentages.each do |entry| %>
        <div>
          <dt><%= entry[:label] %></dt>
          <dd class="dd-type-mono"><%= entry[:percentage].present? ? "#{entry[:percentage]}%" : "Not recorded" %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
  <div class="dd-table-wrap">
    <table class="dd-table">
      <thead>
        <tr>
          <th scope="col">Component</th>
          <th scope="col">Meaning</th>
          <% profiles.each do |profile| %>
            <th scope="col" class="num"><%= CruiseSupplierRateSupport.profile_display_label(profile[:key]) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr>
            <th scope="row"><%= row[:label] %></th>
            <td><%= cruise_saved_rate_role(row[:economic_role]) %></td>
            <% profiles.each do |profile| %>
              <td class="num"><%= cruise_saved_rate_amount(row[:key], profile[:key]) %></td>
            <% end %>
          </tr>
        <% end %>
        <% if commission[:method].to_s == "dollar" %>
          <tr>
            <th scope="row">Expected commission</th>
            <td>Dollar amount</td>
            <% profiles.each do |profile| %>
              <% amount = commission.dig(:amounts, profile[:key].to_s) %>
              <td class="num"><%= cruise_saved_money(amount) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if commission[:method].to_s == "percentage" %>
    <h3 id="saved-commission-treatments-heading" class="dd-section-title">Commission treatment</h3>
    <div class="dd-table-wrap">
      <table class="dd-table" id="saved-commission-treatments">
        <thead>
          <tr>
            <th scope="col">Component</th>
            <th scope="col">Profile</th>
            <th scope="col">Treatment</th>
          </tr>
        </thead>
        <tbody>
          <% cruise_saved_commission_treatments.each do |entry| %>
            <tr>
              <th scope="row"><%= entry[:component] %></th>
              <td><%= entry[:profile] %></td>
              <td><%= entry[:treatment] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <p>Create a successor draft to edit Supplier rates.</p>
</section>
