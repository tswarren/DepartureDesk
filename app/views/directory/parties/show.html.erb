<% content_for :title, "#{@party.display_name} · Directory · DepartureDesk" %>

<%= render "directory/shared/party_chrome", party: @party, current: :overview %>

<div class="dd-content-grid--main-aside">
  <div class="dd-stack">
    <article class="dd-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Contact information <span class="dd-count dd-type-mono"><%= @overview_contact_total %></span></h2>
        <% if @overview_contact_total > 4 %>
          <%= link_to "View all #{@overview_contact_total}", directory_party_contact_information_path(@party), class: "dd-row-action" %>
        <% else %>
          <%= link_to "Manage", directory_party_contact_information_path(@party), class: "dd-row-action" %>
        <% end %>
      </header>
      <div class="dd-panel-body">
        <% if @overview_contacts.any? %>
          <% @overview_contacts.each do |contact_point| %>
            <%= render "directory/shared/contact_row", party: @party, contact_point: contact_point, today: @today, compact: true %>
          <% end %>
        <% else %>
          <%= render "directory/shared/inline_empty", title: "No contact information", copy: "Add an email, phone, or postal address.", action_label: "Add contact", action_path: directory_party_contact_information_path(@party) %>
        <% end %>
      </div>
    </article>

    <% if @party.organization? && @party.organization.website.present? %>
      <article class="dd-panel">
        <header class="dd-panel-header">
          <h2 class="dd-panel-title">Public website</h2>
        </header>
        <div class="dd-panel-body">
          <div class="dd-contact-row">
            <span class="dd-contact-icon"><%= icon_tag "globe", html_class: "dd-icon dd-icon--sm" %></span>
            <div class="dd-contact-main">
              <div class="dd-contact-value"><%= @party.organization.website %></div>
            </div>
          </div>
        </div>
      </article>
    <% end %>

    <article class="dd-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Roles</h2>
        <%= link_to "Manage", directory_party_roles_path(@party), class: "dd-row-action" %>
      </header>
      <div class="dd-panel-body">
        <%= render "directory/shared/role_summary", party: @party, client_profile: @client_profile, supplier_profile: @supplier_profile %>
      </div>
    </article>

    <article class="dd-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Relationships <span class="dd-count dd-type-mono"><%= @current_relationships.size %></span></h2>
        <%= link_to "View all", directory_party_relationships_path(@party), class: "dd-row-action" %>
      </header>
      <div class="dd-panel-body">
        <% if @current_relationships.any? %>
          <% @current_relationships.first(5).each do |relationship| %>
            <%= render "directory/shared/relationship_row", party: @party, relationship: relationship, compact: true %>
          <% end %>
        <% else %>
          <%= render "directory/shared/inline_empty", title: "No current relationships", copy: "Household membership and organization links appear here.", action_label: "Add a relationship", action_path: directory_party_relationships_path(@party) %>
        <% end %>
      </div>
    </article>
  </div>

  <aside class="dd-stack">
    <% if @attention.count.positive? %>
      <div class="dd-attention-callout">
        <%= icon_tag "warning_circle", html_class: "dd-icon dd-icon--sm" %>
        <div>
          <strong><%= pluralize(@attention.count, "item") %> need attention</strong>
          <ul class="dd-list">
            <% @attention.items.each do |item| %>
              <li><%= link_to item.label, party_attention_path(@party, item) %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <article class="dd-panel dd-panel--compact dd-notes-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Notes <span class="dd-count dd-type-mono"><%= @overview_note_count %></span></h2>
        <div class="dd-button-group">
          <%= link_to "Add note", directory_party_notes_path(@party, adding: 1), class: "dd-row-action" %>
          <%= link_to "View all", directory_party_notes_path(@party), class: "dd-row-action" %>
        </div>
      </header>
      <div class="dd-notes-list">
        <% if @overview_notes.any? %>
          <% @overview_notes.each do |note| %>
            <%= render "directory/shared/note_row", party: @party, note: note, compact: true %>
          <% end %>
        <% else %>
          <%= render "directory/shared/inline_empty", title: "No notes yet", copy: "Servicing context is recorded here.", action_label: "Add note", action_path: directory_party_notes_path(@party, adding: 1) %>
        <% end %>
      </div>
    </article>

    <article class="dd-panel dd-panel--compact">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Identifiers</h2>
        <%= link_to "View all", directory_party_identifiers_path(@party), class: "dd-row-action" %>
      </header>
      <div class="dd-panel-body">
        <% if @overview_identifiers.any? %>
          <% @overview_identifiers.each do |identifier| %>
            <%= render "directory/shared/identifier_row", identifier: identifier %>
          <% end %>
        <% else %>
          <%= render "directory/shared/inline_empty", title: "No current identifiers", copy: "External IDs stay on this record.", action_label: "Add identifiers", action_path: directory_party_identifiers_path(@party) %>
        <% end %>
      </div>
    </article>

    <% if @party.person? && @party.person&.agency_membership %>
      <% membership = @party.person.agency_membership %>
      <article class="dd-panel dd-panel--compact">
        <header class="dd-panel-header">
          <h2 class="dd-panel-title">Team membership</h2>
        </header>
        <div class="dd-panel-body">
          <p>
            <%= membership_status_badge(membership) %>
            <span class="dd-cell-subtext"><%= membership.user.email_address %></span>
          </p>
          <% if Current.agency_membership&.administrator? %>
            <p><%= link_to "Open team membership", administration_team_member_path(membership), class: "dd-row-action" %></p>
          <% end %>
        </div>
      </article>
    <% end %>
  </aside>
</div>
