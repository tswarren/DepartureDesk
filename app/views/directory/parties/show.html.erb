<% content_for :title, "#{@party.display_name} · Directory · DepartureDesk" %>

<%= render "directory/shared/party_chrome", party: @party, current: :overview %>

<section class="dd-summary-strip" aria-label="Party summary">
  <div class="dd-summary-segment">
    <span class="dd-summary-label">Primary contact</span>
    <strong class="dd-summary-value"><%= overview_primary_contact_text(@primary_assignments) %></strong>
    <span class="dd-summary-support">Eligible general destination</span>
  </div>
  <div class="dd-summary-segment">
    <span class="dd-summary-label">Responsible office</span>
    <strong class="dd-summary-value"><%= overview_responsible_office_text(@client_profile, @supplier_profile) %></strong>
    <span class="dd-summary-support"><%= @supplier_profile&.active? ? "Supplier office" : (@client_profile&.active? ? "Client office" : "No active role") %></span>
  </div>
  <div class="dd-summary-segment">
    <span class="dd-summary-label">Supplier services</span>
    <strong class="dd-summary-value"><%= overview_supplier_services_text(@party, @supplier_profile) %></strong>
    <span class="dd-summary-support"><%= @party.household? ? "Households cannot be suppliers" : "Role of this party" %></span>
  </div>
  <div class="dd-summary-segment">
    <span class="dd-summary-label">Needs attention</span>
    <strong class="dd-summary-value"><%= @attention.count %></strong>
    <span class="dd-summary-support"><%= @attention.count.positive? ? "Action required" : "No current exceptions" %></span>
  </div>
</section>

<div class="dd-content-grid--main-aside">
  <div class="dd-stack">
    <article class="dd-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Contact summary</h2>
        <%= link_to "Contact information", directory_party_contact_information_path(@party), class: "dd-button dd-button--quiet dd-button--small" %>
      </header>
      <div class="dd-panel-body">
        <% if @primary_assignments.any? %>
          <dl class="dd-definition-list">
            <% @primary_assignments.each do |assignment| %>
              <div>
                <dt><%= assignment.contact_kind.titleize %> · <%= assignment.purpose_label %> primary</dt>
                <dd><%= assignment.contact_point.display_value.to_s.split("\n").first %></dd>
              </div>
            <% end %>
          </dl>
        <% else %>
          <p class="dd-missing">No eligible primary contact information. <%= link_to "Add contact information", directory_party_contact_information_path(@party) %></p>
        <% end %>
      </div>
    </article>

    <article class="dd-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Supplier summary</h2>
        <%= link_to "Manage roles", directory_party_roles_path(@party), class: "dd-button dd-button--quiet dd-button--small" %>
      </header>
      <div class="dd-panel-body">
        <% if @party.household? %>
          <%= status_badge("Ineligible", modifier: "neutral") %>
          <p class="dd-missing">Households cannot hold a supplier role.</p>
        <% elsif @supplier_profile.nil? %>
          <p class="dd-missing">Not assigned. <%= link_to "Add a supplier role", directory_party_roles_path(@party) %></p>
        <% else %>
          <dl class="dd-definition-list">
            <div>
              <dt>Status</dt>
              <dd><%= role_profile_status_badge(@supplier_profile) %></dd>
            </div>
            <div>
              <dt>Responsible office</dt>
              <dd><%= responsible_office_text(@supplier_profile) %></dd>
            </div>
            <div>
              <dt>Service categories</dt>
              <dd><%= overview_supplier_services_text(@party, @supplier_profile) %></dd>
            </div>
          </dl>
        <% end %>
      </div>
    </article>

    <article class="dd-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Current relationships</h2>
        <%= link_to "View all", directory_party_relationships_path(@party), class: "dd-button dd-button--quiet dd-button--small" %>
      </header>
      <div class="dd-panel-body">
        <% if @current_relationships.any? %>
          <ul class="dd-list">
            <% @current_relationships.first(5).each do |relationship| %>
              <li class="dd-list-item">
                <div>
                  <span class="dd-cell-title"><%= relationship.description %></span>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="dd-missing">No current relationships. <%= link_to "Add a relationship", directory_party_relationships_path(@party) %></p>
        <% end %>
      </div>
    </article>

    <article class="dd-panel">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Notes</h2>
        <%= link_to "View all", directory_party_notes_path(@party), class: "dd-button dd-button--quiet dd-button--small" %>
      </header>
      <div class="dd-panel-body">
        <% if @overview_notes.any? %>
          <ul class="dd-list">
            <% @overview_notes.each do |note| %>
              <li class="dd-list-item">
                <div>
                  <% if note.pinned? %>
                    <%= status_badge("Pinned", modifier: "info") %>
                  <% end %>
                  <span class="dd-cell-title"><%= truncate(note.body, length: 140) %></span>
                  <span class="dd-cell-subtext">Recorded <%= note.created_at.utc.to_fs(:long) %></span>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="dd-missing">No notes. <%= link_to "Open notes", directory_party_notes_path(@party) %></p>
        <% end %>
      </div>
    </article>
  </div>

  <aside class="dd-stack">
    <% if @attention.count.positive? %>
      <div class="dd-attention-callout">
        <h2><%= pluralize(@attention.count, "item") %> need attention</h2>
        <ul>
          <% @attention.items.each do |item| %>
            <li><%= link_to item.label, party_attention_path(@party, item) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <article class="dd-panel dd-panel--compact">
      <header class="dd-panel-header">
        <h2 class="dd-panel-title">Identifiers</h2>
        <%= link_to "View all", directory_party_identifiers_path(@party), class: "dd-button dd-button--quiet dd-button--small" %>
      </header>
      <div class="dd-panel-body">
        <% if @overview_identifiers.any? %>
          <ul class="dd-list">
            <% @overview_identifiers.each do |identifier| %>
              <li class="dd-list-item">
                <div>
                  <span class="dd-cell-title"><%= identifier.type_definition.label %></span>
                  <span class="dd-cell-subtext"><%= identifier.original_value %></span>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="dd-missing">No current identifiers. <%= link_to "Add identifiers", directory_party_identifiers_path(@party) %></p>
        <% end %>
      </div>
    </article>

    <% if @party.person? && @party.person&.agency_membership %>
      <% membership = @party.person.agency_membership %>
      <article class="dd-panel dd-panel--compact">
        <header class="dd-panel-header">
          <h2 class="dd-panel-title">Team membership</h2>
        </header>
        <div class="dd-panel-body">
          <p>
            <%= membership_status_badge(membership) %>
            <span class="dd-cell-subtext"><%= membership.user.email_address %></span>
          </p>
          <% if Current.agency_membership&.administrator? %>
            <p><%= link_to "Open team membership", administration_team_member_path(membership) %></p>
          <% end %>
        </div>
      </article>
    <% end %>
  </aside>
</div>
