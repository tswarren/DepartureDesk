<div class="dd-form-grid dd-form-grid--two-column">
  <div class="dd-field-group">
    <%= form.label :given_name, class: "dd-label" %>
    <%= form.text_field :given_name, value: profile.given_name, required: true, class: "dd-field", aria: field_aria(profile, :given_name) %>
    <%= field_error profile, :given_name %>
  </div>
  <div class="dd-field-group">
    <%= form.label :family_name, class: "dd-label" %>
    <%= form.text_field :family_name, value: profile.family_name, required: true, class: "dd-field", aria: field_aria(profile, :family_name) %>
    <%= field_error profile, :family_name %>
  </div>
</div>
