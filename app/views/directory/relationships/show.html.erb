<% content_for :title, "#{@party.display_name} · Relationships · DepartureDesk" %>

<%= render "directory/shared/party_chrome", party: @party, current: :relationships %>

<% history = params[:view] == "history" %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title"><%= history ? "Relationship history" : "Current relationships" %></h2>
    <div class="dd-button-group">
      <%= link_to "Current", directory_party_relationships_path(@party), class: "dd-row-action" %>
      <%= link_to "History", directory_party_relationships_path(@party, view: "history"), class: "dd-row-action" %>
      <% if @party.active? && !history %>
        <%= link_to "Add relationship", new_directory_party_party_relationship_path(@party), class: "dd-button dd-button--secondary dd-button--small" %>
      <% end %>
    </div>
  </header>
  <div class="dd-panel-body">
    <% records = history ? @historical_relationships : @current_relationships %>
    <% if records.any? %>
      <ul class="dd-list">
        <% records.each do |relationship| %>
          <%= render "directory/relationships/relationship", relationship:, party: @party, today: @today %>
        <% end %>
      </ul>
      <% if history && (@page > 1 || @has_next_page) %>
        <nav class="dd-button-group" aria-label="Relationship history pagination">
          <% if @page > 1 %>
            <%= link_to "Previous", directory_party_relationships_path(@party, view: "history", page: @page - 1), class: "dd-button dd-button--quiet dd-button--small" %>
          <% end %>
          <% if @has_next_page %>
            <%= link_to "Next", directory_party_relationships_path(@party, view: "history", page: @page + 1), class: "dd-button dd-button--quiet dd-button--small" %>
          <% end %>
        </nav>
      <% end %>
    <% else %>
      <div class="<%= class_names(empty_state_classes(family: history ? :filtered : :inline)) %>">
        <h3 class="dd-empty-title"><%= history ? "No relationship history" : "No current relationships" %></h3>
        <p class="dd-empty-copy">
          <%= history ? "Ended, corrected, and voided relationships are retained here." : "Household membership, family, and organization relationships stay on this party without creating travel roles." %>
        </p>
      </div>
    <% end %>
  </div>
</article>
