<div class="dd-field-group">
  <%= form.label :label, "Phone label", class: "dd-label" %>
  <%= form.text_field :label, class: "dd-field", value: form.object.label %>
</div>
<div class="dd-field-group">
  <%= form.label :display_number, "Phone number", class: "dd-label" %>
  <%= form.telephone_field :display_number,
    required: true,
    class: "dd-field",
    value: form.object.phone_number&.display_number || params.dig(:party_contact_point, :display_number) %>
  <p class="dd-field-hint">The number you enter is stored as the display value. Possible or unparsed numbers are kept with a warning.</p>
</div>
<div class="dd-form-grid dd-form-grid--two-column">
  <div class="dd-field-group">
    <%= form.label :extension, "Extension", class: "dd-label" %>
    <%= form.text_field :extension, class: "dd-field", value: form.object.phone_number&.extension || params.dig(:party_contact_point, :extension) %>
  </div>
  <div class="dd-field-group">
    <%= form.label :phone_type, "Phone type", class: "dd-label" %>
    <%= form.select :phone_type,
      PartyPhoneNumber::TYPES.map { |type| [ type.titleize, type ] },
      { selected: form.object.phone_number&.phone_type || params.dig(:party_contact_point, :phone_type) || "mobile" },
      class: "dd-field" %>
  </div>
</div>
<div class="dd-field-group">
  <%= form.label :parsed_country_code, "Phone country", class: "dd-label" %>
  <%= form.select :parsed_country_code,
    CountryReference.options,
    { include_blank: "Use agency country (#{Current.agency.country_code})",
      selected: form.object.phone_number&.parsed_country_code || params.dig(:party_contact_point, :parsed_country_code) || Current.agency.country_code },
    class: "dd-field" %>
  <p class="dd-field-hint">Used to parse a national-format number. It is not taken from the current office.</p>
</div>
