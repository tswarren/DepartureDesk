<% content_for :title, "Edit contact information · #{@party.display_name} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Directory</p>
    <h1 class="dd-page-title">Edit <%= @contact_point.kind_label.downcase %></h1>
    <p class="dd-page-description"><%= @party.display_name %></p>
    <%= link_to "Back to contact information", directory_party_contact_information_path(@party), class: "dd-button dd-button--quiet dd-button--small" %>
  </div>
</header>

<%= render "directory/shared/party_subnav", party: @party, current: :contact %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Contact details</h2>
  </header>
  <div class="dd-panel-body">
    <p class="dd-field-hint">Use this form for typos, labels, types, and normalization. A real-world replacement should be deactivated and added as a new contact point.</p>
    <%= form_with model: @contact_point,
      url: directory_party_contact_point_path(@party, @contact_point),
      method: :patch,
      class: "dd-form" do |form| %>
      <%= form.hidden_field :contact_kind, value: @contact_point.contact_kind %>
      <%= form.hidden_field :lock_version %>
      <%= render "directory/contact_points/#{@contact_point.contact_kind}_fields", form: %>
      <div class="dd-form-actions">
        <%= form.submit "Save contact information", class: "dd-button" %>
      </div>
    <% end %>
  </div>
</article>
