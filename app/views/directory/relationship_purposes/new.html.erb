<% content_for :title, "Assign relationship purpose · #{@party.display_name} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Directory</p>
    <h1 class="dd-page-title">Assign a relationship purpose</h1>
    <p class="dd-page-description"><%= @relationship.description %></p>
    <%= link_to "Back to relationships", directory_party_relationships_path(@party), class: "dd-button dd-button--quiet dd-button--small" %>
  </div>
</header>

<%= render "directory/shared/party_subnav", party: @party, current: :relationships %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Purpose</h2>
  </header>
  <div class="dd-panel-body">
    <%= form_with model: @assignment,
      url: directory_party_party_relationship_purposes_path(@party, @relationship),
      method: :post,
      class: "dd-form" do |form| %>
      <div class="dd-field-group">
        <%= form.label :purpose, "Organization purpose", class: "dd-label" %>
        <%= form.select :purpose,
          RelationshipPurposeAssignment::PURPOSES.map { |purpose| [ purpose.titleize, purpose ] },
          {},
          class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :priority, "Purpose priority", class: "dd-label" %>
        <%= form.number_field :priority, min: 1, class: "dd-field" %>
      </div>
      <div class="dd-choice-group">
        <label class="dd-choice">
          <input type="checkbox" name="relationship_purpose_assignment[replace_primary]" value="1">
          Replace the current primary if one exists
        </label>
      </div>
      <div class="dd-form-grid dd-form-grid--two-column">
        <div class="dd-field-group">
          <%= form.label :effective_from, "Effective from", class: "dd-label" %>
          <%= form.date_field :effective_from, class: "dd-field" %>
        </div>
        <div class="dd-field-group">
          <label class="dd-label" for="relationship_purpose_assignment_inclusive_end_on">Inclusive end date</label>
          <input class="dd-field" type="date" id="relationship_purpose_assignment_inclusive_end_on" name="relationship_purpose_assignment[inclusive_end_on]">
        </div>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Assign purpose", class: "dd-button" %>
      </div>
    <% end %>
  </div>
</article>
