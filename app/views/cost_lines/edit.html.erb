<% content_for :title, "Edit cost line · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Suppliers", departure_arrangements_path(@departure) ], [ @arrangement.arrangement_reference, departure_arrangement_path(@departure, @arrangement) ], [ "Edit cost line", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">What it costs · <%= @arrangement.supplier.display_name_for_directory %></p>
    <h1 class="dd-page-title">Edit cost line</h1>
    <p class="dd-page-description">A cost line is fixed once an amount due posts against it.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @cost_line, url: departure_arrangement_cost_line_path(@departure, @arrangement, @cost_line), method: :patch, scope: :cost_line, class: "dd-form", data: { controller: "unsaved-changes" } do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= form.hidden_field :lock_version %>
      <%= render "form", form:, arrangement: @arrangement, cost_line: @cost_line, values: @values %>
      <div class="dd-form-actions">
        <%= form.submit "Save", class: "dd-button" %>
        <%= link_to "Cancel", departure_arrangement_path(@departure, @arrangement, anchor: "supplier-cost"), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
