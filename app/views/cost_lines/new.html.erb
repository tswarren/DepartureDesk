<% content_for :title, "New cost line · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Suppliers", departure_arrangements_path(@departure) ], [ @arrangement.arrangement_reference, departure_arrangement_path(@departure, @arrangement) ], [ "New cost line", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Cost and schedule · <%= @arrangement.supplier.display_name_for_directory %></p>
    <h1 class="dd-page-title">New cost line</h1>
    <p class="dd-page-description">What a supplier commitment costs in total. Confirming the arrangement never records one for you.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @cost_line, url: departure_arrangement_cost_lines_path(@departure, @arrangement), scope: :cost_line, class: "dd-form", data: { controller: "unsaved-changes" } do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= render "form", form:, arrangement: @arrangement, cost_line: @cost_line, values: @values %>
      <div class="dd-form-actions">
        <%= form.submit "Save", class: "dd-button" %>
        <%= link_to "Cancel", departure_arrangement_path(@departure, @arrangement, anchor: "supplier-cost"), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
