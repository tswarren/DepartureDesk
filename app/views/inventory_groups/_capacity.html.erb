<%# Shells or pool, and the capacity event history (INV-05, INV-10, INV-26, INV-38). %>
<%# locals: (departure:, arrangement:, group:, manage:) -%>
<article class="dd-panel" id="capacity">
  <header class="dd-panel-header"><h2 class="dd-panel-title">Capacity</h2></header>
  <div class="dd-panel-body dd-stack">
    <% if arrangement.draft? %>
      <p class="dd-page-description">Shells and pools are created when the arrangement is confirmed.</p>
    <% elsif !group.numeric? %>
      <p class="dd-page-description">No available balance: <%= group.represented_as_none? ? "booked directly with the supplier" : availability_promise_label(group.availability_promise) %> (INV-04).</p>
    <% else %>
      <% projection = group.capacity_projection %>
      <p><strong><%= projection&.current_supplier_capacity || 0 %></strong> <%= group.represented_as_unit_shells? ? "units" : "places" %> from the supplier now<%= ", next change #{projection.next_applies_at.in_time_zone(Current.agency.default_timezone).to_fs(:long)}" if projection&.next_applies_at %>.</p>
      <% if group.represented_as_unit_shells? %>
        <%= render "inventory_groups/shell_grid", group:, shells: group.unit_shells.includes(:capacity_events) %>
      <% end %>
      <div class="dd-table-wrap">
        <table class="dd-table">
          <caption class="dd-visually-hidden">Capacity events, in timeline order</caption>
          <thead><tr><th scope="col">Event</th><th scope="col" class="num">Quantity</th><th scope="col">Effective</th><th scope="col">Evidence</th><th scope="col">Recorded</th></tr></thead>
          <tbody>
            <% group.capacity_events.includes(:actor, :unit_shell).order(:effective_on, :effective_sequence, :recorded_at).each do |event| %>
              <tr>
                <td><%= CapacityEvent::LABELS.fetch(event.event_type) %><%= " · #{event.unit_shell.label}" if event.unit_shell %></td>
                <td class="num"><%= event.signed_quantity.positive? ? "+#{event.quantity}" : "−#{event.quantity}" %></td>
                <td><%= event.effective_on.to_fs(:long) %></td>
                <td><%= event.evidence_note || "Arrangement confirmation" %></td>
                <td><%= event.actor.display_name %>, <%= event.recorded_at.in_time_zone(Current.agency.default_timezone).to_fs(:long) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if manage %>
        <% unit = group.represented_as_unit_shells? ? "units" : "places" %>
        <% capacity = GroupCapacity.new(group:) %>
        <% supply = capacity.points.first.supply %>
        <% used = capacity.consumed %>
        <% pool = group.represented_as_capacity_pool? %>
        <% correctable = group.capacity_events.reject { |event| event.event_type.start_with?("correctable") } %>
        <%= form_with url: departure_arrangement_group_capacity_events_path(departure, arrangement, group), method: :post, class: "dd-form dd-subpanel", id: "supply-change",
              data: { controller: "conditional-fields" } do |form| %>
          <%= hidden_field_tag :idempotency_key, SecureRandom.uuid, id: nil %>
          <h3 class="dd-section-title">Record a change</h3>
          <p class="dd-field-hint"><%= supply %> <%= unit %> from the supplier now · <%= used %> held or reserved by bookings · <%= [ supply - used, 0 ].max %> left</p>
          <fieldset class="dd-form-section">
            <legend class="dd-label">What happened?</legend>
            <div class="dd-rate-patterns">
              <% options = [ [ "increase", "The supplier gave us more", "Extra #{unit}, from a date" ],
                             [ "supplier_release", "The supplier took some back", "Recorded even if bookings hold them; the bookings affected are flagged" ] ]
                 options << [ "correction", "Fix a mistake", "We entered the wrong number; only #{unit} no booking holds can go" ] if pool && correctable.any? %>
              <% options.each do |value, label, hint| %>
                <label class="dd-rate-pattern">
                  <%= radio_button_tag :kind, value, value == "increase", id: "kind_#{value}", data: { conditional_fields_source: true, action: "conditional-fields#update" } %>
                  <span><strong><%= label %></strong><span class="dd-cell-subtext"><%= hint %></span></span>
                </label>
              <% end %>
            </div>
          </fieldset>
          <div class="dd-rate-inline">
            <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="increase">
              <%= label_tag "increase_quantity", "How many #{unit}", class: "dd-label" %>
              <%= number_field_tag :quantity, nil, min: 1, step: 1, required: true, id: "increase_quantity", class: "dd-field dd-field--numeric dd-field--narrow" %>
            </div>
            <% if group.represented_as_unit_shells? %>
              <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="supplier_release">
                <%= label_tag "supplier_release_unit_shell_id", "Which unit they took back", class: "dd-label" %>
                <%= select_tag :unit_shell_id, options_for_select(group.unit_shells.reject(&:returned_to_supplier?).map { |shell| [ shell.label, shell.id ] }), id: "supplier_release_unit_shell_id", class: "dd-field" %>
              </div>
            <% else %>
              <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="supplier_release">
                <%= label_tag "supplier_release_quantity", "How many #{unit}", class: "dd-label" %>
                <%= number_field_tag :quantity, nil, min: 1, step: 1, required: true, id: "supplier_release_quantity", class: "dd-field dd-field--numeric dd-field--narrow" %>
              </div>
            <% end %>
            <% if pool && correctable.any? %>
              <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="correction">
                <%= label_tag "correction_direction", "The right number is", class: "dd-label" %>
                <%= select_tag :direction, options_for_select([ [ "More than entered", "up" ], [ "Fewer than entered", "down" ] ], "down"), id: "correction_direction", class: "dd-field" %>
              </div>
              <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="correction">
                <%= label_tag "correction_quantity", "By how many #{unit}", class: "dd-label" %>
                <%= number_field_tag :quantity, nil, min: 1, step: 1, required: true, id: "correction_quantity", class: "dd-field dd-field--numeric dd-field--narrow" %>
              </div>
              <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="correction">
                <%= label_tag "correction_event", "The entry that was wrong", class: "dd-label" %>
                <%= select_tag :corrects_event_id, options_for_select(correctable.reverse.map { |event| [ "#{CapacityEvent::LABELS.fetch(event.event_type)}, #{event.quantity}, #{event.effective_on.to_fs(:long)}", event.id ] }),
                      id: "correction_event", class: "dd-field" %>
              </div>
            <% end %>
            <div class="dd-field-group">
              <%= label_tag "effective_on", "From", class: "dd-label" %>
              <%= date_field_tag :effective_on, nil, aria: { describedby: "effective_hint" }, class: "dd-field" %>
              <p class="dd-field-hint" id="effective_hint">Blank means today. A later date takes effect at 11:59 p.m. agency time.</p>
            </div>
          </div>
          <div class="dd-field-group">
            <%= label_tag "evidence_note", "What the supplier said, or what was wrong", class: "dd-label" %>
            <%= text_area_tag :evidence_note, nil, rows: 2, required: true, maxlength: 500, class: "dd-field", aria: { describedby: "evidence_hint" } %>
            <p class="dd-field-hint" id="evidence_hint">For example: Email from the hotel, Jan 20: one Garden Queen released for Nov 4.</p>
          </div>
          <%= submit_tag "Record it", class: "dd-button dd-button--secondary", name: nil %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</article>
