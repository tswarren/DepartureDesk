<%# The arrangement's inventory groups (INV-01 to INV-04, SUP-15). %>
<%# locals: (departure:, arrangement:, manage:) -%>
<article class="dd-panel" id="inventory">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Inventory groups</h2>
    <% if manage && arrangement.draft? %>
      <span class="dd-section-header">
        <%= link_to "Add hotel rooms by night", new_departure_arrangement_room_nights_path(departure, arrangement), class: "dd-button dd-button--quiet" %>
        <%= link_to "Add group", new_departure_arrangement_group_path(departure, arrangement), class: "dd-button dd-button--quiet" %>
      </span>
    <% end %>
  </header>
  <% groups = arrangement.inventory_groups %>
  <% if groups.empty? %>
    <div class="dd-panel-body">
      <p class="dd-empty-copy">No inventory groups yet. Add one for each room type, cabin category, session or date the supplier treats separately.</p>
    </div>
  <% else %>
    <% night_groups = night_grid_groups(groups.to_a) %>
    <% if night_groups.any? %>
      <div class="dd-panel-body dd-stack">
        <h3 class="dd-section-title">Rooms by night</h3>
        <%= render "inventory_groups/night_grid", departure:, arrangement:, groups: night_groups %>
      </div>
    <% end %>
    <% groups = groups.to_a - night_groups %>
    <% if groups.any? %>
    <div class="dd-table-wrap">
      <table class="dd-table">
        <thead>
          <tr>
            <th scope="col">Group</th>
            <th scope="col">Category</th>
            <th scope="col">Representation</th>
            <th scope="col">Promise</th>
            <th scope="col">Quantity</th>
            <th scope="col">Service dates</th>
          </tr>
        </thead>
        <tbody>
          <% groups.each do |group| %>
            <tr>
              <th scope="row"><%= link_to group.label, departure_arrangement_group_path(departure, arrangement, group) %></th>
              <td><%= service_category_label(group.service_category) %></td>
              <td><%= representation_label(group.representation) %></td>
              <td><%= availability_promise_label(group.availability_promise) %></td>
              <td><%= group_quantity_label(group) %></td>
              <td><%= group_service_dates(group) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  <% end %>
</article>
