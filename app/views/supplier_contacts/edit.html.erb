<% content_for :title, "Edit Contact · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Suppliers</p>
    <h1 class="dd-page-title">Edit contact</h1>
    <p class="dd-page-description"><%= @supplier.display_name_for_directory %></p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Change status", status_edit_supplier_contact_path(@supplier, @supplier_contact), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @supplier_contact, url: supplier_contact_path(@supplier, @supplier_contact), method: :patch, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save contact", class: "dd-button" %>
        <%= link_to "Cancel", supplier_contact_path(@supplier, @supplier_contact), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
