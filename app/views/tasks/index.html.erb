<% content_for :title, "My tasks · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "My tasks", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Workspace</p>
    <h1 class="dd-page-title">My tasks</h1>
    <p class="dd-page-description">Your open and in-progress tasks, soonest due first.</p>
  </div>
</header>

<article class="dd-panel">
  <% if @tasks.empty? %>
    <div class="dd-panel-body">
      <div class="dd-empty-state">
        <h2 class="dd-empty-title">No open tasks</h2>
        <p class="dd-empty-copy">Tasks assigned to you appear here, such as a supplier deadline on a Departure you own.</p>
      </div>
    </div>
  <% else %>
    <div class="dd-table-wrap">
      <table class="dd-table">
        <caption class="dd-visually-hidden">Your open tasks by due date</caption>
        <thead>
          <tr>
            <th scope="col">Due</th>
            <th scope="col">Task</th>
            <th scope="col">Departure</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <td><%= local_due_label(task.due_at, task.due_time_zone) %></td>
              <th scope="row"><%= link_to task.action, task_path(task) %></th>
              <td><%= link_to task.departure.name, departure_tasks_path(task.departure) %></td>
              <td><%= task_status_badges(task) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</article>
