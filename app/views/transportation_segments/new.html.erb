<% content_for :title, "Add segment · #{@departure.name} · DepartureDesk" %>
<%= render "departure_compositions/shell", active_area: "suppliers" %>
<article class="dd-panel">
  <div class="dd-panel-body dd-stack">
    <h2 class="dd-page-title">Add segment</h2>
    <%= form_with url: departure_arrangement_transportation_segments_path(@departure, @supplier_arrangement), method: :post, class: "dd-form dd-stack" do %>
      <%= render "form", attributes: @attributes, idempotency_key: @idempotency_key %>
    <% end %>
  </div>
</article>
