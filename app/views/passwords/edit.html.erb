<% content_for :title, "Choose a new password · DepartureDesk" %>

<% if alert = flash[:alert] %>
  <p class="dd-alert dd-alert--danger" role="alert"><%= alert %></p>
<% end %>

<h1>Choose a new password</h1>
<p class="dd-auth-intro">Enter and confirm the new password for your account.</p>

<%= form_with url: password_path(params[:token]), method: :put, class: "dd-form" do |form| %>
  <div class="dd-field-group">
    <%= form.label :password, "New password", class: "dd-label" %>
    <%= form.password_field :password,
      required: true,
      autofocus: true,
      autocomplete: "new-password",
      maxlength: 72,
      class: "dd-field" %>
  </div>

  <div class="dd-field-group">
    <%= form.label :password_confirmation, "Confirm new password", class: "dd-label" %>
    <%= form.password_field :password_confirmation,
      required: true,
      autocomplete: "new-password",
      maxlength: 72,
      class: "dd-field" %>
  </div>

  <div class="dd-form-actions">
    <%= form.submit "Save password", class: "dd-button" %>
  </div>
<% end %>
