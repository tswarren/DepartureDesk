<% content_for :title, "Reset password · DepartureDesk" %>

<% if alert = flash[:alert] %>
  <p class="dd-alert dd-alert--danger" role="alert"><%= alert %></p>
<% end %>

<h1>Forgot your password?</h1>
<p class="dd-auth-intro">Enter your email address and we’ll send reset instructions.</p>

<%= form_with url: passwords_path, class: "dd-form" do |form| %>
  <div class="dd-field-group">
    <%= form.label :email_address, "Email address", class: "dd-label" %>
    <%= form.email_field :email_address,
      required: true,
      autofocus: true,
      autocomplete: "username",
      placeholder: "you@example.com",
      value: params[:email_address],
      class: "dd-field" %>
  </div>

  <div class="dd-form-actions">
    <%= form.submit "Email reset instructions", class: "dd-button" %>
    <%= link_to "Back to sign in", new_session_path, class: "dd-auth-link" %>
  </div>
<% end %>
