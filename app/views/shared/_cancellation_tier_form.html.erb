<%# locals: (form:, values:, currency:) -%>
<div class="dd-field-group">
  <%= form.label :min_days_before_departure, "From how many days before departure", class: "dd-label" %>
  <%= form.number_field :min_days_before_departure, value: values["min_days_before_departure"], min: 0, step: 1,
        **dd_field_options(form, :min_days_before_departure, class: "dd-field--numeric dd-field--narrow", aria_describedby_extra: "tier_days_hint") %>
  <p class="dd-field-hint" id="tier_days_hint">The tier applies from this many days before departure until the next tier. Use 0 for the final tier.</p>
  <%= dd_field_error(form, :min_days_before_departure) %>
</div>
<fieldset class="dd-form-section" data-controller="conditional-fields">
  <legend class="dd-section-title">What a cancellation then costs</legend>
  <div class="dd-rate-inline">
    <div class="dd-field-group">
      <%= form.label :charge_kind, "Charge", class: "dd-label" %>
      <%= form.select :charge_kind, PackageHelper::CHARGE_KIND_LABELS.invert, {}, class: "dd-field", data: { conditional_fields_source: true, action: "conditional-fields#update" } %>
    </div>
    <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="percentage">
      <%= form.label :percentage, "Percentage", class: "dd-label" %>
      <%= form.text_field :percentage, value: values["percentage"], inputmode: "decimal", autocomplete: "off", **dd_field_options(form, :percentage, class: "dd-field--numeric dd-field--narrow") %>
      <%= dd_field_error(form, :percentage) %>
    </div>
    <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="fixed_per_traveler fixed_per_unit">
      <%= form.label :amount, "Amount (#{currency})", class: "dd-label" %>
      <%= form.text_field :amount, value: values["amount"], inputmode: "decimal", autocomplete: "off", **dd_field_options(form, :amount, class: "dd-field--numeric dd-field--narrow") %>
      <%= dd_field_error(form, :amount) %>
    </div>
    <div class="dd-field-group" data-conditional-fields-target="option" data-show-for="fixed_per_unit">
      <%= form.label :service_category, "For each", class: "dd-label" %>
      <%= form.select :service_category, ArrangementsHelper::SERVICE_CATEGORY_LABELS.transform_values { |label| "#{label.downcase} unit" }.invert, { selected: values["service_category"] }, class: "dd-field" %>
    </div>
  </div>
</fieldset>
