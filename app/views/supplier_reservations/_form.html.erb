<% existing_scopes = local_assigns[:revision]&.scopes&.order(:position, :id)&.to_a || [] %>
<% submitted_scopes = params.dig(:supplier_reservation, :scopes)&.values.presence %>
<% rows = submitted_scopes || existing_scopes.map { |scope|
  {
    "target_kind" => scope.target_kind,
    "arrangement_item_id" => scope.arrangement_item_id,
    "service_occurrence_id" => scope.service_occurrence_id,
    "supplier_resource_id" => scope.supplier_resource_id,
    "capacity_pool_id" => scope.capacity_pool_id,
    "label" => scope.label,
    "requested_quantity" => scope.requested_quantity,
    "quantity_basis" => scope.quantity_basis
  }
} %>
<% rows = [{ "target_kind" => "arrangement" }] if rows.blank? %>
<% if params[:scope_count].present? %>
  <% desired = [ [ params[:scope_count].to_i, 1 ].max, 20 ].min %>
  <% rows += Array.new([ desired - rows.size, 0 ].max) { { "target_kind" => "" } } %>
<% end %>
<% error_form = @command_form %>

<%= hidden_field_tag "supplier_reservation[supplier_arrangement_version_id]", @supplier_arrangement_version.id %>

<% unless local_assigns[:revision] %>
  <div class="dd-field-group">
    <%= label_tag "supplier_reservation_booking_supplier_id", "Booking Supplier", class: "dd-label" %>
    <%= select_tag "supplier_reservation[booking_supplier_id]",
      options_from_collection_for_select(@booking_supplier_options, :id, :display_name, params.dig(:supplier_reservation, :booking_supplier_id) || @supplier_arrangement.contracting_supplier_id),
      **dd_tag_field_options(error_form, :booking_supplier_id, id: "supplier_reservation_booking_supplier_id") %>
    <p class="dd-field-hint">Use the contracting Supplier or an effective Provider for this exact version.</p>
    <%= dd_tag_field_error(error_form, :booking_supplier_id) %>
  </div>
<% end %>

<div data-controller="reservation-scope-fields" data-reservation-scope-fields-next-index-value="<%= rows.size %>">
  <fieldset>
    <legend class="dd-label">Reservation scopes</legend>
    <p class="dd-field-hint">Start with one scope. Add another only when the booking needs multiple targets.</p>
    <div data-reservation-scope-fields-target="list">
      <% rows.each_with_index do |scope, index| %>
        <%= render "scope_row", scope: scope, index: index, error_form: error_form %>
      <% end %>
    </div>
    <template data-reservation-scope-fields-target="template">
      <%= render "scope_row", scope: {}, index: "__INDEX__", error_form: nil %>
    </template>
    <div class="dd-page-actions">
      <button type="button" class="dd-button dd-button--quiet" data-action="reservation-scope-fields#add" data-reservation-scope-fields-target="addButton">
        Add another scope
      </button>
      <%= link_to "Add another scope (full page)",
            url_for(request.query_parameters.merge(scope_count: rows.size + 1)),
            class: "dd-button dd-button--quiet",
            data: { turbo: false } %>
    </div>
  </fieldset>
</div>
