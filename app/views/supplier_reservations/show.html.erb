<% content_for :title, "Reservation · #{@supplier_arrangement.name} · DepartureDesk" %>
<% manage = Current.agency_user.permitted?(:manage_departures) %>
<% planned_revision = @revisions.find(&:planned?) %>
<% can_request = manage && planned_revision && @supplier_arrangement.active? &&
     planned_revision.supplier_arrangement_version_id == @supplier_arrangement.governing_version_id %>
<% can_withdraw = manage && @pending_scopes.any? %>
<% can_respond = manage && @pending_scopes.any? %>
<% can_cancel = manage && @confirmed_scopes.any? %>
<% can_revise = manage && @supplier_reservation.revisions.where(status: "planned").none? && @supplier_arrangement.active? %>
<% show_path = departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation) %>
<% selected_scope_ids = Array(params[:scope_ids]).map(&:to_s) %>
<% response_mode = params[:response_mode].presence || "all" %>
<% bulk_outcome = params[:bulk_outcome].presence ||
     params.dig(:outcomes, @pending_scopes.first&.id.to_s, :outcome_kind) ||
     params.dig(:outcomes, @pending_scopes.first&.id, :outcome_kind) ||
     "confirmed" %>
<% capacity_param_rows = begin
  raw = params[:capacity_consequences]
  if raw.respond_to?(:to_unsafe_h)
    raw.to_unsafe_h.values
  elsif raw.is_a?(Hash)
    raw.values
  else
    Array(raw)
  end
rescue
  []
end.select { |row| row.present? } %>
<% capacity_rows = capacity_param_rows.presence || (@capacity_pool_options&.any? ? [ {} ] : []) %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier Reservation</p>
    <h1 class="dd-page-title"><%= supplier_option_label(@supplier_reservation.booking_supplier) %></h1>
    <p class="dd-page-description"><%= @supplier_arrangement.name %> · <%= @projection&.state&.humanize || "Projection pending" %></p>
  </div>
  <div class="dd-page-actions">
    <% if manage && planned_revision %>
      <%= link_to "Edit planned reservation", edit_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), class: "dd-button" %>
      <%= link_to "Abandon plan", abandon_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), class: "dd-button dd-button--danger" %>
    <% end %>
    <% if @composer.present? %>
      <%= link_to "Close", show_path, class: "dd-button dd-button--quiet" %>
    <% else %>
      <% if can_request %>
        <%= link_to "Record request sent", departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation, composer: "request"), class: "dd-button" %>
      <% end %>
      <% if can_withdraw %>
        <%= link_to "Withdraw pending scopes", departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation, composer: "withdraw"), class: "dd-button" %>
      <% end %>
      <% if can_respond %>
        <%= link_to "Record Supplier response", departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation, composer: "respond"), class: "dd-button" %>
      <% end %>
      <% if can_cancel %>
        <%= link_to "Cancel confirmed scopes", departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation, composer: "cancel"), class: "dd-button dd-button--danger" %>
      <% end %>
      <% if can_revise %>
        <%= link_to "Create planned revision", departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation, composer: "revise"), class: "dd-button" %>
      <% end %>
    <% end %>
    <%= link_to "Back to reservations", departure_arrangement_reservations_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<%= render "shared/form_errors", object: @command_form if @command_form&.errors&.any? %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Current state</h2>
      <p>Projection is rebuildable from reservation events.</p>
    </div>
  </header>
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div><dt>State</dt><dd><%= @projection&.state&.humanize || "Not rebuilt" %></dd></div>
      <div><dt>Pending</dt><dd><%= @projection&.pending_scope_count.to_i %></dd></div>
      <div><dt>Withdrawn</dt><dd><%= @projection&.withdrawn_scope_count.to_i %></dd></div>
      <div><dt>Confirmed</dt><dd><%= @projection&.confirmed_scope_count.to_i %></dd></div>
      <div><dt>Counterproposed</dt><dd><%= @projection&.counterproposed_scope_count.to_i %></dd></div>
    </dl>
  </div>
</article>

<% if @composer == "request" && can_request %>
  <article class="dd-panel">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Record request sent</h2>
        <p>This records an external Supplier request. No email is sent.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <%= form_with url: request_booking_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), method: :post do %>
        <%= hidden_field_tag :idempotency_key, @idempotency_key %>
        <%= hidden_field_tag :composer, "request" %>
        <div class="dd-field-group">
          <%= label_tag "request_event_occurred_at", "Sent time", class: "dd-label" %>
          <%= datetime_field_tag "request_event[occurred_at]",
            params.dig(:request_event, :occurred_at) || Time.current.strftime("%Y-%m-%dT%H:%M"),
            **dd_tag_field_options(@command_form, :occurred_at, id: "request_event_occurred_at") %>
          <%= dd_tag_field_error(@command_form, :occurred_at, field_id: "request_event_occurred_at_error") %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "request_event_channel", "Channel", class: "dd-label" %>
          <%= text_field_tag "request_event[channel]", params.dig(:request_event, :channel),
            **dd_tag_field_options(@command_form, :channel, id: "request_event_channel", maxlength: 80, required: true) %>
          <%= dd_tag_field_error(@command_form, :channel, field_id: "request_event_channel_error") %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "request_event_reference_note", "Request reference note", class: "dd-label" %>
          <%= text_area_tag "request_event[reference_note]", params.dig(:request_event, :reference_note),
            **dd_tag_field_options(@command_form, :reference_note, id: "request_event_reference_note", maxlength: 500, required: true) %>
          <%= dd_tag_field_error(@command_form, :reference_note, field_id: "request_event_reference_note_error") %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "request_event_safe_contact_snapshot", "Safe contact snapshot", class: "dd-label" %>
          <%= text_area_tag "request_event[safe_contact_snapshot]", params.dig(:request_event, :safe_contact_snapshot),
            **dd_tag_field_options(@command_form, :safe_contact_snapshot, id: "request_event_safe_contact_snapshot", maxlength: 500) %>
          <%= dd_tag_field_error(@command_form, :safe_contact_snapshot, field_id: "request_event_safe_contact_snapshot_error") %>
        </div>
        <%= submit_tag "Record request sent", class: "dd-button" %>
      <% end %>
    </div>
  </article>
<% end %>

<% if @composer == "withdraw" && can_withdraw %>
  <article class="dd-panel">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Withdraw pending scopes</h2>
        <p>Withdrawal does not create capacity, financial, or cancellation consequences.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <%= form_with url: withdraw_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), method: :post do %>
        <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
        <%= hidden_field_tag :composer, "withdraw" %>
        <% @pending_scopes.each do |scope| %>
          <% scope_label = scope.label.presence || scope.target_kind.humanize %>
          <% checked = selected_scope_ids.blank? || selected_scope_ids.include?(scope.id.to_s) %>
          <div class="dd-field-group">
            <%= check_box_tag "scope_ids[]", scope.id, checked,
              id: "withdraw_scope_ids_#{scope.id}",
              **dd_tag_field_options(@command_form, :scope_ids, id: "withdraw_scope_ids_#{scope.id}") %>
            <%= label_tag "withdraw_scope_ids_#{scope.id}", scope_label, class: "dd-label" %>
          </div>
        <% end %>
        <div class="dd-field-group">
          <%= label_tag "withdraw_reason", "Withdrawal reason", class: "dd-label" %>
          <%= text_area_tag :reason, params[:reason],
            **dd_tag_field_options(@command_form, :reason, id: "withdraw_reason", maxlength: 500, required: true) %>
          <%= dd_tag_field_error(@command_form, :reason, field_id: "withdraw_reason_error") %>
        </div>
        <%= submit_tag "Record withdrawal", class: "dd-button dd-button--danger" %>
      <% end %>
    </div>
  </article>
<% end %>

<% if @composer == "respond" && can_respond %>
  <article class="dd-panel" data-controller="reservation-response-fields">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Record Supplier response</h2>
        <p>Confirmed outcomes require booking-Supplier evidence. Counterproposals never open commitments.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <% if @acknowledgement_token.present? %>
        <div class="dd-alert dd-alert--warning" role="status">
          <p class="dd-alert-title">Matching Supplier identifiers</p>
          <p>Review the matching Supplier identifiers, then submit again to create this reservation-owned identifier anyway.</p>
          <ul>
            <% Array(@duplicate_candidates).each do |candidate| %>
              <li><%= Array(candidate.signals).to_sentence %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <% if @unresolved_commitment_triggers.any? %>
        <div class="dd-alert dd-alert--info" role="status">
          <p class="dd-alert-title">Unresolved commitment triggers</p>
          <p>Unresolved commitment triggers remain after prior confirmations:</p>
          <ul>
            <% @unresolved_commitment_triggers.each do |row| %>
              <li><%= row.trigger.description.presence || row.trigger.authority_shape.humanize %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: respond_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), method: :post do %>
        <%= hidden_field_tag :idempotency_key, params[:idempotency_key].presence || SecureRandom.uuid %>
        <%= hidden_field_tag :composer, "respond" %>
        <% if @acknowledgement_token.present? %>
          <%= hidden_field_tag :duplicate_acknowledgement_token, @acknowledgement_token %>
        <% elsif params[:duplicate_acknowledgement_token].present? %>
          <%= hidden_field_tag :duplicate_acknowledgement_token, params[:duplicate_acknowledgement_token] %>
        <% end %>

        <div class="dd-field-group">
          <%= label_tag "response_mode", "Response coverage", class: "dd-label" %>
          <%= select_tag :response_mode,
            options_for_select([
              [ "All pending scopes", "all" ],
              [ "Partial / mixed outcomes", "partial" ]
            ], response_mode),
            **dd_tag_field_options(@command_form, :response_mode, id: "response_mode",
              data: {
                reservation_response_fields_target: "mode",
                action: "change->reservation-response-fields#update"
              }) %>
        </div>

        <div data-reservation-response-fields-target="bulkOutcome" <%= "hidden".html_safe if response_mode == "partial" %>>
          <div data-reservation-response-fields-target="scopeOutcome">
            <% @pending_scopes.each do |scope| %>
              <%= hidden_field_tag "scope_ids[]", scope.id, id: "bulk_scope_ids_#{scope.id}" %>
              <%= hidden_field_tag "outcomes[#{scope.id}][outcome_kind]", bulk_outcome,
                id: "bulk_outcomes_#{scope.id}_outcome_kind",
                data: { bulk_outcome_field: true } %>
            <% end %>

            <div class="dd-field-group">
              <%= label_tag "response_bulk_outcome", "Outcome for all pending scopes", class: "dd-label" %>
              <%= select_tag :bulk_outcome,
                options_for_select([
                  [ "Confirmed", "confirmed" ],
                  [ "Declined", "declined" ],
                  [ "Counterproposed", "counterproposed" ]
                ], bulk_outcome),
                **dd_tag_field_options(@command_form, :bulk_outcome, id: "response_bulk_outcome",
                  data: {
                    bulk_outcome: true,
                    outcome_kind: true,
                    action: "change->reservation-response-fields#update"
                  },
                  onchange: "document.querySelectorAll('[data-bulk-outcome-field]').forEach((el) => { el.value = this.value })") %>
            </div>

            <div class="dd-field-group" data-outcome-for="confirmed">
              <%= label_tag "response_bulk_quantity", "Confirmed quantity (all scopes)", class: "dd-label" %>
              <%= number_field_tag :bulk_quantity,
                params[:bulk_quantity].presence || params.dig(:outcomes, @pending_scopes.first&.id.to_s, :quantity),
                min: 1, step: 1,
                **dd_tag_field_options(@command_form, :bulk_quantity, id: "response_bulk_quantity",
                  oninput: "document.querySelectorAll('[data-bulk-quantity-field]').forEach((el) => { el.value = this.value })") %>
              <% @pending_scopes.each do |scope| %>
                <%= hidden_field_tag "outcomes[#{scope.id}][quantity]",
                  params[:bulk_quantity].presence || params.dig(:outcomes, scope.id.to_s, :quantity) || params.dig(:outcomes, scope.id, :quantity),
                  id: "bulk_outcomes_#{scope.id}_quantity",
                  data: { bulk_quantity_field: true } %>
              <% end %>
            </div>

            <div class="dd-field-group" data-outcome-for="confirmed">
              <span class="dd-label">Quantity basis (locked to requested scope)</span>
              <% @pending_scopes.each do |scope| %>
                <% if scope.quantity_basis.present? %>
                  <p class="dd-help"><%= scope.label.presence || scope.target_kind.humanize %>: <%= scope.quantity_basis.humanize %></p>
                  <%= hidden_field_tag "outcomes[#{scope.id}][quantity_basis]", scope.quantity_basis,
                    id: "bulk_outcomes_#{scope.id}_quantity_basis",
                    data: { bulk_quantity_basis_field: true } %>
                <% end %>
              <% end %>
            </div>

            <div class="dd-field-group" data-outcome-for="declined">
              <%= label_tag "response_bulk_decline_reason", "Decline reason (all scopes)", class: "dd-label" %>
              <%= text_field_tag :bulk_decline_reason,
                params[:bulk_decline_reason].presence ||
                  params.dig(:outcomes, @pending_scopes.first&.id.to_s, :decline_reason),
                **dd_tag_field_options(@command_form, :bulk_decline_reason, id: "response_bulk_decline_reason", maxlength: 500,
                  oninput: "document.querySelectorAll('[data-bulk-decline-field]').forEach((el) => { el.value = this.value })") %>
              <% @pending_scopes.each do |scope| %>
                <%= hidden_field_tag "outcomes[#{scope.id}][decline_reason]",
                  params[:bulk_decline_reason].presence ||
                    params.dig(:outcomes, scope.id.to_s, :decline_reason) ||
                    params.dig(:outcomes, scope.id, :decline_reason),
                  id: "bulk_outcomes_#{scope.id}_decline_reason",
                  data: { bulk_decline_field: true } %>
              <% end %>
            </div>

            <div class="dd-field-group" data-outcome-for="counterproposed declined confirmed">
              <%= label_tag "response_bulk_supplier_note", "Supplier note (all scopes)", class: "dd-label" %>
              <%= text_field_tag :bulk_supplier_note,
                params[:bulk_supplier_note].presence ||
                  params.dig(:outcomes, @pending_scopes.first&.id.to_s, :supplier_note),
                **dd_tag_field_options(@command_form, :bulk_supplier_note, id: "response_bulk_supplier_note", maxlength: 500,
                  oninput: "document.querySelectorAll('[data-bulk-note-field]').forEach((el) => { el.value = this.value })") %>
              <% @pending_scopes.each do |scope| %>
                <%= hidden_field_tag "outcomes[#{scope.id}][supplier_note]",
                  params[:bulk_supplier_note].presence ||
                    params.dig(:outcomes, scope.id.to_s, :supplier_note) ||
                    params.dig(:outcomes, scope.id, :supplier_note),
                  id: "bulk_outcomes_#{scope.id}_supplier_note",
                  data: { bulk_note_field: true } %>
              <% end %>
            </div>
          </div>
        </div>

        <div data-reservation-response-fields-target="partialPanel" <%= "hidden".html_safe if response_mode != "partial" %>>
          <% @pending_scopes.each do |scope| %>
            <% scope_label = scope.label.presence || scope.target_kind.humanize %>
            <% selected_kind = params.dig(:outcomes, scope.id.to_s, :outcome_kind) ||
                 params.dig(:outcomes, scope.id, :outcome_kind) || "confirmed" %>
            <% include_scope = selected_scope_ids.blank? || selected_scope_ids.include?(scope.id.to_s) %>
            <fieldset data-reservation-response-fields-target="scopeOutcome">
              <legend class="dd-label"><%= scope_label %></legend>
              <div class="dd-field-group">
                <%= check_box_tag "scope_ids[]", scope.id, include_scope,
                  id: "response_scope_ids_#{scope.id}",
                  **dd_tag_field_options(@command_form, :scope_ids, id: "response_scope_ids_#{scope.id}",
                    data: { action: "change->reservation-response-fields#update" }) %>
                <%= label_tag "response_scope_ids_#{scope.id}", "Include this scope", class: "dd-label" %>
              </div>
              <div class="dd-field-group">
                <%= label_tag "outcomes_#{scope.id}_outcome_kind", "Outcome", class: "dd-label" %>
                <%= select_tag "outcomes[#{scope.id}][outcome_kind]",
                  options_for_select([
                    [ "Confirmed", "confirmed" ],
                    [ "Declined", "declined" ],
                    [ "Counterproposed", "counterproposed" ]
                  ], selected_kind),
                  **dd_tag_field_options(@command_form, :"outcomes_#{scope.id}_outcome_kind",
                    id: "outcomes_#{scope.id}_outcome_kind",
                    data: {
                      outcome_kind: true,
                      action: "change->reservation-response-fields#update"
                    }) %>
              </div>
              <div class="dd-field-group" data-outcome-for="confirmed">
                <%= label_tag "outcomes_#{scope.id}_quantity", "Confirmed quantity", class: "dd-label" %>
                <%= number_field_tag "outcomes[#{scope.id}][quantity]",
                  params.dig(:outcomes, scope.id.to_s, :quantity) || params.dig(:outcomes, scope.id, :quantity),
                  min: 1, step: 1,
                  **dd_tag_field_options(@command_form, :"outcomes_#{scope.id}_quantity", id: "outcomes_#{scope.id}_quantity") %>
              </div>
              <div class="dd-field-group" data-outcome-for="confirmed">
                <span class="dd-label" id="outcomes_<%= scope.id %>_quantity_basis_label">Quantity basis</span>
                <% if scope.quantity_basis.present? %>
                  <p class="dd-help"><%= scope.quantity_basis.humanize %> (locked to requested scope)</p>
                  <%= hidden_field_tag "outcomes[#{scope.id}][quantity_basis]", scope.quantity_basis,
                    id: "outcomes_#{scope.id}_quantity_basis" %>
                <% else %>
                  <p class="dd-help">No requested quantity basis on this scope.</p>
                <% end %>
              </div>
              <div class="dd-field-group" data-outcome-for="counterproposed declined confirmed">
                <%= label_tag "outcomes_#{scope.id}_supplier_note", "Supplier note", class: "dd-label" %>
                <%= text_field_tag "outcomes[#{scope.id}][supplier_note]",
                  params.dig(:outcomes, scope.id.to_s, :supplier_note) || params.dig(:outcomes, scope.id, :supplier_note),
                  **dd_tag_field_options(@command_form, :"outcomes_#{scope.id}_supplier_note",
                    id: "outcomes_#{scope.id}_supplier_note", maxlength: 500) %>
              </div>
              <div class="dd-field-group" data-outcome-for="declined">
                <%= label_tag "outcomes_#{scope.id}_decline_reason", "Decline reason", class: "dd-label" %>
                <%= text_field_tag "outcomes[#{scope.id}][decline_reason]",
                  params.dig(:outcomes, scope.id.to_s, :decline_reason) || params.dig(:outcomes, scope.id, :decline_reason),
                  **dd_tag_field_options(@command_form, :"outcomes_#{scope.id}_decline_reason",
                    id: "outcomes_#{scope.id}_decline_reason", maxlength: 500) %>
              </div>
            </fieldset>
          <% end %>
        </div>

        <div class="dd-field-group">
          <%= label_tag "response_event_occurred_at", "Response time", class: "dd-label" %>
          <%= datetime_field_tag "response_event[occurred_at]",
            params.dig(:response_event, :occurred_at) || Time.current.strftime("%Y-%m-%dT%H:%M"),
            **dd_tag_field_options(@command_form, :occurred_at, id: "response_event_occurred_at") %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "response_event_channel", "Response channel", class: "dd-label" %>
          <%= text_field_tag "response_event[channel]", params.dig(:response_event, :channel),
            **dd_tag_field_options(@command_form, :channel, id: "response_event_channel", maxlength: 80, required: true) %>
          <%= dd_tag_field_error(@command_form, :channel, field_id: "response_event_channel_error") %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "response_event_reference_note", "Response reference note", class: "dd-label" %>
          <%= text_area_tag "response_event[reference_note]", params.dig(:response_event, :reference_note),
            **dd_tag_field_options(@command_form, :reference_note, id: "response_event_reference_note", maxlength: 500, required: true) %>
          <%= dd_tag_field_error(@command_form, :reference_note, field_id: "response_event_reference_note_error") %>
        </div>

        <div data-reservation-response-fields-target="confirmationPanel">
          <% if @existing_confirmations.any? %>
            <div class="dd-field-group">
              <%= label_tag "response_event_existing_confirmation_id", "Reuse existing confirmation evidence", class: "dd-label" %>
              <%= select_tag "response_event[existing_confirmation_id]",
                options_for_select(
                  [[ "Create new evidence", "" ]] + @existing_confirmations.map { |entry| [ "#{entry.evidence_on}: #{entry.reference_note}", entry.id ] },
                  params.dig(:response_event, :existing_confirmation_id)
                ),
                **dd_tag_field_options(@command_form, :existing_confirmation_id, id: "response_event_existing_confirmation_id") %>
            </div>
          <% end %>

          <fieldset>
            <legend class="dd-label">Confirmation evidence</legend>
            <div class="dd-field-group">
              <%= label_tag "response_event_evidence_evidence_kind", "Evidence kind", class: "dd-label" %>
              <%= select_tag "response_event[evidence][evidence_kind]",
                options_for_select(
                  SupplierConfirmation::BOOKING_EVIDENCE_KINDS.map { |kind| [ kind.humanize, kind ] },
                  params.dig(:response_event, :evidence, :evidence_kind) || "supplier_confirmation"
                ),
                **dd_tag_field_options(@command_form, :evidence_kind, id: "response_event_evidence_evidence_kind") %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "response_event_evidence_evidence_on", "Evidence date", class: "dd-label" %>
              <%= date_field_tag "response_event[evidence][evidence_on]",
                params.dig(:response_event, :evidence, :evidence_on) || Date.current,
                **dd_tag_field_options(@command_form, :evidence_on, id: "response_event_evidence_evidence_on", required: true) %>
              <%= dd_tag_field_error(@command_form, :evidence_on, field_id: "response_event_evidence_evidence_on_error") %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "response_event_evidence_reference_note", "Evidence reference note", class: "dd-label" %>
              <p class="dd-field-hint">Distinct from the response event note when evidence wording differs.</p>
              <%= text_area_tag "response_event[evidence][reference_note]",
                params.dig(:response_event, :evidence, :reference_note),
                **dd_tag_field_options(@command_form, :evidence_reference_note,
                  id: "response_event_evidence_reference_note", maxlength: 500) %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "response_event_evidence_confirmed_without_identifier_reason", "Confirmed without identifier reason", class: "dd-label" %>
              <p class="dd-field-hint">Leave blank when recording a Supplier identifier below.</p>
              <%= text_area_tag "response_event[evidence][confirmed_without_identifier_reason]",
                params.dig(:response_event, :evidence, :confirmed_without_identifier_reason),
                **dd_tag_field_options(@command_form, :confirmed_without_identifier_reason,
                  id: "response_event_evidence_confirmed_without_identifier_reason",
                  maxlength: 500,
                  placeholder: "Enter the reason Staff is confirming without an identifier") %>
            </div>
          </fieldset>

          <fieldset>
            <legend class="dd-label">Supplier-issued identifier</legend>
            <div class="dd-field-group">
              <%= label_tag "response_event_identifier_identifier_type", "Identifier type", class: "dd-label" %>
              <%= select_tag "response_event[identifier][identifier_type]",
                options_for_select(
                  [[ "No identifier", "" ]] + SupplierIssuedIdentifier::IDENTIFIER_TYPES.map { |kind| [ kind.humanize, kind ] },
                  params.dig(:response_event, :identifier, :identifier_type)
                ),
                **dd_tag_field_options(@command_form, :identifier_type, id: "response_event_identifier_identifier_type") %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "response_event_identifier_display_value", "Identifier", class: "dd-label" %>
              <%= text_field_tag "response_event[identifier][display_value]",
                params.dig(:response_event, :identifier, :display_value),
                **dd_tag_field_options(@command_form, :display_value, id: "response_event_identifier_display_value", maxlength: 160) %>
              <%= dd_tag_field_error(@command_form, :display_value, field_id: "response_event_identifier_display_value_error") %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "response_event_identifier_issuer_context", "Issuer context", class: "dd-label" %>
              <%= text_field_tag "response_event[identifier][issuer_context]",
                params.dig(:response_event, :identifier, :issuer_context),
                **dd_tag_field_options(@command_form, :issuer_context, id: "response_event_identifier_issuer_context", maxlength: 80) %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "response_event_identifier_other_type_label", "Other type label", class: "dd-label" %>
              <%= text_field_tag "response_event[identifier][other_type_label]",
                params.dig(:response_event, :identifier, :other_type_label),
                **dd_tag_field_options(@command_form, :other_type_label, id: "response_event_identifier_other_type_label", maxlength: 80) %>
            </div>
          </fieldset>

          <% amount_triggers = @reservation_triggers.select { |trigger| trigger.authority_shape == "confirmed_amount" } %>
          <% quantity_triggers = @reservation_triggers.select { |trigger|
               %w[confirmed_quantity contracted_unit_rate_times_confirmed_quantity].include?(trigger.authority_shape)
             } %>
          <% if amount_triggers.any? || quantity_triggers.any? %>
            <fieldset>
              <legend class="dd-label">Commitment inputs by trigger</legend>
              <% amount_triggers.each do |trigger| %>
                <div class="dd-field-group">
                  <%= label_tag "confirmed_amounts_minor_units_#{trigger.id}",
                    "Confirmed amount (minor units) · #{trigger.description.presence || trigger.authority_shape.humanize}",
                    class: "dd-label" %>
                  <%= number_field_tag "confirmed_amounts_minor_units[#{trigger.id}]",
                    params.dig(:confirmed_amounts_minor_units, trigger.id.to_s) ||
                      params.dig(:response_event, :confirmed_amounts_minor_units, trigger.id.to_s),
                    min: 0, step: 1,
                    **dd_tag_field_options(@command_form, :"confirmed_amounts_minor_units_#{trigger.id}",
                      id: "confirmed_amounts_minor_units_#{trigger.id}") %>
                  <p class="dd-field-hint">Currency: <%= @departure.operating_currency %>.</p>
                </div>
              <% end %>
              <% quantity_triggers.each do |trigger| %>
                <div class="dd-field-group">
                  <%= label_tag "confirmed_quantities_#{trigger.id}",
                    "Confirmed quantity · #{trigger.description.presence || trigger.authority_shape.humanize}",
                    class: "dd-label" %>
                  <%= number_field_tag "confirmed_quantities[#{trigger.id}]",
                    params.dig(:confirmed_quantities, trigger.id.to_s) ||
                      params.dig(:response_event, :confirmed_quantities, trigger.id.to_s),
                    min: 1, step: 1,
                    **dd_tag_field_options(@command_form, :"confirmed_quantities_#{trigger.id}",
                      id: "confirmed_quantities_#{trigger.id}") %>
                </div>
              <% end %>
              <% if @pending_scopes.size > 1 && @reservation_triggers.any? { |trigger|
                   trigger.arrangement_item_id.blank? && trigger.service_occurrence_id.blank? &&
                     trigger.supplier_resource_id.blank? && trigger.capacity_pool_id.blank?
                 } %>
                <% @reservation_triggers.select { |trigger|
                     trigger.arrangement_item_id.blank? && trigger.service_occurrence_id.blank? &&
                       trigger.supplier_resource_id.blank? && trigger.capacity_pool_id.blank?
                   }.each do |trigger| %>
                  <div class="dd-field-group">
                    <%= label_tag "coverage_scope_ids_#{trigger.id}",
                      "Coverage scope · #{trigger.description.presence || "Arrangement-wide trigger"}",
                      class: "dd-label" %>
                    <%= select_tag "coverage_scope_ids[#{trigger.id}]",
                      options_for_select(
                        [[ "Choose covering scope", "" ]] + @pending_scopes.map { |scope| [ scope.label.presence || scope.target_kind.humanize, scope.id ] },
                        params.dig(:coverage_scope_ids, trigger.id.to_s)
                      ),
                      **dd_tag_field_options(@command_form, :"coverage_scope_ids_#{trigger.id}",
                        id: "coverage_scope_ids_#{trigger.id}") %>
                  </div>
                <% end %>
              <% end %>
            </fieldset>
          <% end %>
        </div>

        <% if @capacity_pool_options.any? %>
          <div data-reservation-response-fields-target="capacityPanel">
            <fieldset>
              <legend class="dd-label">Capacity consequences</legend>
              <p class="dd-field-hint">Optional. Add a Pool only when this confirmation should write a capacity event. A Pool requires type, quantity, and effective date.</p>
              <div data-reservation-response-fields-target="capacityList">
                <% capacity_rows.each_with_index do |raw, index| %>
                  <% raw = raw.with_indifferent_access if raw.respond_to?(:with_indifferent_access) %>
                  <% selected_pool = raw[:capacity_pool_id] || raw["capacity_pool_id"] %>
                  <div data-capacity-row>
                    <div class="dd-field-group">
                      <%= label_tag "capacity_consequences_#{index}_capacity_pool_id", "Pool", class: "dd-label" %>
                      <%= select_tag "capacity_consequences[#{index}][capacity_pool_id]",
                        options_for_select(
                          [[ "No capacity event", "" ]] + @capacity_pool_options.map { |pool|
                            [ "#{pool.measurement_basis.humanize} · #{supplier_option_label(pool.supplying_supplier)}", pool.id ]
                          },
                          selected_pool
                        ),
                        **dd_tag_field_options(@command_form, :"capacity_consequences_#{index}_capacity_pool_id",
                          id: "capacity_consequences_#{index}_capacity_pool_id") %>
                    </div>
                    <div class="dd-field-group">
                      <%= label_tag "capacity_consequences_#{index}_event_type", "Event type", class: "dd-label" %>
                      <%= select_tag "capacity_consequences[#{index}][event_type]",
                        options_for_select(
                          [[ "Choose type", "" ]] + RecordSupplierReservationResponse::CAPACITY_CONSEQUENCE_EVENT_TYPES.map { |type| [ type.humanize, type ] },
                          raw[:event_type] || raw["event_type"]
                        ),
                        **dd_tag_field_options(@command_form, :"capacity_consequences_#{index}_event_type",
                          id: "capacity_consequences_#{index}_event_type") %>
                    </div>
                    <div class="dd-field-group">
                      <%= label_tag "capacity_consequences_#{index}_quantity", "Quantity", class: "dd-label" %>
                      <%= number_field_tag "capacity_consequences[#{index}][quantity]",
                        raw[:quantity] || raw["quantity"],
                        min: 1, step: 1,
                        **dd_tag_field_options(@command_form, :"capacity_consequences_#{index}_quantity",
                          id: "capacity_consequences_#{index}_quantity") %>
                    </div>
                    <div class="dd-field-group">
                      <%= label_tag "capacity_consequences_#{index}_effective_on", "Effective on", class: "dd-label" %>
                      <%= date_field_tag "capacity_consequences[#{index}][effective_on]",
                        raw[:effective_on] || raw["effective_on"],
                        **dd_tag_field_options(@command_form, :"capacity_consequences_#{index}_effective_on",
                          id: "capacity_consequences_#{index}_effective_on") %>
                    </div>
                    <div class="dd-field-group">
                      <%= label_tag "capacity_consequences_#{index}_supplier_reservation_scope_id", "Scope (optional)", class: "dd-label" %>
                      <%= select_tag "capacity_consequences[#{index}][supplier_reservation_scope_id]",
                        options_for_select(
                          [[ "Arrangement-wide / unscoped", "" ]] + @pending_scopes.map { |scope| [ scope.label.presence || scope.target_kind.humanize, scope.id ] },
                          raw[:supplier_reservation_scope_id] || raw["supplier_reservation_scope_id"]
                        ),
                        **dd_tag_field_options(@command_form, :"capacity_consequences_#{index}_supplier_reservation_scope_id",
                          id: "capacity_consequences_#{index}_supplier_reservation_scope_id") %>
                    </div>
                  </div>
                <% end %>
              </div>
              <template data-reservation-response-fields-target="capacityTemplate">
                <div data-capacity-row>
                  <div class="dd-field-group">
                    <label class="dd-label" for="capacity_consequences___INDEX___capacity_pool_id">Pool</label>
                    <select name="capacity_consequences[__INDEX__][capacity_pool_id]" id="capacity_consequences___INDEX___capacity_pool_id" class="dd-field">
                      <option value="">No capacity event</option>
                      <% @capacity_pool_options.each do |pool| %>
                        <option value="<%= pool.id %>"><%= pool.measurement_basis.humanize %> · <%= supplier_option_label(pool.supplying_supplier) %></option>
                      <% end %>
                    </select>
                  </div>
                  <div class="dd-field-group">
                    <label class="dd-label" for="capacity_consequences___INDEX___event_type">Event type</label>
                    <select name="capacity_consequences[__INDEX__][event_type]" id="capacity_consequences___INDEX___event_type" class="dd-field">
                      <option value="">Choose type</option>
                      <% RecordSupplierReservationResponse::CAPACITY_CONSEQUENCE_EVENT_TYPES.each do |type| %>
                        <option value="<%= type %>"><%= type.humanize %></option>
                      <% end %>
                    </select>
                  </div>
                  <div class="dd-field-group">
                    <label class="dd-label" for="capacity_consequences___INDEX___quantity">Quantity</label>
                    <input type="number" name="capacity_consequences[__INDEX__][quantity]" id="capacity_consequences___INDEX___quantity" min="1" step="1" class="dd-field">
                  </div>
                  <div class="dd-field-group">
                    <label class="dd-label" for="capacity_consequences___INDEX___effective_on">Effective on</label>
                    <input type="date" name="capacity_consequences[__INDEX__][effective_on]" id="capacity_consequences___INDEX___effective_on" class="dd-field">
                  </div>
                  <div class="dd-field-group">
                    <label class="dd-label" for="capacity_consequences___INDEX___supplier_reservation_scope_id">Scope (optional)</label>
                    <select name="capacity_consequences[__INDEX__][supplier_reservation_scope_id]" id="capacity_consequences___INDEX___supplier_reservation_scope_id" class="dd-field">
                      <option value="">Arrangement-wide / unscoped</option>
                      <% @pending_scopes.each do |scope| %>
                        <option value="<%= scope.id %>"><%= scope.label.presence || scope.target_kind.humanize %></option>
                      <% end %>
                    </select>
                  </div>
                </div>
              </template>
              <div class="dd-page-actions">
                <button type="button" class="dd-button dd-button--quiet" data-action="reservation-response-fields#addCapacity">
                  Add capacity consequence
                </button>
              </div>
            </fieldset>
          </div>
        <% end %>

        <%= submit_tag @acknowledgement_token.present? ? "Create identifier anyway" : "Record response", class: "dd-button" %>
      <% end %>
    </div>
  </article>
<% end %>

<% if @composer == "cancel" && can_cancel %>
  <article class="dd-panel">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Cancel confirmed scopes</h2>
        <p>Cancellation does not automatically release capacity or dispose commitments.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <%= form_with url: cancel_scopes_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), method: :post do %>
        <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
        <%= hidden_field_tag :composer, "cancel" %>
        <% @confirmed_scopes.each do |scope| %>
          <% scope_label = scope.label.presence || scope.target_kind.humanize %>
          <% checked = selected_scope_ids.blank? || selected_scope_ids.include?(scope.id.to_s) %>
          <div class="dd-field-group">
            <%= check_box_tag "scope_ids[]", scope.id, checked,
              id: "cancel_scope_ids_#{scope.id}",
              **dd_tag_field_options(@command_form, :scope_ids, id: "cancel_scope_ids_#{scope.id}") %>
            <%= label_tag "cancel_scope_ids_#{scope.id}", scope_label, class: "dd-label" %>
          </div>
        <% end %>
        <div class="dd-field-group">
          <%= label_tag "cancel_reason", "Cancellation reason", class: "dd-label" %>
          <%= text_area_tag :reason, params[:reason],
            **dd_tag_field_options(@command_form, :reason, id: "cancel_reason", maxlength: 500, required: true) %>
          <%= dd_tag_field_error(@command_form, :reason, field_id: "cancel_reason_error") %>
        </div>
        <%= submit_tag "Cancel confirmed scopes", class: "dd-button dd-button--danger" %>
      <% end %>
    </div>
  </article>
<% end %>

<% if @composer == "revise" && can_revise %>
  <article class="dd-panel">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Create planned revision</h2>
        <p>Copy selected history into a new planned revision on the current activated version or sole successor draft.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <%= form_with url: revise_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), method: :post do %>
        <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
        <%= hidden_field_tag :composer, "revise" %>
        <%= submit_tag "Create planned revision", class: "dd-button" %>
      <% end %>
    </div>
  </article>
<% end %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Revisions and scopes</h2>
      <p>Requested revisions are immutable and remain tied to their exact version.</p>
    </div>
  </header>
  <div class="dd-panel-body">
    <% if @revisions_truncated %>
      <p>Showing the first 50 revisions. Older revisions are not listed here.</p>
    <% end %>
    <% @revisions.each do |revision| %>
      <h3 class="dd-panel-title">Revision <%= revision.revision_number %> · <%= revision.status.humanize %></h3>
      <div class="dd-table-wrap">
        <table class="dd-table">
          <thead>
            <tr>
              <th scope="col">Scope</th>
              <th scope="col">Target</th>
              <th scope="col">Quantity</th>
            </tr>
          </thead>
          <tbody>
            <% revision.scopes.each do |scope| %>
              <tr>
                <td><%= scope.label.presence || scope.target_kind.humanize %></td>
                <td><%= scope_target_label(scope) %></td>
                <td><%= scope.requested_quantity ? "#{scope.requested_quantity} #{scope.quantity_basis.humanize}" : "No quantity" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</article>

<article class="dd-panel">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Event history</h2>
      <p>Supplier request and withdrawal facts are append-only.</p>
    </div>
  </header>
  <div class="dd-panel-body">
    <% if @events_truncated %>
      <p>Showing the first 50 events. Older events are not listed here.</p>
    <% end %>
    <% if @events.any? %>
      <div class="dd-table-wrap">
        <table class="dd-table">
          <thead>
            <tr>
              <th scope="col">Event</th>
              <th scope="col">Occurred</th>
              <th scope="col">Context</th>
              <th scope="col">Scopes</th>
            </tr>
          </thead>
          <tbody>
            <% @events.each do |event| %>
              <tr>
                <td><%= event.event_kind.humanize %></td>
                <td><%= l(event.occurred_at, format: :long) %></td>
                <td><%= event.reference_note.presence || event.reason %></td>
                <td><%= event.scope_outcomes.map { |outcome| outcome.outcome_kind.humanize }.to_sentence %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="<%= empty_state_classes.join(" ") %>">No events recorded yet.</p>
    <% end %>
  </div>
</article>
