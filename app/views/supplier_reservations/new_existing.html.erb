<% content_for :title, "Record existing confirmed booking · DepartureDesk" %>
<% manage = Current.agency_user.permitted?(:manage_departures) %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier Reservation</p>
    <h1 class="dd-page-title">Record existing confirmed booking</h1>
    <p class="dd-page-description">Records an external confirmed booking on <%= @supplier_arrangement.name %> without sending a request.</p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Back to reservations", departure_arrangement_reservations_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<%= render "shared/form_errors", object: @command_form if @command_form&.errors&.any? %>

<% if manage && @supplier_arrangement.active? %>
  <article class="dd-panel">
    <div class="dd-panel-body">
      <%= form_with url: record_existing_departure_arrangement_reservations_path(@departure, @supplier_arrangement), method: :post do %>
        <%= hidden_field_tag :idempotency_key, @idempotency_key %>
        <%= render "form" %>
        <fieldset>
          <legend class="dd-label">Confirmation evidence</legend>
          <div class="dd-field-group">
            <%= label_tag "existing_reservation_channel", "Channel", class: "dd-label" %>
            <%= text_field_tag "existing_reservation[channel]",
              params.dig(:existing_reservation, :channel),
              **dd_tag_field_options(@command_form, :channel, id: "existing_reservation_channel", maxlength: 80, required: true) %>
            <%= dd_tag_field_error(@command_form, :channel) %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "existing_reservation_reference_note", "Reference note", class: "dd-label" %>
            <%= text_area_tag "existing_reservation[reference_note]",
              params.dig(:existing_reservation, :reference_note),
              **dd_tag_field_options(@command_form, :reference_note, id: "existing_reservation_reference_note", maxlength: 500, required: true) %>
            <%= dd_tag_field_error(@command_form, :reference_note) %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "existing_reservation_evidence_evidence_kind", "Evidence kind", class: "dd-label" %>
            <%= select_tag "existing_reservation[evidence][evidence_kind]",
              options_for_select(
                SupplierConfirmation::EVIDENCE_KINDS.map { |kind| [kind.humanize, kind] },
                params.dig(:existing_reservation, :evidence, :evidence_kind) || "supplier_confirmation"
              ),
              **dd_tag_field_options(@command_form, :evidence_kind, id: "existing_reservation_evidence_evidence_kind") %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "existing_reservation_evidence_evidence_on", "Evidence date", class: "dd-label" %>
            <%= date_field_tag "existing_reservation[evidence][evidence_on]",
              params.dig(:existing_reservation, :evidence, :evidence_on) || Date.current,
              **dd_tag_field_options(@command_form, :evidence_on, id: "existing_reservation_evidence_evidence_on", required: true) %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "existing_reservation_evidence_confirmed_without_identifier_reason", "Confirmed without identifier reason", class: "dd-label" %>
            <p class="dd-field-hint">Explain why the existing booking keeps its identifier outside DepartureDesk.</p>
            <%= text_area_tag "existing_reservation[evidence][confirmed_without_identifier_reason]",
              params.dig(:existing_reservation, :evidence, :confirmed_without_identifier_reason),
              **dd_tag_field_options(@command_form, :confirmed_without_identifier_reason,
                id: "existing_reservation_evidence_confirmed_without_identifier_reason", maxlength: 500) %>
          </div>
        </fieldset>
        <%= submit_tag "Record existing confirmed booking", class: "dd-button" %>
      <% end %>
    </div>
  </article>
<% else %>
  <p class="<%= empty_state_classes.join(" ") %>">Only active Arrangements can record an existing confirmed booking.</p>
<% end %>
