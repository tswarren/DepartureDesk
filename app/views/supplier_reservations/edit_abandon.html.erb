<% content_for :title, "Abandon Reservation · #{@supplier_arrangement.name} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier Reservation</p>
    <h1 class="dd-page-title">Abandon planned Reservation</h1>
    <p class="dd-page-description">This keeps the draft history and removes it from current operation.</p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Back to reservation", departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<%= render "shared/form_errors", object: @command_form if @command_form&.errors&.any? %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: abandon_departure_arrangement_reservation_path(@departure, @supplier_arrangement, @supplier_reservation), method: :post do %>
      <%= hidden_field_tag :revision_lock_version, @planned_revision&.lock_version %>
      <div class="dd-field-group">
        <%= label_tag "abandon_reason", "Reason", class: "dd-label" %>
        <%= text_area_tag :reason, params[:reason],
          **dd_tag_field_options(@command_form, :reason, id: "abandon_reason", maxlength: 500, required: true) %>
        <%= dd_tag_field_error(@command_form, :reason) %>
      </div>
      <div class="dd-page-actions">
        <%= submit_tag "Abandon planned reservation", class: "dd-button dd-button--danger" %>
      </div>
    <% end %>
  </div>
</article>
