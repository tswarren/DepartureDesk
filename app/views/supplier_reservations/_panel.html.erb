<%# S-19: the arrangement's supplier reservations (INV-33 to INV-37). %>
<%# locals: (departure:, arrangement:) -%>
<% reservations = arrangement.supplier_reservations.includes(:requested_by, :responded_by, client_booking: { client_trip: { client: %i[client_person client_organization] } }, units: { choice_selection: { option: :choice } }) %>
<% manage = Current.agency_user.permitted?(:manage_supplier_reservations) && !departure.departed? %>
<article class="dd-panel" id="supplier-reservations">
  <header class="dd-panel-header"><h2 class="dd-panel-title">Supplier reservations</h2></header>
  <div class="dd-panel-body dd-stack">
    <p class="dd-page-description">
      <% if arrangement.reservations_none? %>
        This arrangement tracks no supplier reservations below the arrangement.
      <% else %>
        Requests to <%= arrangement.supplier.display_name_for_directory %> for bookings' on-request or directly booked services<%= ", one unit each" if arrangement.reservations_per_unit? %>. Start one from the booking; recording it sends nothing.
      <% end %>
    </p>
    <% if reservations.empty? %>
      <p class="dd-empty-copy">No supplier requests yet.</p>
    <% else %>
      <ul class="dd-plain-list dd-payment-list" aria-label="Supplier reservations">
        <% reservations.each do |reservation| %>
          <% booking = reservation.client_booking %>
          <li class="dd-payment-item">
            <div>
              <strong><%= link_to booking.booking_reference, client_booking_path(booking, step: "rooms", anchor: "supplier-requests"), class: "dd-type-mono" %></strong>
              · <%= booking.client_trip.client.source.display_name %>
              <%= status_badge(reservation.status_requested? && booking.status_confirmed? ? "Awaiting supplier" : reservation.status_label, modifier: reservation.status_confirmed? ? "success" : "warning") %>
              <p class="dd-payment-sentence"><%= reservation.units.map { |unit| unit.choice_selection.label }.to_sentence %></p>
              <p class="dd-cell-subtext">
                Requested <%= reservation.requested_at.in_time_zone(Current.agency.default_timezone).to_fs(:long) %> by <%= reservation.requested_by.display_name %>
                <% if reservation.status_confirmed? %>
                  · Accepted <%= reservation.responded_on.to_fs(:long) %>, ref <span class="dd-type-mono"><%= reservation.supplier_reference %></span>, recorded by <%= reservation.responded_by.display_name %><%= " · #{reservation.response_note}" if reservation.response_note %>
                <% end %>
              </p>
            </div>
            <% if manage && reservation.status_requested? %>
              <%= link_to "Record acceptance", new_departure_arrangement_supplier_reservation_acceptance_path(departure, arrangement, reservation),
                    class: "dd-button dd-button--secondary", aria: { label: "Record acceptance for #{booking.booking_reference}" } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</article>
