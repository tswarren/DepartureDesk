<% content_for :title, "Edit Arrangement · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier planning</p>
    <h1 class="dd-page-title">Edit arrangement</h1>
    <p class="dd-page-description"><%= @departure.name %></p>
  </div>
  <div class="dd-page-actions">
    <% if @supplier_arrangement.draft? %>
      <%= link_to "Abandon", abandon_departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button dd-button--danger" %>
    <% end %>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @supplier_arrangement, url: departure_arrangement_path(@departure, @supplier_arrangement), method: :patch, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save arrangement", class: "dd-button" %>
        <%= link_to "Cancel", departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
