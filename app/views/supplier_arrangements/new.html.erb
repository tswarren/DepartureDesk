<% content_for :title, "New arrangement · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Suppliers", departure_arrangements_path(@departure) ], [ "New arrangement", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Departure · <%= @departure.name %></p>
    <h1 class="dd-page-title">New arrangement</h1>
    <p class="dd-page-description">Saves as a Draft with anything missing. Confirm it once the supplier has.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @arrangement, url: departure_arrangements_path(@departure), scope: :supplier_arrangement, class: "dd-form", data: { controller: "unsaved-changes" } do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= form.hidden_field :lock_version if form.object.persisted? %>
      <%= render "form", form:, arrangement: @arrangement %>
      <div class="dd-form-actions">
        <%= form.submit "Save as Draft", class: "dd-button" %>
        <%= link_to "Cancel", departure_arrangements_path(@departure), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
