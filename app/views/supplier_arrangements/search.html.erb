<% content_for :title, "Search arrangements · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Departures</p>
    <h1 class="dd-page-title">Arrangement search</h1>
    <p class="dd-page-description">Agency-scoped search from <%= @departure.name %>. Identifier and Reservation matches resolve to the owning Arrangement.</p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Back to planning", departure_arrangements_path(@departure), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: search_departure_arrangements_path(@departure), method: :get, class: "dd-form" do |form| %>
      <div class="dd-field-group">
        <%= form.label :q, "Search", class: "dd-label" %>
        <%= form.search_field :q, value: params[:q], maxlength: 100, class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :status, "Status", class: "dd-label" %>
        <%= form.select :status, SearchSupplierArrangements::STATUSES.map { |status| [ status.titleize, status ] }, { selected: @status }, class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :contracting_supplier_id, "Contracting supplier", class: "dd-label" %>
        <%= form.select :contracting_supplier_id,
          Current.agency.suppliers.ordered_for_directory.map { |supplier| [ supplier_option_label(supplier), supplier.id ] },
          { include_blank: "All suppliers", selected: params[:contracting_supplier_id] },
          class: "dd-field" %>
      </div>
      <div class="dd-field-group">
        <%= form.label :identifier_type, "Identifier type", class: "dd-label" %>
        <%= form.select :identifier_type,
          SupplierIssuedIdentifier::IDENTIFIER_TYPES.map { |type| [ type.humanize, type ] },
          { include_blank: "Any identifier type", selected: params[:identifier_type] },
          class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Search", class: "dd-button" %>
        <%= link_to "Reset", search_departure_arrangements_path(@departure), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>

<p><%= @search.truncated ? "Showing the first 50 arrangements. Narrow the filters to see the rest." : "#{pluralize(@search.records.size, "arrangement")} matched." %></p>

<article class="dd-panel">
  <table class="dd-table">
    <thead>
      <tr>
        <th scope="col">Arrangement</th>
        <th scope="col">Departure</th>
        <th scope="col">Contracting supplier</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      <% if @search.records.empty? %>
        <tr>
          <td colspan="4">No arrangements matched.</td>
        </tr>
      <% else %>
        <% @search.records.each do |arrangement| %>
          <tr class="<%= "is-inactive" if arrangement.abandoned? %>">
            <td><%= link_to arrangement.name, departure_arrangement_path(arrangement.departure, arrangement) %></td>
            <td><%= arrangement.departure.name %></td>
            <td><%= supplier_option_label(arrangement.contracting_supplier) %></td>
            <td><%= supplier_arrangement_status_badge(arrangement.status) %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</article>
