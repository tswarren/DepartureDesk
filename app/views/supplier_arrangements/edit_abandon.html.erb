<% content_for :title, "Abandon Arrangement · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier planning</p>
    <h1 class="dd-page-title">Abandon arrangement</h1>
    <p class="dd-page-description"><%= @supplier_arrangement.name %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <p>Abandoning a tentative arrangement records that it will not continue. It does not invent cancellation, occupancy, or money facts.</p>

    <%= form_with url: abandon_departure_arrangement_path(@departure, @supplier_arrangement), method: :post, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: @supplier_arrangement_version %>
      <%= hidden_field_tag :arrangement_lock_version, @supplier_arrangement.lock_version %>
      <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
      <div class="dd-field-group">
        <%= label_tag :reason, "Reason", class: "dd-label" %>
        <%= text_area_tag :reason, @abandon_reason, maxlength: SupplierArrangementVersion::ABANDONED_REASON_LIMIT, required: true, class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Abandon arrangement", class: "dd-button dd-button--danger" %>
        <%= link_to "Cancel", departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
