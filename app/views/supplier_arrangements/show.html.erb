<% content_for :title, "#{@supplier_arrangement.name} · DepartureDesk" %>
<% manage = Current.agency_user.permitted?(:manage_departures) %>
<% draft_graph = @supplier_arrangement.draft? && @supplier_arrangement_version.draft? %>
<% contractor_active = @supplier_arrangement.contracting_supplier.active? %>
<% ordinary_editable = manage && draft_graph && (@departure.draft? || @departure.active?) && contractor_active %>
<% recovery_cleanup = manage && draft_graph && !ordinary_editable && (@departure.departed? || !contractor_active) %>
<% can_remove = ordinary_editable || recovery_cleanup %>
<% can_abandon = manage && draft_graph %>
<% can_edit_arrangement = ordinary_editable || (recovery_cleanup && @supplier_arrangement.supplier_contact_id.present?) %>
<% reorder_items_mode = ordinary_editable && params[:structure_mode] == "items" %>
<% reorder_resources_item_id = params[:structure_item_id] if ordinary_editable && params[:structure_mode] == "resources" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier planning</p>
    <h1 class="dd-page-title"><%= @supplier_arrangement.name %></h1>
    <p class="dd-page-description"><%= @departure.name %></p>
  </div>
  <div class="dd-page-actions">
    <% if can_edit_arrangement %>
      <%= link_to recovery_cleanup ? "Clear contact" : "Edit arrangement", edit_departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button" %>
    <% end %>
    <% if ordinary_editable %>
      <%= link_to "Add item", departure_arrangement_new_item_setup_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
      <% if @item_definitions.size > 1 %>
        <% if reorder_items_mode %>
          <%= link_to "Done reordering items", departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
        <% else %>
          <%= link_to "Reorder items", departure_arrangement_path(@departure, @supplier_arrangement, structure_mode: "items"), class: "dd-button dd-button--quiet" %>
        <% end %>
      <% end %>
    <% end %>
    <% if can_abandon %>
      <%= link_to "Abandon", abandon_departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button dd-button--danger" %>
    <% end %>
    <%= link_to "Back to departure", departure_path(@departure), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<% if recovery_cleanup %>
  <article class="dd-panel">
    <div class="dd-panel-body">
      <p>
        <% if !contractor_active %>
          The contracting supplier is inactive. Clear the arrangement contact, remove draft structure, or abandon this arrangement.
        <% else %>
          This departure has departed. Clear inactive contacts, clear or replace inactive service providers, remove draft structure, or abandon this arrangement.
        <% end %>
      </p>
    </div>
  </article>
<% end %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Status</dt>
        <dd><%= supplier_arrangement_status_badge(@supplier_arrangement.status) %></dd>
      </div>
      <div>
        <dt>Contracting supplier</dt>
        <dd><%= supplier_option_label(@supplier_arrangement.contracting_supplier) %></dd>
      </div>
      <div>
        <dt>Arrangement contact</dt>
        <dd><%= @supplier_arrangement.supplier_contact ? supplier_contact_option_label(@supplier_arrangement.supplier_contact) : "None" %></dd>
      </div>
      <div>
        <dt>Version</dt>
        <dd>Draft version <%= @supplier_arrangement_version.version_number %></dd>
      </div>
    </dl>
  </div>
</article>

<article class="dd-panel" id="planning-status">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Planning status</h2>
      <p>Structure, capacity, and costs are separate readiness tracks.</p>
    </div>
    <div class="dd-inline-actions">
      <%= link_to "Arrangement costs", departure_arrangement_costs_workspace_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
      <%= link_to "Cost forecast", departure_arrangement_cost_forecast_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
    </div>
  </header>
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Items</dt>
        <dd><%= @item_definitions.size %></dd>
      </div>
      <div>
        <dt>Declared costs</dt>
        <dd>
          <% if @cost_forecast.complete %>
            ✓ Complete
          <% else %>
            ⚠ <%= @cost_forecast.subtotal_label %> ·
            <%= @cost_forecast.uncovered_item_ids.size %> uncovered Item(s) ·
            <%= @cost_forecast.incomplete_source_ids.size %> incomplete source(s)
          <% end %>
        </dd>
      </div>
      <div>
        <dt>Forecast Supplier cost</dt>
        <dd><%= Money.new(@cost_forecast.totals.forecast_supplier_cost_minor_units, @cost_forecast.currency).format %></dd>
      </div>
      <div>
        <dt>Arrangement-wide sources</dt>
        <dd><%= @arrangement_cost_sources.size %></dd>
      </div>
    </dl>
  </div>
</article>

<% if @item_definitions.empty? %>
  <article class="dd-panel">
    <div class="dd-panel-body">
      <p class="<%= empty_state_classes.join(" ") %>">No arrangement items yet.</p>
      <% if ordinary_editable %>
        <%= link_to "Add item", departure_arrangement_new_item_setup_path(@departure, @supplier_arrangement), class: "dd-button" %>
      <% end %>
    </div>
  </article>
<% else %>
  <% ordered_item_ids = @item_definitions.map(&:arrangement_item_id) %>
  <% @item_definitions.each_with_index do |item_definition, index| %>
    <% item = item_definition.arrangement_item %>
    <% occurrence_definitions = @occurrence_definitions_by_item_id.fetch(item.id, []) %>
    <% resource_definitions = @resource_definitions_by_item_id.fetch(item.id, []) %>
    <% inactive_item_provider = item_definition.default_service_provider&.inactive? %>
    <% can_edit_item = ordinary_editable || (recovery_cleanup && inactive_item_provider && contractor_active) %>
    <% item_cost_sources = @cost_sources_by_item_id.fetch(item.id, []) %>
    <% capacity_pairs = @capacity_pairs_by_item_members.fetch(item.id, {}) %>
    <% capacity_pool_definitions = @capacity_pool_definitions_by_item_pair_id.fetch(item.id, {}) %>
    <% capacity_warnings = capacity_item_warnings(item_definition, occurrence_definitions, resource_definitions, capacity_pairs, capacity_pool_definitions, @supplier_arrangement) %>
    <% pool_count = capacity_pool_definitions.values.sum(&:size) %>
    <% cost_status = if item_cost_sources.empty?
         "⚠ Incomplete — no cost source"
       elsif item_cost_sources.any? { |source| source.supplier_cost_definitions.none?(&:forecast_ready?) }
         "⚠ Incomplete — needs ready stage"
       else
         "✓ Declared costs ready"
       end %>

    <article class="dd-panel" id="item-<%= item.id %>">
      <header class="dd-panel-header">
        <div>
          <h2 class="dd-panel-title"><%= item_definition.name %></h2>
          <p><%= arrangement_item_category_label(item_definition.category, item_definition.other_category_label) %></p>
        </div>
        <% if can_edit_item || can_remove %>
          <div class="dd-inline-actions">
            <% if can_edit_item %>
              <%= link_to inactive_item_provider && !ordinary_editable ? "Clear provider" : "Edit item", edit_departure_arrangement_item_path(@departure, @supplier_arrangement, item), class: "dd-row-action dd-row-action--edit" %>
            <% end %>
            <% if reorder_items_mode %>
              <% if index.positive? %>
                <% moved_ids = ordered_item_ids.dup.tap { |ids| ids[index - 1], ids[index] = ids[index], ids[index - 1] } %>
                <%= button_to "Move up", reorder_departure_arrangement_items_path(@departure, @supplier_arrangement), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, arrangement_item_ids: moved_ids } %>
              <% end %>
              <% if index < @item_definitions.size - 1 %>
                <% moved_ids = ordered_item_ids.dup.tap { |ids| ids[index + 1], ids[index] = ids[index], ids[index + 1] } %>
                <%= button_to "Move down", reorder_departure_arrangement_items_path(@departure, @supplier_arrangement), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, arrangement_item_ids: moved_ids } %>
              <% end %>
            <% end %>
            <% if can_remove %>
              <%= button_to "Remove", departure_arrangement_item_path(@departure, @supplier_arrangement, item), method: :delete, class: "dd-row-action", form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this item and its planned occurrences and resources?" } }, params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
            <% end %>
          </div>
        <% end %>
      </header>
      <div class="dd-panel-body">
        <% if item_definition.description.present? %>
          <p><%= item_definition.description %></p>
        <% end %>
        <dl class="dd-definition-list">
          <div>
            <dt>Default service provider</dt>
            <dd><%= item_definition.default_service_provider ? supplier_option_label(item_definition.default_service_provider) : "Contracting supplier" %></dd>
          </div>
          <div>
            <dt>Effective provider</dt>
            <dd><%= supplier_option_label(effective_service_provider(@supplier_arrangement, item_definition)) %></dd>
          </div>
          <div>
            <dt>Structure</dt>
            <dd><%= occurrence_definitions.size %> occurrence(s) · <%= resource_definitions.size %> resource(s)</dd>
          </div>
          <div>
            <dt>Capacity</dt>
            <dd>
              <%= capacity_management_label(item_definition.capacity_management) %>
              <% unless item_definition.unmanaged? %>
                · <%= capacity_pairs.size %> of <%= occurrence_definitions.size * resource_definitions.size %> pairs · <%= pool_count %> pool(s)
                <% if capacity_warnings.any? %>
                  · ⚠ <%= capacity_warnings.size %> warning(s)
                <% end %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt>Costs</dt>
            <dd><%= cost_status %> · <%= item_cost_sources.size %> source(s)</dd>
          </div>
        </dl>

        <div class="dd-inline-actions">
          <%= link_to "Manage costs", departure_arrangement_item_costs_workspace_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
          <% if ordinary_editable || recovery_cleanup %>
            <%= link_to "Configure capacity", departure_arrangement_item_capacity_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
          <% else %>
            <%= link_to "View capacity", departure_arrangement_item_capacity_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
          <% end %>
        </div>

        <section>
          <header class="dd-panel-header">
            <h3 class="dd-panel-title">Occurrences</h3>
            <% if ordinary_editable %>
              <%= link_to "Add occurrence", new_departure_arrangement_item_occurrence_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
            <% end %>
          </header>
          <% if occurrence_definitions.any? %>
            <table class="dd-table">
              <thead>
                <tr>
                  <th scope="col">Occurrence</th>
                  <th scope="col">When</th>
                  <th scope="col">Effective provider</th>
                  <% if ordinary_editable || can_remove || recovery_cleanup %>
                    <th scope="col">Actions</th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% occurrence_definitions.each do |occurrence_definition| %>
                  <% inactive_occurrence_provider = occurrence_definition.service_provider&.inactive? %>
                  <% can_edit_occurrence = ordinary_editable || (recovery_cleanup && inactive_occurrence_provider && contractor_active) %>
                  <tr id="occurrence-<%= occurrence_definition.service_occurrence_id %>">
                    <td><%= occurrence_definition.name %></td>
                    <td><%= occurrence_date_label(occurrence_definition) %></td>
                    <td><%= supplier_option_label(effective_service_provider(@supplier_arrangement, item_definition, occurrence_definition)) %></td>
                    <% if ordinary_editable || can_remove || can_edit_occurrence %>
                      <td>
                        <div class="dd-inline-actions">
                          <% if can_edit_occurrence %>
                            <%= link_to inactive_occurrence_provider && !ordinary_editable ? "Clear provider" : "Edit", edit_departure_arrangement_item_occurrence_path(@departure, @supplier_arrangement, item, occurrence_definition.service_occurrence), class: "dd-row-action dd-row-action--edit" %>
                          <% end %>
                          <% if can_remove %>
                            <%= button_to "Remove", departure_arrangement_item_occurrence_path(@departure, @supplier_arrangement, item, occurrence_definition.service_occurrence), method: :delete, class: "dd-row-action", form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this occurrence?" } }, params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                          <% end %>
                        </div>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="<%= empty_state_classes.join(" ") %>">No occurrences yet.</p>
          <% end %>
        </section>

        <section id="resources-<%= item.id %>">
          <header class="dd-panel-header">
            <div>
              <h3 class="dd-panel-title">Resources</h3>
              <% if reorder_resources_item_id == item.id.to_s %>
                <p>Reorder mode. Use Move up and Move down to set the resource order.</p>
              <% end %>
            </div>
            <div class="dd-inline-actions">
              <% if ordinary_editable %>
                <%= link_to "Add resource", new_departure_arrangement_item_resource_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
                <% if resource_definitions.size > 1 %>
                  <% if reorder_resources_item_id == item.id.to_s %>
                    <%= link_to "Done reordering", departure_arrangement_path(@departure, @supplier_arrangement, anchor: "resources-#{item.id}"), class: "dd-button dd-button--quiet" %>
                  <% else %>
                    <%= link_to "Reorder resources", departure_arrangement_path(@departure, @supplier_arrangement, structure_mode: "resources", structure_item_id: item.id, anchor: "resources-#{item.id}"), class: "dd-button dd-button--quiet" %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </header>
          <% if resource_definitions.any? %>
            <% ordered_resource_ids = resource_definitions.map(&:supplier_resource_id) %>
            <table class="dd-table">
              <thead>
                <tr>
                  <th scope="col">Resource</th>
                  <th scope="col">Description</th>
                  <% if ordinary_editable || can_remove %>
                    <th scope="col">Actions</th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% resource_definitions.each_with_index do |resource_definition, resource_index| %>
                  <tr id="resource-<%= resource_definition.supplier_resource_id %>">
                    <td><%= resource_definition.name %></td>
                    <td><%= resource_definition.description.presence || "—" %></td>
                    <% if ordinary_editable || can_remove %>
                      <td>
                        <div class="dd-inline-actions">
                          <% if ordinary_editable %>
                            <%= link_to "Edit", edit_departure_arrangement_item_resource_path(@departure, @supplier_arrangement, item, resource_definition.supplier_resource), class: "dd-row-action dd-row-action--edit" %>
                            <% if reorder_resources_item_id == item.id.to_s && resource_index.positive? %>
                              <% moved_resource_ids = ordered_resource_ids.dup.tap { |ids| ids[resource_index - 1], ids[resource_index] = ids[resource_index], ids[resource_index - 1] } %>
                              <%= button_to "Move up", reorder_departure_arrangement_item_resources_path(@departure, @supplier_arrangement, item), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, supplier_resource_ids: moved_resource_ids } %>
                            <% end %>
                            <% if reorder_resources_item_id == item.id.to_s && resource_index < resource_definitions.size - 1 %>
                              <% moved_resource_ids = ordered_resource_ids.dup.tap { |ids| ids[resource_index + 1], ids[resource_index] = ids[resource_index], ids[resource_index + 1] } %>
                              <%= button_to "Move down", reorder_departure_arrangement_item_resources_path(@departure, @supplier_arrangement, item), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, supplier_resource_ids: moved_resource_ids } %>
                            <% end %>
                          <% end %>
                          <% if can_remove %>
                            <%= button_to "Remove", departure_arrangement_item_resource_path(@departure, @supplier_arrangement, item, resource_definition.supplier_resource), method: :delete, class: "dd-row-action", form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this resource?" } }, params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                          <% end %>
                        </div>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="<%= empty_state_classes.join(" ") %>">No resources yet.</p>
          <% end %>
        </section>
      </div>
    </article>
  <% end %>
<% end %>
