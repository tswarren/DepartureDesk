<% content_for :title, "#{@supplier_arrangement.name} · DepartureDesk" %>
<% manage = Current.agency_user.permitted?(:manage_departures) %>
<% draft_graph = (@supplier_arrangement.draft? || @supplier_arrangement.active?) && @supplier_arrangement_version.draft? %>
<% contractor_active = @supplier_arrangement.contracting_supplier.active? %>
<% ordinary_editable = manage && draft_graph && (@departure.draft? || @departure.active?) && contractor_active %>
<% recovery_cleanup = manage && draft_graph && !ordinary_editable && (@departure.departed? || !contractor_active) %>
<% can_remove = ordinary_editable || recovery_cleanup %>
<% successor_draft = @supplier_arrangement.active? && @supplier_arrangement_version.draft? %>
<% can_abandon = manage && draft_graph && (@supplier_arrangement.draft? || successor_draft) %>
<% can_create_successor = manage && @departure.active? && @supplier_arrangement.active? &&
  @supplier_arrangement_version.activated? && contractor_active %>
<% can_edit_arrangement = ordinary_editable || (recovery_cleanup && @supplier_arrangement.supplier_contact_id.present?) %>
<% reorder_items_mode = ordinary_editable && params[:structure_mode] == "items" %>
<% reorder_resources_item_id = params[:structure_item_id] if ordinary_editable && params[:structure_mode] == "resources" %>
<% structure_mode = params[:structure_mode].presence %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier planning</p>
    <h1 class="dd-page-title"><%= @supplier_arrangement.name %></h1>
    <p class="dd-page-description"><%= @departure.name %></p>
  </div>
  <div class="dd-page-actions">
    <% if manage && @departure.active? && draft_graph && contractor_active %>
      <%= link_to successor_draft ? "Activate successor" : "Activate arrangement", departure_arrangement_activation_path(@departure, @supplier_arrangement), class: "dd-button" %>
    <% end %>
    <%= link_to "Reservations", departure_arrangement_reservations_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
    <% if can_create_successor %>
      <%= button_to "Create successor", successor_departure_arrangement_path(@departure, @supplier_arrangement),
        method: :post, class: "dd-button", params: {
          arrangement_lock_version: @supplier_arrangement.lock_version,
          version_lock_version: @supplier_arrangement_version.lock_version,
          idempotency_key: SecureRandom.uuid
        } %>
    <% end %>
    <% if can_edit_arrangement %>
      <%= link_to recovery_cleanup ? "Clear contact" : "Edit arrangement", edit_departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button" %>
    <% end %>
    <% if can_abandon %>
      <%= link_to successor_draft ? "Abandon successor" : "Abandon", abandon_departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button dd-button--danger" %>
    <% end %>
    <%= link_to "Back to departure", departure_path(@departure), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<% if successor_draft %>
  <article class="dd-panel">
    <div class="dd-panel-body">
      <p><strong>Successor draft workspace.</strong> Version <%= @supplier_arrangement_version.version_number %> is an independent copy of governing version <%= @supplier_arrangement_version.copied_from.version_number %>. Changes here do not alter the current terms.</p>
      <p class="dd-field-hint">Activation requires fresh coverage attestations and new exact-version Supplier confirmation evidence.</p>
    </div>
  </article>
<% end %>

<% if recovery_cleanup %>
  <article class="dd-panel">
    <div class="dd-panel-body">
      <p>
        <% if !contractor_active %>
          The contracting supplier is inactive. Clear the arrangement contact, remove draft structure, or abandon this arrangement.
        <% else %>
          This departure has departed. Clear inactive contacts, clear or replace inactive service providers, remove draft structure, or abandon this arrangement.
        <% end %>
      </p>
    </div>
  </article>
<% end %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Status</dt>
        <dd><%= supplier_arrangement_status_badge(@supplier_arrangement.status) %></dd>
      </div>
      <div>
        <dt>Contracting supplier</dt>
        <dd><%= supplier_option_label(@supplier_arrangement.contracting_supplier) %></dd>
      </div>
      <div>
        <dt>Arrangement contact</dt>
        <dd><%= @supplier_arrangement.supplier_contact ? supplier_contact_option_label(@supplier_arrangement.supplier_contact) : "None" %></dd>
      </div>
      <div>
        <dt>Version</dt>
        <dd>
          <% if @supplier_arrangement_version.draft? %>
            Draft version <%= @supplier_arrangement_version.version_number %>
          <% else %>
            Governing version <%= @supplier_arrangement_version.version_number %>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>
</article>

<% if @effective_capacity_definitions.any? %>
  <article class="dd-panel" id="current-supplier-capacity">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Current Supplier capacity</h2>
        <p>Supplier-side capacity from the governing activated version.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <table class="dd-table">
        <thead>
          <tr>
            <th scope="col">Pool</th>
            <th scope="col">Item</th>
            <th scope="col">Occurrence and resource</th>
            <th scope="col">Supplying Supplier</th>
          </tr>
        </thead>
        <tbody>
          <% @effective_capacity_definitions.each do |definition| %>
            <tr>
              <td>
                <%= link_to definition.label,
                  departure_arrangement_capacity_pool_path(
                    @departure, @supplier_arrangement, definition.capacity_pool
                  ) %>
              </td>
              <td><%= @effective_item_definitions_by_id.fetch(definition.arrangement_item_id).name %></td>
              <td>
                <%= @effective_occurrence_definitions_by_id.fetch(definition.service_occurrence_id).name %> ·
                <%= @effective_resource_definitions_by_id.fetch(definition.supplier_resource_id).name %>
              </td>
              <td><%= supplier_option_label(definition.capacity_pool.supplying_supplier) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </article>
<% end %>

<article class="dd-panel" id="next-actions">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Next actions</h2>
      <p>Ordered by the first detectable planning blockers.</p>
    </div>
  </header>
  <div class="dd-panel-body">
    <% if @planning_workspace.next_actions.any? %>
      <ol class="dd-record-list">
        <% @planning_workspace.next_actions.each do |action| %>
          <li>
            <strong><%= link_to action.label, action.href %></strong>
            <p><%= action.text %></p>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p>No incomplete entered planning facts were detected.</p>
    <% end %>
    <p class="dd-field-hint">These checks cover only entered structure, capacity, and Supplier cost facts. Other real-world costs or commitments may still be missing.</p>
  </div>
</article>

<article class="dd-panel" id="planning-readiness">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Planning readiness</h2>
      <p>Structure, capacity, and declared costs remain separate tracks.</p>
    </div>
  </header>
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Structure</dt>
        <dd><%= @planning_workspace.structure_summary %></dd>
      </div>
      <div>
        <dt>Capacity</dt>
        <dd><%= @planning_workspace.capacity_summary %></dd>
      </div>
      <div>
        <dt>Declared costs</dt>
        <dd><%= @planning_workspace.cost_summary %></dd>
      </div>
    </dl>
  </div>
</article>

<% if @item_definitions.empty? %>
  <article class="dd-panel">
    <div class="dd-panel-body">
      <p class="<%= empty_state_classes.join(" ") %>">No arrangement items yet.</p>
      <% if ordinary_editable %>
        <%= link_to "Add item", departure_arrangement_new_item_setup_path(@departure, @supplier_arrangement), class: "dd-button" %>
      <% end %>
    </div>
  </article>
<% else %>
  <% ordered_item_ids = @item_definitions.map(&:arrangement_item_id) %>
  <% forecast_sources_by_id = @cost_forecast.sources.index_by(&:source_id) %>
  <section>
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Items</h2>
        <p>Manual planning order with one next step per Item.</p>
      </div>
      <% if ordinary_editable %>
        <div class="dd-inline-actions">
          <%= link_to "Add item", departure_arrangement_new_item_setup_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
          <% if @item_definitions.size > 1 %>
            <%= link_to(reorder_items_mode ? "Done reordering items" : "Reorder items",
                  reorder_items_mode ? departure_arrangement_path(@departure, @supplier_arrangement) : departure_arrangement_path(@departure, @supplier_arrangement, structure_mode: "items"),
                  class: "dd-button dd-button--quiet") %>
          <% end %>
        </div>
      <% end %>
    </header>
  </section>
  <% @item_definitions.each_with_index do |item_definition, index| %>
    <% item = item_definition.arrangement_item %>
    <% occurrence_definitions = @occurrence_definitions_by_item_id.fetch(item.id, []) %>
    <% resource_definitions = @resource_definitions_by_item_id.fetch(item.id, []) %>
    <% inactive_item_provider = item_definition.default_service_provider&.inactive? %>
    <% can_edit_item = ordinary_editable || (recovery_cleanup && inactive_item_provider && contractor_active) %>
    <% item_cost_sources = @cost_sources_by_item_id.fetch(item.id, []) %>
    <% capacity_pairs = @capacity_pairs_by_item_members.fetch(item.id, {}) %>
    <% capacity_pool_definitions = @capacity_pool_definitions_by_item_pair_id.fetch(item.id, {}) %>
    <% capacity_warnings = capacity_item_warnings(item_definition, occurrence_definitions, resource_definitions, capacity_pairs, capacity_pool_definitions, @supplier_arrangement) %>
    <% pool_count = capacity_pool_definitions.values.sum(&:size) %>
    <% eligible_pair_keys = occurrence_definitions.reject { |definition| definition.service_occurrence.cancelled? }.product(resource_definitions).map { |occurrence, resource| [ occurrence.service_occurrence_id, resource.supplier_resource_id ] } %>
    <% decided_pair_count = eligible_pair_keys.count { |key| capacity_pairs.key?(key) } %>
    <% item_forecasts = item_cost_sources.filter_map { |source| forecast_sources_by_id[source.id] } %>
    <% selected_stages = item_forecasts.filter_map(&:selected_stage).uniq %>
    <% cost_warning = item_forecasts.reject(&:complete).flat_map(&:warnings).first&.fetch(:message, nil) %>
    <% primary_action = @planning_workspace.primary_action_for(item.id) %>
    <% show_item_structure = structure_mode.present? && (structure_mode == "items" || params[:structure_item_id].to_s == item.id.to_s) %>

    <article class="dd-panel" id="item-<%= item.id %>">
      <header class="dd-panel-header">
        <div>
          <h2 class="dd-panel-title"><%= item_definition.name %></h2>
          <p><%= arrangement_item_category_label(item_definition.category, item_definition.other_category_label) %></p>
        </div>
        <div class="dd-inline-actions">
          <% if reorder_items_mode %>
            <% if index.positive? %>
              <% moved_ids = ordered_item_ids.dup.tap { |ids| ids[index - 1], ids[index] = ids[index], ids[index - 1] } %>
              <%= button_to "Move up", reorder_departure_arrangement_items_path(@departure, @supplier_arrangement), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, arrangement_item_ids: moved_ids } %>
            <% end %>
            <% if index < @item_definitions.size - 1 %>
              <% moved_ids = ordered_item_ids.dup.tap { |ids| ids[index + 1], ids[index] = ids[index], ids[index + 1] } %>
              <%= button_to "Move down", reorder_departure_arrangement_items_path(@departure, @supplier_arrangement), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, arrangement_item_ids: moved_ids } %>
            <% end %>
          <% else %>
            <%= link_to primary_action.label, primary_action.href, class: "dd-button" %>
          <% end %>
        </div>
      </header>
      <div class="dd-panel-body">
        <% if item_definition.description.present? %>
          <p><%= item_definition.description %></p>
        <% end %>
        <dl class="dd-definition-list">
          <div>
            <dt>Effective provider</dt>
            <dd><%= supplier_option_label(effective_service_provider(@supplier_arrangement, item_definition)) %></dd>
          </div>
          <div>
            <dt>Structure</dt>
            <dd>
              <%= pluralize(occurrence_definitions.size, "occurrence") %><%= ": #{occurrence_definitions.first.name}" if occurrence_definitions.one? %>
              ·
              <%= pluralize(resource_definitions.size, "resource") %><%= ": #{resource_definitions.first.name}" if resource_definitions.one? %>
            </dd>
          </div>
          <div>
            <dt>Capacity</dt>
            <dd>
              <%= capacity_management_label(item_definition.capacity_management) %>
              <% unless item_definition.unmanaged? %>
                · <%= decided_pair_count %> of <%= eligible_pair_keys.size %> pairs decided · <%= pluralize(pool_count, "Pool") %>
                <% if capacity_warnings.any? %>
                  · ⚠ <%= capacity_warnings.first %>
                <% end %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt>Costs</dt>
            <dd>
              <%= pluralize(item_cost_sources.size, "source") %>
              · <%= selected_stages.any? ? "Selected ready stage: #{selected_stages.to_sentence}" : "No selected forecast-ready stage" %>
              <% if item_cost_sources.empty? %>
                · ⚠ No Item-scoped cost source
              <% elsif cost_warning %>
                · ⚠ <%= cost_warning %>
              <% end %>
            </dd>
          </div>
        </dl>

        <details>
          <summary>Item modes</summary>
          <div class="dd-inline-actions">
            <% if can_edit_item %>
              <% if inactive_item_provider && !ordinary_editable %>
                <%= link_to "Clear provider", edit_departure_arrangement_item_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
              <% else %>
                <%= link_to "Edit structure", departure_arrangement_path(@departure, @supplier_arrangement, structure_mode: "edit", structure_item_id: item.id, anchor: "item-#{item.id}"), class: "dd-button dd-button--quiet" %>
              <% end %>
            <% elsif !manage %>
              <%= link_to "View structure", departure_arrangement_path(@departure, @supplier_arrangement, structure_mode: "edit", structure_item_id: item.id, anchor: "item-#{item.id}"), class: "dd-button dd-button--quiet" %>
            <% end %>
            <% if ordinary_editable && resource_definitions.size > 1 %>
              <%= link_to "Reorder resources", departure_arrangement_path(@departure, @supplier_arrangement, structure_mode: "resources", structure_item_id: item.id, anchor: "resources-#{item.id}"), class: "dd-button dd-button--quiet" %>
            <% end %>
            <%= link_to ordinary_editable || recovery_cleanup ? "Capacity" : "View capacity", departure_arrangement_item_capacity_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
            <%= link_to ordinary_editable ? "Costs" : "View costs", departure_arrangement_item_costs_workspace_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
          </div>
          <% if can_remove %>
            <div class="dd-page-actions">
              <%= button_to "Remove Item", departure_arrangement_item_path(@departure, @supplier_arrangement, item), method: :delete, class: "dd-button dd-button--danger", form: { data: { turbo_confirm: "Remove this item and its planned occurrences and resources?" } }, params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
            </div>
          <% end %>
        </details>

        <% if show_item_structure %>
        <% if can_edit_item %>
          <div class="dd-inline-actions">
            <%= link_to inactive_item_provider && !ordinary_editable ? "Clear provider" : "Edit Item details", edit_departure_arrangement_item_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
            <%= link_to "Done editing structure", departure_arrangement_path(@departure, @supplier_arrangement, anchor: "item-#{item.id}"), class: "dd-button dd-button--quiet" %>
          </div>
        <% end %>
        <section>
          <header class="dd-panel-header">
            <h3 class="dd-panel-title">Occurrences</h3>
            <% if ordinary_editable %>
              <%= link_to "Add occurrence", new_departure_arrangement_item_occurrence_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
            <% end %>
          </header>
          <% if occurrence_definitions.any? %>
            <table class="dd-table">
              <thead>
                <tr>
                  <th scope="col">Occurrence</th>
                  <th scope="col">When</th>
                  <th scope="col">Effective provider</th>
                  <% if ordinary_editable || can_remove || recovery_cleanup %>
                    <th scope="col">Actions</th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% occurrence_definitions.each do |occurrence_definition| %>
                  <% inactive_occurrence_provider = occurrence_definition.service_provider&.inactive? %>
                  <% can_edit_occurrence = ordinary_editable || (recovery_cleanup && inactive_occurrence_provider && contractor_active) %>
                  <tr id="occurrence-<%= occurrence_definition.service_occurrence_id %>">
                    <td><%= occurrence_definition.name %></td>
                    <td><%= occurrence_date_label(occurrence_definition) %></td>
                    <td><%= supplier_option_label(effective_service_provider(@supplier_arrangement, item_definition, occurrence_definition)) %></td>
                    <% if ordinary_editable || can_remove || can_edit_occurrence %>
                      <td>
                        <div class="dd-inline-actions">
                          <% if can_edit_occurrence %>
                            <%= link_to inactive_occurrence_provider && !ordinary_editable ? "Clear provider" : "Edit", edit_departure_arrangement_item_occurrence_path(@departure, @supplier_arrangement, item, occurrence_definition.service_occurrence), class: "dd-row-action dd-row-action--edit" %>
                          <% end %>
                          <% if can_remove %>
                            <%= button_to "Remove", departure_arrangement_item_occurrence_path(@departure, @supplier_arrangement, item, occurrence_definition.service_occurrence), method: :delete, class: "dd-row-action", form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this occurrence?" } }, params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                          <% end %>
                        </div>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="<%= empty_state_classes.join(" ") %>">No occurrences yet.</p>
          <% end %>
        </section>

        <section id="resources-<%= item.id %>">
          <header class="dd-panel-header">
            <div>
              <h3 class="dd-panel-title">Resources</h3>
              <% if reorder_resources_item_id == item.id.to_s %>
                <p>Reorder mode. Use Move up and Move down to set the resource order.</p>
              <% end %>
            </div>
            <div class="dd-inline-actions">
              <% if ordinary_editable %>
                <%= link_to "Add resource", new_departure_arrangement_item_resource_path(@departure, @supplier_arrangement, item), class: "dd-button dd-button--quiet" %>
                <% if resource_definitions.size > 1 %>
                  <% if reorder_resources_item_id == item.id.to_s %>
                    <%= link_to "Done reordering", departure_arrangement_path(@departure, @supplier_arrangement, anchor: "resources-#{item.id}"), class: "dd-button dd-button--quiet" %>
                  <% else %>
                    <%= link_to "Reorder resources", departure_arrangement_path(@departure, @supplier_arrangement, structure_mode: "resources", structure_item_id: item.id, anchor: "resources-#{item.id}"), class: "dd-button dd-button--quiet" %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </header>
          <% if resource_definitions.any? %>
            <% ordered_resource_ids = resource_definitions.map(&:supplier_resource_id) %>
            <table class="dd-table">
              <thead>
                <tr>
                  <th scope="col">Resource</th>
                  <th scope="col">Description</th>
                  <% if ordinary_editable || can_remove %>
                    <th scope="col">Actions</th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% resource_definitions.each_with_index do |resource_definition, resource_index| %>
                  <tr id="resource-<%= resource_definition.supplier_resource_id %>">
                    <td><%= resource_definition.name %></td>
                    <td><%= resource_definition.description.presence || "—" %></td>
                    <% if ordinary_editable || can_remove %>
                      <td>
                        <div class="dd-inline-actions">
                          <% if ordinary_editable %>
                            <%= link_to "Edit", edit_departure_arrangement_item_resource_path(@departure, @supplier_arrangement, item, resource_definition.supplier_resource), class: "dd-row-action dd-row-action--edit" %>
                            <% if reorder_resources_item_id == item.id.to_s && resource_index.positive? %>
                              <% moved_resource_ids = ordered_resource_ids.dup.tap { |ids| ids[resource_index - 1], ids[resource_index] = ids[resource_index], ids[resource_index - 1] } %>
                              <%= button_to "Move up", reorder_departure_arrangement_item_resources_path(@departure, @supplier_arrangement, item), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, supplier_resource_ids: moved_resource_ids } %>
                            <% end %>
                            <% if reorder_resources_item_id == item.id.to_s && resource_index < resource_definitions.size - 1 %>
                              <% moved_resource_ids = ordered_resource_ids.dup.tap { |ids| ids[resource_index + 1], ids[resource_index] = ids[resource_index], ids[resource_index + 1] } %>
                              <%= button_to "Move down", reorder_departure_arrangement_item_resources_path(@departure, @supplier_arrangement, item), method: :patch, class: "dd-row-action", form: { class: "dd-inline-form" }, params: { version_lock_version: @supplier_arrangement_version.lock_version, supplier_resource_ids: moved_resource_ids } %>
                            <% end %>
                          <% end %>
                          <% if can_remove %>
                            <%= button_to "Remove", departure_arrangement_item_resource_path(@departure, @supplier_arrangement, item, resource_definition.supplier_resource), method: :delete, class: "dd-row-action", form: { class: "dd-inline-form", data: { turbo_confirm: "Remove this resource?" } }, params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                          <% end %>
                        </div>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="<%= empty_state_classes.join(" ") %>">No resources yet.</p>
          <% end %>
        </section>
        <% end %>
      </div>
    </article>
  <% end %>
<% end %>

<article class="dd-panel" id="arrangement-cost-summary">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Arrangement-wide costs and forecast</h2>
      <p><%= pluralize(@arrangement_cost_sources.size, "Arrangement-wide source") %>. The forecast includes only entered, ready Supplier cost terms.</p>
    </div>
    <div class="dd-inline-actions">
      <%= link_to "Arrangement costs", departure_arrangement_costs_workspace_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
      <%= link_to "Commitment triggers",
        departure_arrangement_version_commitment_triggers_path(
          @departure, @supplier_arrangement, @supplier_arrangement_version
        ), class: "dd-button dd-button--quiet" %>
      <%= link_to "Cost forecast", departure_arrangement_cost_forecast_path(@departure, @supplier_arrangement), class: "dd-button" %>
    </div>
  </header>
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
