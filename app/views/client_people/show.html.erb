<% content_for :title, "#{@client_person.display_name} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title"><%= @client_person.display_name %></h1>
    <p class="dd-page-description"><%= @client_person.full_name %></p>
  </div>
  <% if Current.agency_user.permitted?(:manage_client_directory) %>
    <div class="dd-page-actions">
      <%= link_to "Edit person", edit_client_person_path(@client_person), class: "dd-button" %>
      <%= link_to "Change person status", status_edit_client_person_path(@client_person), class: "dd-button dd-button--quiet" %>
      <% if @client_person.client %>
        <%= link_to "Change Client status", client_status_edit_client_person_path(@client_person), class: "dd-button dd-button--quiet" %>
      <% elsif @client_person.active? %>
        <%= button_to "Create Client", client_client_person_path(@client_person), method: :post, class: "dd-button" %>
      <% end %>
    </div>
  <% end %>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Status</dt>
        <dd><%= directory_status_badge(@client_person.status) %></dd>
      </div>
      <div>
        <dt>Client</dt>
        <dd>
          <% if @client_person.client %>
            <span class="dd-inline-actions">
              <span class="dd-type-mono"><%= @client_person.client.client_reference %></span>
              <%= directory_status_badge(@client_person.client.status) %>
            </span>
          <% else %>
            No Client
          <% end %>
        </dd>
      </div>
    </dl>
  </div>
</article>

<% if Current.agency_user.permitted?(:view_client_contact_details) %>
  <%= render "client_people/contact_channel", heading: "Email addresses", records: @email_addresses, new_path: new_client_person_email_address_path(@client_person), channel: :email %>
  <%= render "client_people/contact_channel", heading: "Phone numbers", records: @phone_numbers, new_path: new_client_person_phone_number_path(@client_person), channel: :phone %>
  <%= render "client_people/contact_channel", heading: "Postal addresses", records: @postal_addresses, new_path: new_client_person_postal_address_path(@client_person), channel: :postal %>
<% end %>
