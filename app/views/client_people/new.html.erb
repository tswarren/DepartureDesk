<% content_for :title, "Add person · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">Add person</h1>
    <p class="dd-page-description">Saves a person only. No Client and no trip role is created.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @client_person, class: "dd-form" do |form| %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save person", class: "dd-button" %>
        <%= link_to "Cancel", clients_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
