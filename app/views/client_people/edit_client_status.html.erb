<% content_for :title, "Change Client status · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">Change status for <%= @client.client_reference %></h1>
    <p class="dd-page-description">Current status: <%= @client.status %>. The reference stays with this Client.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <% if @client.inactive? && @client_person.inactive? %>
      <p>Reactivate the person before reactivating this Client.</p>
    <% elsif @client.active? %>
      <p>Inactivation does not inactivate the person or contact records.</p>
    <% end %>
    <%= form_with url: client_status_client_person_path(@client_person), method: :patch, class: "dd-form" do %>
      <%= hidden_field_tag :lock_version, @client.lock_version %>
      <%= hidden_field_tag :status, (@client.active? ? "inactive" : "active") %>
      <div class="dd-form-actions">
        <%= submit_tag (@client.active? ? "Inactivate Client" : "Reactivate Client"), class: "dd-button" %>
        <%= link_to "Cancel", client_person_path(@client_person), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
