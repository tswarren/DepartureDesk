<% content_for :title, "Edit person · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">Edit <%= @client_person.display_name %></h1>
    <p class="dd-page-description">Name changes are reviewed against other people in this agency.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @client_person, class: "dd-form" do |form| %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save person", class: "dd-button" %>
        <%= link_to "Cancel", client_person_path(@client_person), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
