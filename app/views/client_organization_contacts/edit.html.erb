<% content_for :title, "Edit Organization Contact · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">Edit organization contact</h1>
    <p class="dd-page-description"><%= @organization_contact.client_person.display_name %> for <%= @client_organization.display_name %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @organization_contact, url: client_organization_contact_path(@client_organization, @organization_contact), method: :patch, class: "dd-form" do |form| %>
      <%= render "assignment_fields", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save contact", class: "dd-button" %>
        <%= link_to "Cancel", client_organization_path(@client_organization), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
