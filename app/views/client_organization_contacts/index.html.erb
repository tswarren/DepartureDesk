<% content_for :title, "Organization Contacts · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">Organization contacts</h1>
    <p class="dd-page-description"><%= @client_organization.display_name %></p>
  </div>
</header>

<%= render "client_organizations/organization_contacts", heading: "Current contacts", records: @current_contacts, current: true %>
<%= render "client_organizations/organization_contacts", heading: "Historical contacts", records: @historical_contacts, current: false %>
