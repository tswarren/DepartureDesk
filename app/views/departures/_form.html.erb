<%= form.hidden_field :lock_version if form.object.persisted? %>

<div class="dd-field-group">
  <%= form.label :name, "Name", class: "dd-label" %>
  <%= form.text_field :name, maxlength: Departure::NAME_LIMIT, class: "dd-field" %>
</div>

<div class="dd-field-group">
  <%= form.label :description, "Description", class: "dd-label" %>
  <%= form.text_area :description, maxlength: Departure::DESCRIPTION_LIMIT, class: "dd-field" %>
</div>

<div class="dd-field-group">
  <%= form.label :starts_on, "Start date", class: "dd-label" %>
  <%= form.date_field :starts_on, class: "dd-field" %>
</div>

<div class="dd-field-group">
  <%= form.label :ends_on, "End date", class: "dd-label" %>
  <%= form.date_field :ends_on, class: "dd-field" %>
</div>

<div class="dd-field-group">
  <%= form.label :time_zone, "Time zone", class: "dd-label" %>
  <%= form.select :time_zone, iana_timezone_options, { include_blank: form.object.draft? ? "No time zone" : nil }, class: "dd-field", required: !form.object.draft? %>
</div>

<div class="dd-field-group">
  <%= form.label :operating_currency, "Operating currency", class: "dd-label" %>
  <%= form.text_field :operating_currency, maxlength: 3, class: "dd-field" %>
</div>

<fieldset class="dd-form-section">
  <legend class="dd-section-title">Overrides</legend>
  <p class="dd-field-hint">Leave blank to use the agency default. A value here applies to this departure's new work only.</p>
  <div class="dd-field-group">
    <%= form.label :hold_duration_days, "Client hold duration (days)", class: "dd-label" %>
    <%= form.number_field :hold_duration_days, min: 1, step: 1, aria: { describedby: "departure_hold_duration_days_hint" }, class: "dd-field dd-field--numeric dd-field--narrow" %>
    <p class="dd-field-hint" id="departure_hold_duration_days_hint">Agency default: <%= pluralize(Current.agency.hold_duration_days, "day") %>.</p>
  </div>
  <div class="dd-field-group">
    <%= form.label :installment_buffer_days, "Buffer before supplier deadlines (days)", class: "dd-label" %>
    <%= form.number_field :installment_buffer_days, min: 0, step: 1, aria: { describedby: "departure_installment_buffer_days_hint" }, class: "dd-field dd-field--numeric dd-field--narrow" %>
    <p class="dd-field-hint" id="departure_installment_buffer_days_hint">Agency default: <%= pluralize(Current.agency.installment_buffer_days, "day") %>.</p>
  </div>
</fieldset>
