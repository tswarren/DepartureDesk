<%# locals: builder, recommendation, readiness, common_scenarios, departure %>
<article class="dd-panel" id="build-this-departure">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Build this departure</h2>
      <p>Outline Client components, decide Supplier support later, and keep one recommended next action in view.</p>
    </div>
  </header>
  <div class="dd-panel-body dd-stack">
    <dl class="dd-definition-list">
      <div>
        <dt>Concept</dt>
        <dd><%= departure.name %> · <%= departure_status_badge(departure.status) %></dd>
      </div>
      <div>
        <dt>Timing</dt>
        <dd><%= departure.schedule_label %></dd>
      </div>
      <div>
        <dt>Responsible office</dt>
        <dd><%= departure.responsible_office ? office_choice_label(departure.responsible_office) : "—" %></dd>
      </div>
    </dl>

    <% if recommendation %>
      <section id="builder-next-action" aria-labelledby="builder-next-action-heading">
        <h3 id="builder-next-action-heading" class="dd-section-title">Recommended next action</h3>
        <p><%= recommendation.label %></p>
        <% href = begin
          Rails.application.routes.url_helpers.public_send("#{recommendation.finding.route_name}_path", **recommendation.finding.route_params.symbolize_keys)
        rescue StandardError
          departure_path(departure)
        end %>
        <p><%= link_to "Open", href, class: "dd-button" %></p>
      </section>
    <% end %>

    <nav aria-label="Builder focus" class="dd-inline-actions">
      <span class="dd-label">What do you want to work on?</span>
      <%= link_to "Supplier support", departure_path(departure, work_on: "supplier", package_id: builder.selected_package&.id),
            class: "dd-button #{'dd-button--quiet' unless builder.work_on == 'supplier'}" %>
      <%= link_to "Pricing", departure_path(departure, work_on: "pricing", package_id: builder.selected_package&.id),
            class: "dd-button #{'dd-button--quiet' unless builder.work_on == 'pricing'}" %>
      <%= link_to "Client preview", departure_path(departure, work_on: "preview", package_id: builder.selected_package&.id),
            class: "dd-button #{'dd-button--quiet' unless builder.work_on == 'preview'}" %>
    </nav>

    <% if builder.editable_packages.many? %>
      <div class="dd-field-group">
        <label class="dd-label" for="builder-package">Package</label>
        <form method="get" action="<%= departure_path(departure) %>" class="dd-inline-actions">
          <input type="hidden" name="work_on" value="<%= builder.work_on %>">
          <select id="builder-package" name="package_id" class="dd-field" onchange="this.form.requestSubmit()">
            <% builder.editable_packages.each do |package| %>
              <option value="<%= package.id %>" <%= "selected" if builder.selected_package&.id == package.id %>><%= package.name %></option>
            <% end %>
          </select>
        </form>
      </div>
    <% end %>

    <% if builder.empty? %>
      <section aria-labelledby="first-component-heading">
        <h3 id="first-component-heading" class="dd-section-title">Add the first component</h3>
        <p>Will most travelers buy these components together as one main package?</p>
        <%= form_with url: departure_initial_package_outline_path(departure), method: :post, class: "dd-form" do %>
          <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
          <div class="dd-field-group">
            <label class="dd-label" for="initial_component_name">Component name</label>
            <input id="initial_component_name" name="component_name" class="dd-field" required maxlength="160">
          </div>
          <div class="dd-field-group">
            <label class="dd-label" for="initial_client_timing">When Clients see it</label>
            <input id="initial_client_timing" name="client_timing_text" class="dd-field" maxlength="160">
          </div>
          <div class="dd-field-group">
            <label class="dd-label" for="initial_package_name">Package name</label>
            <input id="initial_package_name" name="package_name" class="dd-field" value="<%= departure.name %>" required maxlength="160">
          </div>
          <div class="dd-field-group">
            <label class="dd-label" for="initial_placement">Placement</label>
            <select id="initial_placement" name="placement" class="dd-field">
              <option value="included">Included</option>
              <option value="optional">Optional</option>
            </select>
          </div>
          <div class="dd-form-actions">
            <%= submit_tag "Yes, create the main package", class: "dd-button" %>
          </div>
        <% end %>

        <%= form_with url: departure_service_offer_outlines_path(departure), method: :post, class: "dd-form" do %>
          <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
          <div class="dd-field-group">
            <label class="dd-label" for="outline_name">Or save without a package yet</label>
            <input id="outline_name" name="name" class="dd-field" required maxlength="160" placeholder="Component name">
          </div>
          <div class="dd-field-group">
            <label class="dd-label" for="outline_timing">When Clients see it</label>
            <input id="outline_timing" name="client_timing_text" class="dd-field" maxlength="160">
          </div>
          <div class="dd-form-actions">
            <%= submit_tag "Not yet — save unassigned", class: "dd-button dd-button--quiet" %>
          </div>
        <% end %>
      </section>
    <% else %>
      <% if builder.selected_package %>
        <section aria-labelledby="package-summary-heading">
          <h3 id="package-summary-heading" class="dd-section-title">Package summary</h3>
          <p><strong><%= builder.selected_package.name %></strong></p>
          <% if common_scenarios %>
            <ul>
              <% common_scenarios.summaries.each do |summary| %>
                <li>
                  <%= summary.label %>:
                  <% if summary.complete %>
                    <%= format_offer_money(summary.amount_minor_units, summary.currency) %>
                  <% else %>
                    Pending — <%= summary.missing_inputs.first %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <p>
            <%= link_to "Set Package price", departure_package_path(departure, builder.selected_package), class: "dd-button dd-button--quiet" %>
            <%= link_to "Open Package", departure_package_path(departure, builder.selected_package), class: "dd-button dd-button--quiet" %>
          </p>
        </section>
      <% end %>

      <section aria-labelledby="itinerary-heading">
        <h3 id="itinerary-heading" class="dd-section-title">Itinerary components</h3>
        <% builder.component_cards.each do |card| %>
          <article class="dd-stack" style="border-top: 1px solid var(--dd-border, #d0d7de); padding-top: 0.75rem;">
            <h4 class="dd-section-title"><%= card.definition&.client_title || card.service_offer.name %></h4>
            <p>
              <%= card.placement_label %> · <%= card.timing_label %> · <%= card.fulfillment_label %>
            </p>
            <div class="dd-inline-actions">
              <%= link_to "Open component", departure_service_offer_path(departure, card.service_offer), class: "dd-button dd-button--quiet" %>
              <% if card.definition&.undecided? %>
                <%= button_to "Agency fulfilled",
                      resolve_fulfillment_departure_service_offer_path(departure, card.service_offer),
                      params: { fulfillment_basis: "agency_fulfilled", version_lock_version: card.version.lock_version },
                      class: "dd-button dd-button--quiet" %>
                <%= button_to "On request",
                      resolve_fulfillment_departure_service_offer_path(departure, card.service_offer),
                      params: { fulfillment_basis: "on_request", version_lock_version: card.version.lock_version },
                      class: "dd-button dd-button--quiet" %>
                <%= link_to "Supplier-backed", from_source_departure_service_offers_path(departure), class: "dd-button dd-button--quiet" %>
              <% end %>
              <%= button_to "Cruise cabin setup",
                    setup_cruise_cabins_departure_service_offer_path(departure, card.service_offer),
                    params: { version_lock_version: card.version.lock_version },
                    class: "dd-button dd-button--quiet" %>
              <%= button_to "Hotel room setup",
                    setup_hotel_rooms_departure_service_offer_path(departure, card.service_offer),
                    params: { version_lock_version: card.version.lock_version },
                    class: "dd-button dd-button--quiet" %>
              <% if card.inclusion.nil? %>
                <span class="dd-field-hint">Assign to package to arrange</span>
              <% end %>
            </div>
          </article>
        <% end %>

        <% if builder.selected_package&.editable_draft_version&.inclusions&.size.to_i >= 2 %>
          <details class="dd-disclosure">
            <summary>Arrange itinerary</summary>
            <% inclusions = builder.selected_package.editable_draft_version.inclusions.order(:position, :id).to_a %>
            <%= form_with url: reorder_departure_package_inclusions_path(departure, builder.selected_package), method: :patch, class: "dd-form" do %>
              <%= hidden_field_tag :version_lock_version, builder.selected_package.editable_draft_version.lock_version %>
              <% inclusions.each_with_index do |inclusion, index| %>
                <input type="hidden" name="inclusion_ids[]" value="<%= inclusion.id %>" id="inclusion-order-<%= inclusion.id %>">
                <div class="dd-inline-actions">
                  <span><%= inclusion.service_offer.name %></span>
                  <% if index.positive? %>
                    <button type="button" class="dd-button dd-button--quiet" data-action="move-up" onclick="moveInclusion(this, -1)">Move up</button>
                  <% end %>
                  <% if index < inclusions.size - 1 %>
                    <button type="button" class="dd-button dd-button--quiet" onclick="moveInclusion(this, 1)">Move down</button>
                  <% end %>
                </div>
              <% end %>
              <div class="dd-form-actions">
                <%= submit_tag "Save order", class: "dd-button" %>
              </div>
            <% end %>
          </details>
          <script>
            function moveInclusion(button, delta) {
              const form = button.closest("form");
              const rows = Array.from(form.querySelectorAll("div.dd-inline-actions"));
              const row = button.closest("div.dd-inline-actions");
              const index = rows.indexOf(row);
              const target = index + delta;
              if (target < 0 || target >= rows.length) return;
              const inputs = Array.from(form.querySelectorAll('input[name="inclusion_ids[]"]'));
              const values = inputs.map((input) => input.value);
              const tmp = values[index];
              values[index] = values[target];
              values[target] = tmp;
              inputs.forEach((input, i) => { input.value = values[i]; });
              if (delta < 0) row.parentNode.insertBefore(row, rows[target]);
              else row.parentNode.insertBefore(rows[target], row);
            }
          </script>
        <% end %>
      </section>

      <section aria-labelledby="add-component-heading">
        <h3 id="add-component-heading" class="dd-section-title">Add another component</h3>
        <% if builder.selected_package %>
          <%= form_with url: inline_departure_package_path(departure, builder.selected_package), method: :post, class: "dd-form", scope: :inline do |form| %>
            <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
            <%= hidden_field_tag :version_lock_version, builder.selected_package.editable_draft_version.lock_version %>
            <%= hidden_field_tag :return_to, "builder" %>
            <%= hidden_field_tag :work_on, builder.work_on %>
            <div class="dd-field-group">
              <%= form.label :name, "Component name", class: "dd-label" %>
              <%= form.text_field :name, class: "dd-field", required: true, maxlength: 160 %>
            </div>
            <div class="dd-field-group">
              <%= form.label :client_timing_text, "When Clients see it", class: "dd-label" %>
              <%= form.text_field :client_timing_text, class: "dd-field", maxlength: 160 %>
            </div>
            <div class="dd-field-group">
              <%= form.label :placement, "Placement", class: "dd-label" %>
              <%= form.select :placement, [["Included", "included"], ["Optional", "optional"]], {}, class: "dd-field" %>
            </div>
            <%= form.hidden_field :fulfillment_basis, value: "undecided" %>
            <div class="dd-form-actions">
              <%= form.submit "Add to package", class: "dd-button" %>
            </div>
          <% end %>
        <% else %>
          <%= form_with url: departure_service_offer_outlines_path(departure), method: :post, class: "dd-form" do %>
            <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
            <div class="dd-field-group">
              <label class="dd-label" for="another_outline_name">Component name</label>
              <input id="another_outline_name" name="name" class="dd-field" required maxlength="160">
            </div>
            <div class="dd-form-actions">
              <%= submit_tag "Save unassigned component", class: "dd-button" %>
            </div>
          <% end %>
        <% end %>
        <p><%= link_to "Start from Supplier planning", from_source_departure_service_offers_path(departure), class: "dd-button dd-button--quiet" %></p>
      </section>

      <% if builder.work_on == "preview" && builder.selected_package %>
        <section aria-labelledby="internal-preview-heading">
          <h3 id="internal-preview-heading" class="dd-section-title">Internal preview — not shared with Clients</h3>
          <p><%= departure.name %> · <%= departure.schedule_label %></p>
          <ul>
            <% builder.component_cards.select { |card| card.package }.each do |card| %>
              <li>
                <%= card.definition&.client_title || card.service_offer.name %>
                (<%= card.placement_label %>) —
                <%= card.timing_label %>
              </li>
            <% end %>
          </ul>
          <% if common_scenarios&.summaries&.any? %>
            <p>
              Example total:
              <% summary = common_scenarios.summaries.first %>
              <% if summary.complete %>
                <%= format_offer_money(summary.amount_minor_units, summary.currency) %>
              <% else %>
                Pending — <%= summary.missing_inputs.first %>
              <% end %>
            </p>
          <% end %>
          <p><%= link_to "Open full Package preview", departure_package_path(departure, builder.selected_package), class: "dd-button dd-button--quiet" %></p>
        </section>
      <% end %>
    <% end %>
  </div>
</article>
