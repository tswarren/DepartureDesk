<% content_for :title, "#{@departure.name} · DepartureDesk" %>
<% manage = Current.agency_user.permitted?(:manage_departures) %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Departures</p>
    <h1 class="dd-page-title"><%= @departure.name %></h1>
    <p class="dd-page-description"><span class="dd-type-mono"><%= @departure.display_reference %></span></p>
  </div>
  <% if manage %>
    <div class="dd-page-actions">
      <%= link_to "Edit departure", edit_departure_path(@departure), class: "dd-button" %>
      <%= link_to "Edit responsibility", edit_departure_responsibility_path(@departure), class: "dd-button dd-button--quiet" %>
      <% if @departure.draft? %>
        <%= link_to "Activate", departure_activation_path(@departure), class: "dd-button dd-button--quiet" %>
      <% elsif @departure.active? %>
        <%= link_to "Return to draft", edit_departure_return_to_draft_path(@departure), class: "dd-button dd-button--quiet" %>
        <% if @departure.eligible_to_depart?(at: Time.current) %>
          <%= link_to "Mark departed", new_departure_departed_path(@departure), class: "dd-button dd-button--quiet" %>
        <% end %>
      <% elsif @departure.departed? %>
        <%= link_to "Correct schedule", edit_departure_schedule_correction_path(@departure), class: "dd-button dd-button--quiet" %>
        <%= link_to "Correct currency", edit_departure_currency_correction_path(@departure), class: "dd-button dd-button--quiet" %>
        <% if @departure.lifecycle_correction_allowed?(at: Time.current) %>
          <%= link_to "Return to active", edit_departure_lifecycle_correction_path(@departure), class: "dd-button dd-button--quiet" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Status</dt>
        <dd><%= departure_status_badge(@departure.status) %></dd>
      </div>
      <div>
        <dt>Reference</dt>
        <dd class="dd-type-mono"><%= @departure.display_reference %></dd>
      </div>
      <div>
        <dt>Name</dt>
        <dd><%= @departure.name %></dd>
      </div>
      <div>
        <dt>Description</dt>
        <dd><%= @departure.description.presence || "—" %></dd>
      </div>
      <div>
        <dt>Dates</dt>
        <dd><%= @departure.schedule_label %></dd>
      </div>
      <div>
        <dt>Time zone</dt>
        <dd><%= @departure.time_zone.presence || "—" %></dd>
      </div>
      <div>
        <dt>Operating currency</dt>
        <dd><%= @departure.operating_currency.presence || "—" %></dd>
      </div>
      <div>
        <dt>Responsible office</dt>
        <dd><%= @departure.responsible_office ? office_choice_label(@departure.responsible_office) : "—" %></dd>
      </div>
      <div>
        <dt>Responsible user</dt>
        <dd><%= @departure.responsible_agency_user&.display_name || "—" %></dd>
      </div>
      <div>
        <dt>First activated</dt>
        <dd><%= @departure.first_activated_at&.to_fs(:long) || "—" %></dd>
      </div>
      <div>
        <dt>Departed at</dt>
        <dd><%= @departure.departed_at&.to_fs(:long) || "—" %></dd>
      </div>
    </dl>
  </div>
</article>

<article class="dd-panel">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Supplier planning</h2>
      <p>Arrangements for this Departure. Needs-attention counts roll up from Arrangement projections.</p>
    </div>
    <div class="dd-inline-actions">
      <%= link_to "View all", departure_arrangements_path(@departure), class: "dd-button dd-button--quiet" %>
      <% if manage && (@departure.draft? || @departure.active?) %>
        <%= link_to "Add arrangement", new_departure_arrangement_path(@departure), class: "dd-button" %>
        <%= link_to "Add service from Supplier planning", from_source_departure_service_offers_path(@departure), class: "dd-button" %>
      <% end %>
    </div>
  </header>
  <% if @supplier_planning.records.any? %>
    <table class="dd-table">
      <thead>
        <tr>
          <th scope="col">Arrangement</th>
          <th scope="col">Contracting supplier</th>
          <th scope="col">Status</th>
          <th scope="col">Version</th>
          <th scope="col">Needs attention</th>
        </tr>
      </thead>
      <tbody>
        <% @supplier_planning.records.each do |arrangement| %>
          <% version = arrangement.versions.find(&:draft?) ||
            arrangement.versions.find { |candidate| candidate.id == arrangement.governing_version_id } %>
          <% findings = @attention_findings_by_arrangement_id.fetch(arrangement.id, []) %>
          <tr class="<%= "is-inactive" if arrangement.abandoned? %>">
            <td><%= link_to arrangement.name, departure_arrangement_path(@departure, arrangement) %></td>
            <td><%= supplier_option_label(arrangement.contracting_supplier) %></td>
            <td><%= supplier_arrangement_status_badge(arrangement.status) %></td>
            <td><%= version ? version.status.titleize : "Draft" %></td>
            <td>
              <% if findings.any? %>
                <%= link_to pluralize(findings.size, "finding"),
                  departure_arrangement_path(@departure, arrangement, anchor: "needs-attention"),
                  class: "dd-link" %>
                <% overdue = findings.count { |finding| finding.overdue? } %>
                <% if overdue.positive? %>
                  <span class="dd-field-hint"><%= pluralize(overdue, "overdue") %></span>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @supplier_planning.truncated %>
      <div class="dd-panel-body">
        <p>Showing the first 50 arrangements. Open the supplier planning list to filter.</p>
      </div>
    <% end %>
  <% else %>
    <div class="dd-panel-body">
      <p class="<%= empty_state_classes.join(" ") %>">No tentative supplier arrangements yet.</p>
    </div>
  <% end %>
</article>

<% if manage && @client_offers %>
  <article class="dd-panel">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Client offers (draft)</h2>
        <p>Unpublished Service Offer drafts for this Departure. They are not selectable and have no published price.</p>
      </div>
      <div class="dd-inline-actions">
        <%= link_to "View all", departure_service_offers_path(@departure), class: "dd-button dd-button--quiet" %>
        <% if @departure.draft? || @departure.active? %>
          <%= link_to "Add service from Supplier planning", from_source_departure_service_offers_path(@departure), class: "dd-button" %>
          <%= link_to "Add explicit-basis service", new_departure_service_offer_path(@departure), class: "dd-button dd-button--quiet" %>
        <% end %>
      </div>
    </header>
    <% if @client_offers.records.any? %>
      <table class="dd-table">
        <thead>
          <tr>
            <th scope="col">Service</th>
            <th scope="col">Basis</th>
            <th scope="col">Version</th>
          </tr>
        </thead>
        <tbody>
          <% @client_offers.records.each do |offer| %>
            <% version = offer.versions.find(&:draft?) || offer.versions.max_by(&:version_number) %>
            <tr class="<%= "is-inactive" if version&.abandoned? %>">
              <td><%= link_to offer.name, departure_service_offer_path(@departure, offer) %></td>
              <td><%= version&.definition ? fulfillment_basis_label(version.definition.fulfillment_basis) : "—" %></td>
              <td><%= version ? service_offer_status_badge(version.status) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @client_offers.truncated %>
        <div class="dd-panel-body">
          <p>Showing the first 50 service offers. Open the list to review the rest.</p>
        </div>
      <% end %>
    <% else %>
      <div class="dd-panel-body">
        <p class="<%= empty_state_classes.join(" ") %>">No unpublished service offers yet.</p>
      </div>
    <% end %>
  </article>
<% end %>
