<% content_for :title, "#{@departure.name} · DepartureDesk" %>
<% manage = Current.agency_user.permitted?(:manage_departures) %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Departure</p>
    <h1 class="dd-page-title"><%= @departure.name %></h1>
    <p class="dd-page-description"><span class="dd-type-mono"><%= @departure.display_reference %></span> · <%= @departure.schedule_label %> · <%= departure_label_badge(@departure) %></p>
  </div>
  <% if manage && !@departure.departed? %>
    <div class="dd-page-actions">
      <%= link_to "Edit departure", edit_departure_path(@departure), class: "dd-button" %>
      <% if @departure.draft? %>
        <%= link_to "Mark Ready to sell", departure_ready_to_sell_path(@departure), class: "dd-button dd-button--secondary" %>
      <% else %>
        <%= link_to "Return to Draft", edit_departure_return_to_draft_path(@departure), class: "dd-button dd-button--quiet" %>
      <% end %>
      <% if @departure.eligible_to_depart?(at: Time.current) %>
        <%= link_to "Mark departed", new_departure_departed_path(@departure), class: "dd-button dd-button--quiet" %>
      <% end %>
    </div>
  <% end %>
</header>

<%= render "departures/tabs", departure: @departure, current: :overview %>

<article class="dd-panel" id="statuses">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Status</h2>
  </header>
  <div class="dd-panel-body dd-stack">
    <p><%= departure_label_badge(@departure) %></p>
    <dl class="dd-definition-list">
      <div>
        <dt>Sales status</dt>
        <dd><%= @departure.sales_status.humanize %></dd>
      </div>
      <div>
        <dt>Operating decision</dt>
        <dd><%= @departure.operating_decision.humanize %></dd>
      </div>
      <div>
        <dt>Completion</dt>
        <dd><%= @departure.completion_status.humanize %><%= " on #{@departure.departed_at.in_time_zone(Current.agency.default_timezone).to_fs(:long)}" if @departure.departed_at %></dd>
      </div>
    </dl>
  </div>
</article>

<% if manage && @departure.draft? && !@departure.departed? %>
  <%= render "shared/setup_checklist", id: "ready-to-sell", title: "Ready to sell?",
        items: departure_checklist(@departure),
        required_note: "Marking it Ready to sell needs each required item.",
        optional_title: "Not required to be Ready to sell, but a booking needs them before it is confirmed" %>
<% end %>

<article class="dd-panel" id="details">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Details</h2>
  </header>
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Reference</dt>
        <dd class="dd-type-mono"><%= @departure.display_reference %></dd>
      </div>
      <div>
        <dt>Name</dt>
        <dd><%= @departure.name %></dd>
      </div>
      <div>
        <dt>Description</dt>
        <dd><%= @departure.description.presence || "—" %></dd>
      </div>
      <div>
        <dt>Dates</dt>
        <dd><%= @departure.schedule_label %></dd>
      </div>
      <div>
        <dt>Time zone</dt>
        <dd><%= @departure.time_zone.presence || "—" %></dd>
      </div>
      <div>
        <dt>Operating currency</dt>
        <dd><%= @departure.operating_currency.presence || "—" %></dd>
      </div>
      <div>
        <dt>Client hold duration</dt>
        <dd><%= pluralize(@departure.effective_hold_duration_days, "day") %> <span class="dd-cell-subtext">(<%= @departure.hold_duration_days ? "this departure" : "agency default" %>)</span></dd>
      </div>
      <div>
        <dt>Buffer before supplier deadlines</dt>
        <dd><%= pluralize(@departure.effective_installment_buffer_days, "day") %> <span class="dd-cell-subtext">(<%= @departure.installment_buffer_days ? "this departure" : "agency default" %>)</span></dd>
      </div>
    </dl>
  </div>
</article>

<%= render "departure_decisions/panel", departure: @departure, manage: manage %>

<%= render "departure_team_members/panel", departure: @departure, manage: manage %>
