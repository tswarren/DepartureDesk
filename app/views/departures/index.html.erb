<% content_for :title, "Departures · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Departures</p>
    <h1 class="dd-page-title">Departures</h1>
    <p class="dd-page-description">The agency's dated group trips: each one's status, bookings, space left in what its package includes, and money still due.</p>
  </div>
  <% if Current.agency_user.permitted?(:manage_departures) %>
    <div class="dd-page-actions">
      <%= link_to "New Departure", new_departure_path, class: "dd-button" %>
    </div>
  <% end %>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: departures_path, method: :get, class: "dd-form" do |form| %>
      <div class="dd-filter-grid">
        <div class="dd-field-group">
          <%= form.label :q, "Search", class: "dd-label" %>
          <%= form.search_field :q, value: params[:q], maxlength: 100, class: "dd-field" %>
        </div>
        <div class="dd-field-group">
          <%= form.label :status, "Status", class: "dd-label" %>
          <%= form.select :status, departure_label_filter_options, { selected: @status }, class: "dd-field" %>
        </div>
        <div class="dd-field-group">
          <%= form.label :team_member_id, "Team member", class: "dd-label" %>
          <%= form.select :team_member_id, Current.agency.agency_users.agency_staff.order(:last_name, :first_name).map { |user| [ user.display_name, user.id ] }, { include_blank: "Anyone", selected: params[:team_member_id] }, class: "dd-field" %>
        </div>
      </div>
      <%= disclosure "Dates", open: %i[starts_on_from starts_on_to ends_on_from ends_on_to].any? { |key| params[key].present? } do %>
        <div class="dd-filter-grid">
          <div class="dd-field-group">
            <%= form.label :starts_on_from, "Starts on from", class: "dd-label" %>
            <%= form.date_field :starts_on_from, value: params[:starts_on_from], class: "dd-field" %>
          </div>
          <div class="dd-field-group">
            <%= form.label :starts_on_to, "Starts on to", class: "dd-label" %>
            <%= form.date_field :starts_on_to, value: params[:starts_on_to], class: "dd-field" %>
          </div>
          <div class="dd-field-group">
            <%= form.label :ends_on_from, "Ends on from", class: "dd-label" %>
            <%= form.date_field :ends_on_from, value: params[:ends_on_from], class: "dd-field" %>
          </div>
          <div class="dd-field-group">
            <%= form.label :ends_on_to, "Ends on to", class: "dd-label" %>
            <%= form.date_field :ends_on_to, value: params[:ends_on_to], class: "dd-field" %>
          </div>
        </div>
      <% end %>
      <div class="dd-form-actions">
        <%= form.submit "Apply", class: "dd-button" %>
        <%= link_to "Reset", departures_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>

<% if @search %>
  <% user = Current.agency_user %>
  <% show_bookings = user.permitted?(:view_bookings) %>
  <% show_space = user.permitted?(:view_arrangements) %>
  <% show_due = user.permitted?(:view_client_money) %>
  <article class="dd-panel dd-results" aria-labelledby="results-heading">
    <header class="dd-panel-header">
      <h2 class="dd-panel-title" id="results-heading"><%= @search.truncated ? "Showing the first 50 results matched. Narrow the #{params[:q].present? ? "search" : "filters"} to see the rest." : "#{pluralize(@search.records.size, "result")} matched." %></h2>
    </header>
    <div class="dd-table-wrap">
      <table class="dd-table dd-stacked-table">
        <caption class="dd-visually-hidden">Departures</caption>
        <thead>
          <tr>
            <th scope="col">Departure</th>
            <th scope="col">Dates</th>
            <th scope="col">Status</th>
            <% if show_bookings %><th scope="col" class="num">Bookings</th><% end %>
            <% if show_space %><th scope="col">Space left</th><% end %>
            <% if show_due %><th scope="col" class="num">Still due from clients</th><% end %>
            <th scope="col">Default task owner</th>
          </tr>
        </thead>
        <tbody>
          <% if @search.records.empty? %>
            <tr>
              <td colspan="7">No departures matched.</td>
            </tr>
          <% else %>
            <% @search.records.each do |departure| %>
              <% summary = @summaries.fetch(departure) %>
              <tr>
                <th scope="row"><%= link_to departure.name, departure_path(departure) %><span class="dd-cell-subtext dd-type-mono"><%= departure.display_reference %></span></th>
                <td><%= stacked_label("Dates") %><%= departure.schedule_label %></td>
                <td><%= stacked_label("Status") %><%= departure_label_badge(departure) %></td>
                <% if show_bookings %>
                  <td class="num"><%= stacked_label("Bookings") %><%= summary.confirmed_bookings.size %><% drafts = summary.draft_bookings.size %><% if drafts.positive? %><span class="dd-cell-subtext"><%= drafts %> draft</span><% end %></td>
                <% end %>
                <% if show_space %>
                  <td>
                    <%= stacked_label("Space left") %>
                    <% spaces = summary.space_by_choice %>
                    <% if spaces.empty? %>—<% else %><%= safe_join(spaces.map { |choice, space| tag.span("#{choice}: #{space_left_label(space)}", class: "dd-cell-line") }) %><% end %>
                  </td>
                <% end %>
                <% if show_due %>
                  <td class="num"><%= stacked_label("Still due from clients") %><%= summary.currency && summary.charged? ? money(summary.still_due_from_clients, summary.currency) : "—" %></td>
                <% end %>
                <td><%= stacked_label("Default task owner") %><%= departure.default_task_owner&.display_name || "—" %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </article>
<% end %>
