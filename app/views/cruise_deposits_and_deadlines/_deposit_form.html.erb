<% form = local_assigns.fetch(:form).with_indifferent_access %>
<% mode = local_assigns.fetch(:mode) %>
<% definition = local_assigns[:definition] %>
<% path = if mode == :edit
  departure_arrangement_cruise_deposits_and_deadlines_deposit_path(
    @departure, @supplier_arrangement, definition
  )
else
  departure_arrangement_cruise_deposits_and_deadlines_deposits_path(
    @departure, @supplier_arrangement
  )
end %>
<% http_method = mode == :edit ? :patch : :post %>
<% preview_path = deposit_preview_departure_arrangement_cruise_deposits_and_deadlines_path(
  @departure, @supplier_arrangement
) %>
<% selected_pools = Array(form[:capacity_pool_ids]).map(&:to_s) %>
<% selected_resources = Array(form[:supplier_resource_ids]).map(&:to_s) %>
<% selected_contributors = Array(form[:contributor_definition_ids]).map(&:to_s) %>
<% composite_arm_options =
     [
       [ "Fixed date", "fixed_date" ],
       [ "Days before departure", "days_before_departure" ],
       [ "Days after departure", "days_after_departure" ],
       [ "Names assigned to Supplier", "planning_milestone" ]
     ] %>

<section class="dd-stack" id="cruise-deposit-editor" aria-labelledby="cruise-deposit-editor-heading"
  data-controller="cruise-deposit-editor"
  data-cruise-deposit-editor-preview-url-value="<%= preview_path %>"
  data-cruise-deposit-editor-version-lock-version-value="<%= @supplier_arrangement_version.lock_version %>"
  data-action="change->cruise-deposit-editor#update input->cruise-deposit-editor#schedulePreview">
  <h3 id="cruise-deposit-editor-heading" class="dd-section-title">
    <%= mode == :edit ? "Edit deposit requirement" : "Add deposit requirement" %>
  </h3>

  <%= form_with url: path, method: http_method, scope: :cruise_deposit, class: "dd-stack" do |f| %>
    <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
    <% if mode == :new %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
    <% else %>
      <%= hidden_field_tag :lock_version, definition.lock_version %>
    <% end %>

    <div class="dd-field-group">
      <%= f.label :template, "Template", class: "dd-label" %>
      <%= f.select :template,
            CruiseDepositTemplateSupport.template_options,
            { include_blank: "Choose a template", selected: form[:template] },
            required: true,
            class: "dd-input",
            data: { cruise_deposit_editor_target: "template" } %>
      <p class="dd-help">
        Choose the kind of deposit required by the Supplier agreement.
      </p>
    </div>

    <% description_value = form[:description].to_s %>
    <% template_value = form[:template].to_s %>
    <% generated_name = case template_value
         when "initial_deposit" then "Initial deposit"
         when "final_deposit" then "Final deposit"
         else nil
       end %>
    <% staff_authored = if description_value.blank?
         false
       elsif generated_name.nil?
         true
       else
         description_value != generated_name
       end %>
    <div class="dd-field-group" data-cruise-deposit-editor-target="descriptionGroup">
      <%= f.label :description, "Name", class: "dd-label" %>
      <%= f.text_field :description,
            value: description_value,
            maxlength: 500,
            class: "dd-input",
            data: {
              cruise_deposit_editor_target: "description",
              staff_authored: staff_authored,
              action: "input->cruise-deposit-editor#markNameStaffAuthored"
            } %>
    </div>

    <fieldset class="dd-field-group">
      <legend class="dd-label">Amount</legend>
      <%= f.label :amount_shape, "Amount", class: "dd-label" %>
      <%= f.select :amount_shape,
            [
              [ "Fixed amount", "fixed_amount" ],
              [ "Amount × quantity", "quantity_times_rate" ],
              [ "Cumulative amount per retained cabin", "cumulative_target" ]
            ],
            { include_blank: "Choose amount", selected: form[:amount_shape] },
            class: "dd-input",
            data: {
              cruise_deposit_editor_target: "amountShape",
              action: "change->cruise-deposit-editor#schedulePreview"
            } %>

      <div class="dd-field-group" data-cruise-deposit-editor-target="fixedAmountGroup" hidden>
        <%= f.label :fixed_amount, "Fixed amount (#{@departure.operating_currency})", class: "dd-label" %>
        <%= f.text_field :fixed_amount,
              value: form[:fixed_amount].presence || (
                form[:fixed_amount_minor_units].present? ?
                  Money.new(form[:fixed_amount_minor_units], @departure.operating_currency).amount : nil
              ),
              class: "dd-input",
              data: { cruise_deposit_editor_target: "fixedAmount" } %>
      </div>

      <div class="dd-field-group" data-cruise-deposit-editor-target="rateGroup" hidden>
        <%= f.label :rate_amount, "Rate per unit (#{@departure.operating_currency})", class: "dd-label" %>
        <%= f.text_field :rate_amount,
              value: form[:rate_amount].presence || (
                form[:rate_minor_units].present? ?
                  Money.new(form[:rate_minor_units], @departure.operating_currency).amount : nil
              ),
              class: "dd-input",
              data: { cruise_deposit_editor_target: "rateAmount" } %>
      </div>

      <div class="dd-field-group" data-cruise-deposit-editor-target="quantityBasisGroup" hidden>
        <%= f.label :quantity_basis, "Quantity", class: "dd-label" %>
        <%= f.select :quantity_basis,
              [
                [ "Amount per initially blocked cabin", "capacity_pool_units" ],
                [ "Amount per explicit quantity", "explicit" ]
              ],
              { selected: form[:quantity_basis] || "capacity_pool_units" },
              class: "dd-input",
              data: {
                cruise_deposit_editor_target: "quantityBasis",
                action: "change->cruise-deposit-editor#schedulePreview"
              } %>
      </div>

      <div class="dd-field-group" data-cruise-deposit-editor-target="explicitQuantityGroup" hidden>
        <%= f.label :explicit_quantity, "Explicit quantity", class: "dd-label" %>
        <%= f.number_field :explicit_quantity,
              value: form[:explicit_quantity],
              min: 1,
              class: "dd-input",
              data: { cruise_deposit_editor_target: "explicitQuantity" } %>
      </div>
    </fieldset>

    <fieldset class="dd-field-group" data-cruise-deposit-editor-target="coverageScopeGroup" hidden>
      <legend class="dd-label">What does it cover?</legend>
      <%= f.label :coverage_scope, "Coverage scope", class: "dd-label" %>
      <%= f.select :coverage_scope,
            [
              [ "Entire Cruise Arrangement", "arrangement" ],
              [ "Selected cabin categories", "resource" ],
              [ "Selected cabin Capacity Pools", "capacity_pool" ]
            ],
            { selected: form[:coverage_scope] || "arrangement" },
            class: "dd-input",
            data: { cruise_deposit_editor_target: "coverageScope" } %>
    </fieldset>

    <fieldset class="dd-field-group" data-cruise-deposit-editor-target="resourceGroup" hidden>
      <legend class="dd-label">Cabin categories</legend>
      <div class="dd-stack" role="group" aria-label="Cabin category coverage">
        <% Array(@resource_options).each do |label, resource_id| %>
          <label class="dd-checkbox-label">
            <%= check_box_tag "cruise_deposit[supplier_resource_ids][]",
                  resource_id,
                  selected_resources.include?(resource_id.to_s),
                  id: "cruise_deposit_supplier_resource_#{resource_id}",
                  data: { cruise_deposit_editor_target: "resourceCheckbox" } %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="dd-field-group" data-cruise-deposit-editor-target="poolGroup" hidden>
      <legend class="dd-label">Cabin Capacity Pools</legend>
      <div class="dd-stack" role="group" aria-label="Capacity Pool coverage">
        <% Array(@pool_options).each do |label, pool_id| %>
          <label class="dd-checkbox-label">
            <%= check_box_tag "cruise_deposit[capacity_pool_ids][]",
                  pool_id,
                  selected_pools.include?(pool_id.to_s),
                  id: "cruise_deposit_capacity_pool_#{pool_id}",
                  data: { cruise_deposit_editor_target: "poolCheckbox" } %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="dd-field-group" data-cruise-deposit-editor-target="contributorGroup" hidden>
      <legend class="dd-label">Credit these earlier deposits</legend>
      <div class="dd-stack" role="group" aria-label="Contributor definitions">
        <% Array(@contributor_options).each do |label, contributor_id| %>
          <label class="dd-checkbox-label">
            <%= check_box_tag "cruise_deposit[contributor_definition_ids][]",
                  contributor_id,
                  selected_contributors.include?(contributor_id.to_s),
                  id: "cruise_deposit_contributor_#{contributor_id}",
                  data: { cruise_deposit_editor_target: "contributorCheckbox" } %>
            <%= label %>
          </label>
        <% end %>
        <% if Array(@contributor_options).empty? %>
          <p class="dd-help">Add an initial capacity-pool deposit before a final cumulative deposit.</p>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="dd-field-group">
      <legend class="dd-label">When is it due?</legend>
      <%= f.label :rule_shape, "Timing rule", class: "dd-label" %>
      <%= f.select :rule_shape,
            [
              [ "Fixed date", "fixed_date" ],
              [ "Fixed local date and time", "fixed_local_datetime" ],
              [ "Days before departure", "days_before_departure" ],
              [ "Days after departure", "days_after_departure" ],
              [ "Hours before departure", "hours_before_departure" ],
              [ "Hours after departure", "hours_after_departure" ],
              [ "Earlier of…", "earlier_of" ]
            ],
            { include_blank: "Choose timing", selected: form[:rule_shape] },
            required: true,
            class: "dd-input",
            data: { cruise_deposit_editor_target: "ruleShape" } %>

      <div class="dd-field-group" data-cruise-deposit-editor-target="fixedDateGroup" hidden>
        <%= f.label :fixed_date, "Date", class: "dd-label" %>
        <%= f.date_field :fixed_date, value: form[:fixed_date], class: "dd-input",
              data: { cruise_deposit_editor_target: "fixedDate" } %>
      </div>
      <div class="dd-field-group" data-cruise-deposit-editor-target="fixedDatetimeGroup" hidden>
        <%= f.label :fixed_datetime, "Local date and time", class: "dd-label" %>
        <%= f.datetime_local_field :fixed_datetime, value: form[:fixed_datetime], class: "dd-input" %>
      </div>
      <div class="dd-field-group" data-cruise-deposit-editor-target="offsetDaysGroup" hidden>
        <%= f.label :offset_days, "Days", class: "dd-label" %>
        <%= f.number_field :offset_days, value: form[:offset_days], min: 0, class: "dd-input" %>
      </div>
      <div class="dd-field-group" data-cruise-deposit-editor-target="offsetHoursGroup" hidden>
        <%= f.label :offset_hours, "Hours", class: "dd-label" %>
        <%= f.number_field :offset_hours, value: form[:offset_hours], min: 0, class: "dd-input" %>
      </div>

      <div class="dd-stack" data-cruise-deposit-editor-target="compositeGroup" hidden>
        <fieldset class="dd-field-group" id="cruise-deposit-arm1">
          <legend class="dd-label">Earlier-of arm 1</legend>
          <%= f.select :arm1_rule_shape,
                composite_arm_options,
                { include_blank: "Choose arm", selected: form[:arm1_rule_shape] },
                class: "dd-input",
                data: { cruise_deposit_editor_target: "arm1RuleShape" } %>
          <%= f.hidden_field :arm1_milestone_kind,
                value: form[:arm1_milestone_kind].presence || CruiseDepositTemplateSupport::MILESTONE_KIND %>
          <div data-cruise-deposit-editor-target="arm1FixedDateGroup" hidden>
            <%= f.date_field :arm1_fixed_date, value: form[:arm1_fixed_date], class: "dd-input" %>
          </div>
          <div data-cruise-deposit-editor-target="arm1OffsetDaysGroup" hidden>
            <%= f.number_field :arm1_offset_days, value: form[:arm1_offset_days], min: 0, class: "dd-input" %>
          </div>
        </fieldset>
        <fieldset class="dd-field-group" id="cruise-deposit-arm2">
          <legend class="dd-label">Earlier-of arm 2</legend>
          <%= f.select :arm2_rule_shape,
                composite_arm_options,
                { include_blank: "Choose arm", selected: form[:arm2_rule_shape] },
                class: "dd-input",
                data: { cruise_deposit_editor_target: "arm2RuleShape" } %>
          <%= f.hidden_field :arm2_milestone_kind,
                value: form[:arm2_milestone_kind].presence || CruiseDepositTemplateSupport::MILESTONE_KIND %>
          <div data-cruise-deposit-editor-target="arm2FixedDateGroup" hidden>
            <%= f.date_field :arm2_fixed_date, value: form[:arm2_fixed_date], class: "dd-input" %>
          </div>
          <div data-cruise-deposit-editor-target="arm2OffsetDaysGroup" hidden>
            <%= f.number_field :arm2_offset_days, value: form[:arm2_offset_days], min: 0, class: "dd-input" %>
          </div>
        </fieldset>
      </div>
    </fieldset>

    <div class="dd-field-group" aria-live="polite">
      <p class="dd-label">Amount preview</p>
      <p data-cruise-deposit-editor-target="previewOutput">Enter amount fields to preview.</p>
      <p class="dd-help" data-cruise-deposit-editor-target="previewLabel" hidden></p>
      <p class="dd-help" data-cruise-deposit-editor-target="previewPending" hidden></p>
    </div>

    <div class="dd-inline-actions">
      <%= f.submit "Save deposit", class: "dd-button" %>
      <%= link_to "Cancel",
            departure_arrangement_cruise_deposits_and_deadlines_path(@departure, @supplier_arrangement),
            class: "dd-link" %>
    </div>
  <% end %>
</section>
