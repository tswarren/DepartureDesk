<% activation_preview = local_assigns.fetch(:activation_preview) %>

<div class="dd-stack" id="cruise-activation-preview">
  <p>
    Definition-level preview of what activation will materialize.
    Activation creates no Supplier Payment, Obligation, or paid record.
  </p>

  <% if activation_preview.rows.any? %>
    <div class="dd-table-wrap">
      <table class="dd-table" id="cruise-activation-preview-rows">
        <thead>
          <tr>
            <th scope="col">Definition</th>
            <th scope="col">Amount or basis</th>
            <th scope="col">Due timing</th>
            <th scope="col">Scope</th>
            <th scope="col">Commitment effect</th>
            <th scope="col">Attention</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% activation_preview.rows.each do |row| %>
            <% editor_path =
                 if row.kind.to_s == "deposit"
                   departure_arrangement_cruise_deposits_and_deadlines_path(
                     @departure, @supplier_arrangement,
                     deposit_editor: "edit", deposit_id: row.definition_id
                   )
                 else
                   departure_arrangement_cruise_deposits_and_deadlines_path(
                     @departure, @supplier_arrangement,
                     editor: "edit", deadline_id: row.definition_id
                   )
                 end %>
            <tr>
              <td><%= row.display_name %></td>
              <td>
                <% if row.amount_sentence.present? || row.pending_reasons.any? %>
                  <%= row.amount_sentence.presence || "Pending" %>
                  <% row.pending_reasons.each do |reason| %>
                    <p><%= reason %></p>
                  <% end %>
                <% else %>
                  —
                <% end %>
              </td>
              <td><%= row.due_sentence.presence || "—" %></td>
              <td><%= row.coverage_summary %></td>
              <td><%= row.will_open_commitment? ? "Opens commitment" : "No commitment opening" %></td>
              <td>
                <% if row.elapsed_acknowledgment_required? %>
                  <p>Required at activation</p>
                <% end %>
                <% if row.blocker.present? %>
                  <p><%= row.blocker %></p>
                <% end %>
                <% unless row.elapsed_acknowledgment_required? || row.blocker.present? %>
                  —
                <% end %>
              </td>
              <td><%= link_to "Open definition", editor_path, class: "dd-link" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No deposit or deadline definitions to materialize yet.</p>
  <% end %>
</div>
