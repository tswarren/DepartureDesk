<% content_for :title, "Deposits and deadlines — #{@supplier_arrangement.name}" %>

<% form = (@form || {}).with_indifferent_access %>
<% deposit_form = (@deposit_form || {}).with_indifferent_access %>
<% open_new = @editable && @editor == "new" %>
<% open_edit_id = @editable && @editor == "edit" ? @editing_id : nil %>
<% open_deposit_new = @editable && @deposit_editor == "new" %>
<% open_deposit_edit_id = @editable && @deposit_editor == "edit" ? @editing_deposit_id : nil %>

<article class="dd-panel" id="cruise-deposits-and-deadlines">
  <div class="dd-panel-body dd-stack">
    <p>
      <%= link_to "Back to Cruise workspace",
            departure_arrangement_cruise_path(@departure, @supplier_arrangement),
            class: "dd-link" %>
    </p>

    <header class="dd-stack">
      <h1 class="dd-page-title">Deposits and deadlines</h1>
      <p>
        <%= @supplier_arrangement.name %>
        · <%= cruise_version_status_label(@supplier_arrangement_version) %>
        · <%= @departure.operating_currency %>
      </p>
    </header>

    <% if @form_error.present? %>
      <div id="form-error-summary"
           class="dd-alert dd-alert--danger"
           role="alert"
           tabindex="-1"
           data-controller="form-error-summary">
        <p><%= @form_error %></p>
      </div>
    <% end %>

    <% if @workspace.governing_read_only? %>
      <section class="dd-stack" aria-labelledby="cruise-governing-terms-heading">
        <h2 id="cruise-governing-terms-heading" class="dd-section-title">Governing operational state</h2>
        <p>
          Governing Supplier deadlines and deposits are read-only.
          Evidence actions remain on Arrangement commitments chrome.
        </p>
        <% if @workspace.can_create_successor? %>
          <%= button_to "Create successor draft to change future terms",
                successor_departure_arrangement_cruise_path(@departure, @supplier_arrangement),
                method: :post,
                params: {
                  arrangement_lock_version: @supplier_arrangement.lock_version,
                  version_lock_version: @supplier_arrangement_version.lock_version,
                  idempotency_key: SecureRandom.uuid
                },
                class: "dd-button" %>
        <% end %>
      </section>

      <% if Current.agency_user.permitted?(:manage_departures) && @supplier_arrangement.active? %>
        <section class="dd-stack" aria-labelledby="cruise-planning-milestone-heading">
          <h2 id="cruise-planning-milestone-heading" class="dd-section-title">Record planning milestone</h2>
          <p>Record names assigned to supplier for earlier-of Deposit Requirements.</p>
          <%= form_with url: departure_arrangement_planning_milestones_path(@departure, @supplier_arrangement),
                method: :post, class: "dd-form" do %>
            <%= hidden_field_tag :idempotency_key, @planning_milestone_idempotency_key %>
            <%= hidden_field_tag :kind, "names_assigned_to_supplier" %>
            <%= hidden_field_tag :return_to, CompileCruiseDepositsAndDeadlinesWorkspace::RETURN_TOKEN %>
            <div class="dd-field-group">
              <%= label_tag :occurred_on, "Names assigned to supplier on", class: "dd-label" %>
              <%= date_field_tag :occurred_on, Date.current, required: true, class: "dd-input" %>
              <%= label_tag :note, "Note (optional)", class: "dd-label" %>
              <%= text_field_tag :note, nil, class: "dd-input", maxlength: 2000 %>
            </div>
            <%= submit_tag "Record names assigned to supplier", class: "dd-button" %>
          <% end %>
        </section>
      <% end %>
    <% end %>

    <% if @workspace.successor_draft? %>
      <section class="dd-stack" aria-labelledby="cruise-successor-compare-heading">
        <h2 id="cruise-successor-compare-heading" class="dd-section-title">Successor comparison</h2>
        <p>
          Proposed terms edit this draft only. Reconcile foreshadow is not yet applied.
          Governing occurrences and tranches remain unchanged until successor activation.
        </p>
      </section>
    <% end %>

    <% if @activation_preview %>
      <section class="dd-stack"
               id="cruise-activation-preview"
               aria-labelledby="cruise-activation-preview-heading"
               data-controller="cruise-activation-preview"
               data-cruise-activation-preview-url-value="<%= activation_preview_departure_arrangement_cruise_deposits_and_deadlines_path(@departure, @supplier_arrangement) %>"
               data-cruise-activation-preview-lock-version-value="<%= @supplier_arrangement_version.lock_version %>">
        <h2 id="cruise-activation-preview-heading" class="dd-section-title">Activation consequences</h2>
        <p>
          Definition-level preview of what activation will materialize. No durable writes occur here.
          Activation itself uses the shipped Arrangement activation path.
        </p>
        <p id="cruise-activation-preview-status"
           class="dd-page-description"
           role="status"
           aria-live="polite"
           data-cruise-activation-preview-target="status">
          <% if @activation_preview.elapsed_acknowledgment_required? %>
            Elapsed dates will require acknowledgment at activation.
          <% end %>
          <% if @activation_preview.blockers.any? %>
            <%= @activation_preview.blockers.join(" ") %>
          <% elsif !@activation_preview.elapsed_acknowledgment_required? %>
            Preview is current.
          <% end %>
        </p>
        <% if @activation_preview.rows.any? %>
          <ul class="dd-stack" id="cruise-activation-preview-rows" data-cruise-activation-preview-target="list">
            <% @activation_preview.rows.each do |row| %>
              <li class="dd-stack">
                <p>
                  <strong><%= row.display_name %></strong>
                  <% if row.amount_sentence.present? %>· <%= row.amount_sentence %><% end %>
                  <% if row.due_sentence.present? %>· <%= row.due_sentence %><% end %>
                  · <%= row.coverage_summary %>
                  · <%= row.will_open_commitment? ? "Opens commitment" : "No commitment opening" %>
                  <% if row.elapsed_acknowledgment_required? %>· Elapsed acknowledgment required<% end %>
                  <% if row.blocker.present? %>· <%= row.blocker %><% end %>
                  <% row.pending_reasons.each do |reason| %>
                    · <%= reason %>
                  <% end %>
                </p>
                <p>
                  <%= link_to "Open definition", row.editor_anchor, class: "dd-link" %>
                </p>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p>No deposit or deadline definitions to materialize yet.</p>
        <% end %>
        <div class="dd-inline-actions">
          <button type="button"
                  class="dd-button dd-button--quiet"
                  data-action="cruise-activation-preview#refresh">
            Refresh preview
          </button>
          <% if Current.agency_user.permitted?(:manage_departures) %>
            <%= link_to "Activate Arrangement",
                  @activation_preview.activation_path,
                  class: "dd-button" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="dd-stack" aria-labelledby="cruise-deposit-requirements-heading">
      <h2 id="cruise-deposit-requirements-heading" class="dd-section-title">Deposit requirements</h2>

      <% if @workspace.deposit_rows.any? %>
        <ul class="dd-stack" id="cruise-deposit-summaries">
          <% @workspace.deposit_rows.each do |row| %>
            <li class="dd-stack"
                id="cruise-deposit-<%= row.definition.id %>"
                tabindex="-1"
                <% if params[:focus_deposit_id].to_s == row.definition.id.to_s %>
                  data-controller="form-error-summary"
                <% end %>>
              <p>
                <strong><%= row.display_label %></strong>
                <% if row.template.present? %>
                  · <%= CruiseDepositTemplateSupport::TEMPLATES.dig(row.template, :label) || "Other" %>
                <% else %>
                  · Other
                <% end %>
                · <%= row.amount_sentence %>
                · <%= row.timing_sentence %>
                · <%= row.coverage_summary %>
              </p>

              <% if row.operational %>
                <p>
                  Governing term · <%= row.operational.term_summary %>
                  <% if row.operational.tranche_amount_sentence.present? %>
                    · Tranche <%= row.operational.tranche_amount_sentence %>
                  <% end %>
                  <% if row.operational.occurrence_due_sentence.present? %>
                    · Due <%= row.operational.occurrence_due_sentence %>
                  <% end %>
                  <% if row.operational.projection_status.present? %>
                    · <%= row.operational.projection_status %>
                  <% end %>
                  · <%= row.operational.commitment_state_label %>
                </p>
                <p>
                  <%= link_to "Open commitments", row.operational.commitments_path, class: "dd-link" %>
                  <% if row.operational.attest_path.present? %>
                    · <%= link_to "Attest handled externally", row.operational.attest_path, class: "dd-link" %>
                  <% end %>
                </p>
              <% end %>

              <% if row.successor_compare %>
                <div class="dd-stack" aria-label="Successor compare for <%= row.display_label %>">
                  <p><strong>Governing term</strong> · <%= row.successor_compare.governing_term_summary %></p>
                  <p><strong>Proposed term</strong> · <%= row.successor_compare.proposed_term_summary %></p>
                  <p><strong>Current materialized</strong> · <%= row.successor_compare.governing_operational_summary %></p>
                  <p><strong>Reconcile foreshadow</strong> · <%= row.successor_compare.reconcile_foreshadow_label %></p>
                </div>
              <% end %>

              <% if row.compatible? %>
                <% if @editable %>
                  <div class="dd-inline-actions">
                    <%= link_to "Edit",
                          departure_arrangement_cruise_deposits_and_deadlines_path(
                            @departure, @supplier_arrangement,
                            deposit_editor: "edit", deposit_id: row.definition.id
                          ),
                          class: "dd-row-action dd-row-action--edit" %>
                    <%= button_to "Remove",
                          departure_arrangement_cruise_deposits_and_deadlines_deposit_path(
                            @departure, @supplier_arrangement, row.definition
                          ),
                          method: :delete,
                          class: "dd-row-action",
                          form: {
                            class: "dd-inline-form",
                            data: {
                              turbo_confirm: "Remove #{row.display_label}? This deletes only this draft definition and its children."
                            }
                          },
                          params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                  </div>
                  <% if open_deposit_edit_id == row.definition.id %>
                    <%= render "cruise_deposits_and_deadlines/deposit_form",
                          form: deposit_form,
                          mode: :edit,
                          definition: row.definition %>
                  <% end %>
                <% end %>
              <% else %>
                <p>This deposit uses an advanced shape.</p>
                <% if row.shape.reasons.any? %>
                  <ul>
                    <% row.shape.reasons.each do |reason| %>
                      <li><%= reason %></li>
                    <% end %>
                  </ul>
                <% end %>
                <p>
                  <%= link_to "Open advanced deposits",
                        row.advanced_path,
                        class: "dd-link" %>
                </p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No deposit requirements yet.</p>
      <% end %>

      <% if @editable %>
        <% unless open_deposit_new || open_deposit_edit_id.present? || open_new || open_edit_id.present? %>
          <p>
            <%= link_to "Add deposit requirement",
                  departure_arrangement_cruise_deposits_and_deadlines_path(
                    @departure, @supplier_arrangement, deposit_editor: "new"
                  ),
                  class: "dd-button" %>
          </p>
        <% end %>

        <% if open_deposit_new %>
          <%= render "cruise_deposits_and_deadlines/deposit_form",
                form: deposit_form,
                mode: :new,
                definition: nil %>
        <% end %>
      <% end %>

      <p>
        <%= link_to "Open advanced deposits",
              @workspace.advanced_deposits_path,
              class: "dd-link" %>
      </p>
    </section>

    <section class="dd-stack" aria-labelledby="cruise-other-deadlines-heading">
      <h2 id="cruise-other-deadlines-heading" class="dd-section-title">Other Supplier deadlines</h2>

      <% if @workspace.deadline_rows.any? %>
        <ul class="dd-stack" id="cruise-deadline-summaries">
          <% @workspace.deadline_rows.each do |row| %>
            <li class="dd-stack"
                id="cruise-deadline-<%= row.definition.id %>"
                tabindex="-1"
                <% if params[:focus_deadline_id].to_s == row.definition.id.to_s %>
                  data-controller="form-error-summary"
                <% end %>>
              <p>
                <strong><%= row.display_label %></strong>
                · <%= row.kind.humanize %>
                · <%= row.timing_sentence %>
                · <%= row.coverage_summary %>
              </p>

              <% if row.operational %>
                <p>
                  Governing term · <%= row.operational.term_summary %>
                  <% if row.operational.occurrence_due_sentence.present? %>
                    · Due <%= row.operational.occurrence_due_sentence %>
                  <% end %>
                  <% if row.operational.projection_status.present? %>
                    · <%= row.operational.projection_status %>
                  <% end %>
                  · <%= row.operational.commitment_state_label %>
                </p>
                <p>
                  <%= link_to "Open commitments", row.operational.commitments_path, class: "dd-link" %>
                </p>
              <% end %>

              <% if row.successor_compare %>
                <div class="dd-stack" aria-label="Successor compare for <%= row.display_label %>">
                  <p><strong>Governing term</strong> · <%= row.successor_compare.governing_term_summary %></p>
                  <p><strong>Proposed term</strong> · <%= row.successor_compare.proposed_term_summary %></p>
                  <p><strong>Current materialized</strong> · <%= row.successor_compare.governing_operational_summary %></p>
                  <p><strong>Reconcile foreshadow</strong> · <%= row.successor_compare.reconcile_foreshadow_label %></p>
                </div>
              <% end %>

              <% if row.compatible? %>
                <% if @editable %>
                  <div class="dd-inline-actions">
                    <%= link_to "Edit",
                          departure_arrangement_cruise_deposits_and_deadlines_path(
                            @departure, @supplier_arrangement,
                            editor: "edit", deadline_id: row.definition.id
                          ),
                          class: "dd-row-action dd-row-action--edit" %>
                    <%= button_to "Remove",
                          departure_arrangement_cruise_deposits_and_deadlines_deadline_path(
                            @departure, @supplier_arrangement, row.definition
                          ),
                          method: :delete,
                          class: "dd-row-action",
                          form: {
                            class: "dd-inline-form",
                            data: {
                              turbo_confirm: "Remove #{row.display_label}? This deletes only this draft definition and its children."
                            }
                          },
                          params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                  </div>
                  <% if open_edit_id == row.definition.id %>
                    <%= render "cruise_deposits_and_deadlines/deadline_form",
                          form: form,
                          mode: :edit,
                          definition: row.definition %>
                  <% end %>
                <% end %>
              <% else %>
                <p>This deadline uses an advanced shape.</p>
                <% if row.shape.reasons.any? %>
                  <ul>
                    <% row.shape.reasons.each do |reason| %>
                      <li><%= reason %></li>
                    <% end %>
                  </ul>
                <% end %>
                <p>
                  <%= link_to "Open advanced Deadlines",
                        row.advanced_path,
                        class: "dd-link" %>
                </p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No Supplier deadlines yet.</p>
      <% end %>

      <% if @editable %>
        <% unless open_new || open_edit_id.present? || open_deposit_new || open_deposit_edit_id.present? %>
          <p>
            <%= link_to "Add Supplier deadline",
                  departure_arrangement_cruise_deposits_and_deadlines_path(
                    @departure, @supplier_arrangement, editor: "new"
                  ),
                  class: "dd-button" %>
          </p>
        <% end %>

        <% if open_new %>
          <%= render "cruise_deposits_and_deadlines/deadline_form",
                form: form,
                mode: :new,
                definition: nil %>
        <% end %>
      <% end %>

      <p>
        <%= link_to "Open advanced Deadlines",
              @workspace.advanced_deadlines_path,
              class: "dd-link" %>
      </p>
    </section>
  </div>
</article>
