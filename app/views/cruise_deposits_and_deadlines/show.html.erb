<% content_for :title, "Deposits and deadlines — #{@supplier_arrangement.name}" %>

<% form = (@form || {}).with_indifferent_access %>
<% deposit_form = (@deposit_form || {}).with_indifferent_access %>
<% open_new = @editable && @editor == "new" %>
<% open_edit_id = @editable && @editor == "edit" ? @editing_id : nil %>
<% open_deposit_new = @editable && @deposit_editor == "new" %>
<% open_deposit_edit_id = @editable && @deposit_editor == "edit" ? @editing_deposit_id : nil %>
<% any_editor_open = open_new || open_edit_id.present? || open_deposit_new || open_deposit_edit_id.present? %>
<% readiness = @workspace.readiness %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Cruise Supplier planning</p>
    <h1 class="dd-page-title">Deposits and deadlines</h1>
    <p class="dd-page-description">
      <%= @supplier_arrangement.name %>
      · <%= cruise_version_status_label(@supplier_arrangement_version) %>
      · <%= @departure.operating_currency %>
    </p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Back to Cruise",
          departure_arrangement_cruise_path(@departure, @supplier_arrangement),
          class: "dd-button dd-button--quiet" %>
  </div>
</header>

<% if @form_error.present? %>
  <div id="form-error-summary"
       class="dd-alert dd-alert--danger"
       role="alert"
       tabindex="-1"
       data-controller="form-error-summary">
    <p class="dd-alert-title">Please fix the following</p>
    <p><%= @form_error %></p>
  </div>
<% end %>

<% if readiness %>
  <% case readiness.state %>
  <% when :ready %>
    <section class="dd-alert dd-alert--success dd-stack"
             id="cruise-readiness-banner"
             aria-labelledby="cruise-readiness-heading">
      <h2 id="cruise-readiness-heading" class="dd-alert-title"><%= readiness.heading %></h2>
      <p><%= readiness.summary_sentence %></p>
      <div class="dd-inline-actions">
        <% if @activation_preview %>
          <details id="cruise-activation-details">
            <summary class="dd-link">View activation details</summary>
            <%= render "cruise_deposits_and_deadlines/activation_details",
                  activation_preview: @activation_preview %>
          </details>
        <% end %>
        <% if readiness.can_activate? && Current.agency_user.permitted?(:manage_departures) %>
          <%= link_to "Activate Arrangement",
                readiness.activation_path,
                class: "dd-button" %>
        <% end %>
      </div>
    </section>

  <% when :blocked %>
    <section class="dd-alert dd-alert--warning dd-stack"
             id="cruise-readiness-banner"
             aria-labelledby="cruise-readiness-heading">
      <h2 id="cruise-readiness-heading" class="dd-alert-title"><%= readiness.heading %></h2>
      <p><%= readiness.summary_sentence %></p>
      <% if readiness.unique_blockers.any? %>
        <ul id="cruise-readiness-issues" class="dd-error-list">
          <% readiness.unique_blockers.each do |blocker| %>
            <li>
              <%= blocker.message %>
              <% if blocker.corrective_path.present? %>
                · <%= link_to blocker.corrective_label.presence || "Review issue",
                      blocker.corrective_path,
                      class: "dd-link" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <div class="dd-inline-actions">
        <% if @activation_preview %>
          <details id="cruise-activation-details">
            <summary class="dd-link">View activation details</summary>
            <%= render "cruise_deposits_and_deadlines/activation_details",
                  activation_preview: @activation_preview %>
          </details>
        <% end %>
      </div>
    </section>

  <% when :governing %>
    <section class="dd-alert dd-alert--info dd-stack"
             id="cruise-readiness-banner"
             aria-labelledby="cruise-readiness-heading">
      <h2 id="cruise-readiness-heading" class="dd-alert-title"><%= readiness.heading %></h2>
      <p><%= readiness.summary_sentence %></p>
      <p>
        Definitions cannot be edited or removed here. Use the operational actions on each row,
        or create a successor draft to propose future terms.
      </p>
      <% if @workspace.can_create_successor? %>
        <%= button_to "Create successor draft",
              successor_departure_arrangement_cruise_path(@departure, @supplier_arrangement),
              method: :post,
              params: {
                arrangement_lock_version: @supplier_arrangement.lock_version,
                version_lock_version: @supplier_arrangement_version.lock_version,
                idempotency_key: SecureRandom.uuid
              },
              class: "dd-button" %>
      <% end %>

      <% if Current.agency_user.permitted?(:manage_departures) && @supplier_arrangement.active? %>
        <div class="dd-stack" aria-labelledby="cruise-planning-milestone-heading">
          <h3 id="cruise-planning-milestone-heading" class="dd-section-title">Record names assigned to Supplier</h3>
          <p>Records an occurred planning milestone for earlier-of Deposit Requirements.</p>
          <%= form_with url: departure_arrangement_planning_milestones_path(@departure, @supplier_arrangement),
                method: :post, class: "dd-form" do %>
            <%= hidden_field_tag :idempotency_key, @planning_milestone_idempotency_key %>
            <%= hidden_field_tag :kind, "names_assigned_to_supplier" %>
            <%= hidden_field_tag :return_to, CompileCruiseDepositsAndDeadlinesWorkspace::RETURN_TOKEN %>
            <% milestone_local_today =
                 Time.current.in_time_zone(@departure.time_zone).to_date %>
            <div class="dd-field-group">
              <%= label_tag :occurred_on, "Names assigned to Supplier on", class: "dd-label" %>
              <%= date_field_tag :occurred_on, milestone_local_today,
                    required: true,
                    class: "dd-input",
                    max: milestone_local_today %>
              <%= label_tag :note, "Note (optional)", class: "dd-label" %>
              <%= text_field_tag :note, nil, class: "dd-input", maxlength: 2000 %>
            </div>
            <%= submit_tag "Record names assigned to Supplier", class: "dd-button" %>
          <% end %>
        </div>
      <% end %>
    </section>

  <% when :successor %>
    <section class="dd-alert dd-alert--info dd-stack"
             id="cruise-readiness-banner"
             aria-labelledby="cruise-readiness-heading">
      <h2 id="cruise-readiness-heading" class="dd-alert-title"><%= readiness.heading %></h2>
      <p><%= readiness.summary_sentence %></p>
      <% if readiness.unique_blockers.any? %>
        <ul class="dd-error-list">
          <% readiness.unique_blockers.each do |blocker| %>
            <li>
              <%= blocker.message %>
              <% if blocker.corrective_path.present? %>
                · <%= link_to blocker.corrective_label.presence || "Review issue",
                      blocker.corrective_path,
                      class: "dd-link" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <div class="dd-inline-actions">
        <% if @activation_preview %>
          <details id="cruise-activation-details">
            <summary class="dd-link">View activation details</summary>
            <%= render "cruise_deposits_and_deadlines/activation_details",
                  activation_preview: @activation_preview %>
          </details>
        <% end %>
        <% if readiness.can_activate? && Current.agency_user.permitted?(:manage_departures) %>
          <%= link_to "Activate Arrangement",
                readiness.activation_path,
                class: "dd-button" %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>

<div id="cruise-deposits-and-deadlines" class="dd-stack">
  <article class="dd-panel" aria-labelledby="cruise-deposit-requirements-heading">
    <header class="dd-panel-header">
      <div>
        <h2 id="cruise-deposit-requirements-heading" class="dd-panel-title" tabindex="-1">
          Deposit requirements
        </h2>
        <p class="dd-page-description">
          Amounts and due rules required by the Supplier agreement.
        </p>
      </div>
      <% if @editable && !any_editor_open %>
        <div class="dd-inline-actions">
          <%= link_to "Add deposit",
                departure_arrangement_cruise_deposits_and_deadlines_path(
                  @departure, @supplier_arrangement, deposit_editor: "new"
                ),
                class: "dd-button" %>
        </div>
      <% end %>
    </header>

    <div class="dd-panel-body dd-stack">
      <% if @workspace.deposit_rows.any? %>
        <ul class="dd-definition-grid" id="cruise-deposit-summaries">
          <% @workspace.deposit_rows.each do |row| %>
            <li class="dd-definition-card"
                id="cruise-deposit-<%= row.definition.id %>"
                tabindex="-1"
                <% if params[:focus_deposit_id].to_s == row.definition.id.to_s %>
                  data-controller="form-error-summary"
                <% end %>>
              <header class="dd-definition-card__header">
                <h3><%= row.display_label %></h3>
                <%= cruise_definition_status_badge(row.status_label) %>
              </header>

              <dl class="dd-fact-grid">
                <div>
                  <dt>Type</dt>
                  <dd><%= row.semantic_type_label %></dd>
                </div>
                <div>
                  <dt>Amount</dt>
                  <dd><%= row.amount_label %></dd>
                </div>
                <div>
                  <dt>Due</dt>
                  <dd><%= row.due_label %></dd>
                </div>
                <div>
                  <dt>Coverage</dt>
                  <dd><%= row.coverage_label %></dd>
                </div>
              </dl>

              <% if row.row_blocker %>
                <div class="dd-attention-callout" role="status">
                  <div>
                    <p><%= row.row_blocker.message %></p>
                    <% if row.row_blocker.corrective_path.present? %>
                      <p>
                        <%= link_to row.row_blocker.corrective_label.presence || "Review issue",
                              row.row_blocker.corrective_path,
                              class: "dd-link" %>
                      </p>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if row.operational %>
                <div class="dd-stack" aria-label="Operational facts for <%= row.display_label %>">
                  <p>
                    <%= row.operational.term_summary %>
                    <% if row.operational.tranche_amount_sentence.present? %>
                      · Tranche <%= row.operational.tranche_amount_sentence %>
                    <% end %>
                    <% if row.operational.occurrence_due_sentence.present? %>
                      · Due <%= row.operational.occurrence_due_sentence %>
                    <% end %>
                    <% if row.operational.projection_status.present? %>
                      · <%= row.operational.projection_status %>
                    <% end %>
                    · <%= row.operational.commitment_state_label %>
                  </p>
                  <div class="dd-inline-actions">
                    <%= link_to "Open commitment",
                          row.operational.commitments_path,
                          class: "dd-link" %>
                    <% if row.operational.attest_path.present? %>
                      <%= link_to "Record handled externally",
                            row.operational.attest_path,
                            class: "dd-link" %>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if row.successor_compare %>
                <div class="dd-stack" aria-label="Successor compare for <%= row.display_label %>">
                  <p><strong>Governing term</strong> · <%= row.successor_compare.governing_term_summary %></p>
                  <p><strong>Proposed term</strong> · <%= row.successor_compare.proposed_term_summary %></p>
                  <p><strong>Current materialized</strong> · <%= row.successor_compare.governing_operational_summary %></p>
                  <p><strong>Reconcile foreshadow</strong> · <%= row.successor_compare.reconcile_foreshadow_label %></p>
                </div>
              <% end %>

              <% if row.compatible? %>
                <% if @editable %>
                  <% remove_label = row.definition.copied_from_id.present? ? "Remove from successor" : "Remove" %>
                  <footer class="dd-definition-card__actions">
                    <div class="dd-inline-actions">
                      <%= link_to "Edit",
                            departure_arrangement_cruise_deposits_and_deadlines_path(
                              @departure, @supplier_arrangement,
                              deposit_editor: "edit", deposit_id: row.definition.id
                            ),
                            class: "dd-button dd-button--quiet" %>
                      <%= button_to remove_label,
                            departure_arrangement_cruise_deposits_and_deadlines_deposit_path(
                              @departure, @supplier_arrangement, row.definition
                            ),
                            method: :delete,
                            class: "dd-row-action dd-row-action--danger",
                            form: {
                              class: "dd-inline-form",
                              data: {
                                turbo_confirm:
                                  "#{remove_label} #{row.display_label}? This deletes only this draft definition and its children."
                              }
                            },
                            params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                    </div>
                  </footer>
                  <% if open_deposit_edit_id == row.definition.id %>
                    <%= render "cruise_deposits_and_deadlines/deposit_form",
                          form: deposit_form,
                          mode: :edit,
                          definition: row.definition %>
                  <% end %>
                <% elsif @workspace.governing_read_only? %>
                  <p class="dd-help">
                    Activated definitions cannot be edited or removed. Use operational actions above,
                    or create a successor draft to propose future terms.
                  </p>
                <% end %>
              <% else %>
                <p>This deposit uses an advanced shape.</p>
                <% if row.shape.reasons.any? %>
                  <ul>
                    <% row.shape.reasons.each do |reason| %>
                      <li><%= reason %></li>
                    <% end %>
                  </ul>
                <% end %>
                <footer class="dd-definition-card__actions">
                  <%= link_to "Open advanced deposit",
                        row.advanced_path,
                        class: "dd-link" %>
                </footer>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No deposit requirements yet.</p>
      <% end %>

      <% if open_deposit_new %>
        <%= render "cruise_deposits_and_deadlines/deposit_form",
              form: deposit_form,
              mode: :new,
              definition: nil %>
      <% end %>
    </div>

    <% if @workspace.advanced_deposits_path.present? %>
      <footer class="dd-panel-footer">
        <%= link_to "Open advanced deposits",
              @workspace.advanced_deposits_path,
              class: "dd-link" %>
      </footer>
    <% end %>
  </article>

  <article class="dd-panel" aria-labelledby="cruise-supplier-deadlines-heading">
    <header class="dd-panel-header">
      <div>
        <h2 id="cruise-supplier-deadlines-heading" class="dd-panel-title" tabindex="-1">
          Supplier deadlines
        </h2>
        <p class="dd-page-description">
          Dates that require Supplier action or provide operational information.
        </p>
      </div>
      <% if @editable && !any_editor_open %>
        <div class="dd-inline-actions">
          <%= link_to "Add deadline",
                departure_arrangement_cruise_deposits_and_deadlines_path(
                  @departure, @supplier_arrangement, editor: "new"
                ),
                class: "dd-button" %>
        </div>
      <% end %>
    </header>

    <div class="dd-panel-body dd-stack">
      <% if @workspace.deadline_rows.any? %>
        <ul class="dd-definition-grid" id="cruise-deadline-summaries">
          <% @workspace.deadline_rows.each do |row| %>
            <li class="dd-definition-card"
                id="cruise-deadline-<%= row.definition.id %>"
                tabindex="-1"
                <% if params[:focus_deadline_id].to_s == row.definition.id.to_s %>
                  data-controller="form-error-summary"
                <% end %>>
              <header class="dd-definition-card__header">
                <h3><%= row.display_label %></h3>
                <%= cruise_definition_status_badge(row.status_label) %>
              </header>

              <dl class="dd-fact-grid">
                <div>
                  <dt>Operational effect</dt>
                  <dd><%= row.semantic_type_label %></dd>
                </div>
                <div>
                  <dt>Due</dt>
                  <dd><%= row.due_label %></dd>
                </div>
                <div>
                  <dt>Coverage</dt>
                  <dd><%= row.coverage_label %></dd>
                </div>
              </dl>

              <% if row.row_blocker %>
                <div class="dd-attention-callout" role="status">
                  <div>
                    <p><%= row.row_blocker.message %></p>
                    <% if row.row_blocker.corrective_path.present? %>
                      <p>
                        <%= link_to row.row_blocker.corrective_label.presence || "Review issue",
                              row.row_blocker.corrective_path,
                              class: "dd-link" %>
                      </p>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if row.operational %>
                <div class="dd-stack" aria-label="Operational facts for <%= row.display_label %>">
                  <p>
                    <%= row.operational.term_summary %>
                    <% if row.operational.occurrence_due_sentence.present? %>
                      · Due <%= row.operational.occurrence_due_sentence %>
                    <% end %>
                    <% if row.operational.projection_status.present? %>
                      · <%= row.operational.projection_status %>
                    <% end %>
                    · <%= row.operational.commitment_state_label %>
                  </p>
                  <div class="dd-inline-actions">
                    <%= link_to "Open commitment",
                          row.operational.commitments_path,
                          class: "dd-link" %>
                  </div>
                </div>
              <% end %>

              <% if row.successor_compare %>
                <div class="dd-stack" aria-label="Successor compare for <%= row.display_label %>">
                  <p><strong>Governing term</strong> · <%= row.successor_compare.governing_term_summary %></p>
                  <p><strong>Proposed term</strong> · <%= row.successor_compare.proposed_term_summary %></p>
                  <p><strong>Current materialized</strong> · <%= row.successor_compare.governing_operational_summary %></p>
                  <p><strong>Reconcile foreshadow</strong> · <%= row.successor_compare.reconcile_foreshadow_label %></p>
                </div>
              <% end %>

              <% if row.compatible? %>
                <% if @editable %>
                  <% remove_label = row.definition.copied_from_id.present? ? "Remove from successor" : "Remove" %>
                  <footer class="dd-definition-card__actions">
                    <div class="dd-inline-actions">
                      <%= link_to "Edit",
                            departure_arrangement_cruise_deposits_and_deadlines_path(
                              @departure, @supplier_arrangement,
                              editor: "edit", deadline_id: row.definition.id
                            ),
                            class: "dd-button dd-button--quiet" %>
                      <%= button_to remove_label,
                            departure_arrangement_cruise_deposits_and_deadlines_deadline_path(
                              @departure, @supplier_arrangement, row.definition
                            ),
                            method: :delete,
                            class: "dd-row-action dd-row-action--danger",
                            form: {
                              class: "dd-inline-form",
                              data: {
                                turbo_confirm:
                                  "#{remove_label} #{row.display_label}? This deletes only this draft definition and its children."
                              }
                            },
                            params: { version_lock_version: @supplier_arrangement_version.lock_version } %>
                    </div>
                  </footer>
                  <% if open_edit_id == row.definition.id %>
                    <%= render "cruise_deposits_and_deadlines/deadline_form",
                          form: form,
                          mode: :edit,
                          definition: row.definition %>
                  <% end %>
                <% elsif @workspace.governing_read_only? %>
                  <p class="dd-help">
                    Activated definitions cannot be edited or removed. Use operational actions above,
                    or create a successor draft to propose future terms.
                  </p>
                <% end %>
              <% else %>
                <p>This deadline uses an advanced shape.</p>
                <% if row.shape.reasons.any? %>
                  <ul>
                    <% row.shape.reasons.each do |reason| %>
                      <li><%= reason %></li>
                    <% end %>
                  </ul>
                <% end %>
                <footer class="dd-definition-card__actions">
                  <%= link_to "Open advanced deadline",
                        row.advanced_path,
                        class: "dd-link" %>
                </footer>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No Supplier deadlines yet.</p>
      <% end %>

      <% if open_new %>
        <%= render "cruise_deposits_and_deadlines/deadline_form",
              form: form,
              mode: :new,
              definition: nil %>
      <% end %>
    </div>

    <% if @workspace.advanced_deadlines_path.present? %>
      <footer class="dd-panel-footer">
        <%= link_to "Open advanced Deadlines",
              @workspace.advanced_deadlines_path,
              class: "dd-link" %>
      </footer>
    <% end %>
  </article>
</div>
