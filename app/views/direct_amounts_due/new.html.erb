<% content_for :title, "Record amount due · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Suppliers", departure_arrangements_path(@departure) ], [ @arrangement.arrangement_reference, departure_arrangement_path(@departure, @arrangement) ], [ "Record amount due", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">When you pay · <%= @arrangement.supplier.display_name_for_directory %></p>
    <h1 class="dd-page-title">Record amount due</h1>
    <p class="dd-page-description">A straightforward obligation, payable now or on a date, without a cost line or schedule. It gets its own payment task.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @amount_due, url: departure_arrangement_amounts_due_path(@departure, @arrangement), scope: :amount_due, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <div class="dd-field-group">
        <%= form.label :description, class: "dd-label" %>
        <%= form.text_field :description, value: @values["description"], maxlength: AmountDue::DESCRIPTION_LIMIT, **dd_field_options(form, :description) %>
        <%= dd_field_error(form, :description) %>
      </div>
      <div class="dd-form-grid dd-form-grid--two-column">
        <div class="dd-field-group">
          <%= form.label :amount, "Amount (#{@arrangement.currency})", class: "dd-label" %>
          <%= form.text_field :amount, value: @values["amount"], inputmode: "decimal", autocomplete: "off", **dd_field_options(form, :amount, class: "dd-field--numeric dd-field--narrow") %>
          <%= dd_field_error(form, :amount) %>
        </div>
        <div class="dd-field-group">
          <%= form.label :due_on, "Due date", class: "dd-label" %>
          <%= form.date_field :due_on, value: @values["due_on"], **dd_field_options(form, :due_on) %>
          <%= dd_field_error(form, :due_on) %>
        </div>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Record amount due", class: "dd-button" %>
        <%= link_to "Cancel", departure_arrangement_payments_path(@departure, @arrangement, anchor: "supplier-payments"), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
