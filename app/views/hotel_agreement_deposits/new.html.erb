<% content_for :title, "Deposit · #{@departure.name} · DepartureDesk" %>
<%= render "departure_compositions/shell", active_area: "suppliers" %>
<%= render "hotel_setup/shell", current: "agreement", page_title: "Deposit", item: @arrangement_item %>

<article class="dd-panel" id="hotel-agreement-deposit-form">
  <div class="dd-panel-body dd-stack">
    <%= render "hotel_stays/error_summary" %>
    <%= form_with url: item_hotel_agreement_deposits_departure_arrangement_hotel_path(@departure, @supplier_arrangement, @arrangement_item),
          method: :post, class: "dd-form dd-stack" do %>
      <%= hidden_field_tag :version_id, @supplier_arrangement_version.id %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
      <div class="dd-field-group">
        <label class="dd-label" for="deposit-amount">Amount</label>
        <input id="deposit-amount" name="amount" class="dd-field" required inputmode="decimal" value="<%= @amount %>">
      </div>
      <div class="dd-field-group">
        <label class="dd-label" for="deposit-due-on">Due date</label>
        <input id="deposit-due-on" name="due_on" type="date" class="dd-field" required value="<%= @due_on %>">
      </div>
      <p>This stay</p>
      <button type="submit" class="dd-button">Save deposit</button>
    <% end %>
    <p><%= link_to "Return to Hotel Agreement", hotel_agreement_path_for %></p>
  </div>
</article>
