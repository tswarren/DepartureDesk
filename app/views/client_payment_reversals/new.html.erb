<% content_for :title, "Reverse #{@payment.payment_reference} · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Clients", clients_path ], [ @trip.client.source.display_name, client_profile_path_for(@trip.client) ], [ @trip.trip_reference, client_trip_path(@trip) ], [ "Reverse #{@payment.payment_reference}", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Client money · <%= @trip.trip_reference %></p>
    <h1 class="dd-page-title">Reverse <%= @payment.payment_reference %></h1>
    <p class="dd-page-description"><%= Money.new(@payment.amount_minor_units, @payment.currency).format %> to <%= @payment.collector_label %> on <%= @payment.paid_on.to_fs(:long) %>. The installments it paid open again; both records are kept<%= ", and receipt #{@payment.receipt.receipt_number} stays issued" if @payment.receipt %>.</p>
  </div>
</header>

<% if @error %>
  <div class="dd-alert dd-alert--danger" role="alert" id="form-error-summary" tabindex="-1" data-controller="form-error-summary">
    <p class="dd-alert-title">The payment wasn't reversed</p>
    <p><%= @error %></p>
  </div>
<% end %>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: client_trip_payment_reversal_path(@trip, @payment), class: "dd-form" do |form| %>
      <div class="dd-field-group">
        <%= label_tag :reason, "Why it's reversed", class: "dd-label" %>
        <%= text_area_tag :reason, params[:reason], rows: 2, maxlength: ClientPaymentReversal::REASON_LIMIT, required: true, class: "dd-field", aria: { describedby: "reason_hint" } %>
        <p class="dd-field-hint" id="reason_hint">For example: Check returned unpaid on Jan 20.</p>
      </div>
      <div class="dd-field-group">
        <%= label_tag :reversed_on, "Date (optional)", class: "dd-label" %>
        <%= date_field_tag :reversed_on, params[:reversed_on], class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Reverse payment", class: "dd-button dd-button--danger", name: nil %>
        <%= link_to "Cancel", client_trip_path(@trip, anchor: "money"), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
