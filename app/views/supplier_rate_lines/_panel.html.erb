<%# The supplier rate table (S-14, SUP-35). Shown only with view_supplier_costs (ACC-31). %>
<%# locals: (departure:, arrangement:, manage:) -%>
<% editable = manage && arrangement.draft? %>
<article class="dd-panel" id="rate-table">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Supplier rate table</h2>
    <% if editable && arrangement.inventory_groups.any? %>
      <%= link_to "Add rate", new_departure_arrangement_rate_line_path(departure, arrangement), class: "dd-button dd-button--quiet" %>
    <% end %>
  </header>
  <div class="dd-panel-body dd-stack">
    <% lines = arrangement.rate_lines.ordered.includes(:inventory_group, :traveler_type) %>
    <% if lines.empty? %>
      <p class="dd-empty-copy">
        <% if arrangement.inventory_groups.empty? %>
          No rates yet. Add an inventory group first, then enter the supplier's rates for each occupancy position.
        <% else %>
          No rates yet. Enter the supplier's rate for each inventory group and occupancy position, as the supplier states it.
        <% end %>
      </p>
    <% else %>
      <p class="dd-page-description">
        Amounts in <%= arrangement.currency %>, as the supplier states them. Confirming a booking proposes its supplier cost and commission from these rates.
        <%= "Frozen when the arrangement was confirmed." unless arrangement.draft? %>
      </p>
      <div class="dd-table-wrap">
        <table class="dd-table dd-rates-table">
          <caption class="dd-visually-hidden">Supplier rates by inventory group and occupancy position</caption>
          <thead>
            <tr>
              <th scope="col">Group</th>
              <th scope="col">Occupancy</th>
              <th scope="col">Traveler type</th>
              <th scope="col" class="num">Base fare</th>
              <th scope="col" class="num">Non-commissionable fees</th>
              <th scope="col" class="num">Taxes</th>
              <th scope="col" class="num">Discount</th>
              <th scope="col" class="num">Commission</th>
              <% if editable %><th scope="col" class="dd-col-actions">Actions</th><% end %>
            </tr>
          </thead>
          <tbody>
            <% lines.each do |line| %>
              <% name = "#{line.inventory_group.label}, #{occupancy_position_label(line.occupancy_position).downcase}#{", #{line.traveler_type.name}" if line.traveler_type}" %>
              <tr>
                <th scope="row"><span class="dd-cabin-field-label dd-visually-hidden">Group</span><%= line.inventory_group.label %></th>
                <td><span class="dd-cabin-field-label dd-visually-hidden">Occupancy</span><%= occupancy_position_label(line.occupancy_position) %></td>
                <td><span class="dd-cabin-field-label dd-visually-hidden">Traveler type</span><%= line.traveler_type&.name || "Any" %></td>
                <td class="num"><span class="dd-cabin-field-label dd-visually-hidden">Base fare</span><%= rate_amount(line.base_fare_minor_units, line.currency) %></td>
                <td class="num"><span class="dd-cabin-field-label dd-visually-hidden">Non-commissionable fees</span><%= rate_amount(line.non_commissionable_fees_minor_units, line.currency) %></td>
                <td class="num"><span class="dd-cabin-field-label dd-visually-hidden">Taxes</span><%= rate_amount(line.taxes_minor_units, line.currency) %></td>
                <td class="num"><span class="dd-cabin-field-label dd-visually-hidden">Discount</span><%= rate_amount(line.discount_minor_units, line.currency) %></td>
                <td class="num"><span class="dd-cabin-field-label dd-visually-hidden">Commission</span><%= rate_commission(line) %></td>
                <% if editable %>
                  <td class="dd-col-actions">
                    <%= link_to "Edit", edit_departure_arrangement_rate_line_path(departure, arrangement, line), class: "dd-row-action dd-row-action--text", aria: { label: "Edit #{name}" } %>
                    <%= button_to "Remove", departure_arrangement_rate_line_path(departure, arrangement, line), method: :delete,
                          class: "dd-row-action dd-row-action--text dd-row-action--danger", form_class: "dd-inline-form",
                          aria: { label: "Remove #{name}" }, form: { data: { turbo_confirm: "Remove the rate for #{name}?" } } %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</article>
