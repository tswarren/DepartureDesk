<%# The supplier rate table as a grid (S-14, SUP-35). Shown only with view_supplier_costs (ACC-31). %>
<%# locals: (departure:, arrangement:, manage:) -%>
<% editable = manage && arrangement.draft? %>
<% grid = SupplierRateGrid.new(arrangement) %>
<article class="dd-panel" id="rate-table">
  <header class="dd-panel-header dd-section-header">
    <h2 class="dd-panel-title">Supplier rates</h2>
    <% if editable && arrangement.inventory_groups.any? %>
      <%= link_to grid.bands.any? ? "Edit rates" : "Set up rates", edit_departure_arrangement_rates_path(departure, arrangement), class: "dd-button dd-button--secondary" %>
    <% end %>
  </header>
  <div class="dd-panel-body dd-stack">
    <% if grid.bands.empty? && arrangement.rate_lines.empty? %>
      <p class="dd-empty-copy">
        <%= arrangement.inventory_groups.empty? ? "No rates yet. Add an inventory group first, then set up the supplier's rates." : "No rates yet. Set them up from a pattern or another arrangement's rates." %>
      </p>
    <% elsif grid.bands.empty? %>
      <p class="dd-page-description"><%= pluralize(arrangement.rate_lines.size, "rate") %> entered before rate patterns. <%= "Set up rates to see and edit them as a grid." if editable %></p>
    <% else %>
      <% defaults = grid.defaults %>
      <p class="dd-page-description">
        Per guest in <%= grid.currency %>: non-commissionable fare <%= defaults["non_commissionable_fees"] || "0" %>, taxes and fees <%= defaults["taxes"] || "0" %>,
        commission <%= defaults["commission_method"] == "amount" ? "#{defaults["commission_amount"]} per guest" : "#{defaults["commission_rate"]}% of the #{ArrangementsHelper::COMMISSION_BASE_LABELS.fetch(defaults["commission_base"] || "base_fare").downcase}" %>.
        <%= "Frozen when the arrangement was confirmed." unless arrangement.draft? %>
      </p>
      <div class="dd-table-wrap">
        <table class="dd-table dd-stacked-table">
          <caption class="dd-visually-hidden">Supplier fares per guest by inventory group and band</caption>
          <thead>
            <tr>
              <th scope="col">Group</th>
              <% grid.bands.each do |band| %><th scope="col" class="num"><%= band.label %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% grid.groups.each do |group| %>
              <tr>
                <th scope="row"><%= group.label %></th>
                <% grid.cells_for(group).each do |cell| %>
                  <td class="num">
                    <span class="dd-cabin-field-label dd-visually-hidden"><%= cell.band.label %></span>
                    <% if !cell.available %>
                      <span class="dd-cell-subtext">—</span>
                    <% elsif cell.fare.blank? %>
                      <span class="dd-cell-subtext">No fare</span>
                    <% else %>
                      <%= rate_amount(MoneyInput.minor_units(cell.fare, grid.currency), grid.currency) %>
                      <span class="dd-cell-subtext">less <%= rate_amount(MoneyInput.minor_units(cell.discount.presence || "0", grid.currency), grid.currency) %><%= " · own values" if cell.overrides.any? %></span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</article>
