<% content_for :title, "Mark #{@departure.name} Ready to sell · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Ready to sell", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Departures</p>
    <h1 class="dd-page-title">Mark Ready to sell</h1>
    <p class="dd-page-description"><%= @departure.name %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= render "shared/form_errors", object: @departure %>
    <% if @ready_to_sell_blockers.any? %>
      <section class="dd-callout">
        <h2 class="dd-panel-title">Complete these before marking it Ready to sell</h2>
        <ul>
          <% @ready_to_sell_blockers.each do |blocker| %>
            <li><%= blocker %></li>
          <% end %>
        </ul>
      </section>
      <div class="dd-form-actions">
        <%= link_to "Edit departure", edit_departure_path(@departure), class: "dd-button" %>
        <%= link_to "Cancel", departure_path(@departure), class: "dd-button dd-button--quiet" %>
      </div>
    <% else %>
      <p>Marking the departure Ready to sell lets staff take holds and bookings on it. Its reference stays the same.</p>
      <%= form_with url: departure_ready_to_sell_path(@departure), method: :post, class: "dd-form" do |form| %>
        <%= hidden_field_tag :lock_version, @departure.lock_version %>
        <div class="dd-form-actions">
          <%= form.submit "Mark Ready to sell", class: "dd-button" %>
          <%= link_to "Cancel", departure_path(@departure), class: "dd-button dd-button--quiet" %>
        </div>
      <% end %>
    <% end %>
  </div>
</article>
