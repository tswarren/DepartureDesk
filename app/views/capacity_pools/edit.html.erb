<% content_for :title, "Edit Capacity Pool · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Draft capacity</p>
    <h1 class="dd-page-title">Edit Pool</h1>
    <p class="dd-page-description"><%= @capacity_pool_definition.label %> · <%= @arrangement_item_definition.name %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= render "form",
      pool_definition: @capacity_pool_definition,
      values: {},
      url: pair_pool_departure_arrangement_item_capacity_path(@departure, @supplier_arrangement, @arrangement_item, pair_id: @capacity_pair.id, id: @capacity_pool_definition.capacity_pool_id),
      method: :patch,
      submit_label: "Save Pool",
      include_semantics: false,
      include_version_lock: false %>
  </div>
</article>
