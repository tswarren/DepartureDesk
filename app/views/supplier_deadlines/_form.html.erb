<%# A supplier deadline (SUP-22 to SUP-24, SET-10): what is due and by when, whether staff get a task, summed up in one sentence. %>
<%# locals: (form:, arrangement:, deadline:) -%>
<% departure = arrangement.departure %>
<% owner = departure.default_task_owner %>
<% actionable = deadline.new_record? ? (params.dig(:supplier_deadline, :actionable).presence || SupplierDeadline.default_actionable?(deadline.deadline_type || "option_release").to_s) : deadline.actionable.to_s %>
<% records = SupplierDeadline::TRIGGER_EVENTS.transform_values { |event| SupplierMoneyHelper::PAYMENT_EVENT_PHRASES.fetch(event, nil) } %>
<div class="dd-payment-layout" data-controller="deadline-form"
     data-deadline-form-labels-value="<%= TasksHelper::DEADLINE_TYPE_LABELS.to_json %>"
     data-deadline-form-defaults-value="<%= SupplierDeadline::TYPES.to_h { |type| [ type, SupplierDeadline.default_actionable?(type) ] }.to_json %>"
     data-deadline-form-records-value="<%= records.compact.to_json %>"
     data-deadline-form-supplier-value="<%= arrangement.supplier.display_name_for_directory %>"
     data-deadline-form-owner-value="<%= owner&.display_name %>"
     data-deadline-form-zone-value="<%= departure.time_zone || Current.agency.default_timezone %>"
     data-action="input->deadline-form#update change->deadline-form#update">
  <div class="dd-stack">
    <div class="dd-form-grid dd-form-grid--two-column">
      <div class="dd-field-group">
        <%= form.label :deadline_type, "What is due", class: "dd-label" %>
        <%= form.select :deadline_type, TasksHelper::DEADLINE_TYPE_LABELS.invert, {}, class: "dd-field", data: { deadline_form_target: "type", action: "deadline-form#typeChanged" } %>
      </div>
      <div class="dd-field-group">
        <%= form.label :description, "Name (optional)", class: "dd-label" %>
        <%= form.text_field :description, maxlength: SupplierDeadline::DESCRIPTION_LIMIT, **dd_field_options(form, :description, aria_describedby_extra: "supplier_deadline_description_hint"), data: { deadline_form_target: "name" } %>
        <p class="dd-field-hint" id="supplier_deadline_description_hint">It becomes the task's title. Blank uses what is due, such as Final count or manifest.</p>
        <%= dd_field_error(form, :description) %>
      </div>
    </div>
    <p class="dd-field-hint">A deposit or payment the supplier asks for is better added as a payment under When you pay: it makes its own task.</p>
    <div class="dd-rate-inline">
      <div class="dd-field-group">
        <%= form.label :due_on, "By", class: "dd-label" %>
        <%= form.date_field :due_on, **dd_field_options(form, :due_on), data: { deadline_form_target: "date" } %>
        <%= dd_field_error(form, :due_on) %>
      </div>
      <div class="dd-field-group">
        <%= form.label :due_at_time, "Time (optional)", class: "dd-label" %>
        <%= form.time_field :due_at_time, value: deadline.due_at_time&.strftime("%H:%M"), **dd_field_options(form, :due_at_time, class: "dd-field--narrow"), data: { deadline_form_target: "time" } %>
        <%= dd_field_error(form, :due_at_time) %>
      </div>
    </div>
    <p class="dd-field-hint">No time means the end of that day, 11:59 p.m. agency time (<%= Current.agency.default_timezone %>).</p>
    <%= disclosure "Use the supplier's time zone", open: (deadline.time_zone.present? && deadline.time_zone != departure.time_zone) || form.object.errors[:time_zone].any? do %>
      <div class="dd-field-group">
        <%= form.label :time_zone, "Supplier's time zone", class: "dd-label" %>
        <%= form.select :time_zone, iana_timezone_options, { include_blank: "Departure time zone" }, **dd_field_options(form, :time_zone), data: { deadline_form_target: "zone" } %>
        <%= dd_field_error(form, :time_zone) %>
      </div>
    <% end %>
    <% if arrangement.inventory_groups.any? %>
      <%= disclosure "Limit it to one inventory group", open: deadline.inventory_group_id.present? || form.object.errors[:inventory_group_id].any? do %>
        <div class="dd-field-group">
          <%= form.label :inventory_group_id, "Inventory group", class: "dd-label" %>
          <%= form.select :inventory_group_id, arrangement.inventory_groups.map { |group| [ group.label, group.id ] }, { include_blank: "Whole arrangement" }, **dd_field_options(form, :inventory_group_id) %>
        </div>
      <% end %>
    <% end %>
    <div class="dd-choice-group">
      <%= hidden_field_tag "supplier_deadline[actionable]", "false", id: nil %>
      <label class="dd-choice">
        <%= check_box_tag "supplier_deadline[actionable]", "true", actionable == "true", id: "supplier_deadline_actionable", data: { deadline_form_target: "task", action: "deadline-form#taskTouched" } %>
        <span>Make a task<%= ", for #{owner.display_name}, the default task owner" if owner %></span>
      </label>
    </div>
  </div>
  <aside class="dd-payment-summary" aria-labelledby="deadline-summary-heading">
    <h2 class="dd-payment-summary-title" id="deadline-summary-heading">In plain words</h2>
    <p role="status" data-deadline-form-target="output">Choose what is due and when.</p>
  </aside>
</div>
