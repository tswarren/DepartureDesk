<% content_for :title, "Edit deadline · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Suppliers", departure_arrangements_path(@departure) ], [ @arrangement.arrangement_reference, departure_arrangement_path(@departure, @arrangement) ], [ "Edit deadline", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier deadline · <%= @arrangement.supplier.display_name_for_directory %></p>
    <h1 class="dd-page-title">Edit deadline</h1>
    <p class="dd-page-description">A deadline prompts staff only. It never releases inventory, submits information or pays the supplier.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @deadline, url: departure_arrangement_deadline_path(@departure, @arrangement, @deadline), method: :patch, scope: :supplier_deadline, class: "dd-form", data: { controller: "unsaved-changes" } do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= form.hidden_field :lock_version %>
      <%= render "form", form:, arrangement: @arrangement, deadline: @deadline %>
      <div class="dd-form-actions">
        <%= form.submit "Save deadline", class: "dd-button" %>
        <%= link_to "Cancel", departure_arrangement_payments_path(@departure, @arrangement, anchor: "deadlines"), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
