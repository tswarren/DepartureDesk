<% content_for :title, "#{@supplier_location.name} · DepartureDesk" %>
<% manage = Current.agency_user.permitted?(:manage_supplier_directory) %>
<% contact_details = Current.agency_user.permitted?(:view_supplier_contact_details) %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Suppliers</p>
    <h1 class="dd-page-title"><%= @supplier_location.name %></h1>
    <p class="dd-page-description">
      Location of <%= link_to @supplier.display_name_for_directory, supplier_path(@supplier) %>
    </p>
  </div>
  <% if manage %>
    <div class="dd-page-actions">
      <%= link_to "Edit location", edit_supplier_location_path(@supplier, @supplier_location), class: "dd-button" %>
      <%= link_to "Change status", status_edit_supplier_location_path(@supplier, @supplier_location), class: "dd-button dd-button--quiet" %>
    </div>
  <% end %>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div>
        <dt>Status</dt>
        <dd><%= directory_status_badge(@supplier_location.status) %></dd>
      </div>
      <div>
        <dt>Name</dt>
        <dd><%= @supplier_location.name %></dd>
      </div>
      <div>
        <dt>Timezone</dt>
        <dd><%= @supplier_location.timezone.presence || "—" %></dd>
      </div>
      <% if contact_details %>
        <div>
          <dt>Operational address</dt>
          <dd><%= supplier_location_address_display(@supplier_location).presence || "—" %></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><%= supplier_location_phone_display(@supplier_location).presence || "—" %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</article>
