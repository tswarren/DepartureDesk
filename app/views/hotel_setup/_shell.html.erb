<% current_key = local_assigns[:current].to_s %>
<% item = local_assigns[:item] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Hotel</p>
    <h2 class="dd-page-title"><%= local_assigns[:page_title] %></h2>
    <p class="dd-page-description">
      <%= @supplier_arrangement.name %>
      · <%= @supplier_arrangement_version.status.to_s.humanize %>
      <% if item %>
        · <%= @arrangement_item_definition.name %>
      <% end %>
    </p>
  </div>
  <div class="dd-page-actions">
    <details class="dd-disclosure">
      <summary>More actions</summary>
      <div class="dd-disclosure-body dd-stack">
        <%= link_to "Advanced Supplier planning",
              departure_arrangement_path(@departure, @supplier_arrangement),
              class: "dd-link" %>
        <% if item %>
          <%= link_to "Item capacity",
                departure_arrangement_item_capacity_path(@departure, @supplier_arrangement, item),
                class: "dd-link" %>
        <% end %>
      </div>
    </details>
    <%= link_to "Return to Departure Composition", suppliers_departure_composition_path(@departure), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<nav aria-label="Hotel setup" id="hotel-setup-nav">
  <ol class="dd-journey-strip">
    <% if item %>
      <li>
        <%= link_to item_hotel_agreement_departure_arrangement_hotel_path(
              @departure, @supplier_arrangement, item, version_id: @supplier_arrangement_version.id
            ),
              class: "dd-journey-step",
              id: "hotel-step-agreement",
              aria: (current_key == "agreement" ? { current: "page" } : {}) do %>
          <span class="dd-journey-step__title">Agreement</span>
        <% end %>
      </li>
    <% end %>
    <li>
      <%= link_to departure_arrangement_hotel_path(@departure, @supplier_arrangement),
            class: "dd-journey-step",
            id: "hotel-step-overview",
            aria: (current_key == "overview" ? { current: "page" } : {}) do %>
        <span class="dd-journey-step__title">Overview</span>
      <% end %>
    </li>
    <% if item && @supplier_arrangement_version.draft? %>
      <li>
        <%= link_to edit_item_stay_departure_arrangement_hotel_path(
              @departure, @supplier_arrangement, item, **hotel_editor_options
            ),
              class: "dd-journey-step",
              id: "hotel-step-stay",
              aria: (current_key == "stay" ? { current: "page" } : {}) do %>
          <span class="dd-journey-step__title">Edit stay</span>
        <% end %>
      </li>
      <li>
        <%= link_to item_inventory_departure_arrangement_hotel_path(
              @departure, @supplier_arrangement, item, **hotel_editor_options
            ),
              class: "dd-journey-step",
              id: "hotel-step-inventory",
              aria: (current_key == "inventory" ? { current: "page" } : {}) do %>
          <span class="dd-journey-step__title">Edit room block</span>
        <% end %>
      </li>
      <li>
        <%= link_to item_rates_departure_arrangement_hotel_path(
              @departure, @supplier_arrangement, item, **hotel_editor_options
            ),
              class: "dd-journey-step",
              id: "hotel-step-rates",
              aria: (current_key == "rates" ? { current: "page" } : {}) do %>
          <span class="dd-journey-step__title">Edit rates</span>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
