<% content_for :title, "Change #{@client_organization.display_name} Status · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">Change organization status</h1>
    <p class="dd-page-description"><%= @client_organization.display_name %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: status_client_organization_path(@client_organization), method: :patch, class: "dd-form" do |form| %>
      <%= hidden_field_tag :lock_version, @client_organization.lock_version %>
      <div class="dd-field-group">
        <%= label_tag :status, "Status", class: "dd-label" %>
        <%= select_tag :status, options_for_select(ClientOrganization::STATUSES.map { |status| [status.titleize, status] }, @client_organization.status), class: "dd-field" %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Update status", class: "dd-button" %>
        <%= link_to "Cancel", client_organization_path(@client_organization), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
