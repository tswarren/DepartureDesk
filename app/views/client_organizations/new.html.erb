<% content_for :title, "New Organization · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Clients</p>
    <h1 class="dd-page-title">New organization</h1>
    <p class="dd-page-description">Creates an organization directory record. No Client is created from this form.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @client_organization, class: "dd-form" do |form| %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save organization", class: "dd-button" %>
        <%= link_to "Cancel", clients_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
