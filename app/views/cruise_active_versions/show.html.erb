<% ship_name = @shape.summary["ship_name"].presence || @supplier_arrangement.name %>
<% sailing = @summary.sections.find { |section| section.key == "sailing" } %>
<% content_for :title, "Active Supplier terms · #{ship_name} · DepartureDesk" %>

<%= render "cruise_setup/shell", page_title: "Active Supplier terms", version: @supplier_arrangement_version %>

<article class="dd-stack" id="cruise-active-snapshot">
  <section class="dd-panel" aria-labelledby="active-terms-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="active-terms-heading" class="dd-section-title">Active · Version <%= @supplier_arrangement_version.version_number %></h2>
      <p>These Supplier terms currently govern.</p>
      <% if @activation %>
        <p>Version <%= @supplier_arrangement_version.version_number %> became governing on <%= cruise_activation_recorded_on(@activation) %>.</p>
        <p>Activated by <%= @activation.actor.display_name %>.</p>
        <% identifier = cruise_activation_identifier(@activation) %>
        <% if identifier.present? %>
          <p>Supplier-issued identifier <%= identifier %></p>
        <% end %>
      <% end %>
      <% if @draft_version %>
        <p>
          A proposed successor exists.
          <%= link_to "View proposed Version #{@draft_version.version_number}",
                departure_arrangement_cruise_path(@departure, @supplier_arrangement),
                class: "dd-link" %>
        </p>
      <% end %>
    </div>
  </section>

  <section class="dd-panel" aria-labelledby="active-sailing-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="active-sailing-heading" class="dd-section-title">Sailing</h2>
      <p><%= sailing&.detail %></p>
    </div>
  </section>

  <section class="dd-panel" aria-labelledby="active-cabins-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="active-cabins-heading" class="dd-section-title">Cabin inventory</h2>
      <ul class="dd-stack">
        <% @summary.cabin_rows.each do |row| %>
          <li>
            <strong><%= [ row.code, row.name ].compact_blank.join(" · ") %></strong>
            · <%= row.inventory_label %>
            · <%= row.quantity_label %>
            <% if row.opening_quantity_label.present? %>
              · <%= row.opening_quantity_label %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if @can_manage %>
        <%= link_to "Add cabins under same Supplier terms",
              same_terms_departure_arrangement_cruise_inventory_change_path(@departure, @supplier_arrangement),
              class: "dd-button" %>
      <% end %>
    </div>
  </section>
</article>
