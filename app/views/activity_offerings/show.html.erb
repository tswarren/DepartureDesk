<% content_for :title, "Activity setup · #{@supplier_arrangement.name} · DepartureDesk" %>
<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Activity setup</p>
    <h1 class="dd-page-title"><%= @supplier_arrangement.name %></h1>
  </div>
</header>
<article class="dd-panel">
  <div class="dd-panel-body dd-stack">
    <% if @form_error.present? %>
      <div id="form-error-summary" class="dd-form-error-summary" role="alert" tabindex="-1">
        <h2 class="dd-form-error-summary__title">Please fix the following:</h2>
        <ul><li><%= @form_error %></li></ul>
      </div>
    <% end %>
    <% if @workspace[:offerings].empty? %>
      <p>Not started.</p>
    <% else %>
      <ul>
        <% @workspace[:offerings].each do |offering| %>
          <li>
            <%= offering[:name] %> · <%= offering[:template].humanize %> · <%= offering[:date] %>
            · <%= offering[:connection] %>
            <% if offering[:minimum] %> · minimum <%= offering[:minimum] %><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if @editor.blank? %>
      <%= link_to "Add Supplier cost", departure_arrangement_activities_path(@departure, @supplier_arrangement, editor: "component"), class: "dd-button" %>
    <% elsif @shape.offerings.any? %>
      <% submitted = (@submitted || ActionController::Parameters.new).to_unsafe_h %>
      <% offering = @shape.offerings.first %>
      <%= form_with url: supplier_component_departure_arrangement_activities_path(@departure, @supplier_arrangement), method: :post, class: "dd-form dd-stack", data: { turbo: false } do %>
        <%= hidden_field_tag :editor, "component" %>
        <%= hidden_field_tag :idempotency_key, @idempotency_key %>
        <%= hidden_field_tag :arrangement_item_id, offering.item.id %>
        <%= hidden_field_tag :version_lock_version, @shape.version.lock_version %>
        <%= hidden_field_tag :shape, "per_person" %>
        <div class="dd-field-group">
          <label class="dd-label" for="label">Label</label>
          <input id="label" name="label" class="dd-field" value="<%= submitted["label"].presence || offering.item_definition.name %>">
        </div>
        <div class="dd-field-group">
          <label class="dd-label" for="amount">Amount</label>
          <input id="amount" name="amount" class="dd-field" value="<%= submitted["amount"] %>">
        </div>
        <div class="dd-field-group">
          <label class="dd-label" for="minimum_quantity">Minimum participants</label>
          <input id="minimum_quantity" name="minimum_quantity" class="dd-field" value="<%= submitted["minimum_quantity"] %>">
        </div>
        <%= submit_tag "Save", class: "dd-button" %>
      <% end %>
    <% end %>
  </div>
</article>
