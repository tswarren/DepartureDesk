<% content_for :title, "Make Package · #{@departure.name} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Client offers (draft)</p>
    <h1 class="dd-page-title">Make Package</h1>
    <p class="dd-page-description"><%= @departure.name %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @package, url: departure_packages_path(@departure), class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: @package %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
      <div class="dd-field-group">
        <%= form.label :name, "Package name", class: "dd-label" %>
        <%= form.text_field :name, maxlength: Package::NAME_LIMIT, required: true, **dd_field_options(form, :name) %>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Save draft", class: "dd-button" %>
        <%= link_to "Cancel", departure_packages_path(@departure), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
