<% content_for :title, "Cabin categories · #{@supplier_arrangement.name} · DepartureDesk" %>

<%= render "cruise_setup/shell", current: :cabins, page_title: "Add cabin categories" %>
<p>
  <%= link_to "Cabin inventory",
        departure_arrangement_cruise_cabin_categories_path(@departure, @supplier_arrangement),
        class: "dd-link" %>
</p>
<p class="dd-page-description">Enter the cabin categories the Supplier is holding for this group.</p>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with url: departure_arrangement_cruise_cabin_categories_path(@departure, @supplier_arrangement),
      method: :post,
      class: "dd-form dd-stack",
      data: { controller: "cabin-category-batch" } do %>
      <%= hidden_field_tag :version_lock_version, @version_lock_version %>

      <% if @form_error.present? %>
        <div id="form-error-summary" class="dd-form-error-summary" role="alert" tabindex="-1">
          <h2 class="dd-form-error-summary__title">Please fix the following:</h2>
          <ul><li><%= @form_error %></li></ul>
        </div>
      <% end %>

      <div class="dd-table-wrap">
        <table class="dd-table dd-cabin-table">
          <thead>
            <tr>
              <th scope="col">Code</th>
              <th scope="col">Cabin category</th>
              <th scope="col">Sleeps</th>
              <th scope="col">Inventory</th>
              <th scope="col">Cabins</th>
              <th scope="col"><span class="dd-visually-hidden">Remove</span></th>
            </tr>
          </thead>
          <tbody data-cabin-category-batch-target="rows">
            <% @cabin_rows.each_with_index do |row, index| %>
              <%= render "cruise_cabin_categories/row", row: row, index: index %>
            <% end %>
          </tbody>
        </table>
      </div>

      <template data-cabin-category-batch-target="template">
        <%= render "cruise_cabin_categories/row", row: SaveCruiseCabinCategoryBatch.blank_row.with(idempotency_key: "__KEY__"), index: "new" %>
      </template>

      <div class="dd-form-actions">
        <button type="button" class="dd-button dd-button--quiet" data-action="cabin-category-batch#add">Add category</button>
        <%= submit_tag "Save cabin categories", name: "commit", class: "dd-button" %>
        <%= link_to "Cancel",
              departure_arrangement_cruise_cabin_categories_path(@departure, @supplier_arrangement),
              class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
