<% content_for :title, "New choice · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Package", departure_offerings_path(@departure) ], [ "New choice", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Package · <%= @departure.name %></p>
    <h1 class="dd-page-title">New choice</h1>
    <p class="dd-page-description">Included services are chosen once; add-ons only add a service. A fixed included service is a required choice with one option.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @choice, url: departure_offering_choices_path(@departure, @offering), scope: :offering_choice, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= render "form", form:, presets: true %>
      <div class="dd-form-actions">
        <%= form.submit "Save", class: "dd-button" %>
        <%= link_to "Cancel", departure_offerings_path(@departure), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
