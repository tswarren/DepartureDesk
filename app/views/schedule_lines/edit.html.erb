<% content_for :title, "Edit supplier payment · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Departures", departures_path ], [ @departure.display_reference, departure_path(@departure) ], [ "Suppliers", departure_arrangements_path(@departure) ], [ @arrangement.arrangement_reference, departure_arrangement_path(@departure, @arrangement) ], [ "Edit payment", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">When you pay · <%= @arrangement.supplier.display_name_for_directory %></p>
    <h1 class="dd-page-title">Edit supplier payment</h1>
    <p class="dd-page-description">A payment is fixed once an amount posts from it.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @schedule_line, url: departure_arrangement_schedule_line_path(@departure, @arrangement, @schedule_line), method: :patch, scope: :schedule_line, class: "dd-form", data: { controller: "unsaved-changes" } do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= form.hidden_field :lock_version %>
      <%= render "form", form:, arrangement: @arrangement, schedule_line: @schedule_line, values: @values %>
      <div class="dd-form-actions">
        <%= form.submit "Save", class: "dd-button" %>
        <%= link_to "Cancel", departure_arrangement_payments_path(@departure, @arrangement, anchor: "supplier-payments"), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
