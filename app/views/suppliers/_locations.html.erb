<article class="dd-panel">
  <header class="dd-panel-header">
    <h2 class="dd-panel-title">Locations</h2>
    <% if manage && @supplier.active? %>
      <%= link_to "Add", new_supplier_location_path(@supplier), class: "dd-button dd-button--quiet" %>
    <% end %>
  </header>
  <% if records.any? %>
    <table class="dd-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <% if contact_details %>
            <th scope="col">Locality</th>
          <% end %>
          <th scope="col">Timezone</th>
          <th scope="col">Status</th>
          <% if manage %>
            <th scope="col">Actions</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% records.each do |location| %>
          <tr class="<%= "is-inactive" unless location.active? %>">
            <td><%= link_to location.name, supplier_location_path(@supplier, location) %></td>
            <% if contact_details %>
              <td><%= location.address_locality.presence || "—" %></td>
            <% end %>
            <td><%= location.timezone.presence || "—" %></td>
            <td><%= directory_status_badge(location.status) %></td>
            <% if manage %>
              <td>
                <div class="dd-inline-actions">
                  <%= link_to "Edit", edit_supplier_location_path(@supplier, location), class: "dd-row-action dd-row-action--edit" %>
                </div>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="dd-panel-body">
      <p class="<%= empty_state_classes.join(" ") %>">No locations yet.</p>
    </div>
  <% end %>
</article>
