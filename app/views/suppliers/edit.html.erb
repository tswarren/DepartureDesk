<% content_for :title, "Edit #{@supplier.display_name_for_directory} · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Suppliers</p>
    <h1 class="dd-page-title">Edit supplier</h1>
    <p class="dd-page-description"><%= @supplier.display_name_for_directory %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @supplier, class: "dd-form" do |form| %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save supplier", class: "dd-button" %>
        <%= link_to "Cancel", supplier_path(@supplier), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
