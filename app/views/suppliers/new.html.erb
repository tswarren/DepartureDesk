<% content_for :title, "New Supplier · DepartureDesk" %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Suppliers</p>
    <h1 class="dd-page-title">New supplier</h1>
    <p class="dd-page-description">Creates a supplier directory record for future contracting and settlement work.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @supplier, class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save supplier", class: "dd-button" %>
        <%= link_to "Cancel", suppliers_path, class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
