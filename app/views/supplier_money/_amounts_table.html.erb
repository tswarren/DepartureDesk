<%# Amounts due (SMN-05): open until payments arrive in build step 8. %>
<%# locals: (amounts:, show_supplier:) -%>
<div class="dd-table-wrap">
  <table class="dd-table dd-stacked-table">
    <caption class="dd-visually-hidden">Amounts due by due date</caption>
    <thead>
      <tr>
        <th scope="col">Due</th>
        <% if show_supplier %><th scope="col">Supplier</th><% end %>
        <th scope="col">Amount due</th>
        <th scope="col">Source</th>
        <th scope="col" class="num">Amount</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      <% amounts.each do |amount| %>
        <tr>
          <td><%= stacked_label("Due") %><%= amount.due_on.to_fs(:long) %></td>
          <% if show_supplier %><td><%= stacked_label("Supplier") %><%= amount.supplier_arrangement.supplier.display_name_for_directory %></td><% end %>
          <th scope="row"><%= amount.description %></th>
          <td><%= stacked_label("Source") %><%= amount_due_source(amount) %></td>
          <td class="num"><%= stacked_label("Amount") %><%= money(amount.amount_minor_units, amount.currency) %></td>
          <td><%= stacked_label("Status") %><%= status_badge("Open", modifier: "warning") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
