<% content_for :title, "Sign in · DepartureDesk" %>

<% if alert = flash[:alert] %>
  <p class="dd-alert dd-alert--danger" role="alert"><%= alert %></p>
<% end %>

<% if notice = flash[:notice] %>
  <p class="dd-alert dd-alert--success" role="status"><%= notice %></p>
<% end %>

<h1>Sign in</h1>
<p class="dd-auth-intro">Continue to your agency workspace.</p>

<%= form_with url: session_url, class: "dd-form" do |form| %>
  <div class="dd-field-group">
    <%= form.label :workspace_code, "Workspace code", class: "dd-label" %>
    <%= form.text_field :workspace_code,
      required: true,
      autofocus: true,
      autocomplete: "organization",
      placeholder: "harbor",
      value: params[:workspace_code],
      class: "dd-field" %>
  </div>

  <div class="dd-field-group">
    <%= form.label :email_address, "Email address", class: "dd-label" %>
    <%= form.email_field :email_address,
      required: true,
      autocomplete: "username",
      placeholder: "you@example.com",
      value: params[:email_address],
      class: "dd-field" %>
  </div>

  <div class="dd-field-group">
    <%= form.label :password, class: "dd-label" %>
    <%= form.password_field :password,
      required: true,
      autocomplete: "current-password",
      maxlength: 72,
      class: "dd-field" %>
  </div>

  <div class="dd-form-actions">
    <%= form.submit "Sign in", class: "dd-button" %>
    <%= link_to "Forgot password?", new_password_path, class: "dd-auth-link" %>
  </div>
<% end %>
