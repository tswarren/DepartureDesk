<% content_for :title, "New payee account · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Suppliers", suppliers_path ], [ @supplier.display_name_for_directory, supplier_path(@supplier) ], [ "New payee account", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Suppliers</p>
    <h1 class="dd-page-title">New payee account</h1>
    <p class="dd-page-description"><%= @supplier.display_name_for_directory %></p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @payee_account, url: supplier_payee_accounts_path(@supplier), class: "dd-form", data: { controller: "unsaved-changes" } do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <%= form.hidden_field :lock_version if form.object.persisted? %>
      <%= render "form", form: form %>
      <div class="dd-form-actions">
        <%= form.submit "Save payee account", class: "dd-button" %>
        <%= link_to "Cancel", supplier_path(@supplier), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
