<% successor = @supplier_arrangement.active? && @supplier_arrangement_version.draft? %>
<% content_for :title, "#{successor ? "Activate successor" : "Activate"} #{@supplier_arrangement.name} · DepartureDesk" %>
<% manageable = Current.agency_user.permitted?(:manage_departures) %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Supplier planning</p>
    <h1 class="dd-page-title"><%= successor ? "Activate successor" : "Activate arrangement" %></h1>
    <p class="dd-page-description"><%= @supplier_arrangement.name %> · exact version <%= @supplier_arrangement_version.version_number %></p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Back to arrangement", departure_arrangement_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
  </div>
</header>

<%= render "shared/form_errors", object: @command_form if @command_form&.errors&.any? %>

<article class="dd-panel">
  <header class="dd-panel-header">
    <div>
      <h2 class="dd-panel-title">Readiness</h2>
      <p>The checks run again inside the activation transaction.</p>
    </div>
  </header>
  <div class="dd-panel-body">
    <% if @readiness.ready? %>
      <p><strong>Ready for activation.</strong></p>
    <% else %>
      <ul class="dd-record-list">
        <% @readiness.blockers.each do |blocker| %>
          <li><strong><%= blocker.track.to_s.humanize %>:</strong> <%= blocker.message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</article>

<% if manageable %>
<%= form_with url: departure_arrangement_activation_path(@departure, @supplier_arrangement), method: :post do |form| %>
  <%= hidden_field_tag :idempotency_key, @idempotency_key %>
  <%= hidden_field_tag :arrangement_lock_version, @supplier_arrangement.lock_version %>
  <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
  <% if @acknowledgement_token.present? %>
    <%= hidden_field_tag :duplicate_acknowledgement_token, @acknowledgement_token %>
  <% elsif params[:duplicate_acknowledgement_token].present? %>
    <%= hidden_field_tag :duplicate_acknowledgement_token, params[:duplicate_acknowledgement_token] %>
  <% end %>

  <% if @acknowledgement_token.present? %>
    <div class="dd-alert dd-alert--warning" role="status">
      <p class="dd-alert-title">Matching Supplier identifiers</p>
      <p>Review the matching Supplier identifiers, then activate again to create this Arrangement identifier anyway.</p>
      <ul>
        <% Array(@duplicate_candidates).each do |candidate| %>
          <li><%= Array(candidate.signals).to_sentence %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <article class="dd-panel">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Activation checklist</h2>
        <p>One action records Agency activation, Supplier evidence, manifest, capacity, and deterministic commitments.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <dl class="dd-definition-list">
        <div>
          <dt>Structure and providers</dt>
          <dd><%= pluralize(@supplier_arrangement_version.arrangement_item_definitions.size, "retained Item") %></dd>
        </div>
        <div>
          <dt>Capacity consequences</dt>
          <% carried = @capacity_definitions.count { |entry| entry.capacity_pool.capacity_events.any? } %>
          <% established = @capacity_definitions.count { |entry| entry.capacity_pool.numeric_inventory? && entry.capacity_pool.capacity_events.empty? } %>
          <dd><%= pluralize(established, "numeric Pool") %> will be established; <%= pluralize(carried, "Pool") %> will be carried; <%= pluralize(@capacity_definitions.count { |entry| !entry.capacity_pool.numeric_inventory? }, "nonnumeric Pool") %> will be recorded.</dd>
        </div>
        <div>
          <dt>Entered cost sources</dt>
          <dd><%= @readiness.cost_selections.map { |source, definition| "#{source.label}: #{definition.stage.humanize}" }.presence&.to_sentence || "None" %></dd>
        </div>
        <div>
          <dt>Confirmation-triggered commitments</dt>
          <dd><%= pluralize(@triggers.count { |trigger| trigger.trigger_kind == "arrangement_confirmation" }, "predicted opening") %></dd>
        </div>
      </dl>

      <% arrangement_triggers = @triggers.select { |trigger| trigger.trigger_kind == "arrangement_confirmation" } %>
      <% if arrangement_triggers.any? %>
        <h3 class="dd-panel-title">Commitment consequence preview</h3>
        <div class="dd-table-wrap">
          <table class="dd-table">
            <thead>
              <tr>
                <th scope="col">Trigger</th>
                <th scope="col">Committed Supplier</th>
                <th scope="col">Authority</th>
                <th scope="col">Scope</th>
              </tr>
            </thead>
            <tbody>
              <% arrangement_triggers.each do |trigger| %>
                <tr>
                  <td><%= trigger.description.presence || trigger.authority_shape.humanize %></td>
                  <td><%= supplier_option_label(trigger.committed_supplier) %></td>
                  <td><%= trigger.authority_shape.humanize %></td>
                  <td>
                    <% if trigger.arrangement_item_id.present? %>
                      Item
                    <% elsif trigger.service_occurrence_id.present? %>
                      Occurrence
                    <% elsif trigger.supplier_resource_id.present? %>
                      Resource
                    <% elsif trigger.capacity_pool_id.present? %>
                      Capacity Pool
                    <% else %>
                      Arrangement-wide
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <div class="dd-field-group">
        <%= check_box_tag :cost_source_coverage_acknowledged, "1", params[:cost_source_coverage_acknowledged] == "1", required: true %>
        <%= label_tag :cost_source_coverage_acknowledged, "I confirm the entered cost-source list is complete.", class: "dd-label" %>
      </div>
      <% if @provisional_selections.any? %>
        <div class="dd-field-group">
          <p><strong>Provisional estimates:</strong> <%= @provisional_selections.map { |source, _definition| source.label }.to_sentence %></p>
          <%= check_box_tag :provisional_costs_acknowledged, "1", params[:provisional_costs_acknowledged] == "1", required: true %>
          <%= label_tag :provisional_costs_acknowledged, "I acknowledge these listed provisional estimate sources.", class: "dd-label" %>
        </div>
      <% end %>
      <div class="dd-field-group">
        <%= check_box_tag :commitment_trigger_coverage_acknowledged, "1", params[:commitment_trigger_coverage_acknowledged] == "1", required: true %>
        <%= label_tag :commitment_trigger_coverage_acknowledged, "I confirm known confirmation-triggered commitments are covered by the listed triggers.", class: "dd-label" %>
      </div>
      <% arrangement_triggers.select { |trigger|
           %w[confirmed_quantity contracted_unit_rate_times_confirmed_quantity].include?(trigger.authority_shape)
         }.each do |trigger| %>
        <div class="dd-field-group">
          <%= label_tag "confirmed_quantities_#{trigger.id}",
            "Supplier-confirmed quantity · #{trigger.description.presence || trigger.authority_shape.humanize}",
            class: "dd-label" %>
          <%= number_field_tag "confirmed_quantities[#{trigger.id}]",
            params.dig(:confirmed_quantities, trigger.id.to_s),
            **dd_tag_field_options(@command_form, :"confirmed_quantities_#{trigger.id}",
              id: "confirmed_quantities_#{trigger.id}", min: 1, step: 1, required: true) %>
        </div>
      <% end %>
      <% arrangement_triggers.select { |trigger| trigger.authority_shape == "confirmed_amount" }.each do |trigger| %>
        <div class="dd-field-group">
          <%= label_tag "confirmed_amounts_minor_units_#{trigger.id}",
            "Supplier-confirmed amount in minor units · #{trigger.description.presence || trigger.authority_shape.humanize}",
            class: "dd-label" %>
          <%= number_field_tag "confirmed_amounts_minor_units[#{trigger.id}]",
            params.dig(:confirmed_amounts_minor_units, trigger.id.to_s),
            **dd_tag_field_options(@command_form, :"confirmed_amounts_minor_units_#{trigger.id}",
              id: "confirmed_amounts_minor_units_#{trigger.id}", min: 0, step: 1, required: true) %>
          <p class="dd-field-hint">Currency: <%= @departure.operating_currency %>.</p>
        </div>
      <% end %>
    </div>
  </article>

  <article class="dd-panel">
    <header class="dd-panel-header">
      <div>
        <h2 class="dd-panel-title">Supplier confirmation</h2>
        <p>Create immutable evidence or explicitly reuse compatible exact-version evidence.</p>
      </div>
    </header>
    <div class="dd-panel-body">
      <% if @existing_confirmations.any? %>
        <div class="dd-field-group">
          <%= label_tag :existing_confirmation_id, "Existing compatible evidence", class: "dd-label" %>
          <%= select_tag :existing_confirmation_id,
            options_for_select([["Create new evidence", ""]] + @existing_confirmations.map { |entry| ["#{entry.evidence_on}: #{entry.reference_note}", entry.id] }, params[:existing_confirmation_id]),
            **dd_tag_field_options(@command_form, :existing_confirmation_id, id: "activation_existing_confirmation_id") %>
        </div>
      <% end %>
      <div class="dd-field-group">
        <%= label_tag "confirmation_evidence_kind", "Evidence kind", class: "dd-label" %>
        <%= select_tag "confirmation[evidence_kind]",
          options_for_select(SupplierConfirmation::EVIDENCE_KINDS.map { |kind| [kind.humanize, kind] }, params.dig(:confirmation, :evidence_kind)),
          **dd_tag_field_options(@command_form, :evidence_kind, id: "confirmation_evidence_kind", include_blank: "Choose evidence") %>
        <%= dd_tag_field_error(@command_form, :evidence_kind) %>
      </div>
      <div class="dd-field-group">
        <%= label_tag "confirmation_other_evidence_label", "Other evidence label", class: "dd-label" %>
        <%= text_field_tag "confirmation[other_evidence_label]", params.dig(:confirmation, :other_evidence_label),
          **dd_tag_field_options(@command_form, :other_evidence_label, id: "confirmation_other_evidence_label", maxlength: 80) %>
      </div>
      <div class="dd-field-group">
        <%= label_tag "confirmation_evidence_on", "Evidence date", class: "dd-label" %>
        <%= date_field_tag "confirmation[evidence_on]", params.dig(:confirmation, :evidence_on),
          **dd_tag_field_options(@command_form, :evidence_on, id: "confirmation_evidence_on") %>
        <%= dd_tag_field_error(@command_form, :evidence_on) %>
      </div>
      <div class="dd-field-group">
        <%= label_tag "confirmation_channel", "Channel", class: "dd-label" %>
        <%= text_field_tag "confirmation[channel]", params.dig(:confirmation, :channel),
          **dd_tag_field_options(@command_form, :channel, id: "confirmation_channel", maxlength: 80) %>
        <%= dd_tag_field_error(@command_form, :channel) %>
      </div>
      <div class="dd-field-group">
        <%= label_tag "confirmation_reference_note", "Safe reference note", class: "dd-label" %>
        <%= text_area_tag "confirmation[reference_note]", params.dig(:confirmation, :reference_note),
          **dd_tag_field_options(@command_form, :reference_note, id: "confirmation_reference_note", maxlength: 500) %>
      </div>
      <div class="dd-field-group">
        <%= label_tag "confirmation_confirmed_without_identifier_reason", "Confirmed without identifier reason", class: "dd-label" %>
        <%= text_area_tag "confirmation[confirmed_without_identifier_reason]", params.dig(:confirmation, :confirmed_without_identifier_reason),
          **dd_tag_field_options(@command_form, :confirmed_without_identifier_reason, id: "confirmation_confirmed_without_identifier_reason", maxlength: 500) %>
      </div>

      <details <%= "open".html_safe if @command_form&.errors&.any? { |e| e.attribute.to_s.start_with?("display_value", "identifier") } %>>
        <summary>Add a Supplier-issued identifier</summary>
        <div class="dd-field-group">
          <%= label_tag "identifier_identifier_type", "Identifier type", class: "dd-label" %>
          <%= select_tag "identifier[identifier_type]",
            options_for_select(SupplierIssuedIdentifier::IDENTIFIER_TYPES.map { |kind| [kind.humanize, kind] }, params.dig(:identifier, :identifier_type)),
            **dd_tag_field_options(@command_form, :identifier_type, id: "identifier_identifier_type", include_blank: "No identifier") %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "identifier_other_type_label", "Other identifier label", class: "dd-label" %>
          <%= text_field_tag "identifier[other_type_label]", params.dig(:identifier, :other_type_label),
            **dd_tag_field_options(@command_form, :other_type_label, id: "identifier_other_type_label", maxlength: 80) %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "identifier_issuer_context", "Issuer context", class: "dd-label" %>
          <%= text_field_tag "identifier[issuer_context]", params.dig(:identifier, :issuer_context),
            **dd_tag_field_options(@command_form, :issuer_context, id: "identifier_issuer_context", maxlength: 80) %>
        </div>
        <div class="dd-field-group">
          <%= label_tag "confirmation_display_value", "Identifier", class: "dd-label" %>
          <%= text_field_tag "identifier[display_value]", params.dig(:identifier, :display_value),
            **dd_tag_field_options(@command_form, :display_value, id: "confirmation_display_value", maxlength: 160) %>
          <%= dd_tag_field_error(@command_form, :display_value) %>
        </div>
      </details>
    </div>
  </article>

  <div class="dd-page-actions">
    <%= form.submit successor ? "Activate successor" : "Activate arrangement", class: "dd-button", disabled: !@readiness.ready? %>
  </div>
<% end %>
<% end %>
