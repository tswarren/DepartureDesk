<% content_for :title, "Activate #{@supplier_arrangement.name} · DepartureDesk" %>
<% sailing = @review.sailing %>
<% agreement = @review.agreement %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Cruise</p>
    <h1 class="dd-page-title">Review activation</h1>
    <%= render "cruise_arrangements/version_context", version: @supplier_arrangement_version %>
    <% if @supplier_arrangement_version&.draft? && @supplier_arrangement_version.copied_from_id.present? %>
      <p>Activating Draft Version <%= @supplier_arrangement_version.version_number %>. Active Version <%= @supplier_arrangement_version.copied_from.version_number %> remains in effect until activation succeeds.</p>
    <% end %>
    <p class="dd-page-description">
      <%= sailing[:supplier_name] %>
      · <%= sailing[:ship_name] %>
      · <%= sailing[:sailing_name] %>
      <% if sailing[:starts_on].present? %>
        · <%= sailing[:starts_on] %>–<%= sailing[:ends_on] %>
      <% end %>
      · Version <%= sailing[:version_number] %>
    </p>
  </div>
  <div class="dd-page-actions">
    <%= link_to "Back to Cruise overview", departure_arrangement_cruise_path(@departure, @supplier_arrangement), class: "dd-button dd-button--quiet" %>
    <%= link_to "Advanced Supplier planning", departure_arrangement_activation_path(@departure, @supplier_arrangement), class: "dd-button dd-button--secondary" %>
  </div>
</header>

<%= render "shared/form_errors", object: @command_form if @command_form&.errors&.any? %>

<% if @review.activated? %>
  <section class="dd-panel" aria-labelledby="cruise-activated-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="cruise-activated-heading" class="dd-panel-title">Cruise supplier arrangement activated</h2>
      <p>Version <%= sailing[:version_number] %> is now the governing Supplier Arrangement version.</p>
      <% if sailing[:successor?] && sailing[:governing_version_number].present? %>
        <p>The previous governing version remains preserved.</p>
      <% end %>
      <%= link_to "Connect to Client service",
            departure_arrangement_cruise_service_connection_path(@departure, @supplier_arrangement),
            class: "dd-button" %>
      <%= link_to "Return to Cruise overview",
            departure_arrangement_cruise_path(@departure, @supplier_arrangement),
            class: "dd-button dd-button--secondary" %>
    </div>
  </section>
<% else %>
  <section class="dd-panel" aria-labelledby="cruise-sailing-heading">
    <div class="dd-panel-body">
      <h2 id="cruise-sailing-heading" class="dd-panel-title">Cruise</h2>
      <dl class="dd-fact-grid">
        <div><dt>Supplier</dt><dd><%= sailing[:supplier_name] %></dd></div>
        <div><dt>Ship</dt><dd><%= sailing[:ship_name] %></dd></div>
        <div><dt>Sailing</dt><dd><%= sailing[:sailing_name] %></dd></div>
        <div><dt>Dates</dt><dd><%= sailing[:starts_on] %>–<%= sailing[:ends_on] %></dd></div>
        <div><dt>Arrangement version</dt><dd><%= sailing[:version_number] %></dd></div>
        <% if agreement[:group_reference].present? %>
          <div><dt>Supplier group reference</dt><dd><%= agreement[:group_reference] %></dd></div>
        <% end %>
        <% if sailing[:successor?] %>
          <div>
            <dt>Version under review</dt>
            <dd>Proposed successor. Version <%= sailing[:governing_version_number] %> is governing until this successor is activated.</dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <section class="dd-panel" aria-labelledby="cruise-cabins-heading">
    <div class="dd-panel-body">
      <h2 id="cruise-cabins-heading" class="dd-panel-title">Cabin inventory</h2>
      <% if @review.cabins.any? %>
        <table>
          <thead>
            <tr>
              <th scope="col">Cabin category</th>
              <th scope="col">Inventory</th>
              <th scope="col">Opening quantity</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @review.cabins.each do |cabin| %>
              <tr>
                <th scope="row"><%= cabin.code %> — <%= cabin.name %></th>
                <td><%= cabin.inventory_label %></td>
                <td><%= cabin.quantity_label %></td>
                <td><%= cabin.status_label %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>Cabin inventory cannot be listed on this review.</p>
      <% end %>
    </div>
  </section>

  <section class="dd-panel" aria-labelledby="cruise-rates-heading">
    <div class="dd-panel-body">
      <h2 id="cruise-rates-heading" class="dd-panel-title">Supplier rates</h2>
      <% if @review.cost_rows.any? %>
        <table>
          <thead>
            <tr>
              <th scope="col">Supplier cost</th>
              <th scope="col">Stage</th>
            </tr>
          </thead>
          <tbody>
            <% @review.cost_rows.each do |row| %>
              <tr>
                <th scope="row"><%= row.label %></th>
                <td><%= row.stage_label %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>No selected Supplier cost source.</p>
      <% end %>
    </div>
  </section>

  <section class="dd-panel" aria-labelledby="cruise-requirements-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="cruise-requirements-heading" class="dd-panel-title">Agreement and requirements</h2>
      <p>Supplier agreement: <%= agreement[:status_label] %><% if agreement[:contract_date].present? %>. Contract date <%= agreement[:contract_date] %><% end %><% if agreement[:group_reference].present? %>. Group reference <%= agreement[:group_reference] %><% end %>.</p>
      <% @review.requirements.each do |requirement| %>
        <h3><%= requirement.label %></h3>
        <p><%= requirement.detail %></p>
      <% end %>
    </div>
  </section>

  <section class="dd-panel" aria-labelledby="cruise-status-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="cruise-status-heading" class="dd-panel-title">Activation status</h2>
      <% if @review.blockers.any? %>
        <p><strong>This Cruise isn't ready to activate.</strong> <%= pluralize(@review.blockers.size, "item") %> <%= @review.blockers.one? ? "needs" : "need" %> attention.</p>
        <ul>
          <% @review.blockers.each do |blocker| %>
            <li>
              <p><%= blocker.message %></p>
              <% case blocker.destination %>
              <% when :cabin_categories %>
                <%= link_to "Review cabin categories",
                      blocker.resource_id.present? ? edit_departure_arrangement_cruise_cabin_category_path(@departure, @supplier_arrangement, blocker.resource_id) : departure_arrangement_cruise_path(@departure, @supplier_arrangement, anchor: "cruise-cabins") %>
              <% when :supplier_rates %>
                <%= link_to "Review Supplier rates",
                      blocker.resource_id.present? ? departure_arrangement_cruise_cabin_category_supplier_rates_path(@departure, @supplier_arrangement, blocker.resource_id) : departure_arrangement_cruise_path(@departure, @supplier_arrangement, anchor: "cruise-rates") %>
              <% when :agreement %>
                <%= link_to "Review Supplier agreement", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement) %>
              <% else %>
                <%= link_to "Review in Advanced Supplier planning", departure_arrangement_activation_path(@departure, @supplier_arrangement) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% elsif @review.cruise_post_allowed? %>
        <p><strong>This Cruise can be activated from this review.</strong> Authoritative readiness has no blockers, and this review can represent the activation contract.</p>
      <% else %>
        <p><strong>Use Advanced Supplier planning.</strong> This review cannot safely post the activation command.</p>
        <% @review.unsupported_reasons.each do |reason| %>
          <p><%= reason %></p>
        <% end %>
        <% if @review.cost_rows.any? { |row| row.stage_label == "Estimate" } %>
          <p>A selected Supplier cost is an estimate. This Cruise review will not acknowledge an estimate.</p>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="dd-panel" aria-labelledby="cruise-consequences-heading">
    <div class="dd-panel-body">
      <h2 id="cruise-consequences-heading" class="dd-panel-title">What activation will do</h2>
      <ul>
        <% @review.consequences.each do |sentence| %>
          <li><%= sentence %></li>
        <% end %>
      </ul>
      <% if @review.triggers.empty? %>
        <p>No confirmation-triggered commitments are declared.</p>
      <% else %>
        <h3>Confirmation triggers</h3>
        <ul>
          <% @review.triggers.each do |trigger| %>
            <li><%= trigger.description %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>

  <% if @review.cruise_post_allowed? && Current.agency_user.permitted?(:manage_departures) %>
    <%= form_with url: departure_arrangement_cruise_activation_path(@departure, @supplier_arrangement), method: :post do %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
      <%= hidden_field_tag :arrangement_lock_version, @supplier_arrangement.lock_version %>
      <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
      <% if @elapsed_review_token.present? %>
        <%= hidden_field_tag :elapsed_review_token, @elapsed_review_token %>
      <% end %>
      <% if @acknowledgement_token.present? %>
        <%= hidden_field_tag :duplicate_acknowledgement_token, @acknowledgement_token %>
      <% end %>

      <% if @acknowledgement_token.present? %>
        <div class="dd-alert dd-alert--warning" role="status">
          <p class="dd-alert-title">Matching Supplier identifiers</p>
          <p>Review the matching Supplier identifiers, then activate again to create this identifier anyway.</p>
          <ul>
            <% Array(@duplicate_candidates).each do |candidate| %>
              <li><%= Array(candidate.signals).to_sentence %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @review.elapsed.any? %>
        <section class="dd-panel" aria-labelledby="cruise-elapsed-heading">
          <div class="dd-panel-body dd-stack">
            <h2 id="cruise-elapsed-heading" class="dd-panel-title">A Supplier requirement is already past due</h2>
            <ul>
              <% @review.elapsed.each do |row| %>
                <li><%= row.label %><% if row.due_label.present? %> — due <%= row.due_label %><% end %></li>
              <% end %>
            </ul>
            <p>Activating this Cruise will open each listed requirement as already overdue.</p>
            <div class="dd-field-group">
              <%= check_box_tag :elapsed_deadlines_acknowledged, "1", params[:elapsed_deadlines_acknowledged] == "1" %>
              <%= label_tag :elapsed_deadlines_acknowledged, "I understand these requirements are already overdue and want to activate these terms.", class: "dd-label" %>
            </div>
          </div>
        </section>
      <% end %>

      <% @review.triggers.select(&:needs_quantity?).each do |trigger| %>
        <div class="dd-field-group">
          <%= label_tag "confirmed_quantities_#{trigger.id}", "Supplier-confirmed quantity · #{trigger.description}", class: "dd-label" %>
          <%= number_field_tag "confirmed_quantities[#{trigger.id}]", params.dig(:confirmed_quantities, trigger.id.to_s), min: 1, step: 1, required: true, id: "confirmed_quantities_#{trigger.id}" %>
        </div>
      <% end %>
      <% @review.triggers.select(&:needs_amount?).each do |trigger| %>
        <div class="dd-field-group">
          <%= label_tag "confirmed_amounts_#{trigger.id}", "Supplier-confirmed amount in minor units · #{trigger.description}", class: "dd-label" %>
          <%= number_field_tag "confirmed_amounts_minor_units[#{trigger.id}]", params.dig(:confirmed_amounts_minor_units, trigger.id.to_s), min: 0, step: 1, required: true, id: "confirmed_amounts_#{trigger.id}" %>
        </div>
      <% end %>

      <section class="dd-panel" aria-labelledby="cruise-evidence-heading">
        <div class="dd-panel-body dd-stack">
          <h2 id="cruise-evidence-heading" class="dd-panel-title">Supplier confirmation evidence</h2>
          <p>Record or reuse the Supplier evidence supporting activation of these terms. The Cruise agreement confirmation is a separate record.</p>
          <% if @existing_confirmations.any? %>
            <div class="dd-field-group">
              <%= label_tag :existing_confirmation_id, "Existing compatible evidence", class: "dd-label" %>
              <%= select_tag :existing_confirmation_id,
                    options_for_select([["Create new evidence", ""]] + @existing_confirmations.map { |entry| [ "#{entry.evidence_on}: #{entry.reference_note}", entry.id ] }, params[:existing_confirmation_id]),
                    id: "activation_existing_confirmation_id" %>
            </div>
          <% end %>
          <div class="dd-field-group">
            <%= label_tag "confirmation_evidence_kind", "Evidence kind", class: "dd-label" %>
            <%= select_tag "confirmation[evidence_kind]",
                  options_for_select(SupplierConfirmation::BOOKING_EVIDENCE_KINDS.map { |kind| [ kind.humanize, kind ] }, params.dig(:confirmation, :evidence_kind)),
                  include_blank: "Choose evidence", id: "confirmation_evidence_kind" %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "confirmation_evidence_on", "Evidence date", class: "dd-label" %>
            <%= date_field_tag "confirmation[evidence_on]", params.dig(:confirmation, :evidence_on), id: "confirmation_evidence_on" %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "confirmation_channel", "Channel", class: "dd-label" %>
            <%= text_field_tag "confirmation[channel]", params.dig(:confirmation, :channel), id: "confirmation_channel", maxlength: 80 %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "confirmation_reference_note", "Reference note", class: "dd-label" %>
            <%= text_area_tag "confirmation[reference_note]", params.dig(:confirmation, :reference_note), id: "confirmation_reference_note", maxlength: 500 %>
          </div>
          <div class="dd-field-group">
            <%= label_tag "confirmation_confirmed_without_identifier_reason", "Reason no Supplier identifier was issued", class: "dd-label" %>
            <%= text_area_tag "confirmation[confirmed_without_identifier_reason]", params.dig(:confirmation, :confirmed_without_identifier_reason), id: "confirmation_confirmed_without_identifier_reason", maxlength: 500 %>
          </div>
          <details <%= "open".html_safe if @command_form&.errors&.any? { |error| %w[display_value identifier_type issuer_context other_type_label].include?(error.attribute.to_s) } %>>
            <summary>Add a Supplier-issued identifier</summary>
            <div class="dd-field-group">
              <%= label_tag "identifier_identifier_type", "Identifier type", class: "dd-label" %>
              <%= select_tag "identifier[identifier_type]",
                    options_for_select([[ "No identifier", "" ]] + SupplierIssuedIdentifier::IDENTIFIER_TYPES.map { |kind| [ kind.humanize, kind ] }, params.dig(:identifier, :identifier_type)),
                    id: "identifier_identifier_type" %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "identifier_other_type_label", "Other identifier label", class: "dd-label" %>
              <%= text_field_tag "identifier[other_type_label]", params.dig(:identifier, :other_type_label), id: "identifier_other_type_label", maxlength: 80 %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "identifier_issuer_context", "Issuer context", class: "dd-label" %>
              <%= text_field_tag "identifier[issuer_context]", params.dig(:identifier, :issuer_context), id: "identifier_issuer_context", maxlength: 80 %>
              <% if @command_form&.errors&.[](:issuer_context)&.any? %>
                <p class="dd-field-error" id="identifier_issuer_context_error"><%= @command_form.errors[:issuer_context].to_sentence %></p>
              <% end %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "confirmation_display_value", "Identifier", class: "dd-label" %>
              <%= text_field_tag "identifier[display_value]", params.dig(:identifier, :display_value), id: "confirmation_display_value", maxlength: 160 %>
            </div>
          </details>
          <div class="dd-page-actions">
            <%= submit_tag "Activate Cruise supplier arrangement", class: "dd-button" %>
          </div>
        </div>
      </section>
    <% end %>
  <% end %>
<% end %>
