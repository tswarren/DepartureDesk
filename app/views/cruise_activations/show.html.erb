<% content_for :title, "Review & activate #{@supplier_arrangement.name} · DepartureDesk" %>
<% navigation = cruise_setup_navigation %>
<% review_status = navigation.areas.find { |area| area.key == :review }.status %>
<% setup_areas = navigation.areas.reject { |area| area.key == :review } %>

<%= render "cruise_setup/shell", current: :review, page_title: "Review & activate" %>

<p id="cruise-activation-status"><%= review_status %></p>

<section class="dd-panel" aria-labelledby="cruise-activation-setup-heading">
  <div class="dd-panel-body">
    <h2 id="cruise-activation-setup-heading" class="dd-panel-title">Supplier setup</h2>
    <ul id="cruise-activation-setup">
      <% setup_areas.each do |area| %>
        <li>
          <% if cruise_setup_area_available?(area) %>
            <%= link_to area.label, cruise_setup_area_path(area, @supplier_arrangement_version) %>
          <% else %>
            <%= area.label %>
          <% end %>
          <span><%= area.status %></span>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<%= render "shared/form_errors", object: @command_form if @command_form&.errors&.any? %>

<% if @review.activated? %>
  <section class="dd-panel" aria-labelledby="cruise-activated-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="cruise-activated-heading" class="dd-panel-title">Supplier terms are active</h2>
      <p>Version <%= @supplier_arrangement_version.version_number %> became governing<% if @activation %> on <%= cruise_activation_recorded_on(@activation) %><% end %>.</p>
      <% if @activation %>
        <p>Activated by <%= @activation.actor.display_name %>.</p>
        <% identifier = cruise_activation_identifier(@activation) %>
        <% if identifier.present? %>
          <p>Supplier-issued identifier <%= identifier %></p>
        <% end %>
      <% end %>
      <%= link_to "Connect to Client service",
            departure_arrangement_cruise_service_connection_path(@departure, @supplier_arrangement),
            class: "dd-button" %>
      <%= link_to "Return to Cruise overview",
            departure_arrangement_cruise_path(@departure, @supplier_arrangement),
            class: "dd-button dd-button--secondary" %>
    </div>
  </section>
<% elsif review_status == "Needs attention" %>
  <section class="dd-panel" aria-labelledby="cruise-attention-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="cruise-attention-heading" class="dd-panel-title">Needs attention</h2>
      <ul>
        <% cabins_complete = navigation.areas.find { |area| area.key == :cabins }.status == "Complete" %>
        <% rates_complete = navigation.areas.find { |area| area.key == :rates }.status == "Complete" %>
        <% @review.blockers.each do |blocker| %>
          <% next if blocker.code == :opening_authority_incomplete && cabins_complete %>
          <% next if blocker.code == :cruise_contracted_rates_missing && rates_complete %>
          <li>
            <p><%= blocker.message %></p>
            <% destination = cruise_activation_blocker_path(blocker) %>
            <% if destination %>
              <%= link_to cruise_activation_blocker_label(blocker), destination %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% elsif review_status == "Ready to review" %>
  <section class="dd-panel" aria-labelledby="cruise-consequences-heading">
    <div class="dd-panel-body">
      <h2 id="cruise-consequences-heading" class="dd-panel-title">What activation will do</h2>
      <ul>
        <% @review.consequences.each do |sentence| %>
          <li><%= sentence %></li>
        <% end %>
      </ul>
      <% if @review.triggers.empty? %>
        <p>No confirmation-triggered commitments are declared.</p>
      <% else %>
        <h3>Confirmation triggers</h3>
        <ul>
          <% @review.triggers.each do |trigger| %>
            <li><%= trigger.description %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>

  <% if Current.agency_user.permitted?(:manage_departures) %>
    <%= form_with url: departure_arrangement_cruise_activation_path(@departure, @supplier_arrangement), method: :post do %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
      <%= hidden_field_tag :arrangement_lock_version, @supplier_arrangement.lock_version %>
      <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
      <% if @elapsed_review_token.present? %>
        <%= hidden_field_tag :elapsed_review_token, @elapsed_review_token %>
      <% end %>
      <% if @acknowledgement_token.present? %>
        <%= hidden_field_tag :duplicate_acknowledgement_token, @acknowledgement_token %>
      <% end %>

      <% if @acknowledgement_token.present? %>
        <div class="dd-alert dd-alert--warning" role="status">
          <p class="dd-alert-title">Matching Supplier identifiers</p>
          <p>Review the matching Supplier identifiers, then activate again to create this identifier anyway.</p>
          <ul>
            <% Array(@duplicate_candidates).each do |candidate| %>
              <li><%= Array(candidate.signals).to_sentence %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @review.elapsed.any? %>
        <section class="dd-panel" aria-labelledby="cruise-elapsed-heading">
          <div class="dd-panel-body dd-stack">
            <h2 id="cruise-elapsed-heading" class="dd-panel-title">A Supplier requirement is already past due</h2>
            <ul>
              <% @review.elapsed.each do |row| %>
                <li><%= row.label %><% if row.due_label.present? %> — due <%= row.due_label %><% end %></li>
              <% end %>
            </ul>
            <p>Activating this Cruise will open each listed requirement as already overdue.</p>
            <div class="dd-field-group">
              <%= check_box_tag :elapsed_deadlines_acknowledged, "1", params[:elapsed_deadlines_acknowledged] == "1" %>
              <%= label_tag :elapsed_deadlines_acknowledged, "I reviewed these elapsed Supplier requirements.", class: "dd-label" %>
            </div>
          </div>
        </section>
      <% end %>

      <% @review.triggers.select(&:needs_quantity?).each do |trigger| %>
        <div class="dd-field-group">
          <%= label_tag "confirmed_quantities_#{trigger.id}", "Supplier-confirmed quantity · #{trigger.description}", class: "dd-label" %>
          <%= number_field_tag "confirmed_quantities[#{trigger.id}]", params.dig(:confirmed_quantities, trigger.id.to_s), min: 1, step: 1, required: true, id: "confirmed_quantities_#{trigger.id}" %>
        </div>
      <% end %>
      <% @review.triggers.select(&:needs_amount?).each do |trigger| %>
        <div class="dd-field-group">
          <%= label_tag "confirmed_amounts_#{trigger.id}", "Supplier-confirmed amount in minor units · #{trigger.description}", class: "dd-label" %>
          <%= number_field_tag "confirmed_amounts_minor_units[#{trigger.id}]", params.dig(:confirmed_amounts_minor_units, trigger.id.to_s), min: 0, step: 1, required: true, id: "confirmed_amounts_#{trigger.id}" %>
        </div>
      <% end %>

      <section class="dd-panel" aria-labelledby="cruise-terms-heading">
        <div class="dd-panel-body dd-stack">
          <h2 id="cruise-terms-heading" class="dd-panel-title">Terms to confirm</h2>
          <h3>Cabin inventory</h3>
          <table class="dd-table">
            <thead>
              <tr>
                <th scope="col">Category</th>
                <th scope="col">Treatment</th>
                <th scope="col">Quantity</th>
              </tr>
            </thead>
            <tbody>
              <% @review.cabins.each do |cabin| %>
                <tr>
                  <td><%= cabin.name %></td>
                  <td><%= cabin.inventory_label %></td>
                  <td><%= cabin.numeric? ? cabin.quantity_label : "Quantity not tracked" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <h3>Contracted rates</h3>
          <table class="dd-table">
            <thead>
              <tr>
                <th scope="col">Category</th>
                <th scope="col">Contracted terms</th>
              </tr>
            </thead>
            <tbody>
              <% @review.cabins.each do |cabin| %>
                <tr>
                  <td><%= cabin.name %></td>
                  <td><%= cabin.charges_label %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>

      <div class="dd-field-group">
        <%= check_box_tag :terms_acknowledged, "1", params[:terms_acknowledged] == "1", required: true, id: "terms_acknowledged" %>
        <%= label_tag :terms_acknowledged, "The inventory and rates shown are the Supplier agreement being activated for this exact version.", class: "dd-label" %>
      </div>

      <section class="dd-panel" aria-labelledby="cruise-evidence-heading" data-controller="cruise-activation-proof">
        <div class="dd-panel-body dd-stack">
          <h2 id="cruise-evidence-heading" class="dd-panel-title">Supplier proof</h2>
          <p>Record or reuse the Supplier evidence supporting activation of these terms. The Cruise agreement confirmation is a separate record.</p>
          <% if @existing_confirmations.any? %>
            <fieldset>
              <legend class="dd-label">Supplier proof</legend>
              <label>
                <%= radio_button_tag :proof_choice, "reuse", params[:proof_choice] != "new", data: { action: "cruise-activation-proof#toggle" } %>
                Reuse Supplier proof
              </label>
              <label>
                <%= radio_button_tag :proof_choice, "new", params[:proof_choice] == "new", data: { action: "cruise-activation-proof#toggle" } %>
                Record new Supplier proof
              </label>
            </fieldset>
            <div data-cruise-activation-proof-target="reuse">
              <div class="dd-field-group">
                <%= label_tag :existing_confirmation_id, "Existing compatible evidence", class: "dd-label" %>
                <%= select_tag :existing_confirmation_id,
                      options_for_select(@existing_confirmations.map { |entry| [ supplier_confirmation_choice_label(entry), entry.id ] }, params[:existing_confirmation_id]),
                      id: "activation_existing_confirmation_id" %>
              </div>
            </div>
          <% end %>
          <div data-cruise-activation-proof-target="fresh">
            <div class="dd-field-group">
              <%= label_tag "confirmation_evidence_kind", "Proof type", class: "dd-label" %>
              <%= select_tag "confirmation[evidence_kind]",
                    options_for_select(SupplierConfirmation::BOOKING_EVIDENCE_KINDS.map { |kind| [ kind.humanize, kind ] }, params.dig(:confirmation, :evidence_kind)),
                    include_blank: "Choose proof", id: "confirmation_evidence_kind",
                    data: { cruise_activation_proof_target: "kind", action: "cruise-activation-proof#toggle" } %>
            </div>
            <div class="dd-field-group" data-cruise-activation-proof-target="other" hidden>
              <%= label_tag "confirmation_other_evidence_label", "Other proof description", class: "dd-label" %>
              <%= text_field_tag "confirmation[other_evidence_label]", params.dig(:confirmation, :other_evidence_label), id: "confirmation_other_evidence_label", maxlength: 80 %>
            </div>
            <div class="dd-field-group">
              <%= label_tag :supplier_reference, "Supplier reference", class: "dd-label" %>
              <%= text_field_tag :supplier_reference, supplier_reference_value, id: "supplier_reference", maxlength: 160 %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "confirmation_evidence_on", "Proof date", class: "dd-label" %>
              <%= date_field_tag "confirmation[evidence_on]", params.dig(:confirmation, :evidence_on), id: "confirmation_evidence_on" %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "confirmation_channel", "Channel", class: "dd-label" %>
              <%= text_field_tag "confirmation[channel]", params.dig(:confirmation, :channel), id: "confirmation_channel", maxlength: 80 %>
            </div>
            <div class="dd-field-group">
              <%= label_tag "confirmation_reference_note", "Notes", class: "dd-label" %>
              <%= text_area_tag "confirmation[reference_note]", params.dig(:confirmation, :reference_note), id: "confirmation_reference_note", maxlength: 500 %>
            </div>
          </div>
          <% if Current.agency_user.permitted?(:override_supplier_planning_terms) %>
            <% overridable = @review.cabins.select { |cabin| cabin.numeric? && cabin.pool_definition_id && !cabin.opening_authority? && cabin.quantity_label.to_i.positive? } %>
            <% if overridable.any? %>
              <fieldset>
                <legend class="dd-label">Administrator override</legend>
                <p>Use an override only when ordinary Supplier proof should not establish opening authority for a named cabin.</p>
                <% overridable.each do |cabin| %>
                  <div class="dd-field-group">
                    <%= label_tag "opening_override_#{cabin.pool_definition_id}", "Override explanation · #{cabin.name}", class: "dd-label" %>
                    <%= text_area_tag "opening_overrides[#{cabin.pool_definition_id}]", params.dig(:opening_overrides, cabin.pool_definition_id.to_s), id: "opening_override_#{cabin.pool_definition_id}", maxlength: CapacityPoolDefinition::OVERRIDE_REASON_LIMIT %>
                  </div>
                <% end %>
              </fieldset>
            <% end %>
          <% end %>
          <div class="dd-page-actions">
            <% if @supplier_arrangement_version&.draft? && @supplier_arrangement_version.copied_from_id.present? %>
              <p>Activating Draft Version <%= @supplier_arrangement_version.version_number %>. Active Version <%= @supplier_arrangement_version.copied_from.version_number %> remains in effect until activation succeeds.</p>
            <% end %>
            <%= submit_tag "Confirm and activate group", class: "dd-button" %>
          </div>
        </div>
      </section>
    <% end %>
  <% end %>
<% else %>
  <section class="dd-panel" aria-labelledby="cruise-advanced-heading">
    <div class="dd-panel-body dd-stack">
      <h2 id="cruise-advanced-heading" class="dd-panel-title">Requires Advanced</h2>
      <% if @review.blockers.any? %>
        <p>This screen cannot represent every activation requirement.</p>
        <ul>
          <% @review.blockers.each do |blocker| %>
            <li>
              <p><%= blocker.message %></p>
              <% destination = cruise_activation_blocker_path(blocker) %>
              <% if destination %>
                <%= link_to cruise_activation_blocker_label(blocker), destination %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>The Supplier setup is ready, and this Cruise activation screen cannot safely represent the activation.</p>
        <% @review.unsupported_reasons.each do |reason| %>
          <p><%= reason %></p>
        <% end %>
        <% if @review.cost_rows.any? { |row| row.stage_label == "Estimate" } %>
          <p>A selected Supplier cost is an estimate. This Cruise review will not acknowledge an estimate.</p>
        <% end %>
      <% end %>
      <%= link_to "Open Advanced Supplier planning",
            departure_arrangement_activation_path(@departure, @supplier_arrangement) %>
    </div>
  </section>
<% end %>
