<%= form_with url: url, method: method, class: "dd-form dd-stack" do %>
  <%= hidden_field_tag :version_id, @supplier_arrangement_version.id %>
  <% if @definition %>
    <%= hidden_field_tag :lock_version, @definition.lock_version %>
  <% else %>
    <%= hidden_field_tag :idempotency_key, @idempotency_key %>
  <% end %>
  <div class="dd-field-group">
    <label class="dd-label" for="deadline-type">Deadline</label>
    <select id="deadline-type" name="deadline_type" class="dd-field" required>
      <% HotelAgreementWorkspace::DEADLINE_LABELS.each do |value, label| %>
        <option value="<%= value %>" <%= "selected" if @deadline_type == value %>><%= label %></option>
      <% end %>
    </select>
  </div>
  <div class="dd-field-group">
    <label class="dd-label" for="deadline-other-label">Other label</label>
    <input id="deadline-other-label" name="other_label" class="dd-field" value="<%= @other_label %>">
  </div>
  <div class="dd-field-group">
    <label class="dd-label" for="deadline-due-on">Due date</label>
    <input id="deadline-due-on" name="due_on" type="date" class="dd-field" required value="<%= @due_on %>">
  </div>
  <div class="dd-field-group">
    <label class="dd-label" for="deadline-due-time">Due time</label>
    <input id="deadline-due-time" name="due_time" type="time" class="dd-field" value="<%= @due_time %>">
  </div>
  <p>This stay. Leave the time blank for a date-only deadline.</p>
  <button type="submit" class="dd-button">Save deadline</button>
<% end %>
