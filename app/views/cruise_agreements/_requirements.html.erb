<section class="dd-panel dd-agreement-section" aria-labelledby="deposits-and-deadlines">
  <header class="dd-panel-header">
    <%= cruise_marked_heading(:h2, "deposits-and-deadlines", "Deposits & deadlines", class: "dd-agreement-heading") %>
  </header>
  <div class="dd-panel-body">
    <p class="dd-agreement-description">Recording a Supplier requirement does not record that the Agency has satisfied it.</p>

    <% workspace = @requirements_workspace %>
    <% if workspace&.compatible? %>
      <% deposit_rows = workspace.deposit_rows %>
      <% deadline_rows = workspace.deadline_rows %>
      <% initial_rows = deposit_rows.select { |row| cruise_preset_initial_deposit?(row) } %>
      <% hard_stop_rows = deadline_rows.select { |row| cruise_preset_deadline?(row, "option_or_release") } %>
      <% final_rows = deadline_rows.select { |row| cruise_preset_deadline?(row, "final_payment") } %>
      <% additional_rows = deposit_rows.reject { |row| cruise_preset_initial_deposit?(row) } +
        deadline_rows.reject { |row| cruise_preset_deadline?(row, "option_or_release") || cruise_preset_deadline?(row, "final_payment") } %>

      <% if initial_rows.empty? %>
        <div class="dd-agreement-row" id="deposit-new-initial">
          <% if cruise_agreement_focused?("deposit-new-initial") %>
            <%= cruise_marked_heading(:h3, "initial-deposit", "Initial Deposit", class: "dd-agreement-row-heading") %>
            <%= render "cruise_agreements/initial_deposit_form", definition: nil %>
          <% else %>
            <div class="dd-agreement-row-head">
              <%= cruise_marked_heading(:h3, "initial-deposit", "Initial Deposit", class: "dd-agreement-row-heading") %>
              <%= cruise_status_badge("Not recorded", :neutral) %>
              <% suggested = cruise_suggested_deposit_due_on %>
              <% if suggested %>
                <p class="dd-agreement-meta">Suggested due date: <%= cruise_calendar_date(suggested) %>. Based on group creation date + 30 days.</p>
              <% end %>
              <% if @editable %>
                <div class="dd-agreement-row-actions">
                  <%= cruise_row_link "Add", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: "deposit-new-initial") %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <% initial_rows.each do |row| %>
          <% definition = row.definition %>
          <% focus_key = "deposit-#{definition.id}" %>
          <div class="dd-agreement-row">
            <% if cruise_agreement_focused?(focus_key) %>
              <%= cruise_marked_heading(:h3, focus_key, "Initial Deposit", class: "dd-agreement-row-heading") %>
              <%= render "cruise_agreements/initial_deposit_form", definition: definition %>
            <% else %>
              <div class="dd-agreement-row-head">
                <%= cruise_marked_heading(:h3, focus_key, "Initial Deposit", class: "dd-agreement-row-heading") %>
                <% if (due = cruise_fixed_due_date(definition)) %>
                  <p class="dd-agreement-meta">Due <%= cruise_calendar_date(due) %></p>
                <% end %>
                <% sentence = cruise_opening_deposit_sentence(definition) %>
                <p class="dd-agreement-meta"><%= sentence.presence || "#{cruise_minor_amount_field(definition.rate_minor_units, definition.currency)} per opening cabin" %></p>
                <% if @editable %>
                  <div class="dd-agreement-row-actions">
                    <%= cruise_row_link "Edit", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: focus_key) %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if hard_stop_rows.empty? %>
        <div class="dd-agreement-row" id="deadline-new-hard-stop">
          <% if cruise_agreement_focused?("deadline-new-hard-stop") %>
            <%= cruise_marked_heading(:h3, "hard-stop", "Hard Stop", class: "dd-agreement-row-heading") %>
            <%= render "cruise_agreements/deadline_form", definition: nil, template: "hard_stop", focus_key: "deadline-new-hard-stop", show_description: true %>
          <% else %>
            <div class="dd-agreement-row-head">
              <%= cruise_marked_heading(:h3, "hard-stop", "Hard Stop", class: "dd-agreement-row-heading") %>
              <%= cruise_status_badge("Not recorded", :neutral) %>
              <% if @editable %>
                <div class="dd-agreement-row-actions">
                  <%= cruise_row_link "Add", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: "deadline-new-hard-stop") %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <% hard_stop_rows.each do |row| %>
          <% definition = row.definition %>
          <% focus_key = "deadline-#{definition.id}" %>
          <div class="dd-agreement-row">
            <% if cruise_agreement_focused?(focus_key) %>
              <%= cruise_marked_heading(:h3, focus_key, "Hard Stop", class: "dd-agreement-row-heading") %>
              <%= render "cruise_agreements/deadline_form", definition: definition, template: "hard_stop", focus_key: focus_key, show_description: true %>
            <% else %>
              <div class="dd-agreement-row-head">
                <%= cruise_marked_heading(:h3, focus_key, "Hard Stop", class: "dd-agreement-row-heading") %>
                <% if (due = cruise_fixed_due_date(definition)) %>
                  <p class="dd-agreement-meta"><%= cruise_calendar_date(due) %></p>
                <% end %>
                <% if @editable %>
                  <div class="dd-agreement-row-actions">
                    <%= cruise_row_link "Edit", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: focus_key) %>
                  </div>
                <% end %>
              </div>
              <% if definition.description.present? %>
                <div class="dd-reference-text dd-agreement-row-prose"><%= formatted_reference_text(definition.description) %></div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if final_rows.empty? %>
        <div class="dd-agreement-row" id="deadline-new-final-payment">
          <% if cruise_agreement_focused?("deadline-new-final-payment") %>
            <%= cruise_marked_heading(:h3, "final-payment", "Final Payment", class: "dd-agreement-row-heading") %>
            <%= render "cruise_agreements/deadline_form", definition: nil, template: "final_payment", focus_key: "deadline-new-final-payment", show_description: false %>
          <% else %>
            <div class="dd-agreement-row-head">
              <%= cruise_marked_heading(:h3, "final-payment", "Final Payment", class: "dd-agreement-row-heading") %>
              <%= cruise_status_badge("Not recorded", :neutral) %>
              <% if @editable %>
                <div class="dd-agreement-row-actions">
                  <%= cruise_row_link "Add", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: "deadline-new-final-payment") %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <% final_rows.each do |row| %>
          <% definition = row.definition %>
          <% focus_key = "deadline-#{definition.id}" %>
          <div class="dd-agreement-row">
            <% if cruise_agreement_focused?(focus_key) %>
              <%= cruise_marked_heading(:h3, focus_key, "Final Payment", class: "dd-agreement-row-heading") %>
              <%= render "cruise_agreements/deadline_form", definition: definition, template: "final_payment", focus_key: focus_key, show_description: false %>
            <% else %>
              <div class="dd-agreement-row-head">
                <%= cruise_marked_heading(:h3, focus_key, "Final Payment", class: "dd-agreement-row-heading") %>
                <% if (due = cruise_fixed_due_date(definition)) %>
                  <p class="dd-agreement-meta"><%= cruise_calendar_date(due) %></p>
                <% end %>
                <% if @editable %>
                  <div class="dd-agreement-row-actions">
                    <%= cruise_row_link "Edit", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: focus_key) %>
                  </div>
                <% end %>
              </div>
              <% if definition.description.present? %>
                <div class="dd-reference-text dd-agreement-row-prose"><%= formatted_reference_text(definition.description) %></div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% additional_rows.each do |row| %>
        <div class="dd-agreement-row" id="requirement-<%= row.definition.id %>">
          <div class="dd-agreement-row-head">
            <h3 class="dd-agreement-row-heading"><%= row.display_label %></h3>
            <% if row.timing_sentence.present? %>
              <p class="dd-agreement-meta"><%= row.timing_sentence %></p>
            <% end %>
            <div class="dd-agreement-row-actions">
              <%= cruise_forward_link "Additional Supplier requirement — Review in Advanced", row.advanced_path %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="dd-agreement-description">Additional Supplier requirement — Review in Advanced</p>
      <p><%= cruise_forward_link "Review in Advanced", departure_arrangement_path(@departure, @supplier_arrangement) %></p>
    <% end %>
  </div>
  <% if workspace&.compatible? %>
    <footer class="dd-panel-footer">
      <%= cruise_forward_link "Open deposits and deadlines", departure_arrangement_cruise_deposits_and_deadlines_path(@departure, @supplier_arrangement) %>
    </footer>
  <% end %>
</section>
