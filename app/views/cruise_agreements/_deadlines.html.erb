<section class="dd-panel dd-agreement-section" aria-labelledby="deadlines">
  <header class="dd-panel-header">
    <%= cruise_marked_heading(:h2, "deadlines", "Deadlines", class: "dd-agreement-heading") %>
  </header>
  <div class="dd-panel-body">
    <p class="dd-agreement-description">Saving a deadline records the Supplier date. It does not release inventory.</p>

    <% workspace = @requirements_workspace %>
    <% omissions = [] %>
    <% recorded = [] %>
    <% if workspace&.compatible? %>
      <% hard_stop_rows = workspace.deadline_rows.select { |row| cruise_preset_deadline?(row, "option_or_release") } %>
      <% final_rows = workspace.deadline_rows.select { |row| cruise_preset_deadline?(row, "final_payment") } %>
      <% additional_rows = workspace.deadline_rows.reject { |row|
        cruise_preset_deadline?(row, "option_or_release") || cruise_preset_deadline?(row, "final_payment")
      } %>

      <% [
        [ hard_stop_rows, "deadline-new-hard-stop", "hard-stop", "Hard Stop", "hard_stop", true ],
        [ final_rows, "deadline-new-final-payment", "final-payment", "Final Payment", "final_payment", false ]
      ].each do |rows, new_focus, heading_id, label, template, show_description| %>
        <% if rows.empty? %>
          <% if cruise_agreement_focused?(new_focus) %>
            <div class="dd-agreement-row" id="<%= new_focus %>">
              <%= cruise_marked_heading(:h3, heading_id, label, class: "dd-agreement-row-heading") %>
              <%= render "cruise_agreements/deadline_form", definition: nil, template: template, focus_key: new_focus, show_description: show_description %>
            </div>
          <% else %>
            <% omissions << {
              anchor: new_focus,
              heading_id: heading_id,
              label: label,
              href: departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: new_focus)
            } %>
          <% end %>
        <% else %>
          <% rows.each do |row| %>
            <% definition = row.definition %>
            <% focus_key = "deadline-#{definition.id}" %>
            <% if cruise_agreement_focused?(focus_key) %>
              <div class="dd-agreement-row">
                <%= cruise_marked_heading(:h3, focus_key, label, class: "dd-agreement-row-heading") %>
                <%= render "cruise_agreements/deadline_form", definition: definition, template: template, focus_key: focus_key, show_description: show_description %>
              </div>
            <% else %>
              <% recorded << [ label, row ] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if recorded.any? %>
        <div class="dd-table-wrap">
          <table class="dd-table">
            <thead>
              <tr>
                <th scope="col">Deadline</th>
                <th scope="col">Due</th>
                <th scope="col">Purpose</th>
                <th scope="col">Scope</th>
                <% if @editable %><th scope="col"><span class="dd-visually-hidden">Actions</span></th><% end %>
              </tr>
            </thead>
            <tbody>
              <% recorded.each do |label, row| %>
                <% definition = row.definition %>
                <% focus_key = "deadline-#{definition.id}" %>
                <% due = cruise_fixed_due_date(definition) %>
                <tr>
                  <th scope="row" id="<%= focus_key %>"><%= label %></th>
                  <td><%= due ? cruise_calendar_date(due) : "Not recorded" %></td>
                  <td><%= definition.description.present? ? formatted_reference_text(definition.description) : "Not recorded" %></td>
                  <td><%= row.coverage_label.presence || row.coverage_summary.presence || "Not recorded" %></td>
                  <% if @editable %>
                    <td><%= cruise_row_link "Edit", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, focus: focus_key) %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% additional_rows.each do |row| %>
        <div class="dd-agreement-row" id="requirement-<%= row.definition.id %>">
          <div class="dd-agreement-row-head">
            <h3 class="dd-agreement-row-heading"><%= row.display_label %></h3>
            <%= cruise_status_badge("Advanced", :neutral) %>
            <% if row.timing_sentence.present? %>
              <p class="dd-agreement-meta"><%= row.timing_sentence %></p>
            <% end %>
            <div class="dd-agreement-row-actions">
              <%= cruise_forward_link "Additional Supplier requirement — Review in Advanced", row.advanced_path %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="dd-agreement-description">This deadline structure is Advanced.</p>
      <p><%= cruise_forward_link "Review in Advanced", departure_arrangement_path(@departure, @supplier_arrangement) %></p>
    <% end %>

    <%= render "cruise_agreements/omissions", items: omissions %>
  </div>
</section>
