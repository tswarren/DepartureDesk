<% show_same_terms = @can_manage && @supplier_arrangement_version&.activated? && @same_terms_pool_id.present? %>
<% if show_same_terms || @can_create_successor %>
  <section class="dd-panel dd-agreement-section" aria-labelledby="later-capacity">
    <header class="dd-panel-header">
      <h2 id="later-capacity" class="dd-agreement-heading">Later capacity</h2>
    </header>
    <div class="dd-panel-body dd-stack">
    <p class="dd-agreement-description">These controls stay available until the later-capacity workflow replaces them.</p>

    <% if show_same_terms %>
      <h3 class="dd-agreement-row-heading">Same-terms capacity increase</h3>
      <%= form_with url: same_terms_increase_departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement),
            method: :post, class: "dd-stack", html: { id: "cruise-same-terms-increase" } do %>
        <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
        <%= hidden_field_tag :capacity_pool_id, @same_terms_pool_id %>
        <div class="dd-field">
          <label class="dd-label" for="increase_quantity">Additional cabins</label>
          <%= number_field_tag :quantity, nil, id: "increase_quantity", class: "dd-input" %>
        </div>
        <div class="dd-field">
          <label class="dd-label" for="increase_rate">Deposit per additional cabin (<%= @departure.operating_currency %>)</label>
          <%= text_field_tag :rate_amount, nil, id: "increase_rate", class: "dd-input" %>
        </div>
        <div class="dd-field">
          <label class="dd-label" for="increase_evidence_on">Evidence date</label>
          <%= date_field_tag :evidence_on, nil, id: "increase_evidence_on", class: "dd-input" %>
        </div>
        <div class="dd-field">
          <label class="dd-label" for="increase_evidence_note">Evidence note</label>
          <%= text_field_tag :evidence_reference_note, nil, id: "increase_evidence_note", class: "dd-input" %>
        </div>
        <%= submit_tag "Record same-terms increase", class: "dd-button" %>
      <% end %>
    <% end %>

    <% if @can_create_successor %>
      <h3 class="dd-agreement-row-heading">Supplemental block</h3>
      <%= form_with url: supplemental_block_departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement),
            method: :post, class: "dd-stack", html: { id: "cruise-supplemental-block" } do %>
        <%= hidden_field_tag :arrangement_lock_version, @supplier_arrangement.lock_version %>
        <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
        <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
        <div class="dd-field">
          <label class="dd-label" for="supplemental_occupancy">Maximum occupancy</label>
          <%= number_field_tag :maximum_occupancy, nil, id: "supplemental_occupancy", class: "dd-input" %>
        </div>
        <div class="dd-field">
          <label class="dd-label" for="supplemental_quantity">Opening quantity</label>
          <%= number_field_tag :opening_quantity, nil, id: "supplemental_quantity", class: "dd-input" %>
        </div>
        <%= submit_tag "Add supplemental O1 block", class: "dd-button" %>
      <% end %>
    <% end %>
    </div>
  </section>
<% end %>
