<% confirmation = @agreement_confirmation %>
<% ship_name = @shape.summary["ship_name"].presence || @supplier_arrangement.name %>
<% content_for :title, "Supplier agreement · #{ship_name} · DepartureDesk" %>

<%= render "cruise_setup/shell", current: :agreement, page_title: "Supplier agreement" %>

<div class="dd-cruise-agreement-review">
  <%= render "cruise_agreements/identity", confirmation: confirmation %>
  <%= render "cruise_agreements/requirements" %>
  <%= render "cruise_agreements/benefits" %>
  <%= render "cruise_agreements/terms" %>
  <% if @can_manage && @supplier_arrangement.governing_version&.activated? %>
    <section class="dd-panel dd-agreement-section" id="cruise-change-inventory" aria-labelledby="change-inventory">
      <header class="dd-panel-header">
        <h2 id="change-inventory" class="dd-agreement-heading">Change inventory</h2>
      </header>
      <div class="dd-panel-body">
        <%= link_to "Change inventory",
              departure_arrangement_cruise_inventory_change_path(@departure, @supplier_arrangement),
              class: "dd-link" %>
      </div>
    </section>
  <% end %>
</div>
