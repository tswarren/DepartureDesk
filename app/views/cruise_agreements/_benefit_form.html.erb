<% posted = params[:commercial_benefit] if cruise_agreement_focused?(focus_key) %>
<% body_value = posted&.dig(:body).presence || definition&.body %>
<% if @form_error.present? %>
  <p id="form-error-summary" role="alert" data-controller="form-error-summary"><%= @form_error %></p>
<% end %>
<%= form_with url: definition ?
      departure_arrangement_cruise_commercial_benefit_path(@departure, @supplier_arrangement, term_type) :
      departure_arrangement_cruise_commercial_benefits_path(@departure, @supplier_arrangement),
    method: definition ? :patch : :post, class: "dd-form dd-stack" do %>
  <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
  <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
  <%= hidden_field_tag :benefit_editor, focus_key %>
  <%= hidden_field_tag "commercial_benefit[term_type]", term_type %>
  <% if definition %>
    <%= hidden_field_tag :definition_lock_version, definition.lock_version %>
  <% end %>
  <% if manage_source %>
    <div class="dd-field-group">
      <label class="dd-label" for="benefit_citation_<%= term_type %>">Source citation</label>
      <input id="benefit_citation_<%= term_type %>" name="commercial_benefit[source_citation]" class="dd-field"
        maxlength="160" value="<%= posted&.key?(:source_citation) ? posted[:source_citation] : definition&.source_citation %>">
      <p class="dd-help">Clearing this field removes the stored source citation.</p>
    </div>
    <%= hidden_field_tag "commercial_benefit[body]", definition.body %>
  <% else %>
    <div class="dd-field-group">
      <label class="dd-label" for="benefit_body_<%= term_type %>">Wording</label>
      <textarea id="benefit_body_<%= term_type %>" name="commercial_benefit[body]" class="dd-field"
        maxlength="4000" rows="5" required><%= body_value %></textarea>
    </div>
  <% end %>
  <div class="dd-form-actions">
    <%= submit_tag(manage_source ? "Save source" : (definition ? "Save #{cruise_benefit_label(term_type)}" : "Add #{cruise_benefit_label(term_type)}"), class: "dd-button") %>
    <%= link_to "Cancel", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, anchor: "commercial-benefits"), class: "dd-button dd-button--quiet" %>
  </div>
<% end %>
