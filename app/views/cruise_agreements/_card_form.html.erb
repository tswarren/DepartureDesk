<% body_value = params.key?(:card_restrictions) ? params[:card_restrictions] : term&.body %>
<% if @form_error.present? %>
  <p id="form-error-summary" role="alert" data-controller="form-error-summary"><%= @form_error %></p>
<% end %>
<%= form_with url: terms_departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement),
      method: :post, class: "dd-stack", html: { id: "cruise-payment-restrictions-form" } do %>
  <%= hidden_field_tag :term_scope, "card" %>
  <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
  <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
  <div class="dd-field-group">
    <label class="dd-label" for="card_restrictions">Payment restrictions</label>
    <%= text_area_tag :card_restrictions, body_value, id: "card_restrictions", class: "dd-field", rows: 5, maxlength: SupplierArrangementCruiseTermDefinition::BODY_LIMIT, required: true %>
  </div>
  <div class="dd-form-actions">
    <%= submit_tag term ? "Save payment restrictions" : "Add payment restrictions", class: "dd-button" %>
    <%= link_to "Cancel", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, anchor: "policies"), class: "dd-button dd-button--quiet" %>
  </div>
<% end %>
