<dl class="dd-fact-grid">
  <div>
    <dt>Contracting supplier</dt>
    <dd><%= @supplier_arrangement.contracting_supplier.display_name_for_directory %></dd>
  </div>
  <% if confirmation.group_reference.present? %>
    <div>
      <dt>Supplier group number</dt>
      <dd>Group <%= confirmation.group_reference %></dd>
    </div>
  <% end %>
  <% if confirmation.group_creation_date.present? %>
    <div>
      <dt>Group creation date</dt>
      <dd><%= cruise_calendar_date(confirmation.group_creation_date) %></dd>
    </div>
  <% end %>
  <% if confirmation.contract_date.present? %>
    <div>
      <dt>Contract date</dt>
      <dd><%= cruise_calendar_date(confirmation.contract_date) %></dd>
    </div>
  <% end %>
  <% if confirmation.confirmed? && confirmation.confirmed_at.present? %>
    <div>
      <dt>Confirmation recorded</dt>
      <dd><%= cruise_confirmation_recorded_on(confirmation) %></dd>
    </div>
  <% end %>
</dl>
<% if confirmation.note.present? %>
  <div class="dd-agreement-note">
    <h3 class="dd-agreement-row-heading">Notes</h3>
    <div class="dd-reference-text"><%= formatted_reference_text(confirmation.note) %></div>
  </div>
<% end %>
<% if confirmation.deposit_treatment.present? || cruise_supplemental_deposit_treatment_pending?(confirmation) %>
  <div class="dd-agreement-note">
    <h3 class="dd-agreement-row-heading">Deposit treatment for a supplemental block</h3>
    <% if confirmation.deposit_treatment.present? %>
      <div class="dd-reference-text"><%= formatted_reference_text(confirmation.deposit_treatment) %></div>
    <% else %>
      <p class="dd-agreement-description">Not recorded</p>
    <% end %>
  </div>
<% end %>
<% priors = cruise_agreement_prior_confirmations(confirmation) %>
<% if priors.any? %>
  <details class="dd-agreement-note">
    <summary>View history</summary>
    <div class="dd-table-wrap">
      <table class="dd-table">
        <thead>
          <tr>
            <th scope="col">State</th>
            <th scope="col">Confirmation recorded</th>
            <th scope="col">Actor</th>
            <th scope="col">Group number</th>
            <th scope="col">Group creation date</th>
            <th scope="col">Contract date</th>
          </tr>
        </thead>
        <tbody>
          <% priors.each do |prior| %>
            <tr>
              <td><%= prior.confirmed? ? "Confirmed" : "Provisional" %></td>
              <td><%= prior.confirmed? && prior.confirmed_at.present? ? cruise_confirmation_recorded_on(prior) : "Not confirmed" %></td>
              <td><%= prior.confirmed_by&.display_name.presence || "Not recorded" %></td>
              <td><%= prior.group_reference.present? ? "Group #{prior.group_reference}" : "Not recorded" %></td>
              <td><%= prior.group_creation_date.present? ? cruise_calendar_date(prior.group_creation_date) : "Not recorded" %></td>
              <td><%= prior.contract_date.present? ? cruise_calendar_date(prior.contract_date) : "Not recorded" %></td>
            </tr>
            <% if prior.note.present? || prior.deposit_treatment.present? %>
              <tr>
                <td colspan="6">
                  <details>
                    <summary>Note and supplemental deposit treatment</summary>
                    <% if prior.note.present? %>
                      <div class="dd-reference-text"><%= formatted_reference_text(prior.note) %></div>
                    <% else %>
                      <p>Note not recorded.</p>
                    <% end %>
                    <% if prior.deposit_treatment.present? %>
                      <div class="dd-reference-text"><%= formatted_reference_text(prior.deposit_treatment) %></div>
                    <% else %>
                      <p>Supplemental deposit treatment not recorded.</p>
                    <% end %>
                  </details>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>
<% end %>
