<% editor_key = adding ? "cancellation-new" : "cancellation-edit-#{editing_position}" %>
<% posted_steps = Array(params[:cancellation_steps]).map { |step| step.respond_to?(:to_h) ? step.to_h.with_indifferent_access : {} } %>
<% rows = if posted_steps.any?
     posted_steps
   else
     built = steps.map { |step| { "days_before_departure" => step.days_before_departure, "body" => step.body } }
     built << { "days_before_departure" => "", "body" => "" } if adding
     built
   end %>
<% if @form_error.present? %>
  <p id="form-error-summary" role="alert" data-controller="form-error-summary"><%= @form_error %></p>
<% end %>
<%= form_with url: terms_departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement),
      method: :post, class: "dd-stack", html: { id: "cruise-cancellation-form" } do %>
  <%= hidden_field_tag :term_scope, "cancellation" %>
  <%= hidden_field_tag :cancellation_editor, editor_key %>
  <%= hidden_field_tag :version_lock_version, @supplier_arrangement_version.lock_version %>
  <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
  <% rows.each_with_index do |step, index| %>
    <% visible = adding ? index == rows.length - 1 : index + 1 == editing_position %>
    <% if visible %>
      <div class="dd-field-group">
        <label class="dd-label" for="cancellation_days_<%= index %>">Days before departure</label>
        <%= number_field_tag "cancellation_steps[][days_before_departure]", step[:days_before_departure] || step["days_before_departure"], id: "cancellation_days_#{index}", class: "dd-field", min: 0, required: true %>
      </div>
      <div class="dd-field-group">
        <label class="dd-label" for="cancellation_body_<%= index %>">Policy wording</label>
        <%= text_area_tag "cancellation_steps[][body]", step[:body] || step["body"], id: "cancellation_body_#{index}", class: "dd-field", rows: 4, maxlength: SupplierArrangementCruiseTermDefinition::BODY_LIMIT, required: true %>
      </div>
    <% else %>
      <%= hidden_field_tag "cancellation_steps[][days_before_departure]", step[:days_before_departure] || step["days_before_departure"], id: nil %>
      <%= hidden_field_tag "cancellation_steps[][body]", step[:body] || step["body"], id: nil %>
    <% end %>
  <% end %>
  <div class="dd-form-actions">
    <%= submit_tag adding ? "Save step" : "Save step", class: "dd-button" %>
    <%= link_to "Cancel", departure_arrangement_cruise_agreement_path(@departure, @supplier_arrangement, anchor: "term-cancellation"), class: "dd-button dd-button--quiet" %>
  </div>
<% end %>
