<% content_for :title, "#{@booking.booking_reference} · DepartureDesk" %>
<% departure = @trip.departure %>
<% client_name = @trip.client.source.display_name %>
<% manage = booking_manager? && @booking.status_draft? %>
<% staff = !reseller_area? %>

<%= render "shared/breadcrumbs", trail: booking_trail(@booking, current: true) %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Booking · <%= staff ? link_to("Trip #{@trip.trip_reference}", client_trip_path(@trip)) : "Trip #{@trip.trip_reference}" %></p>
    <h1 class="dd-page-title"><span class="dd-type-mono"><%= @booking.booking_reference %></span></h1>
    <p class="dd-page-description"><%= client_name %> · <%= @booking.offering.name %> on <%= departure.name %></p>
  </div>
  <div class="dd-page-actions">
    <% if @step == "summary" %><%= render "shared/print_button" %><% end %>
    <% if staff && Current.agency_user.permitted?(:manage_bookings) %>
      <%= button_to "New booking on this trip", client_trip_bookings_path(@trip), class: "dd-button dd-button--secondary" %>
    <% end %>
    <%# BKG-56: a reseller discards only while the hold is active. %>
    <% if manage && (staff || @booking.hold_state.first == :held) %>
      <%= button_to "Discard booking", booking_route(:client_booking_discard, @booking), class: "dd-button dd-button--quiet",
            form: { data: { turbo_confirm: "Discard #{@booking.booking_reference}? Its held space is released, and the reference is not reused." } } %>
    <% end %>
  </div>
</header>

<% if @blocked.present? %>
  <div class="dd-alert dd-alert--danger" role="alert" id="form-error-summary" tabindex="-1" data-controller="form-error-summary">
    <p class="dd-alert-title">This booking can't be confirmed yet:</p>
    <ul class="dd-error-list">
      <% @blocked.each do |message, anchor| %>
        <li><%= link_to message, booking_section_path(@booking, anchor) %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<article class="dd-panel" id="status">
  <div class="dd-panel-body">
    <dl class="dd-definition-list">
      <div><dt>Status</dt><dd><%= booking_status_badge(@booking) %></dd></div>
      <div><dt>Space</dt><dd><%= booking_hold_badge(@booking) %></dd></div>
      <div><dt>Responsible client</dt><dd><%= staff ? link_to(client_name, client_profile_path_for(@trip.client)) : client_name %></dd></div>
      <div><dt>Owner</dt><dd><%= @booking.owner_label %></dd></div>
      <% terms = @booking.client_terms_version %>
      <div><dt>Client terms</dt><dd><%= terms ? (staff ? link_to("Version #{terms.version_number}", departure_client_terms_path(departure)) : "Version #{terms.version_number}") : "None yet" %></dd></div>
      <div><dt>Created by</dt><dd><%= @booking.created_by.display_name %></dd></div>
    </dl>
  </div>
</article>

<%= render "client_bookings/steps", booking: @booking, progress: @progress, step: @step %>

<% unless @booking.status_draft? || @step.in?(%w[summary confirm money]) %>
  <p class="dd-alert dd-alert--info" role="status">
    <% if @booking.status_confirmed? %>
      This booking is confirmed, so its travelers and services can't change here: a change to a confirmed booking is an amendment, which isn't built yet.
      To book more for <%= @trip.client.source.display_name %>, start a new booking on this trip.
    <% else %>
      This booking is <%= @booking.status %>; nothing on it can change.
    <% end %>
  </p>
<% end %>

<% case @step %>
<% when "summary" %>
  <%= render "client_bookings/summary", booking: @booking, blockers: @blockers %>
<% when "travelers" %>
  <%= render "client_bookings/step_travelers", booking: @booking, trip: @trip, manage:, linked_travelers: @linked_travelers, traveler_types: @traveler_types,
        traveler_query: @traveler_query, found_travelers: @found_travelers %>
<% when "rooms" %>
  <%= render "client_bookings/step_rooms", booking: @booking, manage:, choices: @choices %>
  <%= render "client_bookings/supplier_requests", booking: @booking, step: "rooms" if Current.agency_user.permitted?(:view_supplier_reservations) %>
<% when "price" %>
  <%= render "client_bookings/step_price", booking: @booking, manage: %>
<% when "hold" %>
  <%= render "client_bookings/step_hold", booking: @booking, trip: @trip, manage: %>
<% when "money" %>
  <%= render "client_bookings/step_money", booking: @booking %>
<% else %>
  <%= render "client_bookings/supplier_requests", booking: @booking, step: "confirm" if Current.agency_user.permitted?(:view_supplier_reservations) %>
  <%= render "client_bookings/step_confirm", booking: @booking, manage:, blockers: @blockers %>
<% end %>

<% if (next_step = @progress.next_after(@step)) %>
  <div class="dd-form-actions dd-step-next">
    <%= link_to "Next: #{BookingProgress::LABELS.fetch(next_step).downcase}", booking_route(:client_booking, @booking, step: next_step), class: "dd-button" %>
  </div>
<% end %>
