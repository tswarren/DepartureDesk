<% content_for :title, "Invite a user · #{@reseller.name} · DepartureDesk" %>

<%= render "shared/breadcrumbs", trail: [ [ "Resellers", resellers_path ], [ @reseller.name, reseller_path(@reseller) ], [ "Invite a user", nil ] ] %>

<header class="dd-page-header">
  <div class="dd-page-heading">
    <p class="dd-eyebrow">Reseller</p>
    <h1 class="dd-page-title">Invite a user to <%= @reseller.name %></h1>
    <p class="dd-page-description">They sign in to this agency's workspace and see only the packages published to <%= @reseller.name %> and the bookings it owns.</p>
  </div>
</header>

<article class="dd-panel">
  <div class="dd-panel-body">
    <%= form_with model: @agency_user, url: reseller_users_path(@reseller), class: "dd-form" do |form| %>
      <%= render "shared/form_errors", object: form.object %>
      <div class="dd-field-group">
        <%= form.label :email_address, "Email address", class: "dd-label" %>
        <%= form.email_field :email_address, **dd_field_options(form, :email_address, required: true, autocomplete: "off") %>
        <%= dd_field_error(form, :email_address) %>
      </div>
      <div class="dd-form-grid dd-form-grid--two-column">
        <div class="dd-field-group">
          <%= form.label :first_name, class: "dd-label" %>
          <%= form.text_field :first_name, **dd_field_options(form, :first_name, required: true) %>
          <%= dd_field_error(form, :first_name) %>
        </div>
        <div class="dd-field-group">
          <%= form.label :last_name, class: "dd-label" %>
          <%= form.text_field :last_name, **dd_field_options(form, :last_name, required: true) %>
          <%= dd_field_error(form, :last_name) %>
        </div>
      </div>
      <div class="dd-form-actions">
        <%= form.submit "Send invitation", class: "dd-button" %>
        <%= link_to "Cancel", reseller_path(@reseller), class: "dd-button dd-button--quiet" %>
      </div>
    <% end %>
  </div>
</article>
