#!/usr/bin/env bash
set -euo pipefail

service="${RAILS_DOCKER_SERVICE:-web}"

# docker compose exec/run does not inherit the caller's environment.
# Forward the variables the runbook and local CI docs set on the host command.
forward_env=()
while IFS= read -r name; do
  forward_env+=(-e "${name}=${!name}")
done < <(compgen -e | grep -E '^(AGENCY_|FORCE_SYSTEM_TESTS$)' || true)

if docker compose ps --status running --services | grep -qx "$service"; then
  compose_cmd=(docker compose exec)
else
  compose_cmd=(docker compose run --rm)
fi

if ((${#forward_env[@]} > 0)); then
  exec "${compose_cmd[@]}" "${forward_env[@]}" "$service" "$@"
else
  exec "${compose_cmd[@]}" "$service" "$@"
fi
